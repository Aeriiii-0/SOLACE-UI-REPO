<Window x:Class="SOLUM_UI.OcrTemplateConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solace — OCR Template Field Box Calibration"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1340" Height="860"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border Background="#33000000">
        <Border Background="White" CornerRadius="16" Margin="16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="60"/>
                    <!-- Main Body -->
                    <RowDefinition Height="*"/>
                    <!-- Footer -->
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="#702943" CornerRadius="16,16,0,0" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📐" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="OCR Template Field Box Calibration" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Visually reposition and resize bounding boxes for CSWDO-066-2 Application Form" FontSize="11" Foreground="#E0B8C4"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄 Revert to Default" Click="ResetToDefault_Click"
                                    Height="32" Padding="14,0" Background="#903554" Foreground="White"
                                    BorderThickness="1" BorderBrush="#B86580" Cursor="Hand" Margin="0,0,12,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="32">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE -->
                <Grid Grid.Row="1" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <!-- Interactive Canvas Viewport -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Field Properties & Calibration Sidebar -->
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: INTERACTIVE DOCUMENT CANVAS -->
                    <Border Grid.Column="0" Background="#F0ECED" BorderBrush="#D8C8CC" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Canvas Toolbar -->
                            <Border Grid.Row="0" Background="#E5D8DC" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnUndo" Content="↩ Undo" Click="Undo_Click" Height="26" Padding="10,0" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="11"/>
                                        <Button x:Name="BtnRedo" Content="↪ Redo" Click="Redo_Click" Height="26" Padding="10,0" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" Margin="0,0,14,0" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="💡 Click &amp; drag box to move. Use sliders on right for fine-tuning." FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Zoom Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="-" Click="ZoomOut_Click" Width="26" Height="26" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,4,0" FontWeight="Bold"/>
                                        <Button Content="Fit" Click="ZoomFit_Click" Height="26" Padding="6,0" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="+" Click="ZoomIn_Click" Width="26" Height="26" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scrollable & Zoomable Viewport -->
                            <ScrollViewer x:Name="CanvasScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#333333">
                                <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Scanned Document Image (Fills Container exactly matching Canvas coordinates) -->
                                    <Image x:Name="ImgDocument" Stretch="Fill"
                                           Width="{Binding Width, ElementName=OverlayCanvas}"
                                           Height="{Binding Height, ElementName=OverlayCanvas}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Overlay Canvas for Field Boxes -->
                                    <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                            MouseDown="OverlayCanvas_MouseDown"
                                            MouseMove="OverlayCanvas_MouseMove"
                                            MouseUp="OverlayCanvas_MouseUp"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: FIELD PROPERTIES & LIVE TESTING SIDEBAR -->
                    <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- GLOBAL TEMPLATE ALIGNMENT & SCALING (ALL BOXES) -->
                                <Border Background="#F3E5F5" BorderBrush="#CE93D8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🌐 Global Image / Box Scale" FontSize="12" FontWeight="Bold" Foreground="#6A1B9A"/>
                                            <TextBlock Text="All 50+ Boxes" Grid.Column="1" FontSize="10" Foreground="#8E24AA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Shift or scale all boxes simultaneously to match different scanner sizes:" FontSize="10" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- NUDGE ALL 4-WAY D-PAD -->
                                        <TextBlock Text="1. Nudge All Boxes Position:" FontSize="11" FontWeight="SemiBold" Foreground="#4A148C" Margin="0,0,0,4"/>
                                        <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26"/>
                                                <RowDefinition Height="26"/>
                                                <RowDefinition Height="26"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Row="0" Grid.Column="1" Content="▲ Up" Click="GlobalNudgeUp_Click" FontSize="10" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes up by 0.5%"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="◀ Left" Click="GlobalNudgeLeft_Click" FontSize="10" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes left by 0.5%"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Right ▶" Click="GlobalNudgeRight_Click" FontSize="10" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes right by 0.5%"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="▼ Down" Click="GlobalNudgeDown_Click" FontSize="10" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes down by 0.5%"/>
                                        </Grid>

                                        <!-- SCALE ALL (PROPORTIONAL, WIDTH, HEIGHT) -->
                                        <TextBlock Text="2. Scale All Boxes Size:" FontSize="11" FontWeight="SemiBold" Foreground="#4A148C" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="➖ Shrink All" Click="GlobalScaleShrink_Click" Height="26" FontSize="10" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Scale all boxes smaller by 1%"/>
                                            <Button Grid.Column="2" Content="➕ Expand All" Click="GlobalScaleExpand_Click" Height="26" FontSize="10" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Scale all boxes larger by 1%"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="↔ Stretch W" Click="GlobalScaleWidth_Click" Height="24" FontSize="10" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Stretch width of all boxes by 1%"/>
                                            <Button Grid.Column="2" Content="↕ Stretch H" Click="GlobalScaleHeight_Click" Height="24" FontSize="10" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Stretch height of all boxes by 1%"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Field Selector" FontSize="13" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbFields" SelectionChanged="CmbFields_SelectionChanged" Height="32" Margin="0,0,0,16">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="#EDE7E9" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Selected Field Details" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,8"/>
                                        
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Field Key:" FontSize="11" Foreground="#666666"/>
                                            <TextBlock x:Name="TxtFieldKey" Grid.Column="1" Text="last_name" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Category:" FontSize="11" Foreground="#666666"/>
                                            <TextBlock x:Name="TxtFieldCategory" Grid.Column="1" Text="Section I: Personal" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Coordinate Sliders / Inputs -->
                                <TextBlock Text="Fine Position Adjustment" FontSize="13" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X (Left):" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderX" Grid.Column="1" Minimum="0" Maximum="1" Value="0.025" SmallChange="0.005" LargeChange="0.02" ValueChanged="Slider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValX" Grid.Column="2" Text="{Binding Value, ElementName=SliderX, StringFormat={}{0:F3}}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Y (Top):" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderY" Grid.Column="1" Minimum="0" Maximum="1" Value="0.180" SmallChange="0.005" LargeChange="0.02" ValueChanged="Slider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValY" Grid.Column="2" Text="{Binding Value, ElementName=SliderY, StringFormat={}{0:F3}}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Width:" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderW" Grid.Column="1" Minimum="0.01" Maximum="1" Value="0.225" SmallChange="0.005" LargeChange="0.02" ValueChanged="Slider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValW" Grid.Column="2" Text="{Binding Value, ElementName=SliderW, StringFormat={}{0:F3}}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Height:" FontSize="11" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderH" Grid.Column="1" Minimum="0.01" Maximum="0.5" Value="0.040" SmallChange="0.005" LargeChange="0.02" ValueChanged="Slider_ValueChanged"/>
                                    <TextBlock x:Name="TxtValH" Grid.Column="2" Text="{Binding Value, ElementName=SliderH, StringFormat={}{0:F3}}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Live OCR Test on Selected Field -->
                                <Button x:Name="BtnTestOcr" Content="⚡ Test OCR On This Box" Click="TestOcr_Click"
                                        Height="34" Background="#3F51B5" Foreground="White" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Border Background="#E8EAF6" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Live Preview Extraction:" FontSize="10" FontWeight="Bold" Foreground="#283593"/>
                                        <TextBlock x:Name="TxtLiveOcrResult" Text="(Click 'Test OCR On This Box' to preview text)" FontSize="12" FontWeight="SemiBold" Foreground="#1A237E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <Border Grid.Row="2" Background="#F9F6F7" BorderBrush="#E5D8DC" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatusMessage" Text="● Ready to calibrate field positions." FontSize="12" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Click="Close_Click" Width="100" Height="36" Background="White"
                                    BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="💾 Save as Template" Click="SaveTemplate_Click" Width="170" Height="36"
                                    Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                    Cursor="Hand" Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="✓ Apply &amp; Re-Extract" Click="ApplyAndReExtract_Click" Width="170" Height="36"
                                    Background="#702943" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
