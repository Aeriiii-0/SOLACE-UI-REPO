<Page x:Class="SOLUM_UI.UserAdministrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Administration"
      Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="User Administration"
                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                           Foreground="#702943"/>
                <TextBlock Text="Manage system user accounts and roles."
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="#A06080" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Height="42" Padding="20,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#702943" CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="+ Add User" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Button>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,24" CornerRadius="14"
                BorderBrush="#E8D8DC" BorderThickness="1" Background="White">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="User Administration"
                           FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                           Foreground="#702943" HorizontalAlignment="Center"/>
                <TextBlock Text="This module is under development."
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="#A06080" HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
