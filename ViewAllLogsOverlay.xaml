<UserControl x:Class="SOLUM_UI.ViewAllLogsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SOLUM_UI"
             xmlns:converters="clr-namespace:SOLUM_UI.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="#D0B8C0"
                                BorderThickness="1.5" CornerRadius="8" Padding="20,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FDF5F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="4" Opacity="0.26" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid x:Name="OverlayContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#702943" CornerRadius="16,16,0,0" Padding="28,20,28,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="All Audit Logs"
                                       FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Double-click any entry to view full change details."
                                       FontFamily="Segoe UI" FontSize="12" Foreground="#E8C0D0" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="CloseBtn" Click="CloseBtn_Click"
                                Width="36" Height="36" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="18">
                                        <TextBlock Text="✕" FontSize="15" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#E8D8DE"
                        BorderThickness="0,0,0,1" Padding="22,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="152"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F7F5F6" CornerRadius="22"
                                BorderBrush="#D0B8C0" BorderThickness="1.5" Height="40">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Fill="#C0A0AA" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="Segoe UI" FontSize="13" Foreground="#333333"
                                         VerticalContentAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock Text="Search by name, user, record…" Foreground="#C0A8B0"
                                                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="2" Height="40"
                                  ItemsSource="{Binding ActionFilters}"
                                  SelectedItem="{Binding SelectedFilter}"
                                  FontFamily="Segoe UI" FontSize="13"
                                  BorderBrush="#D0B8C0" BorderThickness="1.5"
                                  Padding="12,0" VerticalContentAlignment="Center">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Border x:Name="Bg" Background="White" BorderBrush="#D0B8C0"
                                                BorderThickness="1.5" CornerRadius="8">
                                            <Grid Margin="12,0,32,0">
                                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                              Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="White" CornerRadius="8" BorderBrush="#D0B8C0"
                                                    BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                                    MaxHeight="200" Margin="0,2,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                        <Trigger Property="IsDropDownOpen" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItBg" Background="Transparent"
                                                        Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItBg" Property="Background" Value="#FDF0F3"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItBg" Property="Background" Value="#F0E4E8"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <ComboBox Grid.Column="4" Height="40"
                                  ItemsSource="{Binding MonthFilters}"
                                  SelectedItem="{Binding FilterMonth}"
                                  FontFamily="Segoe UI" FontSize="13"
                                  BorderBrush="#D0B8C0" BorderThickness="1.5"
                                  Padding="12,0" VerticalContentAlignment="Center">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Border x:Name="Bg2" Background="White" BorderBrush="#D0B8C0"
                                                BorderThickness="1.5" CornerRadius="8">
                                            <Grid Margin="12,0,32,0">
                                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                              Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="White" CornerRadius="8" BorderBrush="#D0B8C0"
                                                    BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                                    MaxHeight="200" Margin="0,2,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg2" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                        <Trigger Property="IsDropDownOpen" Value="True">
                                            <Setter TargetName="Bg2" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItBg2" Background="Transparent"
                                                        Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItBg2" Property="Background" Value="#FDF0F3"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItBg2" Property="Background" Value="#F0E4E8"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <ComboBox Grid.Column="6" Height="40"
                                  ItemsSource="{Binding YearFilters}"
                                  SelectedItem="{Binding FilterYear}"
                                  FontFamily="Segoe UI" FontSize="13"
                                  BorderBrush="#D0B8C0" BorderThickness="1.5"
                                  Padding="12,0" VerticalContentAlignment="Center">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Border x:Name="Bg3" Background="White" BorderBrush="#D0B8C0"
                                                BorderThickness="1.5" CornerRadius="8">
                                            <Grid Margin="12,0,32,0">
                                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                              Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="White" CornerRadius="8" BorderBrush="#D0B8C0"
                                                    BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                                    MaxHeight="200" Margin="0,2,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg3" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                        <Trigger Property="IsDropDownOpen" Value="True">
                                            <Setter TargetName="Bg3" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItBg3" Background="Transparent"
                                                        Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItBg3" Property="Background" Value="#FDF0F3"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItBg3" Property="Background" Value="#F0E4E8"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Button Grid.Column="8" Height="40" Padding="14,0" Cursor="Hand"
                                Command="{Binding ClearFiltersCommand}" ToolTip="Clear all filters"
                                VerticalAlignment="Bottom">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5ECEE" CornerRadius="8"
                                            BorderBrush="#D0B8C0" BorderThickness="1.5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Clear" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#702943"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#F7F5F6" Padding="28,20,28,8">
                    <ItemsControl ItemsSource="{Binding PagedLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="12"
                                        BorderBrush="#EEE4E8" BorderThickness="1"
                                        Padding="18,14" Margin="0,0,0,10" Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E0C8D0" BlurRadius="8" ShadowDepth="1" Opacity="0.10" Direction="270"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FDF5F7"/>
                                                    <Setter Property="BorderBrush" Value="#D0B8C0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenDetailCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding DotColor}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding DotLabel}" FontSize="14" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#1A1A1A" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding PerformedBy}" FontFamily="Segoe UI" FontSize="12" Foreground="#555555"/>
                                                <Border Background="#F0E8EC" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PerformedByRole}" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#702943"/>
                                                </Border>
                                                <TextBlock Text=" · " FontFamily="Segoe UI" FontSize="12" Foreground="#CCCCCC" Margin="4,0"/>
                                                <TextBlock Text="{Binding TimestampFormatted}" FontFamily="Segoe UI" FontSize="12" Foreground="#AAAAAA"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}"
                                                   FontFamily="Segoe UI" FontSize="11" Foreground="#BBBBBB"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <Border Grid.Column="3" VerticalAlignment="Center"
                                                Padding="10,4" CornerRadius="6" Background="#F0E8EC"
                                                Visibility="{Binding HasChangeDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Has Changes" FontFamily="Segoe UI" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#702943"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Padding="28,16,28,20" Background="White" CornerRadius="0,0,16,16"
                        BorderBrush="#F0E4E8" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← Previous" Style="{StaticResource NavBtn}"
                                Command="{Binding PrevPageCommand}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                   FontFamily="Segoe UI" FontSize="13" Foreground="#702943" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Next →" Style="{StaticResource NavBtn}"
                                Command="{Binding NextPageCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Rectangle Fill="#66000000"/>

                <Border Background="White" CornerRadius="16" Padding="36,30"
                        Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.24" Direction="270"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Audit Log Detail"
                                       FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#702943"/>
                            <Button Grid.Column="1" Command="{Binding CloseDetailCommand}"
                                    Width="34" Height="34" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="17">
                                            <TextBlock Text="✕" FontSize="15" Foreground="#702943"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#F5E8EC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border CornerRadius="8" Padding="12,5" Margin="0,0,10,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding SelectedLog.DotColor}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding SelectedLog.ActionLabel}"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedLog.RecordName}"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="#1A1A1A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E4E4" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Performed by" Style="{StaticResource MetaLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedLog.PerformedBy}" Style="{StaticResource MetaValue}"/>
                                <Border CornerRadius="5" Background="#F0E8EC" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedLog.PerformedByRole}"
                                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Record ID" Style="{StaticResource MetaLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedLog.RecordId}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#702943"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Timestamp" Style="{StaticResource MetaLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedLog.TimestampFormatted}"
                                       Style="{StaticResource MetaValue}"/>
                        </Grid>

                        <Border Visibility="{Binding SelectedLog.HasChangeDetail,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FDF5F7" CornerRadius="12" Padding="20,18" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="WHAT CHANGED"
                                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="#9B3060" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Field" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedLog.FieldChanged}"
                                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#1A1A1A"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Before" Style="{StaticResource MetaLabel}"/>
                                    <Border Grid.Column="1" Background="#FFE8E8" CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="{Binding SelectedLog.OldValue}"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#DC3545" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="↓" FontSize="18" Foreground="#CCCCCC"
                                           HorizontalAlignment="Left" Margin="80,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="After" Style="{StaticResource MetaLabel}"/>
                                    <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="{Binding SelectedLog.NewValue}"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#27AE60" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding SelectedLog.HasChangeDetail,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Background="#F8F8F8" CornerRadius="10" Padding="20,14">
                            <TextBlock Text="No field-level change detail recorded for this action."
                                       FontFamily="Segoe UI" FontSize="13" Foreground="#AAAAAA"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
