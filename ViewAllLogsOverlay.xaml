<UserControl x:Class="SOLUM_UI.ViewAllLogsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SOLUM_UI"
             xmlns:converters="clr-namespace:SOLUM_UI.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="16" Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.28" Direction="270"/>
        </Border.Effect>

        <Grid>

            <!-- Main content -->
            <Grid x:Name="OverlayContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0"
                        Background="White" Padding="24,20,24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="All Audit Logs"
                                       FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                       Foreground="#702943"/>
                            <TextBlock Text="Double-click any entry to see change details."
                                       FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#A06080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="CloseBtn"
                                Click="CloseBtn_Click"
                                Width="32" Height="32"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBg" Background="Transparent" CornerRadius="16">
                                        <TextBlock Text="✕" FontSize="14" Foreground="#702943"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBg" Property="Background" Value="#F5E8EC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Log cards -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,12,24,0">
                    <ItemsControl ItemsSource="{Binding PagedLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="10"
                                        Padding="14,12" Margin="0,0,0,10"
                                        Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#E0C8D0" BlurRadius="8" ShadowDepth="1" Opacity="0.15" Direction="270"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FDF5F7"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenDetailCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Dot -->
                                        <Border Grid.Column="0" Width="28" Height="28"
                                                CornerRadius="14" VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding DotColor}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding DotLabel}" FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Text -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="Segoe UI" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#1A1A1A"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="by " FontFamily="Segoe UI" FontSize="10" Foreground="#888888"/>
                                                <TextBlock Text="{Binding PerformedBy}" FontFamily="Segoe UI" FontSize="10" Foreground="#888888"/>
                                                <TextBlock Text=" · " FontFamily="Segoe UI" FontSize="10" Foreground="#BBBBBB"/>
                                                <TextBlock Text="{Binding TimeAgo}" FontFamily="Segoe UI" FontSize="10" Foreground="#BBBBBB"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Details badge -->
                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0" Padding="6,3"
                                                CornerRadius="6" Background="#F5E8EC"
                                                Visibility="{Binding HasChangeDetail,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Details" FontFamily="Segoe UI"
                                                       FontSize="9" Foreground="#702943"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Pagination footer -->
                <Border Grid.Row="2" Padding="24,12,24,20"
                        Background="White" CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="← Prev"
                                Command="{Binding PrevPageCommand}"
                                FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                Foreground="#702943" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PrevBg" Background="Transparent"
                                            BorderBrush="#E0C8D0" BorderThickness="1"
                                            CornerRadius="6" Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PrevBg" Property="Background" Value="#F5E8EC"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="PrevBg" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#9B3060"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Button Grid.Column="2" Content="Next →"
                                Command="{Binding NextPageCommand}"
                                FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                Foreground="#702943" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NextBg" Background="Transparent"
                                            BorderBrush="#E0C8D0" BorderThickness="1"
                                            CornerRadius="6" Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NextBg" Property="Background" Value="#F5E8EC"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="NextBg" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Detail modal -->
            <Grid Visibility="{Binding IsDetailVisible,
                               Converter={StaticResource BoolToVisibilityConverter}}">
                <Rectangle Fill="#60000000"/>

                <Border Background="White" CornerRadius="14"
                        Padding="28,24" Width="380"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.22" Direction="270"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- Modal header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Change Details"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="#702943"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CloseDetailCommand}"
                                    Width="28" Height="28" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ModalCloseBg" Background="Transparent" CornerRadius="14">
                                            <TextBlock Text="✕" FontSize="13" Foreground="#702943"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ModalCloseBg" Property="Background" Value="#F5E8EC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Action badge + record name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding SelectedLog.DotColor}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding SelectedLog.ActionLabel}"
                                           FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedLog.RecordName}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1A1A1A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E4E4" Margin="0,0,0,14"/>

                        <!-- Performed by -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Performed by"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#888888"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedLog.PerformedBy}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#1A1A1A"/>
                        </Grid>

                        <!-- Timestamp -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Timestamp"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#888888"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedLog.Timestamp, StringFormat='MMM dd, yyyy  hh:mm tt'}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#1A1A1A"/>
                        </Grid>

                        <!-- Has detail -->
                        <Border Visibility="{Binding SelectedLog.HasChangeDetail,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FDF5F7" CornerRadius="10" Padding="16,14" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="WHAT CHANGED"
                                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#9B3060" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Field"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#888888"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedLog.FieldChanged}"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#1A1A1A"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Before"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#888888"/>
                                    <Border Grid.Column="1" Background="#FFE8E8" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding SelectedLog.OldValue}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#DC3545"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="↓" FontSize="14" Foreground="#BBBBBB"
                                           HorizontalAlignment="Left" Margin="80,0,0,6"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="After"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#888888"/>
                                    <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding SelectedLog.NewValue}"
                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#28A745"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- No detail fallback -->
                        <Border Visibility="{Binding SelectedLog.HasChangeDetail,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Background="#F8F8F8" CornerRadius="10" Padding="16,12">
                            <TextBlock Text="No field-level change detail recorded for this action."
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#AAAAAA"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</UserControl>
