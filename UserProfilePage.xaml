<Page x:Class="SOLUM_UI.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Profile"
      Background="#FFFFFF">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="User Profile"
                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                           Foreground="#702943"/>
                <TextBlock Text="View and manage your account information."
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="#A06080" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="14"
                    BorderBrush="#E8D8DC" BorderThickness="1" Padding="28,24"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#E0C8D0" BlurRadius="12" ShadowDepth="2" Opacity="0.14" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Background="#702943" Margin="0,0,20,0">
                        <TextBlock x:Name="TxtInitial" Text="A"
                                   FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDisplayName"
                                   Text="Admin User"
                                   FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="#1A1A1A"/>
                        <TextBlock x:Name="TxtDisplayRole"
                                   Text="Administrator"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#702943" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtDisplayEmail"
                                   Text=""
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#888888" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#F5E8EC" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                        <TextBlock Text="Active Account" FontFamily="Segoe UI" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#702943"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="14"
                    BorderBrush="#E8D8DC" BorderThickness="1" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect Color="#E0C8D0" BlurRadius="12" ShadowDepth="2" Opacity="0.14" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ACCOUNT DETAILS"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                               Foreground="#702943" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Full Name"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TxtFullName" Grid.Column="1"
                                   Text="Admin User"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1A1A1A"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Role"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TxtRole" Grid.Column="1"
                                   Text="Administrator"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1A1A1A"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Email Address"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TxtEmail" Grid.Column="1"
                                   Text=""
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1A1A1A"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Account Status"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#888888"/>
                        <TextBlock Grid.Column="1"
                                   Text="Active"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#27AE60"/>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
