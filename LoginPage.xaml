<Window x:Class="SOLUM_UI.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SOLUM_UI"
        mc:Ignorable="d"
        Title="Solace"
        MinHeight="420" MinWidth="680"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown">

    <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left decorative panel — always 40% of window -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Image Source="pack://application:,,,/Assets/LoginDesign.png"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- Right login panel — Viewbox scales all content with window size -->
        <Grid Grid.Column="1" Background="White">
            <Viewbox Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="420"
                     MaxHeight="520">
                <StackPanel Width="300" VerticalAlignment="Center">

                    <!-- Logo circle -->
                    <Border Width="90" Height="90"
                            CornerRadius="45"
                            Background="White"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#CCCCCC" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/Logo.png"
                               Width="70" Height="70"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- App name -->
                    <TextBlock Text="SOLACE"
                               FontFamily="Segoe UI Semibold"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#8B1A4A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Email label -->
                    <TextBlock Text="EMAIL ADDRESS"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#222222"
                               Margin="0,0,0,4"/>

                    <!-- Email field -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"/>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Margin="0,6,8,6"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="PlaceholderEmail"
                                       Text="Email or Username"
                                       Foreground="#AAAAAA"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="TxtEmail"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     Foreground="#444444"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Padding="0,6"
                                     TextChanged="TxtEmail_TextChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Password label -->
                    <TextBlock Text="PASSWORD"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#222222"
                               Margin="0,0,0,4"/>

                    <!-- Password field -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"/>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Margin="0,6,8,6"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="PlaceholderPassword"
                                       Text="Password"
                                       Foreground="#AAAAAA"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"/>
                            <PasswordBox x:Name="TxtPassword"
                                         FontFamily="Segoe UI"
                                         FontSize="13"
                                         Foreground="#444444"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Padding="0,6"
                                         PasswordChanged="TxtPassword_PasswordChanged"/>
                            <TextBox x:Name="TxtPasswordVisible"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     Foreground="#444444"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Padding="0,6"
                                     Visibility="Collapsed"
                                     TextChanged="TxtPasswordVisible_TextChanged"/>
                        </Grid>
                        <Button x:Name="BtnTogglePassword"
                                Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Padding="4,0"
                                Click="BtnTogglePassword_Click">
                            <TextBlock x:Name="TxtToggleIcon"
                                       Text="&#xED1A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#888888"/>
                        </Button>
                    </Grid>

                    <!-- Forgot password -->
                    <TextBlock HorizontalAlignment="Right"
                               Margin="0,2,0,20">
                        <Hyperlink x:Name="LinkForgotPassword"
                                   Foreground="#8B1A4A"
                                   TextDecorations="None"
                                   FontFamily="Segoe UI"
                                   FontSize="12">
                            Forgot Password?
                        </Hyperlink>
                    </TextBlock>

                    <!-- Terms and Conditions -->
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,0,0,8">
                        <Run Text="By signing in you agree to our " Foreground="#888888" FontFamily="Segoe UI" FontSize="11"/>
                        <Hyperlink x:Name="LinkTerms"
                                   Foreground="#8B1A4A"
                                   TextDecorations="Underline"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Click="LinkTerms_Click">
                            Terms and Conditions
                        </Hyperlink>
                    </TextBlock>

                    <!-- Login button -->
                    <Button x:Name="BtnLogin"
                            Content="LOGIN"
                            Height="42"
                            FontFamily="Segoe UI"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="#A03060"
                                        CornerRadius="21"
                                        Padding="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#8B1A4A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#6D1039"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Viewbox>
        </Grid>

        <Grid Grid.ColumnSpan="2" x:Name="LoadingOverlay" Visibility="Collapsed" Panel.ZIndex="30">
            <Rectangle Fill="#AA1A0A14"/>
            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                       Foreground="#F4A0BC"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" CenterX="18" CenterY="18"/>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetName="SpinnerRotate"
                                    Storyboard.TargetProperty="Angle"
                                    From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Grid>

        <!-- Error Modal Overlay -->
        <Grid Grid.Column="1" x:Name="ErrorModalOverlay" Visibility="Collapsed" Panel.ZIndex="20">
            <Rectangle Fill="#66000000"/>
            <Border Background="White" CornerRadius="12" Padding="28,24" Width="300"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.22"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Sign In Failed" FontFamily="Segoe UI" FontSize="15"
                               FontWeight="Bold" Foreground="#8B1A4A" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtErrorModal" Text="" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Button Content="Close" Height="38" Cursor="Hand" Click="BtnErrorClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#8B1A4A" CornerRadius="8" Padding="0,10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="White"
                                                      TextElement.FontFamily="Segoe UI"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Terms and Conditions Overlay -->
        <Grid Grid.Column="1" x:Name="TermsOverlay" Visibility="Collapsed" Panel.ZIndex="20">
            <Rectangle Fill="#66000000"/>
            <Border Background="White" CornerRadius="12" Padding="0" Width="360" MaxHeight="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.22"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="24,18,24,14"
                            BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Terms and Conditions" FontFamily="Segoe UI"
                                       FontSize="14" FontWeight="Bold" Foreground="#8B1A4A"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="BtnTermsClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Cbg" Background="Transparent" CornerRadius="14">
                                            <TextBlock Text="✕" FontSize="13" Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Cbg" Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,8">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#444444"
                                       TextWrapping="Wrap" LineHeight="18">
                                <Run FontWeight="Bold">1. Acceptance of Terms</Run>
                                <LineBreak/>
                                By accessing and using the SOLACE Solo Parent Information System, you agree to be bound by these Terms and Conditions.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">2. Data Privacy</Run>
                                <LineBreak/>
                                All personal information collected is governed by the Data Privacy Act of 2012 (RA 10173). Information is collected solely for the administration of the Solo Parent Welfare Program.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">3. Authorized Use</Run>
                                <LineBreak/>
                                Access is restricted to authorized personnel only. Unauthorized access, disclosure, or misuse of data is strictly prohibited and may be subject to legal action.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">4. Account Responsibility</Run>
                                <LineBreak/>
                                Users are responsible for maintaining the confidentiality of their credentials. Any activity performed under your account is your responsibility.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">5. System Use</Run>
                                <LineBreak/>
                                This system must only be used for official duties related to the Solo Parent Welfare Program. Misuse may result in account suspension and disciplinary action.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" CornerRadius="0,0,12,12" Padding="24,14"
                            BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                        <Button Content="Close" Height="36" Cursor="Hand" Click="BtnTermsClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#8B1A4A" CornerRadius="8" Padding="0,8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="White"
                                                          TextElement.FontFamily="Segoe UI"
                                                          TextElement.FontSize="12"
                                                          TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Title bar controls -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,16,0"
                    Panel.ZIndex="10">
            <Button x:Name="BtnMinimize"
                    Width="16" Height="16"
                    Background="#A8A8A8"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="BtnMinimize_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnMaximize"
                    Width="16" Height="16"
                    Background="#28C840"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="BtnMaximize_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnClose"
                    Width="16" Height="16"
                    Background="#FF5F57"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

    </Grid>
</Window>
