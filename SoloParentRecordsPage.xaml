<Page x:Class="SOLUM_UI.SoloParentRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Solo Parent Records"
      Background="#FFFFFF">
    <Page.Resources>

        <Style x:Key="FilterComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="White" CornerRadius="10"
                                    BorderBrush="#D4A0B0" BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1"
                                          Data="M7,10L12,15L17,10H7Z"
                                          Fill="#702943" Stretch="Uniform"
                                          Width="12" Height="12"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="10"
                                        BorderBrush="#D4A0B0" BorderThickness="1.5"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FDF5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent"
                                            CornerRadius="6" Margin="2,2" Padding="12,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#F5E8EC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#EDD4DC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0E4E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GvHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#D8C0C8"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBg"
                                    Background="White"
                                    BorderBrush="#D4A0B0"
                                    BorderThickness="0,0,1,2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="6" Cursor="SizeWE" Opacity="0">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBg" Property="Background" Value="#D4A0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#D4A0B0" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyledScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F5EEF1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg"
                                Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <GridViewRowPresenter VerticalAlignment="Center" Margin="0,11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="#E0C0CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="IdText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

    </Page.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Admin Toolbar (search + filter + sort + add + share) -->
        <Grid x:Name="AdminToolbar" Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF" CornerRadius="22"
                    BorderBrush="#E0D0D5" BorderThickness="1.5"
                    Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#C0A0AA" BlurRadius="15" ShadowDepth="3" Opacity="0.08"/>
                </Border.Effect>
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ID" FontSize="10" FontWeight="Bold" Foreground="#702943"
                               VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="SearchId" Grid.Column="1"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                             TextChanged="SearchFields_TextChanged"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock Text="e.g. SP-001" Foreground="#C0A8B0" FontSize="13"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Rectangle Grid.Column="2" Fill="#E0D0D5" Width="1" Margin="0,10"/>

                    <TextBlock Grid.Column="3" Text="NAME" FontSize="10" FontWeight="Bold" Foreground="#702943"
                               VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="SearchName" Grid.Column="4"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                             TextChanged="SearchFields_TextChanged"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock Text="Search by name..." Foreground="#C0A8B0" FontSize="13"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Rectangle Grid.Column="5" Fill="#E0D0D5" Width="1" Margin="0,10"/>

                    <TextBlock Grid.Column="6" Text="BARANGAY" FontSize="10" FontWeight="Bold" Foreground="#702943"
                               VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="SearchBarangay" Grid.Column="7"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                             TextChanged="SearchFields_TextChanged"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock Text="Search by barangay..." Foreground="#C0A8B0" FontSize="13"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button x:Name="ClearSearchBtn" Grid.Column="8"
                            Width="26" Height="26" Margin="4,0,2,0"
                            Cursor="Hand" Visibility="Collapsed"
                            Click="ClearSearch_Click" ToolTip="Clear">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="13">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="#C0A0AA" Stretch="Uniform" Width="11" Height="11"/>
                    </Button>

                    <Button Grid.Column="9"
                            Width="34" Height="34" Margin="2,0,5,0"
                            Cursor="Hand" Click="SearchBtn_Click" ToolTip="Search">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#702943" CornerRadius="17">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#FFFFFF" CornerRadius="22"
                    BorderBrush="#E0D0D5" BorderThickness="1.5"
                    Margin="0,0,8,0">
                <Button x:Name="FilterDropBtn"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Height="44" Padding="14,0"
                        Click="FilterDrop_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z"
                              Fill="#702943" Stretch="Uniform"
                              Width="13" Height="13"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="FilterDropLabel" Text="Filter"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#702943" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <Popup x:Name="FilterPopup"
                   PlacementTarget="{Binding ElementName=FilterDropBtn}"
                   Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="White" CornerRadius="16"
                        BorderBrush="#E8D4DA" BorderThickness="1.5" Padding="22,20,22,20"
                        MinWidth="300">
                    <Border.Effect>
                        <DropShadowEffect Color="#702943" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel>

                        <TextBlock Text="FILTER RECORDS" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="Bold" Foreground="#702943"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Sex" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbFilterSex"
                                  Style="{StaticResource FilterComboBox}"
                                  Margin="0,0,0,14"
                                  SelectionChanged="FilterCombo_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>

                        <TextBlock Text="Barangay" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbFilterBarangay"
                                  Style="{StaticResource FilterComboBox}"
                                  Margin="0,0,0,14"
                                  SelectionChanged="FilterCombo_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Biñan Poblacion"/>
                            <ComboBoxItem Content="Bungahan"/>
                            <ComboBoxItem Content="Canlalay"/>
                            <ComboBoxItem Content="Casile"/>
                            <ComboBoxItem Content="De La Paz"/>
                            <ComboBoxItem Content="Langkiwa"/>
                            <ComboBoxItem Content="Loma"/>
                            <ComboBoxItem Content="Malaban"/>
                            <ComboBoxItem Content="Malamig"/>
                            <ComboBoxItem Content="Mamplasan"/>
                            <ComboBoxItem Content="Platero"/>
                            <ComboBoxItem Content="San Antonio"/>
                            <ComboBoxItem Content="San Francisco"/>
                            <ComboBoxItem Content="San Jose"/>
                            <ComboBoxItem Content="San Vicente"/>
                            <ComboBoxItem Content="Santo Tomas"/>
                            <ComboBoxItem Content="Soro-Soro"/>
                            <ComboBoxItem Content="Timbao"/>
                            <ComboBoxItem Content="Tubigan"/>
                        </ComboBox>

                        <TextBlock Text="Status" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbFilterStatus"
                                  Style="{StaticResource FilterComboBox}"
                                  Margin="0,0,0,18"
                                  SelectionChanged="FilterCombo_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Valid"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="42" Cursor="Hand"
                                    Click="FilterReset_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="10"
                                                BorderBrush="#DCC8CE" BorderThickness="1.5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#702943"/>
                            </Button>
                            <Button Grid.Column="2" Height="42" Cursor="Hand"
                                    Click="FilterApply_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <Border Grid.Column="2"
                    Background="#FFFFFF" CornerRadius="22"
                    BorderBrush="#E0D0D5" BorderThickness="1.5"
                    Margin="0,0,10,0">
                <Button x:Name="SortDropBtn"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Width="44" Height="44"
                        Click="SortDrop_Click" ToolTip="Sort">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z"
                          Fill="#702943" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
            </Border>

            <Popup x:Name="SortPopup"
                   PlacementTarget="{Binding ElementName=SortDropBtn}"
                   Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#E0D0D5" BorderThickness="1" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel MinWidth="160">
                        <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Barangay">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FDF3F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="By Barangay" FontSize="13" Foreground="#333333" Padding="12,9"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <Button Grid.Column="3"
                    Height="44" Padding="18,0"
                    Margin="0,0,10,0" Cursor="Hand"
                    Click="AddNewRecord_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#702943" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.22"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="+ Add New Record" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Button>

            <Button Grid.Column="4"
                    Width="44" Height="44"
                    BorderThickness="0" Background="#FFFFFF"
                    Cursor="Hand" ToolTip="Export">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22" BorderBrush="#E0D0D5" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5ECEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                      Fill="#702943" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,5,20,5"
                CornerRadius="16"
                BorderBrush="#E8D8DC"
                BorderThickness="1"
                ClipToBounds="True"
                Background="White"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <ListView x:Name="RecordsList"
                          BorderThickness="0"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource TableRow}"
                          SelectionChanged="RecordsList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          MouseDoubleClick="RecordsList_MouseDoubleClick"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,4,0,-4">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GvHeader}">

                            <GridViewColumn Header="ID" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource IdText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="NAME" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="Medium"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="BARANGAY" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Barangay}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="SEX" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sex}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="CIVIL STATUS" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CivilStatus}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="DATE OF BIRTH" Width="115">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateOfBirthFormatted}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="CHILDREN" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Children}" Style="{StaticResource CellText}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="STATUS" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}"
                                                Background="{Binding StatusBadgeColor}">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusTextColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="LAST UPDATED" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastUpdatedFormatted}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="ACTIONS" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionBtn}"
                                                    Tag="{Binding Id}"
                                                    Click="Edit_Click"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Edit">
                                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Fill="#702943" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource ActionBtn}"
                                                    Tag="{Binding Id}"
                                                    Click="ExportRecord_Click"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Export">
                                                <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                                      Fill="#2196F3" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource ActionBtn}"
                                                    Tag="{Binding Id}"
                                                    Click="Delete_Click"
                                                    ToolTip="Delete">
                                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Fill="#E53935" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="NoResultsPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,44,0,0">
                    <TextBlock Text="No results found."
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#C0A0AA"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try adjusting your search or filters."
                               FontSize="12"
                               Foreground="#D4B8C0"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Encoder-only search panel (Row 1, hidden for Admin) -->
        <Border x:Name="EncoderSearchPanel" Grid.Row="1"
                Visibility="Collapsed"
                Margin="20,0,20,12"
                Background="White" CornerRadius="12"
                BorderBrush="#E0D0D5" BorderThickness="1" Padding="20,16">
            <Border.Effect>
                <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="SEARCH SOLO PARENT RECORD"
                           FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Solo Parent ID" FontSize="11" Foreground="#777777" Margin="0,0,0,4"/>
                        <TextBox x:Name="EncSearchId" Height="40" Padding="12,0"
                                 FontSize="13" Foreground="#111111" Background="White"
                                 BorderBrush="#E0D0D5" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 TextChanged="EncoderFields_TextChanged"
                                 KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="#D0B8C0" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <TextBlock Text="e.g. SP-001" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="First Name" FontSize="11" Foreground="#777777" Margin="0,0,0,4"/>
                        <TextBox x:Name="EncSearchFirstName" Height="40" Padding="12,0"
                                 FontSize="13" Foreground="#111111" Background="White"
                                 BorderBrush="#E0D0D5" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 TextChanged="EncoderFields_TextChanged"
                                 KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="#D0B8C0" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <TextBlock Text="Enter first name" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Last Name" FontSize="11" Foreground="#777777" Margin="0,0,0,4"/>
                        <TextBox x:Name="EncSearchLastName" Height="40" Padding="12,0"
                                 FontSize="13" Foreground="#111111" Background="White"
                                 BorderBrush="#E0D0D5" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 TextChanged="EncoderFields_TextChanged"
                                 KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="#D0B8C0" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <TextBlock Text="Enter last name" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Barangay" FontSize="11" Foreground="#777777" Margin="0,0,0,4"/>
                        <TextBox x:Name="EncSearchBarangay" Height="40" Padding="12,0"
                                 FontSize="13" Foreground="#111111" Background="White"
                                 BorderBrush="#E0D0D5" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 TextChanged="EncoderFields_TextChanged"
                                 KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="#D0B8C0" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <TextBlock Text="Enter barangay" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Birthday" FontSize="11" Foreground="#777777" Margin="0,0,0,4"/>
                        <TextBox x:Name="EncSearchBirthday" Height="40" Padding="12,0"
                                 FontSize="13" Foreground="#111111" Background="White"
                                 BorderBrush="#E0D0D5" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 TextChanged="EncoderFields_TextChanged"
                                 KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="#D0B8C0" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <TextBlock Text="yyyy-mm-dd" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Grid>
                <Button Height="42" Padding="28,0" HorizontalAlignment="Left" Cursor="Hand"
                        Click="EncoderSearchBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#702943" CornerRadius="21" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Search" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Paging row (Row 3, hidden for Encoder) -->
        <Grid x:Name="PagingRow" Grid.Row="3" Margin="20,8,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBack" Grid.Column="0"
                    Visibility="Collapsed"
                    Height="36" Padding="20,0" Cursor="Hand"
                    Click="BtnBack_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBg" Background="White" CornerRadius="18"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBg" Property="Background" Value="#F5ECEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                          Fill="#702943" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                    <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="PageInfoText" Grid.Column="1"
                       Text="Page 1 of 1"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                       Foreground="#702943"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Button x:Name="BtnNext" Grid.Column="2"
                    Visibility="Collapsed"
                    Height="36" Padding="20,0" Cursor="Hand"
                    Click="BtnNext_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NextBg" Background="#702943" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NextBg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Next" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                          Fill="White" Stretch="Uniform" Width="12" Height="12" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</Page>