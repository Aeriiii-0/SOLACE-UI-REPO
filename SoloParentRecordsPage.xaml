<Page x:Class="SOLUM_UI.SoloParentRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Solo Parent Records"
      Background="#FFFFFF">
    <Page.Resources>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0E4E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GvHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#D8C0C8"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBg"
                                      Background="White"
                                      BorderBrush="#D4A0B0"
                                      BorderThickness="0,0,1,2"
                                      Padding="{TemplateBinding Padding}">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                           HorizontalAlignment="Right"
                           Width="6" Cursor="SizeWE" Opacity="0">
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBg" Property="Background" Value="#D4A0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#D4A0B0" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyledScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="TableRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F5EEF1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg"
                        Background="White"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <GridViewRowPresenter VerticalAlignment="Center" Margin="0,11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="#E0C0CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="IdText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

    </Page.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Toolbar ══ -->
        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Multi-field Search Bar -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                    Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E0D0D5"
                    BorderThickness="1.5"
                    Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect Color="#C0A0AA" BlurRadius="15" ShadowDepth="3" Opacity="0.08"/>
                </Border.Effect>
                <Grid Margin="4,0,4,0" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Record ID field -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock Text="RECORD ID" FontSize="9" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,2"/>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="#C0A0AA" Stretch="Uniform" Width="13" Height="13"/>
                    </StackPanel>
                    <TextBox x:Name="SearchId"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             Foreground="#333333"
                             VerticalAlignment="Center"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock Text="e.g. SP-001"
                                                           Foreground="#C0A8B0" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Divider -->
                    <Rectangle Grid.Column="2" Fill="#E0D0D5" Width="1" Margin="0,10"/>

                    <!-- Name field -->
                    <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock Text="NAME" FontSize="9" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,2"/>
                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                              Fill="#C0A0AA" Stretch="Uniform" Width="13" Height="13"/>
                    </StackPanel>
                    <TextBox x:Name="SearchName"
                             Grid.Column="4"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             Foreground="#333333"
                             VerticalAlignment="Center"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock Text="Search by name..."
                                                           Foreground="#C0A8B0" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Divider -->
                    <Rectangle Grid.Column="5" Fill="#E0D0D5" Width="1" Margin="0,10"/>

                    <!-- Barangay field -->
                    <StackPanel Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock Text="BARANGAY" FontSize="9" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,2"/>
                        <Path Data="M12,3L2,12H5V20H19V12H22L12,3M12,8.5C14.34,8.5 16.46,9.55 17.9,11.2L12,14.35L6.1,11.2C7.54,9.55 9.66,8.5 12,8.5M5.63,13.17L12,16.5L18.37,13.17C18.78,14 19,14.97 19,16H5C5,14.97 5.22,14 5.63,13.17Z"
                              Fill="#C0A0AA" Stretch="Uniform" Width="13" Height="13"/>
                    </StackPanel>
                    <TextBox x:Name="SearchBarangay"
                             Grid.Column="7"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             Foreground="#333333"
                             VerticalAlignment="Center"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <TextBlock Text="Search by barangay..."
                                                           Foreground="#C0A8B0" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Search Button -->
                    <Button Grid.Column="8"
                            Height="36" Padding="16,0"
                            Margin="6,0,4,0"
                            Cursor="Hand"
                            Click="SearchBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#702943" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="White" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Search" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 2: Filter, Sort, Add, Export -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- No-results feedback -->
                <TextBlock x:Name="NoResultsText"
                           Grid.Column="0"
                           Text="No records match your search criteria."
                           FontSize="13" Foreground="#C0A0AA"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Visibility="Collapsed"/>

                <!-- Filter pill -->
                <Border Grid.Column="1"
                        Background="#FFFFFF" CornerRadius="22"
                        BorderBrush="#E0D0D5" BorderThickness="1.5"
                        Margin="0,0,8,0">
                    <Button x:Name="FilterDropBtn"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Height="42" Padding="14,0"
                            Click="FilterDrop_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z"
                                  Fill="#702943" Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="FilterDropLabel" Text="Filter"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#702943" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <Popup x:Name="FilterPopup"
                       PlacementTarget="{Binding ElementName=FilterDropBtn}"
                       Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="12"
                            BorderBrush="#E0D0D5" BorderThickness="1" Padding="12,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.18"/>
                        </Border.Effect>
                        <StackPanel MinWidth="160">
                            <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                                       Foreground="#702943" Margin="2,0,0,6"/>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="StatusOpt_Click" Tag="All">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="All Status" FontSize="13" Foreground="#333333" Padding="10,7"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="StatusOpt_Click" Tag="Active">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Active" FontSize="13" Foreground="#27AE60" FontWeight="SemiBold" Padding="10,7"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="StatusOpt_Click" Tag="Pending">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Pending" FontSize="13" Foreground="#702943" FontWeight="SemiBold" Padding="10,7"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="StatusOpt_Click" Tag="Inactive">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Inactive" FontSize="13" Foreground="#999999" FontWeight="SemiBold" Padding="10,7"/>
                            </Border>

                            <Separator Background="#F0E8EC" Margin="0,8"/>

                            <TextBlock Text="SEX" FontSize="10" FontWeight="Bold"
                                       Foreground="#702943" Margin="2,0,0,6"/>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SexOpt_Click" Tag="All">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="All" FontSize="13" Foreground="#333333" Padding="10,7"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SexOpt_Click" Tag="Male">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Male" FontSize="13" Foreground="#333333" Padding="10,7"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SexOpt_Click" Tag="Female">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Female" FontSize="13" Foreground="#333333" Padding="10,7"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Sort icon -->
                <Border Grid.Column="2"
                        Background="#FFFFFF" CornerRadius="22"
                        BorderBrush="#E0D0D5" BorderThickness="1.5"
                        Margin="0,0,10,0">
                    <Button x:Name="SortDropBtn"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Width="42" Height="42"
                            Click="SortDrop_Click" ToolTip="Sort">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z"
                              Fill="#702943" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                </Border>

                <Popup x:Name="SortPopup"
                       PlacementTarget="{Binding ElementName=SortDropBtn}"
                       Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="12"
                            BorderBrush="#E0D0D5" BorderThickness="1" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.18"/>
                        </Border.Effect>
                        <StackPanel MinWidth="160">
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Name A-Z">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Name A → Z" FontSize="13" Foreground="#333333" Padding="12,9"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Name Z-A">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Name Z → A" FontSize="13" Foreground="#333333" Padding="12,9"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Newest">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Newest First" FontSize="13" Foreground="#333333" Padding="12,9"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Oldest">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Oldest First" FontSize="13" Foreground="#333333" Padding="12,9"/>
                            </Border>
                            <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Barangay">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDF3F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="By Barangay" FontSize="13" Foreground="#333333" Padding="12,9"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Add New Record -->
                <Button Grid.Column="3"
                        Height="42" Padding="18,0"
                        Margin="0,0,10,0" Cursor="Hand"
                        Click="AddNewRecord_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#702943" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.22"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="+ Add New Record" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Button>

                <!-- Export -->
                <Button Grid.Column="4"
                        Width="42" Height="42"
                        BorderThickness="0" Background="#FFFFFF"
                        Cursor="Hand" ToolTip="Export">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="22" BorderBrush="#E0D0D5" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5ECEE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"
                          Fill="#702943" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Grid>

        <!-- table -->
        <Border Grid.Row="1"
        Margin="20,5,20,19"
        CornerRadius="16"
        BorderBrush="#E8D8DC"
        BorderThickness="1"
        ClipToBounds="True"
        Background="White"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"      
                >
           
            <ListView x:Name="RecordsList"
              BorderThickness="0"
              Background="Transparent"
              ItemContainerStyle="{StaticResource TableRow}"
              SelectionChanged="RecordsList_SelectionChanged"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              MouseDoubleClick="RecordsList_MouseDoubleClick"
              ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,4,0,-4">

                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GvHeader}">

                        <GridViewColumn Header="ID" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource IdText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="NAME" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="Medium"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="SEX" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Sex}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="CIVIL STATUS" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CivilStatus}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="DATE OF BIRTH" Width="115">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateOfBirthFormatted}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="BARANGAY" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Barangay}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="CHILDREN" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Children}" Style="{StaticResource CellText}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="STATUS" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}"
                                    Background="{Binding StatusBadgeColor}">
                                        <TextBlock Text="{Binding Status}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StatusTextColor}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="LAST UPDATED" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastUpdatedFormatted}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ACTIONS" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Button Style="{StaticResource ActionBtn}"
                                        Tag="{Binding Id}"
                                        Click="Edit_Click"
                                        Margin="0,0,6,0"
                                        ToolTip="Edit">
                                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                          Fill="#702943" Stretch="Uniform" Width="13" Height="13"/>
                                        </Button>
                                        <Button Style="{StaticResource ActionBtn}"
                                        Tag="{Binding Id}"
                                        Click="Delete_Click"
                                        ToolTip="Delete">
                                            <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                          Fill="#E53935" Stretch="Uniform" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

    </Grid>
</Page>
 
