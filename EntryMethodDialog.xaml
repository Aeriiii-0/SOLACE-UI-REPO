<Window x:Class="SOLUM_UI.EntryMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="500" Height="340"
        ShowInTaskbar="False">

    <Border Background="Transparent">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>
            <Border Background="White" CornerRadius="16" Padding="32,28" Width="480"
                    BorderBrush="#702943" BorderThickness="1.5">
                <StackPanel>

                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="Select entry method" FontSize="20" FontWeight="Bold"
                                   Foreground="#702943" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="30" Height="30" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                        <TextBlock Text="&#x2715;" FontSize="13" Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="CardScan"
                                BorderBrush="#E8D0D7" BorderThickness="1.5"
                                CornerRadius="12" Padding="20,22" Background="White"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#F3C8D2"/>
                                            <Setter Property="Background" Value="#FFFAFB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="52" Height="52" Margin="0,0,0,14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#702943"
                                              Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                                        <Path Fill="#702943" Opacity="0.6"
                                              Data="M9,13H15V15H9V13M9,17H13V19H9V17M10,7L8,9L10,11L8,13"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Scan a document" FontSize="14" FontWeight="Bold"
                                           Foreground="#222222" HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Extract data from a file" FontSize="11"
                                           Foreground="#888888" HorizontalAlignment="Center"
                                           Margin="0,0,0,18"/>
                                <Button Content="Scan document" Click="ScanDocument_Click"
                                        Height="36" Padding="0,0"
                                        Background="#702943" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="16,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" x:Name="CardManual"
                                BorderBrush="#E8D0D7" BorderThickness="1.5"
                                CornerRadius="12" Padding="20,22" Background="White"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#F3C8D2"/>
                                            <Setter Property="Background" Value="#FFFAFB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="52" Height="52" Margin="0,0,0,14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#702943"
                                              Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Manual Fill" FontSize="14" FontWeight="Bold"
                                           Foreground="#222222" HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Enter all records by typing" FontSize="11"
                                           Foreground="#888888" HorizontalAlignment="Center"
                                           Margin="0,0,0,18"/>
                                <Button Content="Add a record" Click="ManualFill_Click"
                                        Height="36" Padding="0,0"
                                        Background="#702943" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="16,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Border>
</Window>
