<Window x:Class="SOLUM_UI.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solo Parent Application Form"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Width="680">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#D0B8C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0B8C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBg"
                                    Background="White"
                                    BorderBrush="#D0B8C0"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid Margin="10,0,36,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder"
                                               Text="Select..."
                                               Foreground="#C0A8B0"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="White"
                                        CornerRadius="10"
                                        BorderBrush="#D0B8C0"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="12"
                                                          ShadowDepth="3" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="ComboBg" Property="Background" Value="#FDF8F9"/>
                            </Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="6" Margin="4,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0B8C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DateBg"
                                Background="White"
                                BorderBrush="#D0B8C0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#111111"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="10,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBg"
                                                    Background="Transparent"
                                                    CornerRadius="0,6,6,0">
                                                <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19Z"
                                                      Fill="#702943"
                                                      Stretch="Uniform"
                                                      Width="16" Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBg" Property="Background" Value="#FDF0F3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=DateBg}"
                                       Placement="Bottom"
                                       StaysOpen="False">
                                    <Border Background="White"
                                            CornerRadius="12"
                                            BorderBrush="#D0B8C0"
                                            BorderThickness="1"
                                            Padding="4" Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#702943" BlurRadius="14"
                                                              ShadowDepth="3" Opacity="0.12"/>
                                        </Border.Effect>
                                        <Calendar x:Name="PART_Calendar"
                                                  Background="White"
                                                  BorderThickness="0"
                                                  Foreground="#333333"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DateBg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FDF5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent">
        <Border Background="White"
                CornerRadius="14"
                Width="660"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Title bar ── -->
                <Border Grid.Row="0"
                        Background="#702943"
                        CornerRadius="14,14,0,0"
                        Padding="20,14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="REPUBLIC OF THE PHILIPPINES"
                                       FontSize="9" Foreground="#F0C8D4"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="APPLICATION FORM FOR SOLO PARENT"
                                       FontSize="15" Foreground="White"
                                       FontWeight="Bold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="FormSubtitle"
                                       Text="New Applicant"
                                       FontSize="11" Foreground="#F0C8D4"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="28" Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBg" Background="Transparent" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="13" Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBg" Property="Background" Value="#8B3555"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Scrollable body ── -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,0,20,0"
                              MaxHeight="700">
                    <StackPanel Margin="0,0,0,8">

                        <!-- Applicant Type -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="APPLICANT TYPE" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="ChkNewApplicant" Content="New Applicant"
                                      Style="{StaticResource FormCheck}"
                                      Checked="ApplicantType_Changed"
                                      Unchecked="ApplicantType_Changed"/>
                            <CheckBox x:Name="ChkRenewal" Content="For Renewal"
                                      Style="{StaticResource FormCheck}"
                                      Checked="ApplicantType_Changed"
                                      Unchecked="ApplicantType_Changed"/>
                        </StackPanel>

                        <!-- I. Identifying Information -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="I. IDENTIFYING INFORMATION" Style="{StaticResource SectionTitle}"/>
                        </Border>

                        <!-- Row: Last Name / First Name / Middle Name / Ext / Civil Status / Sex -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Last Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtLastName" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                         TextChanged="TxtLastName_TextChanged"/>
                                <TextBlock x:Name="ErrLastName"
                                           Text="Last name is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="First Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtFirstName" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                         TextChanged="TxtFirstName_TextChanged"/>
                                <TextBlock x:Name="ErrFirstName"
                                           Text="First name is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Middle Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtMiddleName" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NameOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Ext." Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtExtension" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Text="Civil Status *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbCivilStatus" Style="{StaticResource FormCombo}"
                                          SelectionChanged="CmbCivilStatus_SelectionChanged">
                                    <ComboBoxItem Content="Single"/>
                                    <ComboBoxItem Content="Widowed"/>
                                    <ComboBoxItem Content="Separated"/>
                                    <ComboBoxItem Content="Divorced"/>
                                    <ComboBoxItem Content="Annulled"/>
                                </ComboBox>
                                <TextBlock x:Name="ErrCivilStatus"
                                           Text="Civil status is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5">
                                <TextBlock Text="Sex *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbSex" Style="{StaticResource FormCombo}"
                                          SelectionChanged="CmbSex_SelectionChanged">
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                </ComboBox>
                                <TextBlock x:Name="ErrSex"
                                           Text="Sex is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: Birthdate / Birthplace / Age / Education / PhilSys -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Birthdate *" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DpBirthdate" Style="{StaticResource FormDate}"
                                            SelectedDateChanged="DpBirthdate_SelectedDateChanged"/>
                                <TextBlock x:Name="ErrBirthdate"
                                           Text="Date of birth is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Birthplace *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPlaceOfBirth" Style="{StaticResource FormBox}"
                                         TextChanged="TxtPlaceOfBirth_TextChanged"/>
                                <TextBlock x:Name="ErrPlaceOfBirth"
                                           Text="Birthplace is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAge" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Educational Attainment" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbEducation" Style="{StaticResource FormCombo}">
                                    <ComboBoxItem Content="Elementary"/>
                                    <ComboBoxItem Content="High School"/>
                                    <ComboBoxItem Content="Vocational"/>
                                    <ComboBoxItem Content="College"/>
                                    <ComboBoxItem Content="Post Graduate"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PhilSys Card No." Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPhilSys" Style="{StaticResource FormBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: Blood Type / Height / Weight / Citizenship -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Blood Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbBloodType" Style="{StaticResource FormCombo}">
                                    <ComboBoxItem Content="A+"/>
                                    <ComboBoxItem Content="A-"/>
                                    <ComboBoxItem Content="B+"/>
                                    <ComboBoxItem Content="B-"/>
                                    <ComboBoxItem Content="AB+"/>
                                    <ComboBoxItem Content="AB-"/>
                                    <ComboBoxItem Content="O+"/>
                                    <ComboBoxItem Content="O-"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Height (cm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtHeight" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Weight (kg)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtWeight" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Citizenship *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCitizenship" Style="{StaticResource FormBox}"
                                         TextChanged="TxtCitizenship_TextChanged"/>
                                <TextBlock x:Name="ErrCitizenship"
                                           Text="Citizenship is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: Religion / Occupation / Monthly Income -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Religion" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtReligion" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Occupation / Source of Income" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtOccupation" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Monthly Income" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtMonthlyIncome" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <!-- Employment Status -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Employment Status" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkEmployed"    Content="Employed"      Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkSelfEmployed" Content="Self-Employed" Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkNotEmployed" Content="Not Employed" Style="{StaticResource FormCheck}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row: Address / Barangay / Contact -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Address *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAddress" Style="{StaticResource FormBox}"
                                         TextChanged="TxtAddress_TextChanged"/>
                                <TextBlock x:Name="ErrAddress"
                                           Text="Address is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Barangay *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtBarangay" Style="{StaticResource FormBox}"
                                         TextChanged="TxtBarangay_TextChanged"/>
                                <TextBlock x:Name="ErrBarangay"
                                           Text="Barangay is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contact Number *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtContact" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         TextChanged="TxtContact_TextChanged"/>
                                <TextBlock x:Name="ErrContact"
                                           Text="Contact number is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row: Emergency Contact / Relationship / Address / Number -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Emergency Contact Person" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtEmergencyContact" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NameOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Relationship" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRelationship" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Emergency Contact Address" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtEmergencyAddress" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Emergency Contact Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtEmergencyNumber" Style="{StaticResource FormBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <!-- II. Circumstance -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="II. CIRCUMSTANCE OF BEING SOLO PARENT"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="ChkA1" Content="A1. Gives birth as a result of rape"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkA2" Content="A2. Death of Spouse"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkA3" Content="A3. Detention of Spouse"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkA4" Content="A4. Physical &amp; Mental Incapacity of Spouse"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkA5" Content="A5. Legal or de facto Separation"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkA6" Content="A6. Declaration of nullity / annulment"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkA7" Content="A7. Abandonment of spouse (6+ months)"
                                          Style="{StaticResource FormCheck}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkB" Content="B. Spouse / family member of OFW"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkC" Content="C. Unmarried Mother or Father"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkD" Content="D. Legal Guardian / Adoptive / Foster Parent"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkE" Content="E. Relative within 4th civil degree"
                                          Style="{StaticResource FormCheck}"/>
                                <CheckBox x:Name="ChkF" Content="F. Pregnant Woman"
                                          Style="{StaticResource FormCheck}"/>
                            </StackPanel>
                        </Grid>

                        <!-- III. Family Composition -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="III. FAMILY COMPOSITION" Style="{StaticResource SectionTitle}"/>
                        </Border>

                        <!-- Table header -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                            <Border Grid.Column="1" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Sex" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                            <Border Grid.Column="2" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Age" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                            <Border Grid.Column="3" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Birthdate" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                            <Border Grid.Column="4" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Civil Status" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                            <Border Grid.Column="5" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Relationship" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                            <Border Grid.Column="6" Background="#F5ECEE" Padding="8,6">
                                <TextBlock Text="Educ. / Employment" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </Border>
                        </Grid>

                        <!-- Table rows -->
                        <ItemsControl x:Name="FamilyRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FormBox}" Margin="0,0,2,0" Height="32"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource FormBox}" Margin="0,0,2,0" Height="32"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource FormBox}" Margin="0,0,2,0" Height="32"/>
                                        <TextBox Grid.Column="3" Style="{StaticResource FormBox}" Margin="0,0,2,0" Height="32"/>
                                        <TextBox Grid.Column="4" Style="{StaticResource FormBox}" Margin="0,0,2,0" Height="32"/>
                                        <TextBox Grid.Column="5" Style="{StaticResource FormBox}" Margin="0,0,2,0" Height="32"/>
                                        <TextBox Grid.Column="6" Style="{StaticResource FormBox}" Height="32"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- IV. Needs and Problems -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="IV. NEEDS AND PROBLEMS" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <TextBox x:Name="TxtNeeds"
                                 Height="70" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource FormBox}"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 Margin="0,0,0,10"/>

                        <!-- V. Other Sources of Income -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="V. OTHER SOURCES OF INCOME" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <TextBox x:Name="TxtOtherIncome"
                                 Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource FormBox}"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 Margin="0,0,0,10"/>

                        <!-- VI. Referral Information -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="VI. REFERRAL INFORMATION" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Source of Referral" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtSourceOfReferral" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Date Admitted *" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DpDateAdmitted" Style="{StaticResource FormDate}"
                                            SelectedDateChanged="DpDateAdmitted_SelectedDateChanged"/>
                                <TextBlock x:Name="ErrDateAdmitted"
                                           Text="Date admitted is required."
                                           Style="{StaticResource ErrorText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Case No." Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCaseNo" Style="{StaticResource FormBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Offense Committed" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtOffense" Style="{StaticResource FormBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nature of Referral" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtNatureOfReferral" Style="{StaticResource FormBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- VII. Children Count -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="VII. CHILDREN COUNT" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Number of Children *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtChildren"
                                     Style="{StaticResource FormBox}"
                                     Width="120" HorizontalAlignment="Left"
                                     PreviewTextInput="NumberOnly_PreviewTextInput"
                                     TextChanged="TxtChildren_TextChanged"/>
                            <TextBlock x:Name="ErrChildren"
                                       Text="Number of children is required."
                                       Style="{StaticResource ErrorText}"/>
                        </StackPanel>

                        <!-- VIII. Application Status -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Text="VIII. APPLICATION STATUS" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbStatus"
                                      Style="{StaticResource FormCombo}"
                                      Width="200" HorizontalAlignment="Left"
                                      SelectionChanged="CmbStatus_SelectionChanged">
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="Inactive"/>
                            </ComboBox>
                            <TextBlock x:Name="ErrStatus"
                                       Text="Status is required."
                                       Style="{StaticResource ErrorText}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── Footer ── -->
                <Border Grid.Row="2"
                        BorderBrush="#F0E8EC"
                        BorderThickness="0,1,0,0"
                        Padding="20,14"
                        CornerRadius="0,0,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Validation summary (left side) -->
                        <TextBlock x:Name="ValidationMessage"
                                   Grid.Column="0"
                                   Foreground="#E53935"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Visibility="Collapsed"
                                   Text="Please fill in all required fields."/>

                        <!-- Buttons (right side) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel"
                                    Style="{StaticResource CancelBtn}"
                                    Margin="0,0,10,0"
                                    Click="Close_Click"/>
                            <Button Content="Save Record"
                                    Style="{StaticResource SaveBtn}"
                                    Click="Save_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
