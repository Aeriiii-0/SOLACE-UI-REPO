<Window x:Class="SOLUM_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SOLUM_UI.Controls"
        xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
        xmlns:local="clr-namespace:SOLUM_UI"
        Title="Solace" Height="700" Width="1200" MinWidth="900" MinHeight="580"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFFFFF"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg"
                                     Width="40" Height="40"
                                     Fill="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Path=(local:MainWindow.IsNavActive), RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#702943"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#C4788E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#702943"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideTooltip" TargetType="ToolTip">
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="HorizontalOffset" Value="10"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#702943" CornerRadius="6" Padding="10,6">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18" Direction="270"/>
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="White" FontFamily="Segoe UI"
                                       FontSize="11" FontWeight="Medium"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="13" Height="13"
                                 Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#FFFFFF">
        <!-- Nlur on add/edit modal-->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ── Title Bar ── -->
            <Grid Grid.Row="0"
                  Background="#FFFFFF"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border x:Name="TitleBarDimOverlay" Background="{StaticResource ModalOverlayBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button Style="{StaticResource WinCtrlButton}"
                            Background="#A8A8A8"
                            Margin="0,0,17,0"
                            Click="MinimizeButton_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SideTooltip}" Content="Minimize"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource WinCtrlButton}"
                            Background="#28C840"
                            Margin="0,0,15,0"
                            Click="MaximizeButton_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SideTooltip}" Content="Maximize"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource WinCtrlButton}"
                            Background="#FF5F57"
                            Margin="0,0,1,0"
                            Click="CloseButton_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SideTooltip}" Content="Close"/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
            <!-- ── Main layout ── -->
            <Grid Grid.Row="1">
                <!-- Sidebar -->
                <Border x:Name="Sidebar"
                        Width="68"
                        Background="#F0E4E4"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Margin="28,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#ead7dd" BlurRadius="16"
                                          ShadowDepth="3" Opacity="0.18" Direction="315"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0"
                               Source="pack://application:,,,/Assets/SidebarLogo.png"
                               Width="44" Height="44"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,20"
                               Stretch="Uniform"/>
                        <!-- Top nav -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,14">
                            <Button Style="{StaticResource NavButton}"
                                    Tag="Dashboard" Click="NavButton_Click" Margin="0,10,0,15"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="Dashboard"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M2,2H11V11H2V2M13,2H22V11H13V2M2,13H11V22H2V13M13,13H22V22H13V13M4,4V9H9V4H4M15,4V9H20V4H15M4,15V20H9V15H4M15,15V20H20V15H15Z"/>
                            </Button>
                            <Button Style="{StaticResource NavButton}"
                                    Tag="SoloParentRecords" Click="NavButton_Click" Margin="0,10,0,15"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="Solo Parent Records"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M10,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6H12L10,4Z"/>
                            </Button>
                            <Button Style="{StaticResource NavButton}"
                                    Tag="UserAdministration" Click="NavButton_Click" Margin="0,10,0,15"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="User Administration"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"/>
                            </Button>
                            <Button Style="{StaticResource NavButton}"
                                    Tag="SubsidyRecommendation" Click="NavButton_Click" Margin="0,10,0,15"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="Subsidy Recommendation"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8L6,7M4,19H8L6,17M4,14H8L6,12Z"/>
                            </Button>
                            <Button Style="{StaticResource NavButton}"
                                    Tag="Analytics" Click="NavButton_Click" Margin="0,10,0,15"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="Analytics"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"/>
                            </Button>
                        </StackPanel>
                        <!-- Bottom nav -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <!-- Settings Button -->
                            <Button Style="{StaticResource NavButton}"
                                    Tag="Settings" Click="NavButton_Click" Margin="0,6,0,0"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="Settings"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                            </Button>

                            <!-- Divider between Settings and Logout -->
                            <Rectangle Width="32" Height="1.2" Fill="#D0BEC4" Margin="0,10,0,8" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>

                            <!-- Logout Button -->
                            <Button Style="{StaticResource NavButton}"
                                    Tag="Logout" Click="NavButton_Click" Margin="0,0,0,0"
                                    ToolTipService.InitialShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SideTooltip}" Content="Logout"/>
                                </Button.ToolTip>
                                <Path Stretch="Uniform" Width="20" Height="20"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M4,5H12V3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H12V19H4V5Z"/>
                            </Button>
                        </StackPanel>
                        <!-- Sidebar dim overlay for in-page modals -->
                        <Border x:Name="SidebarDimOverlay" Background="{StaticResource ModalOverlayBrush}" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <!-- Content area -->
                <Grid x:Name="ContentArea" Margin="112,0,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <controls:TopBar x:Name="TopBarControl"
                                     Grid.Row="0"
                                     PageTitle="Dashboard"
                                     Margin="16,0,-16,0"
                                     ProfileClicked="TopBarControl_ProfileClicked"
                                     ChangePasswordRequested="TopBarControl_ChangePasswordRequested"
                                     LogoutRequested="TopBarControl_LogoutRequested"
                                     MyActivityRequested="TopBarControl_MyActivityRequested"/>
                    <Border x:Name="TopBarDimOverlay" Grid.Row="0" Margin="16,0,-16,0" Background="{StaticResource ModalOverlayBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            CornerRadius="0,0,16,16">
                        <Frame x:Name="MainFrame"
                               NavigationUIVisibility="Hidden"
                               JournalOwnership="OwnsJournal"
                               Background="Transparent"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <!-- Full-window dim overlay for modal windows -->
        <Border x:Name="RootModalDimOverlay" Background="{StaticResource ModalOverlayBrush}" Visibility="Collapsed" Panel.ZIndex="100" IsHitTestVisible="True"/>
        <!-- My Activity full-screen overlay (Encoder only) -->
        <Grid x:Name="MyActivityOverlayRoot" Visibility="Collapsed" Panel.ZIndex="997">
            <Rectangle Fill="{StaticResource ModalOverlayBrush}"/>
            <local:ViewAllLogsOverlay x:Name="MyActivityOverlay"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Margin="60,40,60,40"
                                      CloseRequested="MyActivityOverlay_CloseRequested"/>
        </Grid>
        <!-- Full-window overlay host for in-app modals -->
        <Grid x:Name="GlobalModalHost" Visibility="Collapsed" Panel.ZIndex="998">
            <Rectangle Fill="{StaticResource ModalOverlayBrush}" MouseLeftButtonDown="GlobalModalBackdrop_MouseLeftButtonDown"/>
            <ContentPresenter x:Name="GlobalModalContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
        <!-- Session Auto-Lock Overlay (Data Privacy Act RA 10173) -->
        <Grid x:Name="SessionLockOverlay" Visibility="Collapsed" Panel.ZIndex="9999" Background="#E6150810" Focusable="True">
            <Border Background="White" CornerRadius="20" Padding="36,32" Width="430"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="8" Opacity="0.32" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Padlock Badge -->
                    <Border Width="56" Height="56" CornerRadius="28" Background="#FDF0F4" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                              Fill="#702943" Stretch="Uniform" Width="26" Height="26"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Session Locked" FontFamily="Segoe UI" FontSize="20"
                               FontWeight="Bold" Foreground="#702943"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Locked due to inactivity. Enter your password to resume."
                               FontFamily="Segoe UI" FontSize="12" Foreground="#666666" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                    <!-- User Pill -->
                    <Border Background="#F9F1F4" CornerRadius="12" Padding="14,10" Margin="0,0,0,18" BorderBrush="#EAD6DD" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#702943" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LockUserInitial" Text="U" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LockUserName" Text="Authorized Staff" FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold" Foreground="#1E1418"/>
                                <TextBlock x:Name="LockUserRole" Text="Caseworker" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#702943" Margin="0,1,0,0"/>
                                <TextBlock x:Name="LockUserEmail" Text="user@binan.gov.ph" FontFamily="Segoe UI" FontSize="11" Foreground="#777777" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Password Field -->
                    <TextBlock Text="Account Password" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,6"/>
                    <Border x:Name="BorderLockPassword" Background="#FAFAFA" CornerRadius="10" BorderBrush="#D5C5CB" BorderThickness="1.2" Height="42" Padding="12,0">
                        <Grid>
                            <PasswordBox x:Name="TxtLockPassword" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                                         FontFamily="Segoe UI" FontSize="14" Foreground="#1E1418" KeyDown="TxtLockPassword_KeyDown"/>
                            <TextBox x:Name="TxtLockPasswordVisible" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                                     FontFamily="Segoe UI" FontSize="14" Foreground="#1E1418" Visibility="Collapsed" KeyDown="TxtLockPassword_KeyDown"/>
                            <Button x:Name="BtnLockTogglePassword" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnLockTogglePassword_Click">
                                <Path x:Name="IconLockEye" Stretch="Uniform" Width="17" Height="17" Fill="#888888"
                                      Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Error Text -->
                    <TextBlock x:Name="TxtLockError" Text="" FontFamily="Segoe UI" FontSize="11.5" Foreground="#DC2626"
                               Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                    <!-- Unlock Button -->
                    <Button x:Name="BtnUnlockSession" Height="44" Margin="0,16,0,12" Cursor="Hand" Click="BtnUnlockSession_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#5A2035"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="IconUnlockSpin" Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z"
                                  Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="TxtUnlockBtnLabel" Text="Unlock Session" FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Switch User Footer -->
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Padding="4,4" Click="LockSwitchUser_Click">
                        <TextBlock Text="Sign in as a different user" FontFamily="Segoe UI" FontSize="12" Foreground="#888888" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- DEPRECATED: LogoutOverlay replaced with ActionConfirmDialog in HandleLogout() -->
        <Grid x:Name="LogoutOverlay" Visibility="Collapsed" Panel.ZIndex="50">
            <Rectangle Fill="{StaticResource ModalOverlayBrush}"/>
            <Border Background="White" CornerRadius="16" Padding="32,28" Width="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#702943" BlurRadius="28" ShadowDepth="4" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="24"
                            Background="#FDF0F4" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M4,5H12V3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H12V19H4V5Z"
                              Fill="#702943" Stretch="Uniform" Width="22" Height="22"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Confirm Logout" FontFamily="Segoe UI" FontSize="16"
                               FontWeight="Bold" Foreground="#702943"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Are you sure you want to logout?" FontFamily="Segoe UI"
                               FontSize="12" Foreground="#666666" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="42" Cursor="Hand" Click="LogoutCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="10"
                                            BorderBrush="#DCC8CE" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#702943"/>
                        </Button>
                        <Button Grid.Column="2" Height="42" Cursor="Hand" Click="LogoutConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Logout" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <components:LoaderOverlay x:Name="LogoutLoadingOverlay"
                                  BlurTarget="{Binding ElementName=MainContent}"
                                  Message="Signing out..."
                                  Panel.ZIndex="60"/>
    </Grid>
</Window>