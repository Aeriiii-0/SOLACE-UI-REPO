<Window x:Class="SOLUM_UI.RecordViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeChanged="Window_SizeChanged"
        Closing="Window_Closing" Width="860" Height="760">

    <Border Background="#60000000">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.20"/>
            </Border.Effect>
            <Border x:Name="DialogShell" Background="#F7F5F6" CornerRadius="14"
                    ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#702943" CornerRadius="14,14,0,0" Padding="24,13">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Profile Details"
                                           FontSize="14" FontWeight="Bold" Foreground="White"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Solo Parent Record"
                                           FontSize="10" Foreground="#E8C0D0"
                                           FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="26" Height="26" BorderThickness="0"
                                    Background="Transparent" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="13">
                                            <TextBlock Text="&#x2715;" FontSize="11" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#F7F5F6">
                        <StackPanel Margin="22,18,22,18">

                            <Border Background="White" CornerRadius="10"
                                    BorderBrush="#D0B8C0" BorderThickness="1"
                                    Padding="18,14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRecordName" Text=""
                                                   FontSize="18" FontWeight="Bold" Foreground="#111111"
                                                   FontFamily="Segoe UI" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtSexAge" Text=""
                                                   FontSize="13" Foreground="#666666"
                                                   FontFamily="Segoe UI" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtContact" Text=""
                                                   FontSize="13" Foreground="#888888"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="StatusBadge"
                                            CornerRadius="6" Padding="10,5"
                                            VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Background="#F0E4E8">
                                        <TextBlock x:Name="TxtStatusBadge" Text=""
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#702943" FontFamily="Segoe UI"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="CardPanel"/>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="White" BorderBrush="#D0B8C0"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="22,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSpId" Grid.Column="0"
                                       FontSize="12" Foreground="#A06080"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                            <Button x:Name="BtnEdit" Grid.Column="1" Height="38" Padding="22,0"
                                    Cursor="Hand" Click="Edit_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="White" CornerRadius="8"
                                                BorderBrush="#D0B8C0" BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#FDF5F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Edit Record" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#702943" FontFamily="Segoe UI"/>
                            </Button>
                            <Button Grid.Column="3" Height="38" Padding="22,0"
                                    Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#702943" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Close" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" FontFamily="Segoe UI"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
