<Window x:Class="SOLUM_UI.RecordViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeChanged="Window_SizeChanged"
        Closing="Window_Closing" Width="860" Height="760">

    <Border Background="#60000000">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.20"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Dialog Shell ── -->
                <Border x:Name="DialogShell" Grid.Column="0"
                        Background="White" CornerRadius="14"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#702943" CornerRadius="14,14,0,0" Padding="24,13">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Profile Details"
                                               FontSize="14" FontWeight="Bold" Foreground="White"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="Solo Parent Record"
                                               FontSize="10" Foreground="#E8C0D0"
                                               FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="26" Height="26" BorderThickness="0"
                                        Background="Transparent" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="13">
                                                <TextBlock Text="&#x2715;" FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="White">
                            <StackPanel Margin="22,18,22,18">
                                <Border Background="White" CornerRadius="10"
                                        BorderBrush="#702943" BorderThickness="1"
                                        Padding="18,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRecordName" Text=""
                                                       FontSize="18" FontWeight="Bold" Foreground="#111111"
                                                       FontFamily="Segoe UI" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtSexAge" Text=""
                                                       FontSize="13" Foreground="#666666"
                                                       FontFamily="Segoe UI" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtContact" Text=""
                                                       FontSize="13" Foreground="#888888"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="StatusBadge"
                                                CornerRadius="6" Padding="10,5"
                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Background="#F0E4E8">
                                            <TextBlock x:Name="TxtStatusBadge" Text=""
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#702943" FontFamily="Segoe UI"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="CardPanel"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#D0B8C0"
                                BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="22,12">
                            <Grid>
                                <TextBlock x:Name="TxtSpId"
                                           FontSize="12" Foreground="#A06080"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"
                                           FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <Button HorizontalAlignment="Right" Height="38" Padding="28,0"
                                        Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#702943" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Close" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Segoe UI"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Delete confirmation overlay — spans all 3 rows, sits on top -->
                        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DeleteConfirmOverlay"
                              Visibility="Collapsed" Panel.ZIndex="99">
                            <Rectangle Fill="#88000000" RadiusX="14" RadiusY="14"/>
                            <Border Background="White" CornerRadius="14"
                                    Padding="32,28" Width="360"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.22"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Width="48" Height="48" CornerRadius="24"
                                            Background="#FFF0EE" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Fill="#E74C3C" Stretch="Uniform" Width="22" Height="22"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Danger: Are you sure?"
                                               FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                               Foreground="#E74C3C" HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Are you sure you want to delete this record? This action is permanent and cannot be undone."
                                               FontFamily="Segoe UI" FontSize="12" Foreground="#666666"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="40" Cursor="Hand"
                                                Click="DeleteCancel_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#F5F0F2" CornerRadius="10"
                                                            BorderBrush="#DCC8CE" BorderThickness="1.2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#702943"/>
                                        </Button>
                                        <Button Grid.Column="2" Height="40" Cursor="Hand"
                                                Click="DeleteConfirm_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#E74C3C" CornerRadius="10">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#E74C3C" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="Yes, Delete" FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>

                <!-- ── Vertical Action Toolbar ── -->
                <Border Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="10,48,0,0"
                        Background="#FDFAF9"
                        CornerRadius="14"
                        BorderBrush="#EDD8DE"
                        BorderThickness="1.2">
                    <Border.Effect>
                        <DropShadowEffect Color="#702943" BlurRadius="18" ShadowDepth="3" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel x:Name="ActionToolbar" Width="58" Margin="0,10,0,12">

                        <!-- Sidebar toggle -->
                        <Button x:Name="BtnToolbarToggle"
                                Width="44" Height="44" Margin="7,0,7,6"
                                Cursor="Hand" Click="BtnToolbarToggle_Click"
                                ToolTipService.InitialShowDelay="400"
                                ToolTipService.Placement="Right">
                            <Button.ToolTip>
                                <ToolTip Placement="Right" HorizontalOffset="6" VerticalOffset="-4">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Border Background="White" CornerRadius="8"
                                                    BorderBrush="#E8E8E8" BorderThickness="1" Padding="10,7">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <TextBlock Text="Collapse toolbar" Foreground="#702943"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                                        <Viewbox Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="22" Height="22"
                                                           RadiusX="5" RadiusY="5" Stroke="#702943"
                                                           StrokeThickness="2" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="4" Canvas.Top="6" Width="4" Height="12"
                                                           RadiusX="2" RadiusY="2" Fill="#702943"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5E8EC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Renew -->
                        <Button x:Name="BtnRenew"
                                Width="44" Height="44" Margin="7,0,7,6"
                                Cursor="Hand" Click="Renew_Click"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.Placement="Right">
                            <Button.ToolTip>
                                <ToolTip Placement="Right" HorizontalOffset="6" VerticalOffset="-4">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Border Background="White" CornerRadius="8"
                                                    BorderBrush="#E8E8E8" BorderThickness="1" Padding="10,7">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <TextBlock Text="Renew Record" Foreground="#27AE60"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                                        <Path Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.04 17.73,14.01 17.27,14.86L18.74,16.33C19.54,15.08 20,13.6 20,12C20,7.58 16.42,4 12,4M12,18C8.69,18 6,15.31 6,12C6,10.96 6.27,9.99 6.73,9.14L5.26,7.67C4.46,8.92 4,10.4 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18Z"
                                              Fill="#27AE60" Stretch="Uniform" Width="20" Height="20"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#E8F8EE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Edit -->
                        <Button x:Name="BtnEdit"
                                Width="44" Height="44" Margin="7,0,7,6"
                                Cursor="Hand" Click="Edit_Click"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.Placement="Right">
                            <Button.ToolTip>
                                <ToolTip Placement="Right" HorizontalOffset="6" VerticalOffset="-4">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Border Background="White" CornerRadius="8"
                                                    BorderBrush="#E8E8E8" BorderThickness="1" Padding="10,7">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <TextBlock Text="Edit Record" Foreground="#702943"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                                        <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                              Fill="#702943" Stretch="Uniform" Width="20" Height="20"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5EEF2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Delete -->
                        <Button x:Name="BtnDelete"
                                Width="44" Height="44" Margin="7,0,7,0"
                                Cursor="Hand" Click="Delete_Click"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.Placement="Right">
                            <Button.ToolTip>
                                <ToolTip Placement="Right" HorizontalOffset="6" VerticalOffset="-4">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="ToolTip">
                                            <Border Background="White" CornerRadius="8"
                                                    BorderBrush="#F5D0CE" BorderThickness="1" Padding="10,7">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <TextBlock Text="Delete Record" Foreground="#E74C3C"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Fill="#E74C3C" Stretch="Uniform" Width="20" Height="20"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FDECEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
