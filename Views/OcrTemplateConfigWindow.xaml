<Window x:Class="SOLUM_UI.OcrTemplateConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solace — OCR Template Field Box Calibration"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1340" Height="860"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border Background="#33000000">
        <Border Background="White" CornerRadius="16" Margin="16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="60"/>
                    <!-- Main Body -->
                    <RowDefinition Height="*"/>
                    <!-- Footer -->
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="#702943" CornerRadius="16,16,0,0" Padding="24,0"
                        Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📐" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="OCR Template Field Box Calibration" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Visually reposition and resize bounding boxes for CSWDO-066-2 Application Form" FontSize="11" Foreground="#E0B8C4"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄 Revert to Default" Click="ResetToDefault_Click"
                                    Height="32" Padding="14,0" Background="#903554" Foreground="White"
                                    BorderThickness="1" BorderBrush="#B86580" Cursor="Hand" Margin="0,0,12,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="32">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE -->
                <Grid Grid.Row="1" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <!-- Interactive Canvas Viewport -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Field Properties & Calibration Sidebar -->
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: INTERACTIVE DOCUMENT CANVAS -->
                    <Border Grid.Column="0" Background="#2B2B2B" BorderBrush="#D8C8CC" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <!-- Scrollable & Zoomable Viewport with Native Scroll + Pan + Cursor-Centered Zoom -->
                            <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          Background="#2B2B2B"
                                          PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel"
                                          MouseDown="CanvasScrollViewer_MouseDown"
                                          MouseMove="CanvasScrollViewer_MouseMove"
                                          MouseUp="CanvasScrollViewer_MouseUp">
                                <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Scanned Document Image -->
                                    <Image x:Name="ImgDocument" Stretch="Fill"
                                           Width="{Binding Width, ElementName=OverlayCanvas}"
                                           Height="{Binding Height, ElementName=OverlayCanvas}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Overlay Canvas for Field Boxes -->
                                    <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                            MouseDown="OverlayCanvas_MouseDown"
                                            MouseMove="OverlayCanvas_MouseMove"
                                            MouseUp="OverlayCanvas_MouseUp"/>
                                </Grid>
                            </ScrollViewer>

                            <!-- FLOATING UNDO / REDO DOCK (Top-Left) -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="16,14,0,0" Background="#F8FFFFFF" BorderBrush="#D0C0C6" BorderThickness="1"
                                    CornerRadius="16" Padding="6,4" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.16"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnUndo" Content="↩ Undo" Click="Undo_Click" Height="24" Padding="8,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Foreground="#444444" ToolTip="Undo Last Change (Ctrl+Z)"/>
                                    <Border Width="1" Height="14" Background="#E0D0D5" Margin="4,0"/>
                                    <Button x:Name="BtnRedo" Content="↪ Redo" Click="Redo_Click" Height="24" Padding="8,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Foreground="#444444" ToolTip="Redo Last Change (Ctrl+Y)"/>
                                    <Border Width="1" Height="14" Background="#E0D0D5" Margin="4,0"/>
                                    <TextBlock Text="💡 Shift+Click to multi-select • Drag empty space to pan • Ctrl+Wheel to zoom" FontSize="10" Foreground="#666666" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- FLOATING NAVIGATION DOCK (Bottom-Right, shifted left to clear scrollbars) -->
                            <Border x:Name="FloatingNavDock" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,48,24" Background="#F4FFFFFF" BorderBrush="#D0C0C6" BorderThickness="1"
                                    CornerRadius="16" Padding="6,3" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.16"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Zoom Out -->
                                    <Button x:Name="BtnFloatZoomOut" Click="ZoomOut_Click" Width="24" Height="24"
                                            Background="Transparent" Foreground="#555555" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Zoom Out (−)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <TextBlock Text="−" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBg" Property="Background" Value="#F3EBF0"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Zoom Percentage Readout / Reset -->
                                    <Border x:Name="PillZoomLevel" Background="Transparent" CornerRadius="8" Padding="5,2"
                                            Cursor="Hand" MouseLeftButtonUp="ZoomReset_Click" ToolTip="Click to reset zoom to 100%">
                                        <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="10.5" FontWeight="Bold" Foreground="#702943"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Zoom In -->
                                    <Button x:Name="BtnFloatZoomIn" Click="ZoomIn_Click" Width="24" Height="24"
                                            Background="Transparent" Foreground="#555555" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Zoom In (+)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBg" Property="Background" Value="#F3EBF0"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Vertical Separator -->
                                    <Border Width="1" Height="14" Background="#E0D0D5" Margin="4,0"/>

                                    <!-- Fit Page in View -->
                                    <Button x:Name="BtnFloatZoomFit" Click="ZoomFit_Click" Width="24" Height="24"
                                            Background="Transparent" Foreground="#555555" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Fit Entire Page in View">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Data="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBg" Property="Background" Value="#F3EBF0"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 1:1 Actual Size -->
                                    <Button x:Name="BtnFloatZoomReset" Click="ZoomReset1to1_Click" Width="24" Height="24"
                                            Background="Transparent" Foreground="#555555" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Reset to 1:1 (100% Actual Size)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <TextBlock Text="1:1" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBg" Property="Background" Value="#F3EBF0"/>
                                                        <Setter Property="Foreground" Value="#702943"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT: STREAMLINED CALIBRATION SIDEBAR -->
                    <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="12" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- CARD 1: ACTIVE FIELD & POSITION READOUT -->
                                <Border Background="White" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Field Selector" FontSize="11" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbFields" SelectionChanged="CmbFields_SelectionChanged" Height="30" Margin="0,0,0,10">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Compact Key & Category Pill -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtFieldKey" Text="field_key" FontSize="11" FontWeight="SemiBold" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#F3EBF0" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TxtFieldCategory" Text="Section I" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                            </Border>
                                        </Grid>

                                        <!-- Coordinate Badge Pills (2x2 Grid) -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- X -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="#F7F5F6" BorderBrush="#E8DFE2" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                <Grid>
                                                    <TextBlock Text="X (Left)" FontSize="9.5" Foreground="#777777" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtValX" Text="0.000" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Y -->
                                            <Border Grid.Row="0" Grid.Column="2" Background="#F7F5F6" BorderBrush="#E8DFE2" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                <Grid>
                                                    <TextBlock Text="Y (Top)" FontSize="9.5" Foreground="#777777" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtValY" Text="0.000" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Width -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="#F7F5F6" BorderBrush="#E8DFE2" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <Grid>
                                                    <TextBlock Text="Width" FontSize="9.5" Foreground="#777777" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtValW" Text="0.000" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Height -->
                                            <Border Grid.Row="1" Grid.Column="2" Background="#F7F5F6" BorderBrush="#E8DFE2" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                <Grid>
                                                    <TextBlock Text="Height" FontSize="9.5" Foreground="#777777" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtValH" Text="0.000" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: POSITION FINE-TUNING & MICRO-NUDGE -->
                                <Border Background="White" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Position Nudge &amp; Sizing" FontSize="11" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                                            <!-- Step Size Toggle (1px fine vs 5px normal) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton x:Name="RbStepFine" Content="1px" IsChecked="True" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <RadioButton x:Name="RbStepNormal" Content="5px" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Clean Directional D-Pad -->
                                        <Grid HorizontalAlignment="Center" Margin="0,4,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Up -->
                                            <Button x:Name="BtnNudgeUp" Grid.Row="0" Grid.Column="1" Content="▲" Click="Nudge_Click" Tag="Up"
                                                    Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" ToolTip="Nudge Up (Arrow Up)"/>

                                            <!-- Left -->
                                            <Button x:Name="BtnNudgeLeft" Grid.Row="1" Grid.Column="0" Content="◄" Click="Nudge_Click" Tag="Left"
                                                    Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" ToolTip="Nudge Left (Arrow Left)"/>

                                            <!-- Center icon indicator -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="#FBF6F8" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="6" Margin="3">
                                                <TextBlock Text="🎯" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Right -->
                                            <Button x:Name="BtnNudgeRight" Grid.Row="1" Grid.Column="2" Content="►" Click="Nudge_Click" Tag="Right"
                                                    Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" ToolTip="Nudge Right (Arrow Right)"/>

                                            <!-- Down -->
                                            <Button x:Name="BtnNudgeDown" Grid.Row="2" Grid.Column="1" Content="▼" Click="Nudge_Click" Tag="Down"
                                                    Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" ToolTip="Nudge Down (Arrow Down)"/>
                                        </Grid>

                                        <!-- Box Sizing Quick Buttons (Expand / Shrink) -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="➕ Expand Box" Click="ExpandBox_Click" Height="26" FontSize="10.5" Background="#FAFAFA" BorderBrush="#D0C0C6" Cursor="Hand" ToolTip="Expand width &amp; height by 1px"/>
                                            <Button Grid.Column="2" Content="➖ Shrink Box" Click="ShrinkBox_Click" Height="26" FontSize="10.5" Background="#FAFAFA" BorderBrush="#D0C0C6" Cursor="Hand" ToolTip="Shrink width &amp; height by 1px"/>
                                        </Grid>

                                        <!-- Keyboard Shortcut Hint -->
                                        <Border Background="#F9F8F9" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="💡 Shift+Click boxes to multi-select &amp; resize together. Arrow keys micro-nudge." FontSize="9.5" Foreground="#777777" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 3: REAL-TIME LIVE OCR TEST -->
                                <Border Background="White" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Button x:Name="BtnTestOcr" Click="TestOcr_Click" Height="36" Background="#702943" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Test Box OCR" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Border Background="#FDF8FA" BorderBrush="#ECDCE1" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="Extraction Result:" FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TxtLiveOcrResult" Text="(Click 'Test Box OCR' to run AI extraction)" FontSize="11" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 4: ADVANCED GLOBAL CALIBRATION EXPANDER (COLLAPSED BY DEFAULT) -->
                                <Expander Header="🌐 Advanced: Calibrate All Boxes" FontWeight="SemiBold" FontSize="11" Foreground="#6A1B9A" Background="#F8F3F9" BorderBrush="#E1D0E4" BorderThickness="1" Margin="0,0,0,8">
                                    <StackPanel Margin="10,8">
                                        <TextBlock Text="Shift or scale all 50+ boxes simultaneously to adapt to scanner variations:" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        
                                        <!-- Nudge All D-Pad -->
                                        <TextBlock Text="Nudge All Boxes Position:" FontSize="10.5" FontWeight="SemiBold" Foreground="#4A148C" Margin="0,0,0,4"/>
                                        <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="26"/>
                                                <RowDefinition Height="26"/>
                                                <RowDefinition Height="26"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Row="0" Grid.Column="1" Content="▲ Up" Click="GlobalNudgeUp_Click" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes up"/>
                                            <Button Grid.Row="1" Grid.Column="0" Content="◀ Left" Click="GlobalNudgeLeft_Click" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes left"/>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Right ▶" Click="GlobalNudgeRight_Click" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes right"/>
                                            <Button Grid.Row="2" Grid.Column="1" Content="▼ Down" Click="GlobalNudgeDown_Click" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Height="24" Cursor="Hand" ToolTip="Nudge all boxes down"/>
                                        </Grid>

                                        <!-- Scale All -->
                                        <TextBlock Text="Scale All Boxes Size:" FontSize="10.5" FontWeight="SemiBold" Foreground="#4A148C" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="➖ Shrink All" Click="GlobalScaleShrink_Click" Height="24" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Scale all boxes smaller by 1%"/>
                                            <Button Grid.Column="2" Content="➕ Expand All" Click="GlobalScaleExpand_Click" Height="24" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Scale all boxes larger by 1%"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="↔ Stretch W" Click="GlobalScaleWidth_Click" Height="24" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Stretch width by 1%"/>
                                            <Button Grid.Column="2" Content="↕ Stretch H" Click="GlobalScaleHeight_Click" Height="24" FontSize="9.5" Background="White" BorderBrush="#BA68C8" Cursor="Hand" ToolTip="Stretch height by 1%"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <Border Grid.Row="2" Background="#F9F6F7" BorderBrush="#E5D8DC" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatusMessage" Text="● Ready to calibrate field positions." FontSize="12" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Click="Close_Click" Width="100" Height="36" Background="White"
                                    BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="💾 Save as Template" Click="SaveTemplate_Click" Width="170" Height="36"
                                    Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                    Cursor="Hand" Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="✓ Apply &amp; Re-Extract" Click="ApplyAndReExtract_Click" Width="170" Height="36"
