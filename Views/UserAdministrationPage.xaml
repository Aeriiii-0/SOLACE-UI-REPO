                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#555555"/>
                        </Button>
                        <Button Grid.Column="2" Height="40" Cursor="Hand" Click="Submit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#702943" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtSubmitBtn" Text="Create Account"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>


        <components:LoadingOverlay x:Name="UsersLoadingOverlay"
                                   Grid.RowSpan="99" Grid.ColumnSpan="99"
                                   Panel.ZIndex="9999"/>
    </Grid>
</Page>
