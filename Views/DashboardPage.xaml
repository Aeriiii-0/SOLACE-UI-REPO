<Page x:Class="SOLUM_UI.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SOLUM_UI.ViewModels"
      xmlns:local="clr-namespace:SOLUM_UI"
      xmlns:converters="clr-namespace:SOLUM_UI.Converters"
      Background="Transparent"
      Title="Dashboard">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    <Page.DataContext>
        <vm:DashboardViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid x:Name="DashboardScroll">
            <Grid Margin="28,22,28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="300" MaxWidth="400"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock x:Name="TxtWelcome" Text="Welcome back!"
                                   FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                   Foreground="#702943"/>
                        <TextBlock Text="Here's what's happening with your solo parent program today."
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="#A06080" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="22,18">
                            <Border.Effect>
                                <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#702943" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="REGISTERED" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#9B3060"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RegisteredSoloParents, StringFormat={}{0:N0}}"
                                           FontFamily="Segoe UI" FontSize="44" FontWeight="Bold" Foreground="#702943"/>
                                <TextBlock Text="Solo Parents" FontFamily="Segoe UI" FontSize="14" Foreground="#888888" Margin="0,3,0,10"/>
                                <Border Background="#F0E8EC" CornerRadius="7" Padding="10,5" HorizontalAlignment="Left"
                                        ToolTip="{Binding InactiveSoloParents, StringFormat={}{0:N0} inactive records}">
                                    <TextBlock Text="{Binding RegisteredDelta}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22,18">
                            <Border.Effect>
                                <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#27AE60" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ACTIVE" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#27AE60"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveSoloParents, StringFormat={}{0:N0}}"
                                           FontFamily="Segoe UI" FontSize="44" FontWeight="Bold" Foreground="#27AE60"/>
                                <TextBlock Text="Valid Records" FontFamily="Segoe UI" FontSize="14" Foreground="#888888" Margin="0,3,0,10"/>
                                <Border Background="#E8F5E9" CornerRadius="7" Padding="10,5" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ActiveDelta}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#27AE60"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="White" CornerRadius="14" Padding="22,18">
                            <Border.Effect>
                                <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#F57F17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="RENEWALS" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#C0762A"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RenewalsDueThisMonth, StringFormat={}{0:N0}}"
                                           FontFamily="Segoe UI" FontSize="44" FontWeight="Bold" Foreground="#C0762A"/>
                                <TextBlock Text="Due this month" FontFamily="Segoe UI" FontSize="14" Foreground="#888888" Margin="0,3,0,10"/>
                                <Border Background="#FFF4E3" CornerRadius="7" Padding="10,5" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RenewalsDelta}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#C0762A"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,18">
                        <Border.Effect>
                            <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Monthly Registrations"
                                               FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#702943"/>
                                    <TextBlock Text="{Binding ChartSubtitle}"
                                               FontFamily="Segoe UI" FontSize="13" Foreground="#A06080" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FFF5F8" BorderBrush="#E8C8D4" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding QuarterPeriodLabel}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#702943"/>
                                        <TextBlock Text=": " FontFamily="Segoe UI" FontSize="12" Foreground="#702943"/>
                                        <TextBlock Text="{Binding QuarterGrandTotal, StringFormat={}{0:N0} registered}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#9B3060"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,32">
                                    <TextBlock Text="{Binding YAxisMax}" FontSize="11" Foreground="#C0A0AA" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding YAxisMidHigh}" FontSize="11" Foreground="#C0A0AA" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-10,0,0"/>
                                    <TextBlock Text="{Binding YAxisMidLow}" FontSize="11" Foreground="#C0A0AA" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,32"/>
                                    <TextBlock Text="{Binding YAxisMin}"   FontSize="11" Foreground="#C0A0AA" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding MonthlyBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="32"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="1" Background="#D4A0B0"
                                                        CornerRadius="5,5,0,0"
                                                        Height="{Binding BarHeight}"
                                                        Margin="8,0" VerticalAlignment="Bottom">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#702943"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.ToolTip>
                                                        <ToolTip Content="{Binding Value}"/>
                                                    </Border.ToolTip>
                                                </Border>
                                                <TextBlock Grid.Row="2" Text="{Binding Month}"
                                                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#702943"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#702943" CornerRadius="14" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" Background="#9B3060" CornerRadius="22" Margin="0,0,16,0">
                                <TextBlock Text="🤖" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ML Model ran 14 new subsidy recommendations"
                                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="10 high-priority cases await staff approval · Last retrained 4 hours ago"
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#E8C8D4" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" BorderBrush="White"
                                                BorderThickness="1.5" CornerRadius="9" Padding="18,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Review ↗" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="White" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="22,20,22,16" BorderBrush="#F0E4E8" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Recent Activity"
                                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock Text="Audit Logs"
                                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#702943" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,0">
                            <ItemsControl ItemsSource="{Binding RecentLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="10"
                                                BorderBrush="#EEE4E8" BorderThickness="1"
                                                Padding="14,12" Margin="0,0,0,10"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectLogCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FAFAFA"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FDF3F6"/>
                                                            <Setter Property="BorderBrush" Value="#D0B8C0"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34"
                                                        CornerRadius="17" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding DotColor}"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding DotLabel}" FontSize="14" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Description}"
                                                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111111" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding PerformedBy}" FontFamily="Segoe UI" FontSize="12" Foreground="#666666"/>
                                                        <TextBlock Text=" · " FontFamily="Segoe UI" FontSize="12" Foreground="#CCCCCC"/>
                                                        <TextBlock Text="{Binding TimeAgo}" FontFamily="Segoe UI" FontSize="12" Foreground="#AAAAAA"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ScrollViewer>

                        <Border Grid.Row="2" Padding="18,14" BorderBrush="#F0E4E8" BorderThickness="0,1,0,0">
                            <Button Click="ViewAllLogs_Click" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="#702943" CornerRadius="9" Padding="0,13">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="View all logs" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="OverlayRoot" Visibility="Collapsed">
            <Rectangle Fill="#80000000"/>
            <local:ViewAllLogsOverlay x:Name="LogsOverlay"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Margin="60,40,60,40"
                                      CloseRequested="LogsOverlay_CloseRequested"/>
        </Grid>

        <!-- ── Log card detail overlay ──────────────────────────────────────── -->
        <Grid Visibility="{Binding IsLogDetailVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Dim backdrop — clicking it closes the panel -->
            <Rectangle Fill="#66000000" Cursor="Arrow">
                <Rectangle.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CloseLogDetailCommand}"/>
                </Rectangle.InputBindings>
            </Rectangle>

            <!-- Detail card -->
            <Border Background="White" CornerRadius="16" Padding="32,28"
                    Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxHeight="650">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32"
                                      ShadowDepth="4" Opacity="0.22" Direction="270"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedLog}">

                        <!-- Header row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Log Detail"
                                       FontFamily="Segoe UI" FontSize="17"
                                       FontWeight="Bold" Foreground="#702943"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Width="32" Height="32" Cursor="Hand"
                                    Command="{Binding DataContext.CloseLogDetailCommand,
                                              RelativeSource={RelativeSource AncestorType=Page}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="16">
                                            <TextBlock Text="✕" FontSize="14" Foreground="#702943"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#F5E8EC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Action badge + record name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border CornerRadius="8" Padding="12,5" Margin="0,0,10,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding DotColor}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding ActionLabel}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding RecordName}"
                                       FontFamily="Segoe UI" FontSize="15"
                                       FontWeight="Bold" Foreground="#1A1A1A"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E4E4" Margin="0,0,0,14"/>

                        <!-- Performed by -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Performed by"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#888888" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding PerformedBy}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#1A1A1A"
                                           VerticalAlignment="Center"/>
                                <Border CornerRadius="5" Background="#F0E8EC"
                                        Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PerformedByRole}"
                                               FontFamily="Segoe UI" FontSize="10"
                                               FontWeight="SemiBold" Foreground="#702943"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Target -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#888888" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding RecordId}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="Bold" Foreground="#702943"
                                           VerticalAlignment="Center"/>
                                <Border CornerRadius="5" Background="#EEF2FF"
                                        Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetType}"
                                               FontFamily="Segoe UI" FontSize="10"
                                               FontWeight="SemiBold" Foreground="#4F46E5"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Status"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#888888" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" CornerRadius="6" Padding="10,4"
                                    HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                <Setter Property="Background" Value="#FFE8E8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="FAILURE">
                                                <Setter Property="Background" Value="#FFE8E8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                    <Setter Property="Foreground" Value="#DC3545"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="FAILURE">
                                                    <Setter Property="Foreground" Value="#DC3545"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- IP Address -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IP Address"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#888888" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#444444" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Timestamp -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Timestamp"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#888888" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TimestampFormatted}"
                                       FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#1A1A1A"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Page>

