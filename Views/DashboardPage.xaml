<Page x:Class="SOLUM_UI.DashboardPage"

      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

      xmlns:vm="clr-namespace:SOLUM_UI.ViewModels"

      xmlns:local="clr-namespace:SOLUM_UI"

      xmlns:converters="clr-namespace:SOLUM_UI.Converters"

      xmlns:components="clr-namespace:SOLUM_UI.Views.Components"

      Background="White"

      Title="Dashboard"

      TextOptions.TextRenderingMode="ClearType"

      TextOptions.TextFormattingMode="Display"

      UseLayoutRounding="True"

      SnapsToDevicePixels="True">

    <Page.Resources>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <DropShadowEffect x:Key="CardShadow" Color="#702943" BlurRadius="16" ShadowDepth="2" Opacity="0.06" Direction="270"/>

        <FontFamily x:Key="HeadingFont">Georgia</FontFamily>

        

        <!-- Global Typography Style: Crispy Text Rendering -->

        <Style TargetType="TextBlock">

            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

        </Style>

        <Style TargetType="TextBox">

            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

        </Style>

        

        <Style x:Key="SlimProgress" TargetType="ProgressBar">

            <Setter Property="Height" Value="8"/>

            <Setter Property="Minimum" Value="0"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Grid>

                            <Border Background="{TemplateBinding Background}" CornerRadius="4" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

                            <Border x:Name="PART_Track"/>

                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"

                                    Background="{TemplateBinding Foreground}" CornerRadius="4" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SegmentToggle" TargetType="RadioButton">

            <Setter Property="Foreground" Value="#702943"/>

            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="FontSize" Value="11.5"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14" Padding="14,5" UseLayoutRounding="True" SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Bg" Property="Background" Value="#F6DDE5"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="Bg" Property="Background" Value="#702943"/>

                                <Setter Property="Foreground" Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ArrowButton" TargetType="Button">

            <Setter Property="Width" Value="28"/>

            <Setter Property="Height" Value="28"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" UseLayoutRounding="True" SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Bg" Property="Background" Value="#F8E6EC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>

    <Page.DataContext>

        <vm:DashboardViewModel/>

    </Page.DataContext>

    <Grid>

        <!-- Loading State -->

        <components:DashboardSkeletonLoader Visibility="{Binding IsLoading,

                                            Converter={StaticResource BoolToVisibilityConverter}}"

                                            Panel.ZIndex="100"/>

        <!-- Main Content -->

        <ScrollViewer x:Name="DashboardScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsLoading,

                                   Converter={StaticResource InverseBoolToVisibilityConverter}}">

            <Grid Margin="18,10,18,12">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2.5*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="3" CornerRadius="22" Margin="0,0,0,16"

                        BorderBrush="#702943" BorderThickness="1.5"

                        Effect="{StaticResource CardShadow}" UseLayoutRounding="True" SnapsToDevicePixels="True">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#FFFFFF" Offset="0"/>

                            <GradientStop Color="#FDF1F5" Offset="0.55"/>

                            <GradientStop Color="#F8DFE8" Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid x:Name="HeroClipHost" SizeChanged="HeroClipHost_SizeChanged">

                        <Canvas IsHitTestVisible="False">

                            <Ellipse Width="210" Height="210" Canvas.Right="-105" Canvas.Top="-105"

                                     Stroke="#E7BFCD" StrokeThickness="1" Opacity="0.7"/>

                            <Ellipse Width="160" Height="160" Canvas.Right="-80" Canvas.Top="-80"

                                     Stroke="#E7BFCD" StrokeThickness="1" Opacity="0.85"/>

                            <Ellipse Width="100" Height="100" Canvas.Right="-50" Canvas.Top="-50"

                                     Fill="#F7DCE5" Opacity="0.8"/>

                            <Ellipse Width="10" Height="10" Canvas.Left="400" Canvas.Top="26" Fill="#C97E98" Opacity="0.55"/>

                            <Ellipse Width="6" Height="6" Canvas.Left="452" Canvas.Top="58" Fill="#C97E98" Opacity="0.45"/>

                            <Ellipse Width="7" Height="7" Canvas.Left="520" Canvas.Top="30" Fill="#702943" Opacity="0.25"/>

                            <Path Data="M0,6 L6,6 M3,3 L3,9" Stroke="#B5607D" StrokeThickness="1.6" StrokeStartLineCap="Round"

                                  StrokeEndLineCap="Round" Canvas.Left="480" Canvas.Top="84" Opacity="0.55"/>

                        </Canvas>

                        <Grid Margin="34,30,34,30">

                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">

                                <TextBlock x:Name="TxtWelcome" Text="Welcome back!"

                                           FontFamily="{StaticResource HeadingFont}" FontSize="26" FontWeight="Bold"

                                           Foreground="#702943"/>

                                <TextBlock Text="Here's what's happening with your program today."

                                           FontFamily="Segoe UI" FontSize="13" Foreground="#9B6B7E" Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">

                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">

                                    <TextBlock Text="RECORD HEALTH" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold"

                                               Foreground="#9B6B7E" HorizontalAlignment="Right"/>

                                    <TextBlock FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#702943"

                                               HorizontalAlignment="Right" Margin="0,3,0,0">

                                        <Run Text="{Binding ActiveSoloParents, Mode=OneWay}"/>

                                        <Run Text=" of "/>

                                        <Run Text="{Binding RegisteredSoloParents, Mode=OneWay}"/>

                                        <Run Text=" records valid"/>

                                    </TextBlock>

                                    <Border Background="#FBE3EA" CornerRadius="12" Padding="10,5"

                                            HorizontalAlignment="Right" Margin="0,8,0,0">

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"

                                                  Fill="#702943" Stretch="Uniform" Width="9" Height="9" Margin="0,0,5,0"/>

                                            <TextBlock Text="{Binding LastRefreshedText, FallbackValue='Updated: Just now'}"

                                                       FontSize="10.5" FontFamily="Segoe UI" Foreground="#702943"/>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                                <Grid Width="88" Height="88" VerticalAlignment="Center" Margin="0,0,18,0">

                                    <Ellipse Margin="2" Fill="White" Opacity="0.85"/>

                                    <Viewbox>

                                        <Canvas Width="100" Height="100">

                                            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="82" Height="82"

                                                     Stroke="#F1D9E2" StrokeThickness="7"/>

                                            <Path x:Name="HealthArc" StrokeThickness="7"

                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">

                                                <Path.Stroke>

                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                                        <GradientStop Color="#E8A5BA" Offset="0"/>

                                                        <GradientStop Color="#A63A67" Offset="1"/>

                                                    </LinearGradientBrush>

                                                </Path.Stroke>

                                            </Path>

                                        </Canvas>

                                    </Viewbox>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding RecordHealthText, FallbackValue='—'}"

                                                   FontFamily="{StaticResource HeadingFont}" FontSize="19" FontWeight="Bold"

                                                   Foreground="#702943" HorizontalAlignment="Center"/>

                                        <TextBlock Text="valid" FontFamily="Segoe UI" FontSize="9" Foreground="#9B6B7E"

                                                   HorizontalAlignment="Center" Margin="0,-2,0,0"/>

                                    </StackPanel>

                                </Grid>

                                <Button x:Name="BtnRefreshDashboard" VerticalAlignment="Center"

                                        Width="38" Height="38" Cursor="Hand"

                                        BorderThickness="0" Background="Transparent"

                                        ToolTip="{Binding RefreshTooltip, FallbackValue='Refresh dashboard data'}"

                                        Command="{Binding RefreshCommand}">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"

                                                    CornerRadius="19" BorderBrush="#702943" BorderThickness="1">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="Bg" Property="Background" Value="#F8E1E8"/>

                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">

                                                    <Setter Property="Opacity" Value="0.45"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"

                                          Fill="#702943" Stretch="Uniform" Width="14" Height="14"/>

                                </Button>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

                <Grid Grid.Row="1" Grid.Column="0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="14"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="14"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="20"

                                BorderBrush="#702943" BorderThickness="1.5" Padding="20,18"

                                Effect="{StaticResource CardShadow}" UseLayoutRounding="True" SnapsToDevicePixels="True">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="34" Height="34" CornerRadius="10" Background="#FBE3EA">

                                        <Path Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"

                                              Fill="#702943" Stretch="Uniform" Width="16" Height="16"/>

                                    </Border>

                                    <TextBlock Text="Total registered" FontFamily="Segoe UI" FontSize="12"

                                               Foreground="#8E6F7B" VerticalAlignment="Center" Margin="12,0,0,0"/>

                                </StackPanel>

                                <TextBlock Text="{Binding RegisteredSoloParents, StringFormat={}{0:N0}}"

                                           FontFamily="{StaticResource HeadingFont}" FontSize="30" FontWeight="Bold"

                                           Foreground="#702943" Margin="0,12,0,0"/>

                                <TextBlock Text="solo parents" FontFamily="Segoe UI" FontSize="12" Foreground="#8E6F7B"/>

                                <Border Background="#FBE3EA" CornerRadius="12" Padding="12,4"

                                        HorizontalAlignment="Left" Margin="0,12,0,0">

                                    <TextBlock Text="{Binding RegisteredDelta}" FontFamily="Segoe UI" FontSize="11"

                                               FontWeight="SemiBold" Foreground="#702943"/>

                                </Border>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="20"

                                BorderBrush="#702943" BorderThickness="1.5" Padding="20,18"

                                Effect="{StaticResource CardShadow}" UseLayoutRounding="True" SnapsToDevicePixels="True">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="34" Height="34" CornerRadius="10" Background="#E3F5EE">

                                        <Path Data="M20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4C12.76,4 13.5,4.11 14.2,4.31L15.77,2.74C14.61,2.26 13.34,2 12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12M7.91,10.08L6.5,11.5L11,16L21,6L19.59,4.58L11,13.17L7.91,10.08Z"

                                              Fill="#0F9D76" Stretch="Uniform" Width="16" Height="16"/>

                                    </Border>

                                    <TextBlock Text="Active" FontFamily="Segoe UI" FontSize="12"

                                               Foreground="#8E6F7B" VerticalAlignment="Center" Margin="12,0,0,0"/>

                                </StackPanel>

                                <TextBlock Text="{Binding ActiveSoloParents, StringFormat={}{0:N0}}"

                                           FontFamily="{StaticResource HeadingFont}" FontSize="30" FontWeight="Bold"

                                           Foreground="#0F9D76" Margin="0,12,0,0"/>

                                <TextBlock Text="valid records" FontFamily="Segoe UI" FontSize="12" Foreground="#8E6F7B"/>

                                <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,16,0,0"

                                             Background="#D3F0E6" Foreground="#0F9D76"

                                             Maximum="{Binding RegisteredSoloParents}"

                                             Value="{Binding ActiveSoloParents, Mode=OneWay}"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Column="4" Background="White" CornerRadius="20"

                                BorderBrush="#702943" BorderThickness="1.5" Padding="20,18"

                                ToolTip="{Binding InactiveSubtext}"

                                Effect="{StaticResource CardShadow}" UseLayoutRounding="True" SnapsToDevicePixels="True">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="34" Height="34" CornerRadius="10" Background="#FDEBC8">

                                        <Path Data="M11,15H13V17H11V15M11,7H13V13H11V7M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z"

                                              Fill="#E8960C" Stretch="Uniform" Width="16" Height="16"/>

                                    </Border>

                                    <TextBlock Text="Inactive" FontFamily="Segoe UI" FontSize="12"

                                               Foreground="#8E6F7B" VerticalAlignment="Center" Margin="12,0,0,0"/>

                                </StackPanel>

                                <TextBlock Text="{Binding InactiveRecordsCount, StringFormat={}{0:N0}}"

                                           FontFamily="{StaticResource HeadingFont}" FontSize="30" FontWeight="Bold"

                                           Foreground="#E8960C" Margin="0,12,0,0"/>

                                <TextBlock Text="need review" FontFamily="Segoe UI" FontSize="12" Foreground="#8E6F7B"/>

                                <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,16,0,0"

                                             Background="#FCE8C6" Foreground="#E8960C"

                                             Maximum="{Binding RegisteredSoloParents}"

                                             Value="{Binding InactiveRecordsCount, Mode=OneWay}"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="24,20" Margin="0,0,0,16"

                            BorderBrush="#702943" BorderThickness="1" Effect="{StaticResource CardShadow}" UseLayoutRounding="True" SnapsToDevicePixels="True">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock x:Name="TxtChartTitle" Text="Quarterly registrations"

                                               FontFamily="{StaticResource HeadingFont}" FontSize="19" FontWeight="Bold"

                                               Foreground="#702943"/>

                                    <TextBlock x:Name="TxtChartSubtitle" Text="{Binding ChartSubtitle}"

                                               FontFamily="Segoe UI" FontSize="11.5" Foreground="#9B6B7E" Margin="0,3,0,0"/>

                                </StackPanel>

                                <Border Grid.Column="1" Background="#FDF3F6" BorderBrush="#EBCFD8" BorderThickness="1"

                                        CornerRadius="17" Padding="3" VerticalAlignment="Top">

                                    <StackPanel Orientation="Horizontal">

                                        <RadioButton x:Name="RbQuarterly" Content="Quarterly" IsChecked="True"

                                                     Style="{StaticResource SegmentToggle}"

                                                     Checked="ChartMode_Checked"/>

                                        <RadioButton x:Name="RbMonthly" Content="Monthly"

                                                     Style="{StaticResource SegmentToggle}"

                                                     Checked="ChartMode_Checked"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <Grid Grid.Row="1">

                                <Canvas x:Name="ChartCanvas" Background="Transparent"

                                        SizeChanged="ChartCanvas_SizeChanged" MinHeight="200"/>

                                <Border x:Name="ChartTip" Visibility="Collapsed" IsHitTestVisible="False"

                                        HorizontalAlignment="Left" VerticalAlignment="Top"

                                        Background="#702943" CornerRadius="12" Padding="14,10" MinWidth="140"

                                        Panel.ZIndex="10">

                                    <Border.Effect>

                                        <DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="3" Opacity="0.3" Direction="270"/>

                                    </Border.Effect>

                                    <StackPanel>

                                        <TextBlock x:Name="TipTitle" FontFamily="{StaticResource HeadingFont}" FontSize="13"

                                                   FontWeight="Bold" Foreground="White"/>

                                        <TextBlock x:Name="TipRange" FontFamily="Segoe UI" FontSize="10.5"

                                                   Foreground="#E8C5D1" Margin="0,1,0,0"/>

                                        <Rectangle Height="1" Fill="White" Opacity="0.2" Margin="0,8,0,8"/>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock x:Name="TipValue" FontFamily="{StaticResource HeadingFont}" FontSize="22"

                                                       FontWeight="Bold" Foreground="White"/>

                                            <TextBlock Text="total registered" FontFamily="Segoe UI" FontSize="10.5"

                                                       Foreground="#E8C5D1" VerticalAlignment="Bottom" Margin="6,0,0,4"/>

                                        </StackPanel>

                                        <Border x:Name="TipDeltaPill" CornerRadius="4" Padding="6,2" Margin="0,4,0,0">

                                            <TextBlock x:Name="TipDelta" FontFamily="Segoe UI" FontSize="10.5"

                                                       FontWeight="SemiBold"/>

                                        </Border>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Grid>

                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="18" Padding="18,14"

                            BorderBrush="#E8B04A" BorderThickness="1" UseLayoutRounding="True" SnapsToDevicePixels="True">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" Background="#FDEBC8" CornerRadius="12" Margin="0,0,14,0">

                                <Path Data="M6,2H18V8H18V8L14,12L18,16V16H18V22H6V16H6V16L10,12L6,8V8H6V2M16,16.5L12,12.5L8,16.5V20H16V16.5M12,11.5L16,7.5V4H8V7.5L12,11.5M10,6H14V6.75L12,8.75L10,6.75V6Z"

                                      Fill="#E8960C" Stretch="Uniform" Width="16" Height="16"/>

                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <TextBlock Text="Expiring this month"

                                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#2A1B21"/>

                                <TextBlock Text="{Binding ExpiringThisMonthCount}"

                                           FontFamily="Segoe UI" FontSize="12" Foreground="#8E6F7B" Margin="0,3,0,0"/>

                            </StackPanel>

                            <Button Grid.Column="2" Cursor="Hand" Click="ReviewExpiring_Click" VerticalAlignment="Center">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="Bg" Background="#E8960C" CornerRadius="12" Padding="18,10">

                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="Bg" Property="Background" Value="#CF8209"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                                <TextBlock Text="Review expiring records" FontFamily="Segoe UI" FontSize="12.5"

                                           FontWeight="SemiBold" Foreground="White"/>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

                <Grid Grid.Row="1" Grid.Column="2">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="20"

                            BorderBrush="#702943" BorderThickness="1.5" Effect="{StaticResource CardShadow}">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,16,18,8">

                                <TextBlock Text="Recent activity"

                                           FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="Bold" Foreground="#702943"/>

                                <Button Click="ViewAllLogs_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <ContentPresenter/>

                                        </ControlTemplate>

                                    </Button.Template>

                                    <TextBlock Text="Audit logs" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"

                                               Foreground="#8E5A70"/>

                                </Button>

                            </Grid>

                            <Grid Grid.Row="1">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"

                                              HorizontalScrollBarVisibility="Disabled" Padding="10,6,10,0"

                                              Visibility="{Binding HasRecentLogs, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <ItemsControl ItemsSource="{Binding RecentLogs}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border CornerRadius="12" Padding="6,8" Margin="0,0,0,2"

                                                    Cursor="Hand" ToolTip="{Binding TargetTooltip}">

                                                <Border.InputBindings>

                                                    <MouseBinding MouseAction="LeftClick"

                                                                  Command="{Binding DataContext.SelectLogCommand,

                                                                            RelativeSource={RelativeSource AncestorType=Page}}"

                                                                  CommandParameter="{Binding}"/>

                                                </Border.InputBindings>

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background" Value="Transparent"/>

                                                        <Style.Triggers>

                                                            <Trigger Property="IsMouseOver" Value="True">

                                                                <Setter Property="Background" Value="#FDF3F6"/>

                                                            </Trigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="36"/>

                                                        <ColumnDefinition Width="*"/>

                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="36" Height="36" VerticalAlignment="Center">

                                                        <Border CornerRadius="12" Background="{Binding DotColorBrush}" Opacity="0.16"/>

                                                        <Viewbox Width="15" Height="15"

                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">

                                                            <Path Data="{Binding DotIcon}" Fill="{Binding DotColorBrush}" Stretch="Uniform"/>

                                                        </Viewbox>

                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding ActionTitle, Mode=OneWay}"

                                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"

                                                                   Foreground="#2A1B21" TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock FontFamily="Segoe UI" FontSize="11.5" Foreground="#8E6F7B"

                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis">

                                                            <Run Text="{Binding PerformedByDisplay, Mode=OneWay}"/>

                                                            <Run Text=" · "/>

                                                            <Run Text="{Binding DateDisplay, Mode=OneWay}"/>

                                                        </TextBlock>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"

                                            Visibility="{Binding HasRecentLogs, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                                    <TextBlock Text="No recent activity found"

                                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"

                                               Foreground="#8E6F7B" HorizontalAlignment="Center"/>

                                    <TextBlock Text="Your actions will appear here as you work."

                                               FontFamily="Segoe UI" FontSize="11"

                                               Foreground="#B09DA5" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                            <Border Grid.Row="2" Padding="16,12,16,16">

                                <Button Click="ViewAllLogs_Click" Cursor="Hand" HorizontalAlignment="Stretch">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="Bg" Background="#702943" CornerRadius="20" Padding="0,12">

                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                    <TextBlock Text="View all logs" FontFamily="Segoe UI" FontSize="13.5" FontWeight="SemiBold" Foreground="White"/>

                                </Button>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </ScrollViewer>

        <Grid x:Name="OverlayRoot" Visibility="Collapsed" Panel.ZIndex="999">

            <Rectangle Fill="{DynamicResource ModalOverlayBrush}"/>

            <local:ViewAllLogsOverlay x:Name="LogsOverlay"

                                      HorizontalAlignment="Stretch"

                                      VerticalAlignment="Stretch"

                                      Margin="60,40,60,40"

                                      CloseRequested="LogsOverlay_CloseRequested"/>

        </Grid>

        <Grid Visibility="{Binding IsLogDetailVisible,

                            Converter={StaticResource BoolToVisibilityConverter}}">

            <Rectangle Fill="{DynamicResource ModalOverlayBrush}" Cursor="Arrow">

                <Rectangle.InputBindings>

                    <MouseBinding MouseAction="LeftClick"

                                  Command="{Binding CloseLogDetailCommand}"/>

                </Rectangle.InputBindings>

            </Rectangle>

            <Border Background="White" CornerRadius="16" Padding="32,28"

                    Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"

                    MaxHeight="650">

                <Border.Effect>

                    <DropShadowEffect Color="#000000" BlurRadius="32"

                                      ShadowDepth="4" Opacity="0.22" Direction="270"/>

                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto"

                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel DataContext="{Binding SelectedLog}">

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Log Detail"

                                       FontFamily="Segoe UI" FontSize="17"

                                       FontWeight="Bold" Foreground="#702943"

                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Width="32" Height="32" Cursor="Hand"

                                    Command="{Binding DataContext.CloseLogDetailCommand,

                                              RelativeSource={RelativeSource AncestorType=Page}}">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="16">

                                            <TextBlock Text="✕" FontSize="14" Foreground="#702943"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="Bg" Property="Background" Value="#F5E8EC"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">

                            <Border CornerRadius="8" Padding="12,5" Margin="0,0,10,0" Background="{Binding DotColorBrush}">

                                <TextBlock Text="{Binding ActionLabel}"

                                           FontFamily="Segoe UI" FontSize="13"

                                           FontWeight="Bold" Foreground="White"/>

                            </Border>

                            <TextBlock Text="{Binding RecordName}"

                                       FontFamily="Segoe UI" FontSize="15"

                                       FontWeight="Bold" Foreground="#1A1A1A"

                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E4E4" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Performed by"

                                       FontFamily="Segoe UI" FontSize="12"

                                       FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">

                                <TextBlock Text="{Binding PerformedByDisplay}"

                                           FontFamily="Segoe UI" FontSize="13"

                                           FontWeight="Normal" Foreground="#1A1A1A"

                                           VerticalAlignment="Center"/>

                                <Border CornerRadius="5" Background="#F0E8EC"

                                        Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding PerformedByRole}"

                                               FontFamily="Segoe UI" FontSize="10"

                                               FontWeight="SemiBold" Foreground="#702943"/>

                                </Border>

                            </StackPanel>

                        </Grid>

                        <Grid Margin="0,0,0,10"

                              Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Target"

                                       FontFamily="Segoe UI" FontSize="12"

                                       FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Vertical">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding TargetDisplay}"

                                               FontFamily="Segoe UI" FontSize="13"

                                               FontWeight="Normal" Foreground="#1A1A1A"

                                               VerticalAlignment="Center"/>

                                    <Border CornerRadius="5" Background="#EEF2FF"

                                            Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"

                                            Visibility="{Binding HasTargetType, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <TextBlock Text="{Binding TargetType}"

                                                   FontFamily="Segoe UI" FontSize="10"

                                                   FontWeight="SemiBold" Foreground="#4F46E5"/>

                                    </Border>

                                </StackPanel>

                                <TextBlock Text="{Binding TargetIdDisplay, StringFormat='ID: {0}'}"

                                           FontFamily="Segoe UI" FontSize="12" Foreground="#666666" Margin="0,2,0,0"

                                           Visibility="{Binding HasTargetId, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            </StackPanel>

                        </Grid>

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Status"

                                       FontFamily="Segoe UI" FontSize="12"

                                       FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                            <Border Grid.Column="1" CornerRadius="6" Padding="10,4"

                                    HorizontalAlignment="Left">

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter Property="Background" Value="#E8F5E9"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Status}" Value="FAILED">

                                                <Setter Property="Background" Value="#FFE8E8"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status}" Value="FAILURE">

                                                <Setter Property="Background" Value="#FFE8E8"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>

                                <TextBlock Text="{Binding Status}"

                                           FontFamily="Segoe UI" FontSize="12"

                                           FontWeight="SemiBold">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="#27AE60"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Status}" Value="FAILED">

                                                    <Setter Property="Foreground" Value="#DC3545"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="FAILURE">

                                                    <Setter Property="Foreground" Value="#DC3545"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Border>

                        </Grid>

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="IP Address"

                                       FontFamily="Segoe UI" FontSize="12"

                                       FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}"

                                       FontFamily="Consolas" FontSize="12"

                                       Foreground="#444444" TextWrapping="Wrap"

                                       VerticalAlignment="Center"/>

                        </Grid>

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Timestamp"

                                       FontFamily="Segoe UI" FontSize="12"

                                       FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding TimestampFormatted}"

                                       FontFamily="Segoe UI" FontSize="13"

                                       FontWeight="Normal" Foreground="#1A1A1A"

                                       VerticalAlignment="Center"/>

                        </Grid>

                        <Border Background="#FDF5F7" CornerRadius="12" Padding="16,14" Margin="0,4,0,4">

                            <StackPanel>

                                <TextBlock Text="CHANGES RECORDED"

                                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"

                                           Foreground="#9B3060" Margin="0,0,0,10"/>

                                <StackPanel Visibility="{Binding HasChangeDetail,

                                                         Converter={StaticResource BoolToVisibilityConverter}}">

                                    <Grid Margin="0,0,0,6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Field"

                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"

                                                   Foreground="#9B3060" Padding="6,0,0,0"/>

                                        <TextBlock Grid.Column="1" Text="Previous Value"

                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"

                                                   Foreground="#9B3060" Padding="4,0,0,0"/>

                                        <TextBlock Grid.Column="2" Text="New / Current Value"

                                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"

                                                   Foreground="#9B3060" Padding="4,0,0,0"/>

                                    </Grid>

                                    <Rectangle Height="1" Fill="#E8D4DC" Margin="0,0,0,6"/>

                                    <ItemsControl ItemsSource="{Binding Changes}"

                                                  Visibility="{Binding Changes.Count,

                                                               Converter={StaticResource BoolToVisibilityConverter}}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Grid Margin="0,0,0,4" MinHeight="32">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="*"/>

                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="White"

                                                            CornerRadius="6" Padding="6,5" Margin="0,0,3,0">

                                                        <TextBlock Text="{Binding DisplayFieldName}"

                                                                   FontFamily="Segoe UI" FontSize="11"

                                                                   FontWeight="SemiBold" Foreground="#1A1A1A"

                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>

                                                    </Border>

                                                    <Border Grid.Column="1" Background="#FFE8E8"

                                                            CornerRadius="6" Padding="6,5" Margin="3,0,3,0">

                                                        <TextBlock Text="{Binding DisplayOldValue, TargetNullValue='—', FallbackValue='—'}"

                                                                   FontFamily="Segoe UI" FontSize="11"

                                                                   Foreground="#DC3545" TextWrapping="Wrap"

                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                    <Border Grid.Column="2" Background="#E8F5E9"

                                                            CornerRadius="6" Padding="6,5" Margin="3,0,0,0">

                                                        <TextBlock Text="{Binding DisplayNewValue, TargetNullValue='—', FallbackValue='—'}"

                                                                   FontFamily="Segoe UI" FontSize="11"

                                                                   FontWeight="SemiBold" Foreground="#27AE60"

                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <Grid Visibility="{Binding Changes.Count,

                                                       Converter={StaticResource InverseBoolToVisibilityConverter}}"

                                          MinHeight="32">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="White"

                                                CornerRadius="6" Padding="6,5" Margin="0,0,3,0">

                                            <TextBlock Text="{Binding DisplayFieldChanged, TargetNullValue='—'}"

                                                       FontFamily="Segoe UI" FontSize="11"

                                                       FontWeight="SemiBold" Foreground="#1A1A1A"

                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>

                                        </Border>

                                        <Border Grid.Column="1" Background="#FFE8E8"

                                                CornerRadius="6" Padding="6,5" Margin="3,0,3,0">

                                            <TextBlock Text="{Binding DisplayOldValue, TargetNullValue='—'}"

                                                       FontFamily="Segoe UI" FontSize="11"

                                                       Foreground="#DC3545" TextWrapping="Wrap"

                                                       VerticalAlignment="Center"/>

                                        </Border>

                                        <Border Grid.Column="2" Background="#E8F5E9"

                                                CornerRadius="6" Padding="6,5" Margin="3,0,0,0">

                                            <TextBlock Text="{Binding DisplayNewValue, TargetNullValue='—'}"

                                                       FontFamily="Segoe UI" FontSize="11"

                                                       FontWeight="SemiBold" Foreground="#27AE60"

                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>

                                        </Border>

                                    </Grid>

                                </StackPanel>

                                <Border Visibility="{Binding HasChangeDetail,

                                                      Converter={StaticResource InverseBoolToVisibilityConverter}}"

                                        Background="White" CornerRadius="6" Padding="12,10">

                                    <TextBlock Text="No field-level changes recorded for this action."

                                               FontFamily="Segoe UI" FontSize="11"

                                               Foreground="#888888" TextWrapping="Wrap"

                                               HorizontalAlignment="Center"/>

                                </Border>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

        <components:LoaderOverlay Grid.RowSpan="99" Grid.ColumnSpan="99"

                                   x:Name="DashboardLoadingOverlay"

                                   BlurTarget="{Binding ElementName=DashboardScroll}"

                                   Message="Loading dashboard..."

                                   Panel.ZIndex="9999"/>

    </Grid>

</Page>