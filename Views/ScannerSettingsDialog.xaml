<Window x:Class="SOLUM_UI.ScannerSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="540" Height="500"
        ShowInTaskbar="False">

    <Border Background="#66000000">
        <Border Background="White" CornerRadius="16" Width="500"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#702943" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#FDFBFC" CornerRadius="16,16,0,0" Padding="24,20" BorderBrush="#EFE6E9" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Scanner Configuration" FontSize="18" FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Configure hardware device, resolution, and scan preferences" FontSize="12" Foreground="#888888" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="28" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                                        <TextBlock Text="&#x2715;" FontSize="13" Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Settings Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                    <StackPanel>
                        <!-- Device Selection -->
                        <TextBlock Text="Active Scanner Device" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDevices" Grid.Column="0" Height="36" VerticalContentAlignment="Center"
                                      Padding="10,0" FontSize="12" BorderBrush="#D0B8C0" Background="White"/>
                            <Button Grid.Column="2" Content="Refresh Devices" Height="36" Padding="12,0"
                                    Background="#F6F0F2" Foreground="#702943" BorderBrush="#D0B8C0" BorderThickness="1"
                                    FontWeight="SemiBold" FontSize="11" Cursor="Hand" Click="BtnRefreshDevices_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="TxtDeviceStatus" Text="Detecting devices..." FontSize="11" Foreground="#666666" Margin="0,-10,0,16"/>

                        <!-- Resolution (DPI) -->
                        <TextBlock Text="Resolution (DPI)" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                        <TextBlock Text="Higher DPI gives sharper text recognition; lower DPI scans faster." FontSize="11" Foreground="#888888" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 300 DPI -->
                            <RadioButton x:Name="Rb300Dpi" Grid.Column="0" GroupName="DpiGroup" IsChecked="True" Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5" CornerRadius="8" Padding="10,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="300 DPI" FontWeight="Bold" FontSize="13" Foreground="#702943" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Recommended" FontSize="10" Foreground="#27AE60" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <TextBlock Text="Highest OCR accuracy" FontSize="9" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF6F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 200 DPI -->
                            <RadioButton x:Name="Rb200Dpi" Grid.Column="2" GroupName="DpiGroup" Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5" CornerRadius="8" Padding="10,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="200 DPI" FontWeight="Bold" FontSize="13" Foreground="#333333" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Balanced" FontSize="10" Foreground="#2980B9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <TextBlock Text="Fast ~4s scan" FontSize="9" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF6F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 150 DPI -->
                            <RadioButton x:Name="Rb150Dpi" Grid.Column="4" GroupName="DpiGroup" Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5" CornerRadius="8" Padding="10,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="150 DPI" FontWeight="Bold" FontSize="13" Foreground="#333333" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Draft" FontSize="10" Foreground="#7F8C8D" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <TextBlock Text="Quick scan ~2s" FontSize="9" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF6F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>

                        <!-- Color Mode & Paper Source -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Mode -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Color Mode" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbColorMode" Height="34" VerticalContentAlignment="Center"
                                          Padding="10,0" FontSize="12" BorderBrush="#D0B8C0" Background="White">
                                    <ComboBoxItem Content="Full Color (24-bit)" IsSelected="True"/>
                                    <ComboBoxItem Content="Grayscale (8-bit)"/>
                                    <ComboBoxItem Content="Black and White (1-bit)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Paper Source -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Paper Source" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbPaperSource" Height="34" VerticalContentAlignment="Center"
                                          Padding="10,0" FontSize="12" BorderBrush="#D0B8C0" Background="White">
                                    <ComboBoxItem Content="Flatbed Glass" IsSelected="True"/>
                                    <ComboBoxItem Content="Document Feeder (ADF)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="#FDFBFC" CornerRadius="0,0,16,16" Padding="24,16" BorderBrush="#EFE6E9" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="38"
                                Background="White" BorderBrush="#D0B8C0" BorderThickness="1"
                                Foreground="#555555" FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                                Click="BtnCancel_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="Save Settings" Height="38"
                                Background="#702943" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" FontSize="12" Cursor="Hand"
                                Click="BtnSave_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
