<Window x:Class="SOLUM_UI.ScannerSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <Style x:Key="PillOutline" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FBF3F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3E3E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillPrimary" TargetType="Button" BasedOn="{StaticResource PillOutline}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A1F35"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A1F35"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#491829"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#491829"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCircle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="34" Height="34">
                            <Ellipse x:Name="Ring" Width="34" Height="34" Fill="White"
                                     Stroke="#E2C6CE" StrokeThickness="1.5"
                                     SnapsToDevicePixels="True"/>
                            <Path x:Name="Cross" Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="#8A6B75" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="#FBF3F5"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#702943"/>
                                <Setter TargetName="Cross" Property="Stroke" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2B1B20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2C6CE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" SnapsToDevicePixels="True">
                                <Grid Margin="12,0,32,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#B9A0A8" FontSize="13"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,14,0" Data="M0,0 L5,5 L10,0"
                                  Stroke="#702943" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="10" Height="5" Stretch="None"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="12" BorderBrush="#E2C6CE"
                                        BorderThickness="1.5" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,4,0,8" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="2" Opacity="0.14" RenderingBias="Quality"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#C79AA8"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,9"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#2B1B20"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="4,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FBF3F5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F3E3E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    <Border x:Name="BackdropBorder" Background="{DynamicResource ModalOverlayBrush}" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border x:Name="DialogShell" Background="White" CornerRadius="24" Width="540"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#702943" BorderThickness="1.5"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DialogShellTransform"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.22" RenderingBias="Quality"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="HeaderBorder" Background="White" CornerRadius="24,24,0,0" Padding="28,24,24,8"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseMove="Header_MouseMove"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Scanner Configuration" FontSize="21" FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Configure hardware device, resolution, and scan preferences" FontSize="12.5" Foreground="#7A6068" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource CloseCircle}" Click="BtnCancel_Click"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,16">
                    <StackPanel>
                        <TextBlock Text="Active Scanner Device" FontSize="13" FontWeight="Bold" Foreground="#2B1B20" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDevices" Grid.Column="0" Style="{StaticResource FormCombo}"/>
                            <Button Grid.Column="2" Content="Refresh Devices" Style="{StaticResource PillOutline}" Click="BtnRefreshDevices_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtDeviceStatus" Text="Detecting devices..." FontSize="12" Foreground="#7A6068" Margin="0,-8,0,22" TextWrapping="Wrap"/>
                        <TextBlock Text="Resolution (DPI)" FontSize="13" FontWeight="Bold" Foreground="#2B1B20" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="Rb200Dpi" Grid.Column="0" GroupName="DpiGroup" IsChecked="True" Cursor="Hand" Focusable="False">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#E2C6CE" BorderThickness="2" CornerRadius="16" Padding="14,16" SnapsToDevicePixels="True">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="200 DPI" FontWeight="Bold" FontSize="15" Foreground="#702943" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Recommended" FontSize="11.5" Foreground="#1F7A47" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#C79AA8"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF3F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="Rb300Dpi" Grid.Column="2" GroupName="DpiGroup" Cursor="Hand" Focusable="False">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#E2C6CE" BorderThickness="2" CornerRadius="16" Padding="14,16" SnapsToDevicePixels="True">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="Title" Text="300 DPI" FontWeight="Bold" FontSize="15" Foreground="#2B1B20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="High Detail" FontSize="11.5" Foreground="#7A6068" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#C79AA8"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF3F5"/>
                                                <Setter TargetName="Title" Property="Foreground" Value="#702943"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Color Mode" FontSize="13" FontWeight="Bold" Foreground="#2B1B20" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbColorMode" Style="{StaticResource FormCombo}">
                                    <ComboBoxItem Content="Full Color (24-bit)" IsSelected="True"/>
                                    <ComboBoxItem Content="Grayscale (8-bit) - Recommended"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Paper Source" FontSize="13" FontWeight="Bold" Foreground="#2B1B20" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbPaperSource" Style="{StaticResource FormCombo}">
                                    <ComboBoxItem Content="Flatbed Glass" IsSelected="True"/>
                                    <ComboBoxItem Content="Document Feeder (ADF)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="White" CornerRadius="0,0,24,24" Padding="28,12,28,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource PillOutline}" Click="BtnCancel_Click"/>
                        <Button Grid.Column="2" Content="Save Settings" Style="{StaticResource PillPrimary}" Click="BtnSave_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
