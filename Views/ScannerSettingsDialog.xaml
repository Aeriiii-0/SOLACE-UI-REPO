<Window x:Class="SOLUM_UI.ScannerSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- FormCombo: Adapted from RecordDialog.xaml for polished, responsive dropdowns -->
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#BBBBBB" FontSize="12"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="11" Height="11"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="8" BorderBrush="#C0A0AA"
                                        BorderThickness="1.2" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.10" RenderingBias="Performance"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="ComboBg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="#222222"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border x:Name="BackdropBorder" Background="#66000000" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border x:Name="DialogShell" Background="White" CornerRadius="16" Width="500"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#702943" BorderThickness="1.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DialogShellTransform"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.18" RenderingBias="Performance"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (Draggable) -->
                <Border Grid.Row="0" x:Name="HeaderBorder" Background="#FDFBFC" CornerRadius="16,16,0,0" Padding="24,18"
                        BorderBrush="#EFE6E9" BorderThickness="0,0,0,1" Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseMove="Header_MouseMove"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Scanner Configuration" FontSize="18" FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Configure hardware device, resolution, and scan preferences" FontSize="12" Foreground="#888888" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="28" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                                        <TextBlock Text="&#x2715;" FontSize="13" Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Settings Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                    <StackPanel>
                        <!-- Device Selection -->
                        <TextBlock Text="Active Scanner Device" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDevices" Grid.Column="0" Style="{StaticResource FormCombo}"/>
                            <Button Grid.Column="2" Content="Refresh Devices" Height="38" Padding="14,0"
                                    Background="#F6F0F2" Foreground="#702943" BorderBrush="#C0A0AA" BorderThickness="1.2"
                                    FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Click="BtnRefreshDevices_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="TxtDeviceStatus" Text="Detecting devices..." FontSize="11" Foreground="#666666" Margin="0,-10,0,18"/>

                        <!-- Resolution (DPI) -->
                        <TextBlock Text="Resolution (DPI)" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 200 DPI (Recommended) -->
                            <RadioButton x:Name="Rb200Dpi" Grid.Column="0" GroupName="DpiGroup" IsChecked="True" Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5" CornerRadius="8" Padding="14,14">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="200 DPI" FontWeight="Bold" FontSize="14" Foreground="#702943" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Recommended" FontSize="11" Foreground="#27AE60" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF6F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 300 DPI (High Detail) -->
                            <RadioButton x:Name="Rb300Dpi" Grid.Column="2" GroupName="DpiGroup" Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5" CornerRadius="8" Padding="14,14">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="300 DPI" FontWeight="Bold" FontSize="14" Foreground="#333333" HorizontalAlignment="Center"/>
                                                <TextBlock Text="High Detail" FontSize="11" Foreground="#2980B9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FBF6F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>

                        <!-- Color Mode & Paper Source -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Mode -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Color Mode" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbColorMode" Style="{StaticResource FormCombo}">
                                    <ComboBoxItem Content="Full Color (24-bit)" IsSelected="True"/>
                                    <ComboBoxItem Content="Grayscale (8-bit) - Recommended"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Paper Source -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Paper Source" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbPaperSource" Style="{StaticResource FormCombo}">
                                    <ComboBoxItem Content="Flatbed Glass" IsSelected="True"/>
                                    <ComboBoxItem Content="Document Feeder (ADF)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="#FDFBFC" CornerRadius="0,0,16,16" Padding="24,16" BorderBrush="#EFE6E9" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="38"
                                Background="White" BorderBrush="#D0B8C0" BorderThickness="1"
                                Foreground="#555555" FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                                Click="BtnCancel_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="Save Settings" Height="38"
                                Background="#702943" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" FontSize="12" Cursor="Hand"
                                Click="BtnSave_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
