<Page x:Class="SOLUM_UI.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Profile"
      Background="#FFFFFF">
    <Page.Resources>

        <!-- ═══ Colors ═══ -->
        <SolidColorBrush x:Key="Maroon" Color="#702943"/>
        <SolidColorBrush x:Key="MaroonBorder" Color="#702943"/>
        <SolidColorBrush x:Key="RoseTint" Color="#F4E8EC"/>
        <SolidColorBrush x:Key="MutedText" Color="#8B7480"/>
        <SolidColorBrush x:Key="InkText" Color="#2B1A22"/>

        <!-- ═══ Card (maroon border) ═══ -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaroonBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="32,28"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- ═══ Text styles ═══ -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkText}"/>
        </Style>

        <!-- ═══ Icon chip (soft rose, maroon icon) ═══ -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource RoseTint}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipIcon" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource Maroon}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Stat tile (hero) ═══ -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#702943"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatIconBox" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource Maroon}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StatIcon" TargetType="Path">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ═══ Inputs ═══ -->
        <Style x:Key="FormInputPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#D4A0B0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Buttons (pill) ═══ -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#702943" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#702943"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,32">

            <!-- ═══════════════ HERO CARD ═══════════════ -->
            <Grid x:Name="HeroCard" Height="160" Margin="0,0,0,20">
                <!-- Background with decorative circles (lowest layer) -->
                <Border x:Name="HeroCardBg" Background="#F4E8EC" CornerRadius="22" Panel.ZIndex="0" ClipToBounds="True" SizeChanged="RoundedClip_SizeChanged">
                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="384" Height="384" Fill="#ECD7DF" Canvas.Right="-88" Canvas.Top="-152"/>
                        <Ellipse Width="240" Height="240" Fill="#E8D0DA" Canvas.Right="120" Canvas.Bottom="-120"/>
                        <Ellipse Width="120" Height="120" Fill="#EFDDE4" Canvas.Left="552" Canvas.Top="-56"/>
                    </Canvas>
                </Border>

                <!-- Content (middle layer) -->
                <Grid Margin="28,0" Panel.ZIndex="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar (white ring) -->
                        <Border Grid.Column="0" Width="110" Height="110" CornerRadius="55" Background="White"
                                Margin="0,0,24,0" VerticalAlignment="Center">
                            <Border Width="98" Height="98" CornerRadius="49" Background="{StaticResource Maroon}">
                                <TextBlock x:Name="TxtInitial" Text="U"
                                           FontFamily="Segoe UI" FontSize="40" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <!-- Name, email, pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDisplayName" Text=""
                                       FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource InkText}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtDisplayEmail" Text=""
                                       FontFamily="Segoe UI" FontSize="13" Foreground="#7D5F6C" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource Maroon}" CornerRadius="15" Height="28" Padding="14,0" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtDisplayRole" Text=""
                                               FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#D9F2E3" CornerRadius="15" Height="28" Padding="14,0">
                                    <TextBlock Text="ACTIVE" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                               Foreground="#1A7C44" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Stat tiles -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Scope -->
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <Border Style="{StaticResource StatIconBox}">
                                        <Path Style="{StaticResource StatIcon}"
                                              Data="M15,19L9,16.89V5L15,7.11M20.5,3C20.44,3 20.39,3 20.34,3L15,5.1L9,3L3.36,4.9C3.15,4.97 3,5.15 3,5.38V20.5A0.5,0.5 0 0,0 3.5,21C3.55,21 3.61,21 3.66,21L9,18.9L15,21L20.64,19.1C20.85,19 21,18.85 21,18.62V3.5A0.5,0.5 0 0,0 20.5,3Z"/>
                                    </Border>
                                    <TextBlock Text="SCOPE" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TxtScope" Text="All barangays" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <!-- Session -->
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <Border Style="{StaticResource StatIconBox}">
                                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="White" StrokeThickness="2.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M3,12 L7,12 L9.5,5 L14,19 L16.5,12 L21,12"/>
                                    </Border>
                                    <TextBlock Text="SESSION" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="Active now" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <!-- Environment -->
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <Border Style="{StaticResource StatIconBox}">
                                        <Path Style="{StaticResource StatIcon}"
                                              Data="M4,1H20A1,1 0 0,1 21,2V6A1,1 0 0,1 20,7H4A1,1 0 0,1 3,6V2A1,1 0 0,1 4,1M4,9H20A1,1 0 0,1 21,10V14A1,1 0 0,1 20,15H4A1,1 0 0,1 3,14V10A1,1 0 0,1 4,9M4,17H20A1,1 0 0,1 21,18V22A1,1 0 0,1 20,23H4A1,1 0 0,1 3,22V18A1,1 0 0,1 4,17M9,5H10V3H9V5M9,13H10V11H9V13M9,21H10V19H9V21M5,3V5H7V3H5M5,11V13H7V11H5M5,19V21H7V19H5Z"/>
                                    </Border>
                                    <TextBlock Text="ENVIRONMENT" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="Production" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                <!-- Border overlay (top layer) -->
                <Border BorderBrush="{StaticResource MaroonBorder}" BorderThickness="1.5" 
                        CornerRadius="22" Background="Transparent" Panel.ZIndex="2"
                        IsHitTestVisible="False"/>
            </Grid>

            <!-- ═══════════════ TWO COLUMN LAYOUT ═══════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── Left: Account Details ───────── -->
                <Border x:Name="AccountDetailsCard" Grid.Column="0" Style="{StaticResource SectionCard}"
                        VerticalAlignment="Top" MinHeight="392">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Title and Edit Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Account details" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            
                            <!-- Edit Profile Button -->
                            <Button x:Name="BtnEditProfile" Grid.Column="1" Height="32" Padding="16,0" 
                                    Cursor="Hand" Click="BtnEditProfile_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{StaticResource RoseTint}" CornerRadius="16"
                                                BorderBrush="{StaticResource Maroon}" BorderThickness="1.2"
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Fill="{StaticResource Maroon}" Stretch="Uniform" 
                                                      Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Edit" FontFamily="Segoe UI" FontSize="11.5" 
                                                           FontWeight="SemiBold" Foreground="{StaticResource Maroon}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#ECD7DF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Full name -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource ChipIcon}"
                                      Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtFullName" Text="Not set" Style="{StaticResource FieldValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Role -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource ChipIcon}"
                                      Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,11.99H19C18.47,16.11 15.72,19.78 12,20.93V12H5V6.3L12,3.19V11.99Z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtRole" Text="" Style="{StaticResource FieldValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Contact number -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource ChipIcon}"
                                      Data="M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Contact number" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtContactNumber" Text="—" Style="{StaticResource FieldValue}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Assigned barangay -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource ChipIcon}"
                                      Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Assigned barangay" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtBarangay" Text="" Style="{StaticResource FieldValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ───────── Right: Password & Session Info ───────── -->
                <StackPanel Grid.Column="2">

                    <!-- Password -->
                    <Border x:Name="PasswordCard" Style="{StaticResource SectionCard}" Padding="0" SizeChanged="PasswordCard_SizeChanged">
                        <Grid>
                            <!-- Background circle (behind content) -->
                            <Border x:Name="PasswordCardBg" Background="Transparent" CornerRadius="20.5" Panel.ZIndex="0" ClipToBounds="True" SizeChanged="RoundedClip_SizeChanged">
                                <Canvas IsHitTestVisible="False">
                                    <Ellipse Width="168" Height="168" Fill="#F4E8EC" Canvas.Right="-40" Canvas.Top="-48"/>
                                </Canvas>
                            </Border>
                            
                            <!-- Content -->
                            <StackPanel Margin="32,28" Panel.ZIndex="1">
                                <TextBlock Text="Password" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                                <!-- Change Password Button (visible by default) -->
                                <StackPanel x:Name="ChangePasswordButtonPanel">
                                    <TextBlock Text="Update your password to keep your account secure."
                                               FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                                    <Button x:Name="BtnChangePassword" Style="{StaticResource PrimaryBtn}"
                                            Width="170" HorizontalAlignment="Left" Click="BtnChangePassword_Click">
                                        <TextBlock Text="Change password" FontFamily="Segoe UI" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </Button>
                                </StackPanel>

                                <!-- Change Password Form (hidden by default) -->
                                <StackPanel x:Name="ChangePasswordFormPanel" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Current Password *" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="PwdCurrentPassword" Style="{StaticResource FormInputPassword}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ErrCurrentPassword" Text=""
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#DC3545"
                                               Margin="0,0,0,16" Visibility="Collapsed"/>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="New Password *" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="PwdNewPassword" Style="{StaticResource FormInputPassword}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ErrNewPassword" Text=""
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#DC3545"
                                               Margin="0,0,0,16" Visibility="Collapsed"/>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Confirm Password *" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="PwdConfirmPassword" Style="{StaticResource FormInputPassword}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ErrConfirmPassword" Text=""
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#DC3545"
                                               Margin="0,0,0,20" Visibility="Collapsed"/>
                                    <Border x:Name="ChangePasswordSuccessBanner" Visibility="Collapsed"
                                            Background="#E8F5E9" CornerRadius="12" BorderBrush="#A8D5B0"
                                            BorderThickness="1" Padding="16,12" Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                                  Fill="#27AE60" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="TxtChangePasswordSuccess"
                                                       Text="Password changed successfully!"
                                                       FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#1E7E34" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                                        <Button x:Name="BtnCancelChangePassword" Style="{StaticResource PrimaryBtn}"
                                                Background="#FFFFFF" Margin="0,0,10,0" Click="BtnCancelChangePassword_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="White" CornerRadius="22"
                                                            BorderBrush="#702943" BorderThickness="1.5"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#FDF5F7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#702943"/>
                                        </Button>
                                        <Button x:Name="BtnSaveChangePassword" Style="{StaticResource PrimaryBtn}"
                                                Click="BtnSaveChangePassword_Click">
                                            <TextBlock Text="Save" FontFamily="Segoe UI" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Session Info -->
                    <Border x:Name="SessionInfoCard" Style="{StaticResource SectionCard}" SizeChanged="SessionInfoCard_SizeChanged">
                        <StackPanel>
                            <TextBlock Text="Session info" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                            <!-- Session started -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Style="{StaticResource IconChip}">
                                    <Path Style="{StaticResource ChipIcon}"
                                          Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Session started" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtSessionStart" Text="" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Last activity -->
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconChip}">
                                    <Path Style="{StaticResource ChipIcon}"
                                          Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12.5,7H11V13L16.25,16.15L17.02,14.92L12.5,12.11V7Z"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Last activity" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtLastActivity" Text="Just now" Style="{StaticResource FieldValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
