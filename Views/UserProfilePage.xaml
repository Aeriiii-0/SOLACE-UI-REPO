<Page x:Class="SOLUM_UI.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Profile"
      Background="#FFFFFF">

    <Page.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E8D4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="28,24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#D4A0B0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormInputPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#D4A0B0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#702943" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,32">

            <!-- Header: User Info Card -->
            <Border Background="#F5E8EC" CornerRadius="16" Padding="28,28" Margin="0,0,0,28" BorderBrush="#E8D4DA" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Circle -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="#702943" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtInitial" Text="U"
                                   FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- User Info: Name, Email, Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDisplayName" Text="Full name not set"
                                   FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtDisplayEmail" Text="anycaraliman@gmail.com"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#888888" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#702943" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtDisplayRole" Text="ENCODER"
                                           FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Ellipse Width="8" Height="8" Fill="#27AE60" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVE" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#27AE60"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Scope info -->
                    <StackPanel Grid.Column="2" Margin="20,0,20,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12.5,7H11V13L16.25,16.15L17.02,14.92L12.5,12.11V7Z"
                                  Fill="#888888" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SCOPE" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="All barangays" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Session info -->
                    <StackPanel Grid.Column="3">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12.5,7H11V13L16.25,16.15L17.02,14.92L12.5,12.11V7Z"
                                  Fill="#888888" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SESSION" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="Active now" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Two Column Layout -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Account Details -->
                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="4" Height="24" CornerRadius="2" Background="#702943" Margin="0,0,12,0"/>
                            <TextBlock Text="ACCOUNT DETAILS" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Full Name -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="TxtFullName" Text="Not set" Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,16"/>

                        <!-- Role -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="TxtRole" Text="ENCODER" Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,16"/>

                        <!-- Contact Number -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Contact number" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="TxtContactNumber" Text="—" Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,16"/>

                        <!-- Assigned Barangay -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Assigned barangay" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="TxtBarangay" Text="ALL BARANGAYS" Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,16"/>

                        <!-- Account Status -->
                        <StackPanel>
                            <TextBlock Text="Account status" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#702943" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ACTIVE" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Password & Session Info -->
                <StackPanel Grid.Column="2">
                    <!-- Password Section -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <!-- Section Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="4" Height="24" CornerRadius="2" Background="#702943" Margin="0,0,12,0"/>
                                <TextBlock Text="PASSWORD" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Change Password Button (Visible by default) -->
                            <StackPanel x:Name="ChangePasswordButtonPanel">
                                <TextBlock Text="Update your password to keep your account secure."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#666666"
                                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <Button x:Name="BtnChangePassword" Style="{StaticResource PrimaryBtn}"
                                        Width="160" HorizontalAlignment="Left" Click="BtnChangePassword_Click">
                                    <TextBlock Text="Change password" FontFamily="Segoe UI" FontSize="12"
                                               FontWeight="SemiBold" Foreground="White"/>
                                </Button>
                            </StackPanel>

                            <!-- Change Password Form (Hidden by default) -->
                            <StackPanel x:Name="ChangePasswordFormPanel" Visibility="Collapsed">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Current Password *" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PwdCurrentPassword" Style="{StaticResource FormInputPassword}"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrCurrentPassword" Text=""
                                           FontFamily="Segoe UI" FontSize="11" Foreground="#DC3545"
                                           Margin="0,0,0,16" Visibility="Collapsed"/>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="New Password *" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PwdNewPassword" Style="{StaticResource FormInputPassword}"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrNewPassword" Text=""
                                           FontFamily="Segoe UI" FontSize="11" Foreground="#DC3545"
                                           Margin="0,0,0,16" Visibility="Collapsed"/>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Confirm Password *" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PwdConfirmPassword" Style="{StaticResource FormInputPassword}"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrConfirmPassword" Text=""
                                           FontFamily="Segoe UI" FontSize="11" Foreground="#DC3545"
                                           Margin="0,0,0,20" Visibility="Collapsed"/>

                                <Border x:Name="ChangePasswordSuccessBanner" Visibility="Collapsed"
                                        Background="#E8F5E9" CornerRadius="8" BorderBrush="#A8D5B0"
                                        BorderThickness="1" Padding="16,12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                              Fill="#27AE60" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtChangePasswordSuccess"
                                                   Text="Password changed successfully!"
                                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1E7E34" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                    <Button x:Name="BtnCancelChangePassword" Style="{StaticResource PrimaryBtn}"
                                            Background="#FFFFFF" Margin="0,0,10,0" Click="BtnCancelChangePassword_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="White" CornerRadius="10"
                                                        BorderBrush="#D4A0B0" BorderThickness="1.5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#FDF5F7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#702943"/>
                                    </Button>
                                    <Button x:Name="BtnSaveChangePassword" Style="{StaticResource PrimaryBtn}"
                                            Click="BtnSaveChangePassword_Click">
                                        <TextBlock Text="Save" FontFamily="Segoe UI" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Session Info Section -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <!-- Section Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="4" Height="24" CornerRadius="2" Background="#702943" Margin="0,0,12,0"/>
                                <TextBlock Text="SESSION INFO" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Session Started -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Session started" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtSessionStart" Text="Oct 26, 2026 11:02 PM" Style="{StaticResource FieldValue}"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,14"/>

                            <!-- Last Activity -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Last activity" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtLastActivity" Text="Just now" Style="{StaticResource FieldValue}"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,14"/>

                            <!-- System Version -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="System version" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="SOLACE v1.0.0" Style="{StaticResource FieldValue}"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#F0E8EC" Margin="0,0,0,14"/>

                            <!-- Environment -->
                            <StackPanel>
                                <TextBlock Text="Environment" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="PRODUCTION" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#27AE60"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
