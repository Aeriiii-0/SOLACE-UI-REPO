<Window x:Class="SOLUM_UI.PreCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Record — Identity Check"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="780" Height="620"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Foreground="#111111" Background="Transparent"
                                               BorderThickness="0" Padding="12,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                            <ToggleButton x:Name="PART_Button" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="20" Height="20"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Focusable="False"
                                    IsChecked="{Binding IsOpen, ElementName=PART_Popup, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19Z"
                                              Fill="#702943" Stretch="Uniform" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Grid.Column="0" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0"
                                        BorderThickness="1" Padding="8,6" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="White"
                                              BorderThickness="0" Foreground="#222222" FontSize="13"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewRecordBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#55000000">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>

            <Border x:Name="DialogShell" Background="White" CornerRadius="18"
                    ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="740">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#702943" CornerRadius="18,18,0,0" Padding="36,24,36,24">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="#88FFFFFF" Margin="0,0,14,0">
                                        <Viewbox Width="18" Height="18">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White"
                                                      Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A4,4 0 0,0 8,10A4,4 0 0,0 12,14A4,4 0 0,0 16,10A4,4 0 0,0 12,6M12,8A2,2 0 0,1 14,10A2,2 0 0,1 12,12A2,2 0 0,1 10,10A2,2 0 0,1 12,8M6.22,18A8,8 0 0,0 12,20A8,8 0 0,0 17.78,18C16.54,16.78 14.36,16 12,16C9.64,16 7.46,16.78 6.22,18Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Identity Verification" FontSize="20" FontWeight="Bold"
                                                   Foreground="White"/>
                                        <TextBlock Text="Check for existing records before proceeding to the full form."
                                                   FontSize="12" Foreground="#FFCCD8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="32" Height="32" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBg" Background="Transparent" CornerRadius="16">
                                            <TextBlock Text="&#x2715;" FontSize="14" Foreground="#FFAACC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBg" Property="Background" Value="#44000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Form body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#F7F3F5" Padding="36,28,36,20">
                        <StackPanel>

                            <!-- Step hint -->
                            <Border Background="#FBF0F3" CornerRadius="10" Padding="16,12" Margin="0,0,0,24"
                                    BorderBrush="#EDD0DA" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="#702943" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="1" FontSize="13" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#702943"
                                                   Text="Step 1 of 2 — Identity Verification"/>
                                        <TextBlock FontSize="11" Foreground="#886677" Margin="0,2,0,0"
                                                   Text="Fill in the fields below, then click Check &amp; Continue to search for duplicates."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section label -->
                            <Border BorderBrush="#702943" BorderThickness="3,0,0,0" Padding="10,0" Margin="0,0,0,16">
                                <TextBlock Text="APPLICANT NAME" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                            </Border>

                            <!-- Name row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        Last Name <Run Text="*" Foreground="#D32F2F"/>
                                    </TextBlock>
                                    <TextBox x:Name="TxtLastName" Style="{StaticResource FormBox}"
                                             PreviewTextInput="NameOnly_PreviewTextInput"
                                             TextChanged="Name_TextChanged"/>
                                    <TextBlock x:Name="ErrLastName" Text="Last name is required." Style="{StaticResource ErrorText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        First Name <Run Text="*" Foreground="#D32F2F"/>
                                    </TextBlock>
                                    <TextBox x:Name="TxtFirstName" Style="{StaticResource FormBox}"
                                             PreviewTextInput="NameOnly_PreviewTextInput"
                                             TextChanged="Name_TextChanged"/>
                                    <TextBlock x:Name="ErrFirstName" Text="First name is required." Style="{StaticResource ErrorText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Middle Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtMiddleName" Style="{StaticResource FormBox}"
                                             PreviewTextInput="NameOnly_PreviewTextInput"
                                             TextChanged="Name_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Section label -->
                            <Border BorderBrush="#702943" BorderThickness="3,0,0,0" Padding="10,0" Margin="0,0,0,16">
                                <TextBlock Text="IDENTIFICATION &amp; DATE OF BIRTH" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                            </Border>

                            <!-- Birthdate + PhilSys row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        Birthdate <Run Text="*" Foreground="#D32F2F"/>
                                    </TextBlock>
                                    <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="8" Background="White">
                                        <DatePicker x:Name="DpBirthdate" Style="{StaticResource FormDate}"
                                                    SelectedDateChanged="Birthdate_Changed"/>
                                    </Border>
                                    <TextBlock x:Name="ErrBirthdate" Style="{StaticResource ErrorText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        PhilSys Card Number <Run Text="*" Foreground="#D32F2F"/>
                                    </TextBlock>
                                    <TextBox x:Name="TxtPhilSys" Style="{StaticResource FormBox}"
                                             PreviewTextInput="NumberOnly_PreviewTextInput"
                                             TextChanged="PhilSys_TextChanged"/>
                                    <TextBlock x:Name="ErrPhilSys" Text="PhilSys number is required (digits only)." Style="{StaticResource ErrorText}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status / result banner -->
                            <Border x:Name="BannerPanel" Visibility="Collapsed" CornerRadius="12"
                                    Padding="18,14" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                            Background="#22FFFFFF" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="BannerIcon" FontSize="17" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="BannerTitle" FontSize="14" FontWeight="Bold"
                                                   Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="BannerText" Foreground="White" FontSize="12"
                                                   TextWrapping="Wrap" Opacity="0.92"/>
                                        <Button x:Name="BtnViewRecord" Visibility="Collapsed"
                                                Content="View Existing Record" Margin="0,12,0,0"
                                                Style="{StaticResource ViewRecordBtn}"
                                                HorizontalAlignment="Left"
                                                Click="ViewRecord_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0" Padding="36,18">
                        <Grid>
                            <Button x:Name="BtnCancel" Content="Cancel"
                                    Style="{StaticResource SecondaryBtn}"
                                    HorizontalAlignment="Left" Width="120"
                                    Click="Cancel_Click"/>
                            <Button x:Name="BtnContinue"
                                    Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right" Width="220"
                                    Click="Continue_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="BtnContinueText" Text="Check &amp; Continue"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
