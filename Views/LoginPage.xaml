<Window x:Class="SOLUM_UI.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SOLUM_UI"
        xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
        mc:Ignorable="d"
        Title="Solace"
        MinHeight="420" MinWidth="680"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#FBEFF3"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="FeatureChip" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6D1F40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" SnapsToDevicePixels="True" UseLayoutRounding="True">

        <Image Source="pack://application:,,,/Assets/login.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <Viewbox Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="48,44,48,36"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True">
            <Grid Width="1360" Height="980" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/SidebarLogo.png"
                           Width="52" Height="52"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SOLACE"
                                   FontFamily="Segoe UI"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#6D1F40"/>
                        <TextBlock Text="Solo Parent Management"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   Foreground="#8A5068"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="620"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Margin="0,0,56,0">

                        <Border HorizontalAlignment="Left"
                                Background="#66FFFFFF"
                                BorderBrush="#6D1F40"
                                BorderThickness="1.2"
                                CornerRadius="22"
                                Padding="16,8"
                                Margin="0,0,0,30"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="#6D1F40" StrokeThickness="1.8"/>
                                    <Ellipse Width="6" Height="6" Fill="#6D1F40"/>
                                </Grid>
                                <TextBlock Text="Authorized Personnel Access"
                                           FontFamily="Segoe UI"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#6D1F40"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="A secure gateway to"
                                   FontFamily="Georgia"
                                   FontSize="56"
                                   FontWeight="ExtraBold"
                                   Foreground="#2B0D1A"
                                   LineHeight="66"/>
                        <TextBlock Text="solo parent records."
                                   FontFamily="Georgia"
                                   FontSize="56"
                                   FontWeight="ExtraBold"
                                   Foreground="#7A2650"
                                   LineHeight="66"
                                   Margin="0,0,0,26"/>

                        <TextBlock Text="Sign in to manage solo parent records, monitor program operations, and access beneficiary data through the unified management system of the Biñan City Social Welfare and Development Office."
                                   FontFamily="Segoe UI"
                                   FontSize="20"
                                   Foreground="#6B4256"
                                   TextWrapping="Wrap"
                                   LineHeight="32"
                                   MaxWidth="680"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,42"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource FeatureChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#F6DCE6" Margin="0,0,12,0" SnapsToDevicePixels="True">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                   Foreground="#6D1F40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Role-Based" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#2B0D1A"/>
                                        <TextBlock Text="Access" FontFamily="Segoe UI" FontSize="14" Foreground="#8A5068"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FeatureChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#F6DCE6" Margin="0,0,12,0" SnapsToDevicePixels="True">
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                   Foreground="#6D1F40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Audit" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#2B0D1A"/>
                                        <TextBlock Text="Logged" FontFamily="Segoe UI" FontSize="14" Foreground="#8A5068"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FeatureChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#F6DCE6" Margin="0,0,12,0" SnapsToDevicePixels="True">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                   Foreground="#6D1F40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Encrypted" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#2B0D1A"/>
                                        <TextBlock Text="Data" FontFamily="Segoe UI" FontSize="14" Foreground="#8A5068"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                        <Border Background="White"
                                BorderBrush="#6D1F40"
                                BorderThickness="1.5"
                                CornerRadius="22"
                                Padding="56,72,56,56"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Width="552">
                            <Border.Effect>
                                <DropShadowEffect Color="#6D1F40" BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.14" RenderingBias="Quality"/>
                            </Border.Effect>

                            <StackPanel>

                                <Grid Margin="0,0,0,44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Welcome back"
                                                   FontFamily="Georgia"
                                                   FontSize="42"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2B0D1A"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Sign in to your SOLACE account"
                                                   FontFamily="Segoe UI"
                                                   FontSize="20"
                                                   Foreground="#8A5068"
                                                   Margin="0,8,0,0"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Email"
                                           FontFamily="Segoe UI"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#2B0D1A"
                                           Margin="0,0,0,10"/>

                                <Border x:Name="BorderEmail"
                                        Background="White"
                                        BorderBrush="#6D1F40"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20,0"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Grid Height="72">
                                        <TextBlock x:Name="PlaceholderEmail"
                                                   Text="Enter your email address"
                                                   Foreground="#B08A9C"
                                                   FontFamily="Segoe UI"
                                                   FontSize="19"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                        <TextBox x:Name="TxtEmail"
                                                 FontFamily="Segoe UI"
                                                 FontSize="19"
                                                 Foreground="#2B0D1A"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 TextChanged="TxtEmail_TextChanged"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="ErrEmail"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           Foreground="#DC3545"
                                           Margin="4,5,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <TextBlock Text="Password"
                                           FontFamily="Segoe UI"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#2B0D1A"
                                           Margin="0,26,0,10"/>

                                <Border x:Name="BorderPassword"
                                        Background="White"
                                        BorderBrush="#6D1F40"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20,0,14,0"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Grid Height="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBlock x:Name="PlaceholderPassword"
                                                       Text="Enter your password"
                                                       Foreground="#B08A9C"
                                                       FontFamily="Segoe UI"
                                                       FontSize="19"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            <PasswordBox x:Name="TxtPassword"
                                                         FontFamily="Segoe UI"
                                                         FontSize="19"
                                                         Foreground="#2B0D1A"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalContentAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         PasswordChanged="TxtPassword_PasswordChanged"/>
                                            <TextBox x:Name="TxtPasswordVisible"
                                                     FontFamily="Segoe UI"
                                                     FontSize="19"
                                                     Foreground="#2B0D1A"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed"
                                                     TextChanged="TxtPasswordVisible_TextChanged"/>
                                        </Grid>
                                        <Button x:Name="BtnTogglePassword"
                                                Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Padding="10,8"
                                                Click="BtnTogglePassword_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock x:Name="TxtToggleIcon"
                                                       Text="&#xED1A;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="#6D1F40"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="ErrPassword"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           Foreground="#DC3545"
                                           Margin="4,5,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <TextBlock HorizontalAlignment="Right" Margin="0,14,0,20">
                                    <Hyperlink x:Name="LinkForgotPassword"
                                               Foreground="#7A2650"
                                               TextDecorations="None"
                                               FontFamily="Segoe UI"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Click="LinkForgotPassword_Click">Forgot password?</Hyperlink>
                                </TextBlock>

                                <Button x:Name="BtnLogin"
                                        Content="Sign in securely"
                                        Height="74"
                                        FontFamily="Segoe UI"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Margin="0,30,0,0"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True"
                                        Click="BtnLogin_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" CornerRadius="12"
                                                    BorderBrush="#4A1229" BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#8A2D58" Offset="0"/>
                                                        <GradientStop Color="#6D1F40" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Run Text="By signing in you agree to our " Foreground="#8A5068" FontFamily="Segoe UI" FontSize="12.5"/>
                                    <Hyperlink x:Name="LinkTerms"
                                               Foreground="#7A2650"
                                               TextDecorations="Underline"
                                               FontFamily="Segoe UI"
                                               FontSize="12.5"
                                               Click="LinkTerms_Click">Terms and Conditions</Hyperlink>
                                </TextBlock>

                                <TextBlock Text="Accounts are issued by the system administrator."
                                           FontFamily="Segoe UI"
                                           FontSize="12.5"
                                           Foreground="#8A5068"
                                           HorizontalAlignment="Center"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   Foreground="#6B4256"
                                   LineHeight="24"
                                   Margin="0,26,0,0">
                            Access is restricted to authorized CSWDO personnel.<LineBreak/>Unauthorized use is monitored and logged.
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="© 2026 Biñan City Social Welfare and Development Office. All rights reserved."
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="#6B4256"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
            </Grid>
        </Viewbox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,20,0"
                    Panel.ZIndex="10">
            <Button x:Name="BtnMinimize"
                    Width="16" Height="16"
                    Background="#A8A8A8"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="BtnMinimize_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnMaximize"
                    Width="16" Height="16"
                    Background="#28C840"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="BtnMaximize_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnClose"
                    Width="16" Height="16"
                    Background="#FF5F57"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <components:LoaderOverlay x:Name="LoadingOverlay"
                                  Message="Signing in..."
                                  Panel.ZIndex="30"/>

        <Grid x:Name="ErrorModalOverlay" Visibility="Collapsed" Panel.ZIndex="20">
            <Rectangle Fill="#66000000"/>
            <Border Background="White" CornerRadius="14" Padding="28,24" Width="360"
                    BorderBrush="#6D1F40" BorderThickness="1.5"
                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.18" RenderingBias="Quality"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE783;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtErrorModalTitle" Text="Sign In Failed" FontFamily="Segoe UI" FontSize="16"
                                   FontWeight="Bold" Foreground="#6D1F40" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtErrorModal" Text="" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#444444" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,20"/>
                    <Button Content="Close" Height="40" Cursor="Hand" Click="BtnErrorClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#6D1F40" CornerRadius="10" Padding="0,10" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="White"
                                                      TextElement.FontFamily="Segoe UI"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="TermsOverlay" Visibility="Collapsed" Panel.ZIndex="20">
            <Rectangle Fill="#66000000"/>
            <Border Background="White" CornerRadius="14" Padding="0" Width="400" MaxHeight="480"
                    BorderBrush="#6D1F40" BorderThickness="1.5"
                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.18" RenderingBias="Quality"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="24,18,24,14"
                            BorderBrush="#EBD3DC" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock Text="Terms and Conditions" FontFamily="Segoe UI"
                                       FontSize="14" FontWeight="Bold" Foreground="#6D1F40"/>
                            <Button HorizontalAlignment="Right" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="BtnTermsClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Cbg" Background="Transparent" CornerRadius="14" SnapsToDevicePixels="True">
                                            <TextBlock Text="✕" FontSize="13" Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Cbg" Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,8">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI" FontSize="11.5" Foreground="#444444"
                                       TextWrapping="Wrap" LineHeight="18">
                                <Run FontWeight="Bold">1. Acceptance of Terms</Run>
                                <LineBreak/>
                                By accessing and using the SOLACE Solo Parent Information System, you agree to be bound by these Terms and Conditions.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">2. Data Privacy</Run>
                                <LineBreak/>
                                All personal information collected is governed by the Data Privacy Act of 2012 (RA 10173). Information is collected solely for the administration of the Solo Parent Welfare Program.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">3. Authorized Use</Run>
                                <LineBreak/>
                                Access is restricted to authorized personnel only. Unauthorized access, disclosure, or misuse of data is strictly prohibited and may be subject to legal action.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">4. Account Responsibility</Run>
                                <LineBreak/>
                                Users are responsible for maintaining the confidentiality of their credentials. Any activity performed under your account is your responsibility.
                                <LineBreak/><LineBreak/>
                                <Run FontWeight="Bold">5. System Use</Run>
                                <LineBreak/>
                                This system must only be used for official duties related to the Solo Parent Welfare Program. Misuse may result in account suspension and disciplinary action.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" CornerRadius="0,0,14,14" Padding="24,14"
                            BorderBrush="#EBD3DC" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
                        <Button Content="Close" Height="38" Cursor="Hand" Click="BtnTermsClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#6D1F40" CornerRadius="10" Padding="0,8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="White"
                                                          TextElement.FontFamily="Segoe UI"
                                                          TextElement.FontSize="12"
                                                          TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
