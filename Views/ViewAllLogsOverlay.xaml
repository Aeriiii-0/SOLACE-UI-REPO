<UserControl x:Class="SOLUM_UI.ViewAllLogsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SOLUM_UI"
             xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
             xmlns:converters="clr-namespace:SOLUM_UI.Converters"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <!-- ── Shared text styles ─────────────────────────────────── -->
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ── Nav button: outlined pill (First / Previous / Next) ── -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" BorderBrush="#702943"
                                BorderThickness="1.5" CornerRadius="19" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FAF0F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ── Outlined pill (Clear / Retry) ─────────────────────── -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" CornerRadius="20"
                                BorderBrush="#702943" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FAF0F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ── Filled maroon pill (Search) ───────────────────────── -->
        <Style x:Key="PillFilledBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#702943" CornerRadius="20"
                                BorderBrush="#702943" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#9B3060"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ── Shared ComboBox template ──────────────────────────── -->
        <ControlTemplate x:Key="StyledComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="CbBg" Background="White" BorderBrush="#702943"
                        BorderThickness="1.5" CornerRadius="12">
                    <Grid Margin="12,0,32,0">
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                  RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False" Opacity="0"/>
                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                      Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="12" BorderBrush="#702943"
                            BorderThickness="1.5" MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="200" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                    <Setter TargetName="CbBg" Property="Background" Value="#FAF2F5"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                    <Setter TargetName="CbBg" Property="Background" Value="#FAF2F5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- ── Branded DatePicker style ──────────────────────────── -->
        <Style x:Key="BrandDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Foreground"          Value="#333333"/>
            <Setter Property="Background"          Value="White"/>
            <Setter Property="IsTodayHighlighted"  Value="True"/>
            <Setter Property="SelectedDateFormat"  Value="Short"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DpBorder" Background="White"
                                BorderBrush="#702943" BorderThickness="1.5"
                                CornerRadius="12" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#333333"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="12,0,0,0"
                                                   VerticalContentAlignment="Center"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                            <!-- Suppress the native watermark by not displaying PART_Watermark -->
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <!-- Custom clean placeholder - only visible when input is empty -->
                                <TextBlock Text="MM/DD/YYYY" Foreground="#999999" FontSize="13"
                                           Padding="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBg" Background="Transparent"
                                                    Width="28" Height="28" CornerRadius="6">
                                                <!-- Calendar icon (MDI path) -->
                                                <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.9,4 3,4.9 3,6V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                                      Fill="#702943" Stretch="Uniform"
                                                      Width="13" Height="13"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBg" Property="Background" Value="#F5ECEE"/>
                                                    <Setter Property="Foreground" Value="#702943"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="DpBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ── Shared ComboBox item style ────────────────────────── -->
        <Style x:Key="StyledComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItBg" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#F0E4E8"/>
                                <Setter Property="Foreground" Value="#702943"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="16" BorderBrush="#702943" BorderThickness="1.5"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="4" Opacity="0.26" Direction="270"/>
        </Border.Effect>
        <Grid>
            <!-- ═══════════════════════ Main content ════════════════════════════ -->
            <Grid x:Name="OverlayContent">
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filter bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Log list / loading / error -->
                    <RowDefinition Height="*"/>
                    <!-- Pagination footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ── Header (clean, no filled band, rounded top corners) ── -->
                <Border Grid.Row="0" Background="White" CornerRadius="14,14,0,0" Padding="28,22,24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeaderTitle}"
                                       FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="{Binding HeaderSubtitle}"
                                       FontFamily="Segoe UI" FontSize="12" Foreground="#993556" Margin="0,3,0,0"/>
                        </StackPanel>
                        <!-- Refresh button -->
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                                Width="36" Height="36" Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="Refresh logs">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="RefBg" Background="White" BorderBrush="#702943"
                                            BorderThickness="1.5" CornerRadius="18">
                                        <!-- ↻ refresh icon using Path -->
                                        <Path Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.01 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12C20,7.58 16.42,4 12,4M12,18C8.69,18 6,15.31 6,12C6,10.99 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18Z"
                                              Fill="#702943" Stretch="Uniform"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RefBg" Property="Background" Value="#F0E0E6"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="RefBg" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Close button -->
                        <Button Grid.Column="2" x:Name="CloseBtn" Click="CloseBtn_Click"
                                Width="36" Height="36" Cursor="Hand" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" BorderBrush="#702943"
                                            BorderThickness="1.5" CornerRadius="18">
                                        <TextBlock Text="✕" FontSize="14" Foreground="#702943"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F0E0E6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
                <!-- ── Filter bar ──────────────────────────────────────────── -->
                <Border Grid.Row="1" Background="#FAF4F6" BorderBrush="#E8D8DE"
                        BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Search box -->
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="14"/>
                            <!-- Action filter -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="14"/>
                            <!-- Date range pickers -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <!-- Filter action buttons -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Full name search (Performer or Target) -->
                        <Border Grid.Column="0" Height="38" Background="White" CornerRadius="19"
                                BorderBrush="#702943" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Fill="#702943" Stretch="Uniform" Width="13" Height="13" Margin="12,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Margin="0,0,12,0"
                                         BorderThickness="0" Background="Transparent" FontSize="12.5" Foreground="#333333"
                                         VerticalAlignment="Center" FontFamily="Segoe UI"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock Text="Search full name (performer/target)..." Foreground="#A89AA0" FontSize="12.5"
                                                                       FontFamily="Segoe UI" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Action filter -->
                        <TextBlock Grid.Column="2" Text="Action:" FontFamily="Segoe UI" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4" Height="38"
                                  ItemsSource="{Binding VisibleActionFilters}"
                                  SelectedValue="{Binding SelectedFilter, Mode=TwoWay}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="DisplayName"
                                  FontFamily="Segoe UI" FontSize="13"
                                  Template="{StaticResource StyledComboTemplate}"
                                  ItemContainerStyle="{StaticResource StyledComboItem}"/>

                        <!-- Date range pickers -->
                        <TextBlock Grid.Column="6" Text="From:" FontFamily="Segoe UI" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="8"
                                    SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                    Style="{StaticResource BrandDatePicker}"/>
                        <TextBlock Grid.Column="10" Text="To:" FontFamily="Segoe UI" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="12"
                                    SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                    Style="{StaticResource BrandDatePicker}"/>

                        <!-- Filter action buttons -->
                        <Button Grid.Column="14" Height="38" Padding="20,0" Cursor="Hand"
                                Command="{Binding SearchCommand}" Style="{StaticResource PillFilledBtn}"
                                ToolTip="Apply filters">
                            <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                        <Button Grid.Column="16" Height="38" Padding="18,0" Cursor="Hand"
                                Command="{Binding ClearFiltersCommand}" Style="{StaticResource IconBtn}"
                                ToolTip="Reset filters">
                            <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="#702943"/>
                        </Button>
                    </Grid>
                </Border>
                <!-- ── Content area: loading / error / list ────────────────── -->
                <Grid Grid.Row="2" x:Name="LogsContentGrid" Background="White">
                    <!-- Loading overlay -->
                    <components:LoaderOverlay IsActive="{Binding IsLoading}"
                                              Message="Loading logs..."
                                              Panel.ZIndex="10"/>
                    <!-- Error panel -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#FFF0F3" CornerRadius="12" Padding="24,18"
                                BorderBrush="#F0C0CC" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚠ Could not load logs" FontFamily="Segoe UI"
                                           FontSize="14" FontWeight="Bold" Foreground="#DC3545"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ErrorMessage}" FontFamily="Segoe UI"
                                           FontSize="12" Foreground="#555555"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           Margin="0,0,0,14"/>
                                <Button Content="Retry" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource IconBtn}"
                                        Height="36" Padding="20,0" HorizontalAlignment="Center"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- Log list (hidden while loading or error) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="28,20,28,8"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding PagedLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" BorderThickness="1.5"
                                                Padding="18,12" Margin="0,0,0,8" Cursor="Hand"
                                                SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                ToolTip="Click to view details">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E5D8DC"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FDF6F8"/>
                                                            <Setter Property="BorderBrush" Value="#702943"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenDetailCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Action type icon: tinted rounded tile + colored glyph (matches the drawer) -->
                                                <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True">
                                                    <Border CornerRadius="10" Background="{Binding DotColorBrush}" Opacity="0.14"/>
                                                    <Viewbox Width="16" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{Binding DotIcon}" Fill="{Binding DotColorBrush}" Stretch="Uniform"/>
                                                    </Viewbox>
                                                </Grid>
                                                <!-- Content Grid: 2 rows x 2 columns -->
                                                <Grid Grid.Column="1" Margin="14,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Row 0, Col 0: Action -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Segoe UI" FontSize="13" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Action: " FontWeight="Bold" Foreground="#222222"/>
                                                        <Run Text="{Binding ActionTitle, Mode=OneWay}" FontWeight="Normal" Foreground="#111111"/>
                                                    </TextBlock>
                                                    <!-- Row 0, Col 1: Target ID -->
                                                    <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Segoe UI" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetTooltip}"
                                                               Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Run Text="Target: " FontWeight="Bold" Foreground="#222222"/>
                                                        <Run Text="{Binding TargetDisplay, Mode=OneWay}" FontWeight="Normal" Foreground="#111111"/>
                                                    </TextBlock>
                                                    <!-- Row 1, Col 0: Performed By -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Segoe UI" FontSize="12.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Performed By: " FontWeight="Bold" Foreground="#222222"/>
                                                        <Run Text="{Binding PerformedByDisplay, Mode=OneWay}" FontWeight="Normal" Foreground="#111111"/>
                                                    </TextBlock>
                                                    <!-- Row 1, Col 1: Date -->
                                                    <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Segoe UI" FontSize="12.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Date: " FontWeight="Bold" Foreground="#222222"/>
                                                        <Run Text="{Binding DateDisplay, Mode=OneWay}" FontWeight="Normal" Foreground="#555555"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Empty state (no error, not loading, no items) -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,32,0,0"
                                        Visibility="{Binding HasNoLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="No audit logs found" FontFamily="Segoe UI"
                                           FontSize="14" Foreground="#BBBBBB" HorizontalAlignment="Center"/>
                                <TextBlock Text="Try adjusting your filters or date range."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#CCCCCC"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- ── Pagination footer ───────────────────────────────────── -->
                <Border Grid.Row="3" Padding="28,16,28,20" Background="White" CornerRadius="0,0,14,14"
                        BorderBrush="#E5D8DC" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="« First" Style="{StaticResource NavBtn}"
                                    Command="{Binding FirstPageCommand}"
                                    IsEnabled="{Binding CanGoPrev}"
                                    Margin="0,0,12,0"/>
                            <Button Content="Previous" Style="{StaticResource NavBtn}"
                                    Command="{Binding PrevPageCommand}"
                                    IsEnabled="{Binding CanGoPrev}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                   FontFamily="Segoe UI" FontSize="13" Foreground="#702943" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Next" Style="{StaticResource NavBtn}"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}"/>
                    </Grid>
                </Border>
            </Grid>
            <!-- ═══════════════════════ Detail overlay ══════════════════════════ -->
            <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Rectangle Fill="{DynamicResource ModalOverlayBrush}"/>
                <Border Background="White" CornerRadius="16" Padding="32,26"
                        BorderBrush="#5C1D38" BorderThickness="1.5"
                        Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxHeight="700">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.24" Direction="270"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Title row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Audit Log Detail"
                                           FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="#702943"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding CloseDetailCommand}"
                                        Width="34" Height="34" Cursor="Hand" ToolTip="Close">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="White" BorderBrush="#702943"
                                                    BorderThickness="1.5" CornerRadius="17">
                                                <TextBlock Text="✕" FontSize="14" Foreground="#702943"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#F0E0E6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!-- Action type badge + record name -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border CornerRadius="14" Padding="14,5" Margin="0,0,10,0" Background="{Binding SelectedLog.DotColorBrush}">
                                    <TextBlock Text="{Binding SelectedLog.ActionLabel}"
                                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedLog.RecordName}"
                                           FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           Foreground="#1A1A1A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#E5D8DC" Margin="0,0,0,16"/>
                            <!-- ── Who ──────────────────────────────────────────── -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Performed by" Style="{StaticResource MetaLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedLog.PerformedByDisplay}"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Normal"
                                                   Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                        <Border CornerRadius="10" Background="#F0E8EC" Padding="10,3"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedLog.PerformedByRole}"
                                                       FontFamily="Segoe UI" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#702943"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedLog.PerformedByUserId, StringFormat='ID: {0}'}"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#888888" Margin="0,2,0,0"
                                               Visibility="{Binding SelectedLog.HasPerformedByUserId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                            <!-- ── Target ───────────────────────────────────────── -->
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding SelectedLog.HasTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target" Style="{StaticResource MetaLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedLog.TargetDisplay}"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="Normal"
                                                   Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                        <Border CornerRadius="10" Background="#EEF2FF" Padding="10,3"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedLog.HasTargetType, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SelectedLog.TargetTypeDisplay}"
                                                       FontFamily="Segoe UI" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#4F46E5"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedLog.TargetIdDisplay, StringFormat='ID: {0}'}"
                                               FontFamily="Segoe UI" FontSize="12" Foreground="#666666" Margin="0,2,0,0"
                                               Visibility="{Binding SelectedLog.HasTargetId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                            <!-- ── Status ───────────────────────────────────────── -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status" Style="{StaticResource MetaLabel}"/>
                                <Border Grid.Column="1" CornerRadius="12" Padding="12,4"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLog.Status}" Value="FAILED">
                                                    <Setter Property="Background" Value="#FFE8E8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedLog.Status}" Value="FAILURE">
                                                    <Setter Property="Background" Value="#FFE8E8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedLog.Status}"
                                               FontFamily="Segoe UI" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLog.Status}" Value="FAILED">
                                                        <Setter Property="Foreground" Value="#DC3545"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedLog.Status}" Value="FAILURE">
                                                        <Setter Property="Foreground" Value="#DC3545"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <!-- ── IP Address ────────────────────────────────────── -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IP Address" Style="{StaticResource MetaLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedLog.IpAddress}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#444444" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <!-- ── Timestamp ──────────────────────────────────────── -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Timestamp" Style="{StaticResource MetaLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedLog.TimestampFormatted}"
                                           Style="{StaticResource MetaValue}"/>
                            </Grid>
                            <!-- ── Changes Recorded (diff table) ─────────────────── -->
                            <Border Background="#FDF5F7" BorderBrush="#E5D8DC" BorderThickness="1"
                                    CornerRadius="14" Padding="20,16" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="CHANGES RECORDED"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                               Foreground="#9B3060" Margin="0,0,0,12"/>
                                    <!-- ── Table: has changes ─── -->
                                    <StackPanel Visibility="{Binding SelectedLog.HasChangeDetail,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Column headers -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Field"
                                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                                       Foreground="#9B3060" Padding="8,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="Previous Value"
                                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                                       Foreground="#9B3060" Padding="4,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="New / Current Value"
                                                       FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                                       Foreground="#9B3060" Padding="4,0,0,0"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="#E8D4DC" Margin="0,0,0,6"/>
                                        <!-- Multi-field rows (new API format) -->
                                        <ItemsControl ItemsSource="{Binding SelectedLog.Changes}"
                                                      Visibility="{Binding SelectedLog.Changes.Count,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4" MinHeight="34">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Field name -->
                                                        <Border Grid.Column="0" Background="White"
                                                                CornerRadius="8" Padding="8,6" Margin="0,0,3,0">
                                                            <TextBlock Text="{Binding DisplayFieldName}"
                                                                       FontFamily="Segoe UI" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#1A1A1A"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Previous value -->
                                                        <Border Grid.Column="1" Background="#FFE8E8"
                                                                CornerRadius="8" Padding="8,6" Margin="3,0,3,0">
                                                            <TextBlock Text="{Binding DisplayOldValue, TargetNullValue='—', FallbackValue='—'}"
                                                                       FontFamily="Segoe UI" FontSize="12"
                                                                       Foreground="#DC3545" TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- New value -->
                                                        <Border Grid.Column="2" Background="#E8F5E9"
                                                                CornerRadius="8" Padding="8,6" Margin="3,0,0,0">
                                                            <TextBlock Text="{Binding DisplayNewValue, TargetNullValue='—', FallbackValue='—'}"
                                                                       FontFamily="Segoe UI" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#27AE60"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Legacy single-field row (backward compat, shown only when Changes list is empty) -->
                                        <Grid Visibility="{Binding SelectedLog.Changes.Count,
                                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                              MinHeight="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="White"
                                                    CornerRadius="8" Padding="8,6" Margin="0,0,3,0">
                                                <TextBlock Text="{Binding SelectedLog.DisplayFieldChanged, TargetNullValue='—'}"
                                                           FontFamily="Segoe UI" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#1A1A1A"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#FFE8E8"
                                                    CornerRadius="8" Padding="8,6" Margin="3,0,3,0">
                                                <TextBlock Text="{Binding SelectedLog.DisplayOldValue, TargetNullValue='—'}"
                                                           FontFamily="Segoe UI" FontSize="12"
                                                           Foreground="#DC3545" TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" Background="#E8F5E9"
                                                    CornerRadius="8" Padding="8,6" Margin="3,0,0,0">
                                                <TextBlock Text="{Binding SelectedLog.DisplayNewValue, TargetNullValue='—'}"
                                                           FontFamily="Segoe UI" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#27AE60"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <!-- ── Empty state: no changes recorded ─── -->
                                    <TextBlock Visibility="{Binding SelectedLog.HasChangeDetail,
                                                            Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                               Text="No field modifications recorded for this log entry."
                                               FontFamily="Segoe UI" FontSize="12" Foreground="#AAAAAA"
                                               FontStyle="Italic" HorizontalAlignment="Center"
                                               Margin="0,4,0,4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
