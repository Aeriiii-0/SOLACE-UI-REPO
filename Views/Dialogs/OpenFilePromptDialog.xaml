<Window x:Class="SOLUM_UI.Views.Dialogs.OpenFilePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="450" SizeToContent="Height"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display">
    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#15803D" BorderThickness="2"
                UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Icon / Title -->
                <StackPanel Grid.Row="0" Margin="32,28,32,0" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27"
                            Background="#D1FAE5" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
                              Fill="#15803D" Stretch="Uniform" Width="24" Height="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Export Complete" FontFamily="Segoe UI" FontSize="20"
                               FontWeight="Bold" Foreground="#111111" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your file has been exported successfully."
                               FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280"
                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Message -->
                <Border Grid.Row="1" Margin="32,20,32,0">
                    <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13.5" Foreground="#374151"
                               LineHeight="20"/>
                </Border>

                <!-- Buttons -->
                <Grid Grid.Row="2" Margin="32,24,32,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Not Now Button -->
                    <Button Grid.Column="0" Height="44" Cursor="Hand" Click="BtnNotNow_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="22"
                                        BorderBrush="#D1D5DB" BorderThickness="1.5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Not now" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#6B7280"/>
                    </Button>

                    <!-- Open File Button -->
                    <Button Grid.Column="2" Height="44" Cursor="Hand" Click="BtnOpenFile_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#15803D" CornerRadius="22">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" 
                                                          Direction="270" Opacity="0.24" 
                                                          Color="#15803D"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Open file" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
