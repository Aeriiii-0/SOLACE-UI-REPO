<Window x:Class="SOLUM_UI.Views.Dialogs.DeleteRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="520" SizeToContent="Height"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ── Solace Themed Colors ── -->
        <SolidColorBrush x:Key="SolaceMaroon" Color="#702943"/>
        <SolidColorBrush x:Key="SolacePlumHover" Color="#8B3555"/>
        <SolidColorBrush x:Key="SolaceBgTint" Color="#FAF2F5"/>
        <SolidColorBrush x:Key="SolaceBorder" Color="#C0A0AA"/>
        <SolidColorBrush x:Key="SolaceDanger" Color="#9E2A4B"/>
        <SolidColorBrush x:Key="SolaceDangerHover" Color="#7D1B36"/>

        <!-- ── Form Label Style ── -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ── Multi-line Remarks TextBox ── -->
        <Style x:Key="SolaceInputMulti" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B3555"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Themed Solace ComboBox ── -->
        <Style x:Key="SolaceCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M7,10L12,15L17,10H7Z" Fill="#702943" Width="11" Height="11"
                                          Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1.5"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Padding="4" Margin="0,0,8,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B3555"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent" CornerRadius="6" Margin="2,1" Padding="12,8">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#FAF2F5"/>
                                            <Setter Property="Foreground" Value="#702943"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#F3E5EB"/>
                                            <Setter Property="Foreground" Value="#702943"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="30" ShadowDepth="4" Opacity="0.16" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Citizen Card -->
                    <RowDefinition Height="Auto"/> <!-- Reason Form -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="24,22,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="#FBF2F5" BorderBrush="#EBD8DE" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                              Fill="#9E2A4B" Stretch="Uniform" Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Delete Solo Parent Record" FontFamily="Georgia" FontSize="19" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock Text="Move record to the 30-day reinstatement Recycle Bin"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="32" Height="32" Cursor="Hand" Click="BtnCancel_Click" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="16" BorderBrush="#EBD8DE" BorderThickness="1">
                                    <TextBlock Text="✕" FontSize="12" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── Citizen Card ── -->
                <Border Grid.Row="1" Margin="24,16,24,0" Background="#FAF2F5" BorderBrush="#EBD8DE" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="RECORD TARGET" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtCitizenName" Text="Citizen Name" FontFamily="Segoe UI" FontSize="14.5" FontWeight="SemiBold" Foreground="#111111" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtCitizenSub" Text="Solo Parent Case File" FontFamily="Segoe UI" FontSize="12" Foreground="#666666" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="30-Day Window" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#9E2A4B"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Reason Form ── -->
                <StackPanel Grid.Row="2" Margin="24,18,24,18">
                    <TextBlock Text="Reason for Deletion *" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CmbReason" Style="{StaticResource SolaceCombo}"
                              SelectionChanged="CmbReason_SelectionChanged" Margin="0,0,0,14">
                        <ComboBoxItem Content="Select a reason for deletion..." IsSelected="True"/>
                        <ComboBoxItem Content="Duplicate Record Entry"/>
                        <ComboBoxItem Content="Loss of Solo Parent Eligibility"/>
                        <ComboBoxItem Content="Relocated Outside Municipality"/>
                        <ComboBoxItem Content="Requested by Citizen / Applicant"/>
                        <ComboBoxItem Content="Dependent Reached Legal Age (18+)"/>
                        <ComboBoxItem Content="Other Reason (Specify Below)"/>
                    </ComboBox>

                    <TextBlock Text="Additional Remarks / Specific Details" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtRemarks" Style="{StaticResource SolaceInputMulti}"/>

                    <!-- Validation Error Message -->
                    <Border x:Name="PnlError" Background="#FFF0F3" BorderBrush="#F0C0CC" BorderThickness="1" CornerRadius="6"
                            Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " Foreground="#9E2A4B" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtError" Text="" FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#9E2A4B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Action Buttons Footer ── -->
                <Border Grid.Row="3" Background="#FAF4F6" BorderBrush="#EBD8DE"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button x:Name="BtnCancel" Grid.Column="0" Height="40" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="8" BorderBrush="#C4A0AC" BorderThickness="1.2">
                                        <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F3E5EB"/>
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Move to Recycle Bin Button -->
                        <Button x:Name="BtnDelete" Grid.Column="2" Height="40" Cursor="Hand" Click="BtnDelete_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{StaticResource SolaceDanger}" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                  Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Move to Recycle Bin" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SolaceDangerHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>