<Window x:Class="SOLUM_UI.Views.Dialogs.RenewalReassessmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annual Re-assessment &amp; Renewal"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="880" Height="720">

    <Window.Resources>
        <!-- ── Typography & Labels ── -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ── Card Styles matching RecordDialog ── -->
        <Style x:Key="CardSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#EDE0E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CardSectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="3.5,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ── Form Controls matching RecordDialog ── -->
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="12,0,32,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select option..."
                                               Foreground="#AAAAAA" FontSize="13"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="8" BorderBrush="#C0A0AA"
                                        BorderThickness="1.2" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" Margin="0,3,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.10"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="ComboBg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#222222"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Foreground="#111111" Background="Transparent"
                                                   BorderThickness="0" Padding="10,0"
                                                   VerticalAlignment="Center" FontSize="13">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <TextBlock Text="MM/DD/YYYY" Foreground="#999999" FontSize="13"
                                           Padding="10,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ToggleButton x:Name="PART_Button" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="20" Height="20"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Focusable="False"
                                    IsChecked="{Binding IsOpen, ElementName=PART_Popup, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19Z"
                                                  Fill="#702943" Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Grid.Column="0" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="White" CornerRadius="10" BorderBrush="#C0A0AA"
                                        BorderThickness="1.2" Padding="8,6" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.10"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="White"
                                              BorderThickness="0" Foreground="#222222"
                                              FontSize="13">
                                        <Calendar.Resources>
                                            <Style TargetType="CalendarDayButton">
                                                <Setter Property="Width" Value="30"/>
                                                <Setter Property="Height" Value="30"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarDayButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsToday" Value="True">
                                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                                                    <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="CalendarButton">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="2">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="HasSelectedDays" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="HasSelectedDays" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Calendar.Resources>
                                    </Calendar>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Buttons matching App Theme ── -->
        <Style x:Key="PrimaryMaroonBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#8B3555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#5A1F34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineMaroonBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FDF0F3"/>
                                <Setter TargetName="BtnBg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dimmed Modal Backdrop -->
    <Border Background="#55000000">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>

            <!-- Dialog Shell -->
            <Border x:Name="DialogShell" Background="#FAFAFA" CornerRadius="16" Width="860" Height="700"
                    BorderBrush="#702943" BorderThickness="1.5" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title Header -->
                        <RowDefinition Height="Auto"/> <!-- Read-only Identity Banner -->
                        <RowDefinition Height="Auto"/> <!-- Stepper Bar -->
                        <RowDefinition Height="*"/>    <!-- Step Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- ── 1. TITLE HEADER (Maroon Brand) ── -->
                    <Border Grid.Row="0" Background="#702943" Padding="26,14">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Annual Re-assessment &amp; Renewal" FontSize="16" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                                <TextBlock Text="Update changeable circumstances, employment, and family composition for the annual solo parent renewal."
                                           FontSize="11" Foreground="#F0E4E8" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="30" Height="30" BorderThickness="0"
                                    Background="Transparent" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBg" Background="Transparent" CornerRadius="15">
                                            <TextBlock Text="✕" FontSize="13" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBg" Property="Background" Value="#8B3555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── 2. PINNED IDENTITY CONTEXT CARD (Read-only, Solum Tint) ── -->
                    <Border Grid.Row="1" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar badge -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#702943" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtInitials" Text="SP" FontSize="15" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtApplicantName" Text="Maria Santos y Dela Cruz" FontSize="15" FontWeight="Bold" Foreground="#702943" FontFamily="Segoe UI"/>
                                    <Border Background="#FDF0F3" BorderBrush="#EDD0DA" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCategoryBadge" Text="A2 · Death of Spouse" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="ID: " FontSize="11" Foreground="#666666"/>
                                    <TextBlock x:Name="TxtSoloParentId" Text="SP-2024-00123" FontSize="11" FontWeight="SemiBold" Foreground="#111111" Margin="0,0,14,0"/>
                                    <TextBlock Text="PhilSys: " FontSize="11" Foreground="#666666"/>
                                    <TextBlock x:Name="TxtPhilSysNumber" Text="1234-5678-9012" FontSize="11" FontWeight="SemiBold" Foreground="#111111" Margin="0,0,14,0"/>
                                    <TextBlock Text="Barangay: " FontSize="11" Foreground="#666666"/>
                                    <TextBlock x:Name="TxtBarangay" Text="Poblacion" FontSize="11" FontWeight="SemiBold" Foreground="#111111"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Expiry & Renewal Status -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                              Fill="#D97706" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtExpiryNotice" Text="Current Expiry: Oct 18, 2026" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Extends by 1 Year upon confirmation" FontSize="10" Foreground="#702943" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── 3. STEPPER BAR (Maroon Accent) ── -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#EDE0E5" BorderThickness="0,0,0,1" Padding="28,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Step 1 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step1Indicator" Width="26" Height="26" CornerRadius="13" Background="#702943" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Step1Label" Text="Civil &amp; Livelihood" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                    <TextBlock Text="Income &amp; Status" FontSize="9" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Height="2" Background="#E0D0D6" VerticalAlignment="Center"/>

                            <!-- Step 2 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step2Indicator" Width="26" Height="26" CornerRadius="13" Background="#E0D0D6" Margin="0,0,8,0">
                                    <TextBlock x:Name="Step2Num" Text="2" Foreground="#777777" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Step2Label" Text="Dependents" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                                    <TextBlock Text="Family Composition" FontSize="9" Foreground="#999999"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3" Height="2" Background="#E0D0D6" VerticalAlignment="Center"/>

                            <!-- Step 3 -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step3Indicator" Width="26" Height="26" CornerRadius="13" Background="#E0D0D6" Margin="0,0,8,0">
                                    <TextBlock x:Name="Step3Num" Text="3" Foreground="#777777" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Step3Label" Text="Circumstances" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                                    <TextBlock Text="Needs &amp; Other Income" FontSize="9" Foreground="#999999"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="5" Height="2" Background="#E0D0D6" VerticalAlignment="Center"/>

                            <!-- Step 4 -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step4Indicator" Width="26" Height="26" CornerRadius="13" Background="#E0D0D6" Margin="0,0,8,0">
                                    <TextBlock x:Name="Step4Num" Text="4" Foreground="#777777" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Step4Label" Text="Review &amp; Renew" FontSize="11" FontWeight="Bold" Foreground="#777777"/>
                                    <TextBlock Text="Confirm Changes" FontSize="9" Foreground="#999999"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── 4. STEP CONTENT PANELS ── -->
                    <Grid Grid.Row="3" Background="#FAFAFA">

                        <!-- ──────── STEP 1: CIVIL STATUS & LIVELIHOOD ──────── -->
                        <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto" Padding="28,20" Visibility="Visible">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                                <TextBlock Text="Step 1: Civil Status &amp; Livelihood" Style="{StaticResource SectionHeading}" Margin="0,0,0,4"/>
                                <TextBlock Text="Verify or update marital status and current household income. These factors determine ongoing subsidy eligibility." Style="{StaticResource HelperText}" Margin="0,0,0,16"/>

                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="I. CIVIL &amp; EMPLOYMENT INFORMATION" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- Civil Status & Employment Status -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Civil Status *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbCivilStatus" Style="{StaticResource FormCombo}">
                                                    <ComboBoxItem Content="Single"/>
                                                    <ComboBoxItem Content="Married"/>
                                                    <ComboBoxItem Content="Widowed"/>
                                                    <ComboBoxItem Content="Separated"/>
                                                    <ComboBoxItem Content="Annulled"/>
                                                    <ComboBoxItem Content="Divorced"/>
                                                    <ComboBoxItem Content="Common Law / Live-in"/>
                                                    <ComboBoxItem Content="Abandoned"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Employment Status *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbEmploymentStatus" Style="{StaticResource FormCombo}">
                                                    <ComboBoxItem Content="Employed" Tag="employed"/>
                                                    <ComboBoxItem Content="Self-Employed" Tag="self_employed"/>
                                                    <ComboBoxItem Content="Not Employed" Tag="not_employed"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Occupation & Monthly Income -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Occupation / Source of Livelihood *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtOccupation" Style="{StaticResource FormBox}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Monthly Income (₱) *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMonthlyIncome" Style="{StaticResource FormBox}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Other Sources of Income (Livelihood placement) -->
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="Other Sources of Income" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtOtherIncomeStep1" Style="{StaticResource FormBox}"
                                                     TextChanged="TxtOtherIncomeStep1_TextChanged"/>
                                            <TextBlock Text="Specify additional livelihood sources (e.g. Small sari-sari store (₱3,000/month), home baking, remittances)."
                                                       Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ──────── STEP 2: FAMILY COMPOSITION (DEPENDENTS) ──────── -->
                        <ScrollViewer x:Name="Step2Panel" VerticalScrollBarVisibility="Auto" Padding="28,20" Visibility="Collapsed">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Step 2: Family Dependents" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="Review existing dependents, update educational levels, add new qualified children, or remove aged-out dependents."
                                                   Style="{StaticResource HelperText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryMaroonBtn}" Height="34" Padding="14,0" Click="BtnAddChild_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <TextBlock Text="Add Dependent" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Add/Edit Dependent Inline Sub-Card (Collapsible) -->
                                <Border x:Name="AddChildSubCard" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="1.5"
                                        CornerRadius="10" Padding="18" Margin="0,0,0,16" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtAddChildTitle" Text="Add New Dependent" FontSize="13" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Full Name *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtChildName" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Relationship *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbChildRel" Style="{StaticResource FormCombo}">
                                                    <ComboBoxItem Content="Child"/>
                                                    <ComboBoxItem Content="Adopted Child"/>
                                                    <ComboBoxItem Content="Legal Ward"/>
                                                    <ComboBoxItem Content="Dependent Relative"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Sex *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbChildSex" Style="{StaticResource FormCombo}">
                                                    <ComboBoxItem Content="Female"/>
                                                    <ComboBoxItem Content="Male"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Birthdate *" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Height="42">
                                                    <DatePicker x:Name="DpChildDob" Style="{StaticResource FormDate}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Educational Level *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbChildEdu" Style="{StaticResource FormCombo}">
                                                    <ComboBoxItem Content="None"/>
                                                    <ComboBoxItem Content="Preschool"/>
                                                    <ComboBoxItem Content="Elementary"/>
                                                    <ComboBoxItem Content="High School"/>
                                                    <ComboBoxItem Content="Senior High"/>
                                                    <ComboBoxItem Content="College"/>
                                                    <ComboBoxItem Content="Vocational"/>
                                                    <ComboBoxItem Content="Employed"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Monthly Income (₱)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtChildIncome" Style="{StaticResource FormBox}" Text="0.00" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Style="{StaticResource OutlineMaroonBtn}" Height="32" Padding="14,0" Margin="0,0,8,0" Click="BtnCancelChild_Click"/>
                                            <Button Content="Save Dependent" Style="{StaticResource PrimaryMaroonBtn}" Height="32" Padding="14,0" Click="BtnSaveChild_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dependents Items List -->
                                <Border Style="{StaticResource CardSection}" Padding="14">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="IV. FAMILY COMPOSITION (ELIGIBLE DEPENDENTS)" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <Grid Margin="8,4,8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="NAME &amp; RELATIONSHIP" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                            <TextBlock Grid.Column="1" Text="AGE &amp; SEX" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                            <TextBlock Grid.Column="2" Text="EDUCATION / WORK" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                            <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                            <TextBlock Grid.Column="4" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="1" Background="#EDE0E5" Margin="0,0,0,8"/>

                                        <ItemsControl x:Name="DependentsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Name + Relationship -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextColor}"/>
                                                                <TextBlock Text="{Binding Relationship}" FontSize="11" Foreground="#777777"/>
                                                            </StackPanel>

                                                            <!-- Age & Sex -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AgeDisplay}" FontSize="12" Foreground="#222222"/>
                                                                <TextBlock Text="{Binding Sex}" FontSize="11" Foreground="#777777"/>
                                                            </StackPanel>

                                                            <!-- Education -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EducationalLevel}" FontSize="12" Foreground="#222222"/>
                                                                <TextBlock Text="{Binding IncomeDisplay}" FontSize="11" Foreground="#777777"/>
                                                            </StackPanel>

                                                            <!-- Status Tag -->
                                                            <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                    Background="{Binding TagBg}" CornerRadius="6" Padding="6,2">
                                                                <TextBlock Text="{Binding StatusTag}" FontSize="10" FontWeight="Bold" Foreground="{Binding TagFg}"/>
                                                            </Border>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Content="Edit" FontSize="11" Height="26" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#FDF0F3" Foreground="#702943" BorderThickness="0" Cursor="Hand"
                                                                        Click="BtnEditDependent_Click" Tag="{Binding}"/>
                                                                <Button Content="{Binding ActionButtonText}" FontSize="11" Height="26" Padding="8,0"
                                                                        Background="{Binding ActionButtonBg}" Foreground="{Binding ActionButtonFg}"
                                                                        BorderThickness="0" Cursor="Hand" Click="BtnToggleRemoveDependent_Click" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="TxtNoDependents" Text="No dependents recorded. Click '+ Add Dependent' to register children."
                                                   FontSize="12" Foreground="#999999" HorizontalAlignment="Center" Margin="0,16" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ──────── STEP 3: CIRCUMSTANCES & NEEDS ASSESSMENT ──────── -->
                        <ScrollViewer x:Name="Step3Panel" VerticalScrollBarVisibility="Auto" Padding="28,20" Visibility="Collapsed">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                                <TextBlock Text="Step 3: Circumstances &amp; Needs Assessment" Style="{StaticResource SectionHeading}" Margin="0,0,0,4"/>
                                <TextBlock Text="Review or update the primary legal basis for the solo parent classification, family needs, and other sources of income."
                                           Style="{StaticResource HelperText}" Margin="0,0,0,16"/>

                                <!-- Circumstance / Problem Presented -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="III. CIRCUMSTANCE OF BEING SOLO PARENT" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <TextBlock Text="Primary Circumstance / Ground for Classification *" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbCircumstance" Style="{StaticResource FormCombo}" Margin="0,0,0,14" SelectionChanged="CmbCircumstance_SelectionChanged">
                                            <ComboBoxItem Content="A1 · Gives birth as a result of rape" Tag="A1"/>
                                            <ComboBoxItem Content="A2 · Death of spouse" Tag="A2"/>
                                            <ComboBoxItem Content="A3 · Detention of spouse" Tag="A3"/>
                                            <ComboBoxItem Content="A4 · Physical &amp; mental incapacity of spouse" Tag="A4"/>
                                            <ComboBoxItem Content="A5 · Legal or de facto separation (at least 6 months)" Tag="A5"/>
                                            <ComboBoxItem Content="A6 · Declaration of nullity or annulment of marriage" Tag="A6"/>
                                            <ComboBoxItem Content="A7 · Abandonment of spouse for at least 6 months" Tag="A7"/>
                                            <ComboBoxItem Content="B · OFW-related solo parent" Tag="B"/>
                                            <ComboBoxItem Content="C · Unmarried mother or father" Tag="C"/>
                                            <ComboBoxItem Content="D · Legal guardian, adoptive or foster parent" Tag="D"/>
                                            <ComboBoxItem Content="E · Relative within 4th civil degree caring for child" Tag="E"/>
                                            <ComboBoxItem Content="F · Pregnant woman alone" Tag="F"/>
                                        </ComboBox>

                                        <!-- Dynamic Conditional Subfields -->
                                        <!-- For A2 (Death) -->
                                        <Border x:Name="PanelSubA2" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Cause of Death" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtA2Cause" Style="{StaticResource FormBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Date of Death" Style="{StaticResource FieldLabel}"/>
                                                    <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Height="42">
                                                        <DatePicker x:Name="DpA2Date" Style="{StaticResource FormDate}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- For A4 (Incapacity) -->
                                        <Border x:Name="PanelSubA4" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Type of Disability / Incapacity" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtA4Disability" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- For A5 (Separation) -->
                                        <Border x:Name="PanelSubA5" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Period of Separation (e.g. 2 years, since 2022)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtA5Period" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- For A6 (Nullity / Annulment) -->
                                        <Border x:Name="PanelSubA6" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RdoNullity" Content="Declaration of Nullity" GroupName="A6Sub" FontSize="13" Margin="0,0,24,0" IsChecked="True"/>
                                                <RadioButton x:Name="RdoAnnulment" Content="Annulment of Marriage" GroupName="A6Sub" FontSize="13"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- For B (OFW) -->
                                        <Border x:Name="PanelSubB" Background="#FFF7F9" BorderBrush="#EDD0DA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Length of Stay Abroad (months)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtBStayAbroad" Style="{StaticResource FormBox}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: V. NEEDS AND PROBLEMS -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="V. NEEDS AND PROBLEMS" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <TextBox x:Name="TxtNeeds" Style="{StaticResource FormBox}" Height="80"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="12,8"/>
                                        <TextBlock Text="Record any specific needs or assistance requested by the solo parent (e.g. livelihood capital, educational support)."
                                                   Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: VI. OTHER SOURCES OF INCOME (Section VI placement) -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="VI. OTHER SOURCES OF INCOME" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <TextBox x:Name="TxtOtherIncomeStep3" Style="{StaticResource FormBox}" Height="60"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="12,8"
                                                 TextChanged="TxtOtherIncomeStep3_TextChanged"/>
                                        <TextBlock Text="e.g. Small sari-sari store (₱3,000/month), sewing, livestock, financial aid from family."
                                                   Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ──────── STEP 4: REVIEW & CONFIRM ──────── -->
                        <ScrollViewer x:Name="Step4Panel" VerticalScrollBarVisibility="Auto" Padding="28,20" Visibility="Collapsed">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                                <TextBlock Text="Step 4: Review Changes &amp; Confirm Renewal" Style="{StaticResource SectionHeading}" Margin="0,0,0,4"/>
                                <TextBlock Text="Please review the changes before saving. Submitting will update the parent's record and automatically extend validity by 1 year."
                                           Style="{StaticResource HelperText}" Margin="0,0,0,16"/>

                                <!-- Validity Extension Banner (Solum Maroon Brand) -->
                                <Border Background="#FFF7F9" BorderBrush="#702943" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#702943" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Annual Extension Ready for Confirmation" FontSize="14" FontWeight="Bold" Foreground="#702943"/>
                                            <TextBlock x:Name="TxtNewValidityPreview" Text="New Validity Period: October 18, 2026 to October 18, 2027" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Changes Diff Table -->
                                <Border Style="{StaticResource CardSection}" Padding="18">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="RE-ASSESSMENT SUMMARY &amp; AUDIT TRAIL" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SECTION / FIELD" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                            <TextBlock Grid.Column="1" Text="CURRENT VALUE" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                                            <TextBlock Grid.Column="2" Text="NEW VALUE (FOR RENEWAL)" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                        </Grid>
                                        <Border Height="1" Background="#EDE0E5" Margin="0,0,0,8"/>

                                        <ItemsControl x:Name="ReviewDiffList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontSize="12" FontWeight="SemiBold" Foreground="#222222"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding OldValue}" FontSize="12" Foreground="#777777" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding NewValue}" FontSize="12" FontWeight="{Binding NewValueWeight}" Foreground="{Binding NewValueColor}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Dependents Reconciliation Summary -->
                                        <Border Height="1" Background="#EDE0E5" Margin="0,12,0,10"/>
                                        <TextBlock x:Name="TxtDependentsReconcileSummary"
                                                   Text="Dependents: 2 active (0 added, 0 removed)"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ── 5. FOOTER ACTIONS ── -->
                    <Border Grid.Row="4" Background="White" BorderBrush="#EDE0E5" BorderThickness="0,1,0,0" Padding="28,14">
                        <Grid>
                            <Button x:Name="BtnBack" Content="← Back" Style="{StaticResource OutlineMaroonBtn}" HorizontalAlignment="Left" Click="BtnBack_Click" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource OutlineMaroonBtn}" Margin="0,0,10,0" Click="Close_Click"/>
                                <Button x:Name="BtnNext" Content="Next Step →" Style="{StaticResource PrimaryMaroonBtn}" Click="BtnNext_Click"/>
                                <Button x:Name="BtnSubmitRenew" Content="Confirm &amp; Renew Record" Style="{StaticResource PrimaryMaroonBtn}" Visibility="Collapsed" Click="BtnSubmitRenew_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
