<Window x:Class="SOLUM_UI.Views.Dialogs.RecycleBinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="960" Height="580"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Table Header Style -->
        <Style x:Key="RecycleHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#FBF1F4"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FBF1F4" BorderBrush="#EAD8DE" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecycleHeaderCenter" TargetType="GridViewColumnHeader" BasedOn="{StaticResource RecycleHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Table Row Style -->
        <Style x:Key="RecycleTableRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0E4E9"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <GridViewRowPresenter VerticalAlignment="Stretch" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#F8E9EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.18" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Search & Filter -->
                    <RowDefinition Height="*"/>    <!-- Row 2: DataGrid Table -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Grace Period Notice -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Footer -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="20,16,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                            Background="#F0E8EC" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                              Fill="#702943" Stretch="Uniform" Width="16" Height="16"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Deleted Records" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="Records in 30-day grace period pending permanent archival"
                                   FontFamily="Segoe UI" FontSize="11.5" Foreground="#666666" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="28" Height="28" Cursor="Hand" Click="BtnClose_Click" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="14">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="#702943" Stretch="Uniform" Width="9" Height="9"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#EBD5DC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── Search & Filter Controls ── -->
                <Grid Grid.Row="1" Margin="20,0,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Filter Box -->
                    <Border Grid.Column="0" Background="#FDF8FA" BorderBrush="#DCC4CC" BorderThickness="1.2" CornerRadius="17" Height="34" Padding="10,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearchFilter" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     FontSize="12.5" FontFamily="Segoe UI" Foreground="#111111" VerticalAlignment="Center"
                                     TextChanged="TxtSearchFilter_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="Filter by citizen name or PhilSys ID..."
                                       FontFamily="Segoe UI" FontSize="12.5" Foreground="#998890" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1" Width="34" Height="34" Margin="8,0,0,0" Cursor="Hand" Click="BtnRefresh_Click" ToolTip="Refresh Deleted Records">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#FFFFFF" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="17">
                                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                          Fill="#702943" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── Data Table Area ── -->
                <Border Grid.Row="2" Margin="20,0,20,8" BorderBrush="#EAD8DE" BorderThickness="1" CornerRadius="10" Background="White" ClipToBounds="True">
                    <Grid x:Name="RecycleTableGrid" SizeChanged="RecycleTableGrid_SizeChanged">
                        <!-- List View -->
                        <ListView x:Name="RecycleList" BorderThickness="0" Background="Transparent"
                                  ItemContainerStyle="{StaticResource RecycleTableRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource RecycleHeader}">
                                    <!-- Citizen Name -->
                                    <GridViewColumn Header="CITIZEN NAME" Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding FullName}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#111111" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PhilsysCardNumber, StringFormat='PhilSys: {0}'}" FontFamily="Segoe UI" FontSize="10.5" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Barangay -->
                                    <GridViewColumn Header="BARANGAY" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8EDF1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding Barangay}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#702943" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Deletion Date -->
                                    <GridViewColumn Header="DELETED" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeletionRequestedAt, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#444444" VerticalAlignment="Center" Margin="6,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Reason for Deletion -->
                                    <GridViewColumn Header="REASON FOR DELETION" Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeletionReasonDisplay}"
                                                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#222222"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DeletionReasonDisplay}"
                                                           VerticalAlignment="Center" Margin="6,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Grace Period Countdown -->
                                    <GridViewColumn Header="GRACE PERIOD" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="#92400E"/>
                                                                    <Setter Property="Data" Value="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                            <Setter Property="Fill" Value="#991B1B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding DaysRemainingText}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Action: 1-Click Reinstate -->
                                    <GridViewColumn Header="ACTION" Width="110" HeaderContainerStyle="{StaticResource RecycleHeaderCenter}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Height="26" Cursor="Hand" Click="BtnReinstate_Click" Tag="{Binding Id}" Margin="4,0" HorizontalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Background="#059669" CornerRadius="6" Padding="10,0">
                                                                <TextBlock Text="Reinstate" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#047857"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#F5EEF1" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                      Fill="#702943" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No deleted records" FontFamily="Segoe UI" FontSize="13.5" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                            <TextBlock Text="No solo parent records are currently in the 30-day deletion grace period."
                                       FontFamily="Segoe UI" FontSize="11.5" Foreground="#777777" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Loading Indicator -->
                        <Border x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Loading deleted records..." FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#702943"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Compact Statutory Grace Period Notice (Below Table) ── -->
                <Border Grid.Row="3" Margin="20,0,20,8" Background="#FAF2F5" BorderBrush="#EBD8DE" BorderThickness="1" CornerRadius="6" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                              Fill="#702943" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" FontFamily="Segoe UI" FontSize="11" Foreground="#555555" VerticalAlignment="Center">
                            <Bold Foreground="#702943">30-Day Grace Period:</Bold> Records can be reinstated anytime before automatic transfer to cold archives.
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ── Footer ── -->
                <Grid Grid.Row="4" Margin="20,0,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtFooterCount" Grid.Column="0" Text="0 records in grace period"
                               FontFamily="Segoe UI" FontSize="11.5" Foreground="#666666" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Discrete Access to Municipal Archives -->
                        <Button Height="30" Cursor="Hand" Click="BtnViewArchives_Click" Margin="0,0,10,0" Padding="14,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M3,3H21V7H3V3M4,8H20V21H4V8M9.5,11A1.5,1.5 0 0,0 8,12.5A1.5,1.5 0 0,0 9.5,14H14.5A1.5,1.5 0 0,0 16,12.5A1.5,1.5 0 0,0 14.5,11H9.5Z"
                                                  Fill="#702943" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="View Archives" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Height="30" Cursor="Hand" Click="BtnClose_Click" Padding="16,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Close" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
