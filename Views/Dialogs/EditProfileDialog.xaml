<Window x:Class="SOLUM_UI.Views.Dialogs.EditProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="520" Height="auto"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <SolidColorBrush x:Key="Maroon" Color="#702943"/>
        <SolidColorBrush x:Key="RoseTint" Color="#F4E8EC"/>
        <SolidColorBrush x:Key="MutedText" Color="#8B7480"/>
        <SolidColorBrush x:Key="InkText" Color="#2B1A22"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#E53935"/>
        
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#D4A0B0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource Maroon}" 
            BorderThickness="1.5" Padding="36,20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.24"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" 
                        Background="{StaticResource RoseTint}" Margin="0,0,16,0">
                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                          Fill="{StaticResource Maroon}" Stretch="Uniform" 
                          Width="24" Height="24"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Edit Profile" FontFamily="Segoe UI" FontSize="22" 
                               FontWeight="Bold" Foreground="{StaticResource InkText}"/>
                    <TextBlock Text="Update your account information" 
                               FontFamily="Segoe UI" FontSize="12.5" 
                               Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Form Fields -->
            <StackPanel Grid.Row="1">
                <!-- Full Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Full Name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtFullName" Style="{StaticResource FormInput}"/>
                    <TextBlock x:Name="ErrFullName" Text="Full name is required" 
                               Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Email Address *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource FormInput}"/>
                    <TextBlock x:Name="ErrEmail" Text="Invalid email address" 
                               Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Contact Number -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtContactNumber" Style="{StaticResource FormInput}" 
                             xmlns:behaviors="clr-namespace:SOLUM_UI.Behaviors"
                             behaviors:PhoneInputBehavior.IsEnabled="True"/>
                    <TextBlock x:Name="ErrContactNumber" Text="Invalid contact number format (09XXXXXXXXX)" 
                               Style="{StaticResource ErrorText}"/>
                </StackPanel>

                <!-- Info Note -->
                <Border Background="{StaticResource RoseTint}" CornerRadius="12" 
                        Padding="14,12" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Path Grid.Column="0" 
                              Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                              Fill="{StaticResource Maroon}" Stretch="Uniform" 
                              Width="18" Height="18" Margin="0,0,12,0"
                              VerticalAlignment="Top" Opacity="0.7"/>
                        
                        <TextBlock Grid.Column="1" 
                                   Text="Your role, email, and barangay assignment can only be changed by an administrator."
                                   FontFamily="Segoe UI" FontSize="11.5" 
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap" LineHeight="16"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cancel Button -->
                <Button x:Name="BtnCancel" Grid.Column="1" Height="44" Padding="26,0" 
                        Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="22"
                                    BorderBrush="#D4A0B0" BorderThickness="1.5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FAFAFA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13" 
                               FontWeight="SemiBold" Foreground="{StaticResource Maroon}"/>
                </Button>

                <!-- Save Button -->
                <Button x:Name="BtnSave" Grid.Column="2" Height="44" Padding="32,0" 
                        Cursor="Hand" Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{StaticResource Maroon}" CornerRadius="22"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" 
                                                      Direction="270" Opacity="0.28" 
                                                      Color="#702943"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Save Changes" FontFamily="Segoe UI" FontSize="13" 
                               FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
