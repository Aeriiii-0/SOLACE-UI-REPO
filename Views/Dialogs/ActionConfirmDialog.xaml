<Window x:Class="SOLUM_UI.Views.Dialogs.ActionConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="460" SizeToContent="Height">

    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Icon / Title -->
                <StackPanel Grid.Row="0" Margin="32,28,32,0" HorizontalAlignment="Center">
                    <Border x:Name="IconCircle" Width="54" Height="54" CornerRadius="27"
                            Background="#F0E8EC" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path x:Name="IconPath"
                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                              Fill="#702943" Stretch="Uniform" Width="24" Height="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="Confirm Action" FontFamily="Segoe UI"
                               FontSize="20" FontWeight="Bold" Foreground="#111111"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>

                <!-- Message Body -->
                <StackPanel Grid.Row="1" Margin="32,14,32,24">
                    <TextBlock x:Name="TxtMessage"
                               Text="Are you sure you want to proceed with this action?"
                               FontFamily="Segoe UI" FontSize="13.5" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                </StackPanel>

                <!-- Action Buttons Footer -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="28,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button x:Name="BtnCancel" Grid.Column="0" Height="42" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="8"
                                            BorderBrush="#DDDDDD" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtCancelBtn" Text="Cancel" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#555555"/>
                        </Button>

                        <!-- Confirm Action Button -->
                        <Button x:Name="BtnConfirm" Grid.Column="2" Height="42" Cursor="Hand" Click="BtnConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtConfirmBtn" Text="Confirm" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
