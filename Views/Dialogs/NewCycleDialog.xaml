<Window x:Class="SOLUM_UI.Views.Dialogs.NewCycleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="480" SizeToContent="Height">

    <Border Background="Transparent" Padding="16">
        <Border Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Title -->
                <StackPanel Grid.Row="0" Margin="28,24,28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#F0E8EC" Margin="0,0,12,0">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start New Subsidy Cycle" FontSize="18" FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Archives the current cycle and sets up a new funding quota" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,14,0,0" Background="#F0E2E7"/>
                </StackPanel>

                <!-- Form Fields -->
                <StackPanel Grid.Row="1" Margin="28,16,28,20">
                    <!-- Fiscal Year -->
                    <TextBlock Text="Fiscal Year" FontSize="11.5" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFiscalYear" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                             FontSize="12.5" BorderBrush="#D4A0B0" BorderThickness="1"/>

                    <!-- Target Beneficiary Quota -->
                    <TextBlock Text="Target Beneficiary Quota (Number of Grantees)" FontSize="11.5" FontWeight="SemiBold" Foreground="#444444" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtGrantees" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                             FontSize="12.5" BorderBrush="#D4A0B0" BorderThickness="1" TextChanged="Inputs_Changed"/>

                    <!-- Per Grantee Allowance -->
                    <TextBlock Text="Monthly Allowance Per Beneficiary (₱)" FontSize="11.5" FontWeight="SemiBold" Foreground="#444444" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtPerGrantee" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                             FontSize="12.5" BorderBrush="#D4A0B0" BorderThickness="1" TextChanged="Inputs_Changed"/>

                    <!-- Computed Total Budget Preview -->
                    <Border Background="#FDF8FA" CornerRadius="8" BorderBrush="#E5D5DC" BorderThickness="1" Padding="12,10" Margin="0,16,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Calculated Total Budget" FontSize="11" Foreground="#888888"/>
                                <TextBlock x:Name="TxtBudgetPreview" Text="₱100,000.00" FontSize="14" FontWeight="Bold" Foreground="#702943" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Auto-Computed" FontSize="10" Foreground="#A06080" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="28,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="38" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="White" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1.5">
                                        <TextBlock Text="Cancel" FontSize="12.5" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Height="38" Cursor="Hand" Click="BtnLaunch_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#702943" CornerRadius="8">
                                        <TextBlock Text="Launch Cycle" FontSize="12.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
