<Window x:Class="SOLUM_UI.Views.Dialogs.ReactivateCitizenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="660" Height="680"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SolaceInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CharacterCasing" Value="Upper"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B3555"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SolaceInputMulti" TargetType="TextBox" BasedOn="{StaticResource SolaceInput}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Solace Themed ComboBox -->
        <Style x:Key="SolaceCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M7,10L12,15L17,10H7Z" Fill="#702943" Width="11" Height="11"
                                          Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1.5"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Padding="4" Margin="0,0,8,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8B3555"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent" CornerRadius="6" Margin="2,1" Padding="12,8">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#FAF2F5"/>
                                            <Setter Property="Foreground" Value="#702943"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#F3E5EB"/>
                                            <Setter Property="Foreground" Value="#702943"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Notice Banner -->
                    <RowDefinition Height="*"/>    <!-- Form Body -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#F0E8EC" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                              Fill="#702943" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reactivate Record" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="Restore archived solo parent with a fresh 1-year card validity term"
                                   FontFamily="Segoe UI" FontSize="12.5" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="32" Height="32" Cursor="Hand" Click="BtnCancel_Click" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="16">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="#702943" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#EBD5DC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── Solace Themed Notice Banner ── -->
                <Border Grid.Row="1" Margin="28,0,28,14" Background="#FDF8FA" BorderBrush="#EBD8DE" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                              Fill="#702943" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" FontFamily="Segoe UI" FontSize="12" Foreground="#444444" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="17">
                            <Bold Foreground="#702943">Re-Assessment &amp; Validity Renewal:</Bold> Reactivation restores this record from cold storage back to the active directory, issuing a new 1-year Card Term validity starting today.
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ── Form Body ── -->
                <ScrollViewer Grid.Row="2" Margin="28,0,28,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <!-- Card 1: Livelihood & Assessment Information -->
                        <Border Background="White" CornerRadius="10" BorderBrush="#EDE0E5" BorderThickness="1" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <Border BorderBrush="#702943" BorderThickness="3.5,0,0,0" Padding="8,0" Margin="0,0,0,14">
                                    <TextBlock Text="LIVELIHOOD &amp; ASSESSMENT" FontSize="11" FontWeight="Bold" Foreground="#702943" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- Employment Status & Monthly Income -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Employment Status *" Style="{StaticResource FormLabel}"/>
                                        <ComboBox x:Name="CmbEmploymentStatus" Style="{StaticResource SolaceCombo}">
                                            <ComboBoxItem Content="Employed" IsSelected="True"/>
                                            <ComboBoxItem Content="Self-Employed"/>
                                            <ComboBoxItem Content="Unemployed"/>
                                            <ComboBoxItem Content="Part-Time / Seasonal"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Monthly Income (PHP) *" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtMonthlyIncome" Text="0.00" Style="{StaticResource SolaceInput}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Occupation -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Current Occupation / Source of Livelihood *" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtOccupation" Style="{StaticResource SolaceInput}"/>
                                </StackPanel>

                                <!-- Other Sources of Income -->
                                <StackPanel>
                                    <TextBlock Text="Other Sources of Income" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtOtherIncome" Style="{StaticResource SolaceInput}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Reactivation Justification -->
                        <Border Background="White" CornerRadius="10" BorderBrush="#EDE0E5" BorderThickness="1" Padding="18,16" Margin="0,0,0,4">
                            <StackPanel>
                                <Border BorderBrush="#702943" BorderThickness="3.5,0,0,0" Padding="8,0" Margin="0,0,0,14">
                                    <TextBlock Text="REACTIVATION JUSTIFICATION" FontSize="11" FontWeight="Bold" Foreground="#702943" FontFamily="Segoe UI"/>
                                </Border>

                                <!-- Needs and Problems -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Assistance Needs &amp; Problems Presented" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtNeedsAndProblems" Style="{StaticResource SolaceInputMulti}"/>
                                </StackPanel>

                                <!-- Reactivation Notes / Reason -->
                                <StackPanel>
                                    <TextBlock Text="Reactivation Justification Notes *" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtReactivationNotes" Style="{StaticResource SolaceInputMulti}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Footer Actions ── -->
                <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="28,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button Grid.Column="0" Height="42" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="10">
                                        <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Submit Button (On-Theme Solace Maroon) -->
                        <Button Grid.Column="2" Height="42" Cursor="Hand" Click="BtnSubmit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <TextBlock Text="Confirm Reactivation" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#5A1F34"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
