<Window x:Class="SOLUM_UI.Views.Dialogs.RecordViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeChanged="Window_SizeChanged"
        Closing="Window_Closing" Width="920" Height="780">

    <Window.Resources>
        <Style x:Key="SegmentTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="#E8D8DE"/>
                                <Setter Property="Foreground" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#60000000">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="3" Opacity="0.18" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- â”€â”€ Dialog Shell â”€â”€ -->
                <Border x:Name="DialogShell" Grid.Column="0"
                        Background="#FDFBFC" CornerRadius="14"
                        TextOptions.TextFormattingMode="Display"
                        RenderOptions.ClearTypeHint="Enabled"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DialogShellTransform"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#702943" CornerRadius="14,14,0,0" Padding="24,13">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Profile Details"
                                               FontSize="14" FontWeight="Bold" Foreground="White"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="Solo Parent Record"
                                               FontSize="10" Foreground="#E8C0D0"
                                               FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="26" Height="26" BorderThickness="0"
                                        Background="Transparent" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="13">
                                                <TextBlock Text="&#x2715;" FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#9B3060"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="White"
                                      PanningMode="VerticalOnly"
                                      CanContentScroll="False"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <StackPanel Margin="22,18,22,18">
                                <Border Background="White" CornerRadius="12"
                                        BorderBrush="#E8D4DA" BorderThickness="1.2"
                                        Padding="20,16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRecordName" Text=""
                                                       FontSize="18" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"
                                                       FontFamily="Segoe UI" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSexAge" Text=""
                                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"
                                                           FontFamily="Segoe UI"/>
                                                <TextBlock Text=" • " FontSize="12" Foreground="#CBD5E1" Margin="4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBarangayBadge" Text=""
                                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#702943"
                                                           FontFamily="Segoe UI"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtContact" Text=""
                                                       FontSize="12" Foreground="#64748B"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border x:Name="StatusBadge"
                                                    CornerRadius="12" Padding="10,4"
                                                    HorizontalAlignment="Right" Margin="0,0,0,5"
                                                    Background="#E8F8EE" BorderBrush="#A5D6A7" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#2E7D32" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtStatusBadge" Text=""
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="#1B5E20" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="ValidityBadge"
                                                    CornerRadius="12" Padding="10,3.5"
                                                    HorizontalAlignment="Right"
                                                    Background="#FAF0F3" BorderBrush="#DF9BB1" BorderThickness="1">
                                                <TextBlock x:Name="TxtValidUntil" Text=""
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#702943" FontFamily="Segoe UI"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Segmented View Navigation Tabs -->
                                <Border Background="#F1E4E8" CornerRadius="8" Padding="3" Margin="0,0,0,14" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TabProfile"
                                                     Content="Profile Details"
                                                     IsChecked="True"
                                                     GroupName="RecordViewTabs"
                                                     Style="{StaticResource SegmentTabStyle}"
                                                     Click="TabProfile_Click"/>
                                        <RadioButton x:Name="TabTimeline"
                                                     Content="Activity History / Timeline"
                                                     IsChecked="False"
                                                     GroupName="RecordViewTabs"
                                                     Style="{StaticResource SegmentTabStyle}"
                                                     Click="TabTimeline_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- CardPanel (Profile Details View) -->
                                <StackPanel x:Name="CardPanel"/>

                                <!-- TimelineContainer (Activity History View) -->
                                <StackPanel x:Name="TimelineContainer" Visibility="Collapsed" Margin="0,2,0,0">
                                    <!-- Header with title & refresh button -->
                                    <Border Background="White" CornerRadius="12" BorderBrush="#E8D4DA" BorderThickness="1.2"
                                            Padding="18,14" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3.5" Height="14" CornerRadius="2" Background="#702943" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CITIZEN AUDIT &amp; ACTIVITY TIMELINE"
                                                               FontSize="12" FontWeight="Bold" Foreground="#702943" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Chronological event history, profile updates, and annual renewals for this record."
                                                           FontSize="11.5" Foreground="#64748B" FontFamily="Segoe UI" Margin="11.5,3,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnRefreshTimeline" Grid.Column="1"
                                                    Click="BtnRefreshTimeline_Click"
                                                    Height="32" Padding="12,0" Cursor="Hand"
                                                    Background="#FDF2F5" BorderBrush="#E0CDD5" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="↻" FontSize="13" Foreground="#702943" Margin="0,0,6,0" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Refresh" FontSize="11.5" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#F5DDE5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Timeline Loading State -->
                                    <Border x:Name="TimelineLoadingPanel" Background="White" CornerRadius="12" BorderBrush="#E8D4DA" BorderThickness="1.2"
                                            Padding="24,36" Margin="0,0,0,14" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Loading activity timeline..." FontSize="13.5" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Retrieving audit history from server..." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Timeline Empty State -->
                                    <Border x:Name="TimelineEmptyPanel" Background="White" CornerRadius="12" BorderBrush="#E8D4DA" BorderThickness="1.2"
                                            Padding="24,36" Margin="0,0,0,14" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="#F8EDF1" Margin="0,0,0,12" HorizontalAlignment="Center">
                                                <TextBlock Text="🕒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="No activity history recorded yet" FontSize="14" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="There are no audit events or modification logs registered for this citizen profile."
                                                       FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Timeline Error State -->
                                    <Border x:Name="TimelineErrorPanel" Background="#FEF2F2" CornerRadius="12" BorderBrush="#FECACA" BorderThickness="1.2"
                                            Padding="20,16" Margin="0,0,0,14" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Failed to load timeline" FontSize="13" FontWeight="Bold" Foreground="#B91C1C"/>
                                                <TextBlock x:Name="TxtTimelineError" Text="Network error" FontSize="11.5" Foreground="#7F1D1D" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="BtnRefreshTimeline_Click"
                                                    Content="Try Again" Height="30" Padding="14,0" Cursor="Hand"
                                                    Background="#B91C1C" Foreground="White" BorderThickness="0"
                                                    FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Dynamic Timeline Nodes Panel -->
                                    <StackPanel x:Name="TimelineItemsPanel"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#D0B8C0"
                                BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="22,12">
                            <Grid>
                                <TextBlock x:Name="TxtSpId"
                                           FontSize="12" Foreground="#A06080"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"
                                           FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <Button HorizontalAlignment="Right" Height="38" Padding="28,0"
                                        Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#702943" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Close" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Segoe UI"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Delete confirmation overlay â€” spans all 3 rows, sits on top -->
                        <!-- Visibility is driven by IsDeleteOverlayVisible on the VM;
                             the toolbar's Delete_Click sets it via HandleDeleteRequest(). -->
                        <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DeleteConfirmOverlay"
                              Visibility="{Binding IsDeleteOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                              Panel.ZIndex="99">
                            <Rectangle Fill="#88000000" RadiusX="14" RadiusY="14"/>
                            <Border Background="White" CornerRadius="14"
                                    Padding="32,28" Width="360"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.22"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Width="48" Height="48" CornerRadius="24"
                                            Background="#FFF0EE" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Fill="#E74C3C" Stretch="Uniform" Width="22" Height="22"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Danger: Are you sure?"
                                               FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                               Foreground="#E74C3C" HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Are you sure you want to delete this record? This action is permanent and cannot be undone."
                                               FontFamily="Segoe UI" FontSize="12" Foreground="#666666"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="40" Cursor="Hand"
                                                Click="DeleteCancel_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#F5F0F2" CornerRadius="10"
                                                            BorderBrush="#DCC8CE" BorderThickness="1.2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#702943"/>
                                        </Button>
                                        <Button Grid.Column="2" Height="40" Cursor="Hand"
                                                Click="DeleteConfirm_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#E74C3C" CornerRadius="10">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#E74C3C" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="Yes, Delete" FontFamily="Segoe UI" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ── Notification card overlay – floats at bottom-right ── -->
                        <!-- Bound to VM: IsNotificationVisible, NotificationTitle,   -->
                        <!-- NotificationMessage, IsNotificationSuccess.              -->
                        <components:NotificationCardComponent
                            Grid.Row="0" Grid.RowSpan="3"
                            Panel.ZIndex="100"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="0,0,16,16"
                            Title="{Binding NotificationTitle}"
                            Message="{Binding NotificationMessage}"
                            IsSuccess="{Binding IsNotificationSuccess}"
                            Visibility="{Binding IsNotificationVisible,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                    </Grid>
                </Border>

                <!-- â”€â”€ Vertical Action Toolbar (extracted to RecordActionToolbar UserControl) â”€â”€ -->
                <components:RecordActionToolbar Grid.Column="1"/>

            </Grid>
        </Border>
    </Border>
</Window>
