<Window x:Class="SOLUM_UI.Views.Dialogs.RecordViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeChanged="Window_SizeChanged"
        Closing="Window_Closing" Width="920" Height="780"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <Style x:Key="UnderlineTabStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#6B6470"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2,9,2,10"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Underline" Height="2.5" VerticalAlignment="Bottom"
                                    Background="#702943" CornerRadius="2,2,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#702943"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="#702943"
                                BorderThickness="1.2" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Actions" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#702943" VerticalAlignment="Center"/>
                                <Path Data="M0,0 L4,4 L8,0" Stroke="#702943" StrokeThickness="1.6"
                                      Width="8" Height="5" Stretch="Fill" Margin="8,2,0,0"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8ECF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F6F1F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#60000000">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border CornerRadius="18" Background="White" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="3" Opacity="0.18" RenderingBias="Quality"/>
                </Border.Effect>
            </Border>
            <Border x:Name="DialogShell"
                    Background="White" BorderBrush="#702943" BorderThickness="1.5" CornerRadius="18"
                    TextOptions.TextFormattingMode="Display"
                    RenderOptions.ClearTypeHint="Enabled"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DialogShellTransform"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#EDE6EA" BorderThickness="0,0,0,1" Padding="26,16,22,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="Profile details" FontSize="17" FontWeight="Bold"
                                       Foreground="#1B1722" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <Border Width="1.5" Height="18" Background="#D9D2D6" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Solo parent record" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#6B6470" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton x:Name="BtnActions" Style="{StaticResource ActionsToggleStyle}"/>
                                <Popup x:Name="ActionsPopup"
                                   PlacementTarget="{Binding ElementName=BtnActions}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Opened="ActionsPopup_Opened"
                                   IsOpen="{Binding IsChecked, ElementName=BtnActions, Mode=TwoWay}">
                                    <Border Width="168" Background="White" BorderBrush="#E6E0E3" BorderThickness="1"
                                        CornerRadius="10" Padding="5" Margin="12,6,12,18">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.16"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button Style="{StaticResource MenuItemStyle}" Click="MenuRenew_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z"
                                                      Fill="#15803D" Stretch="Uniform" Width="13" Height="13"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Renew record" FontFamily="Segoe UI" FontSize="12.5"
                                                           FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MenuItemStyle}" Click="MenuEdit_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Fill="#D97706" Stretch="Uniform" Width="13" Height="13"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Edit record" FontFamily="Segoe UI" FontSize="12.5"
                                                           FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Height="1" Background="#EDE6EA" Margin="6,4,6,4"/>
                                            <Button Style="{StaticResource MenuItemStyle}" Click="MenuDelete_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Fill="#C62828" Stretch="Uniform" Width="13" Height="13"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Delete record" FontFamily="Segoe UI" FontSize="12.5"
                                                           FontWeight="SemiBold" Foreground="#C62828" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Grid Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False">
                                    <components:RecordActionToolbar x:Name="HiddenToolbar"/>
                                </Grid>
                                <Button Width="30" Height="30" BorderThickness="0" Background="Transparent"
                                    Cursor="Hand" Margin="8,0,0,0" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="#F3EEF0" CornerRadius="15">
                                                <TextBlock Text="&#x2715;" FontSize="11" Foreground="#1B1722"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#E8DDE2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="White"
                                  PanningMode="VerticalOnly"
                                  CanContentScroll="False"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <StackPanel Margin="26,15,26,20">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtRecordName" Text=""
                                               FontSize="23" FontWeight="SemiBold" Foreground="#1B1722" TextWrapping="Wrap"
                                               FontFamily="Segoe UI" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSexAge" Text=""
                                                   FontSize="12.5" Foreground="#6B6470" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="·" FontSize="12.5" Foreground="#6B6470" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBarangayBadge" Text=""
                                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#702943"
                                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        <TextBlock Text="·" FontSize="12.5" Foreground="#6B6470" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtContact" Text=""
                                                   FontSize="12.5" Foreground="#6B6470" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="ValidityBadge" Width="210" VerticalAlignment="Top"
                                        Background="White" BorderBrush="#D9D2D6" BorderThickness="1"
                                        CornerRadius="10" Padding="12,7,12,8" Margin="20,5,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtStatusBadge" Grid.Column="0" Text=""
                                                       FontSize="12" FontWeight="Bold" Foreground="#16794C"
                                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDaysLeft" Grid.Column="1" Text=""
                                                       FontSize="11" FontWeight="Normal" Foreground="#6B6470"
                                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border x:Name="ProgressTrack" Height="6" CornerRadius="3"
                                                Background="#D8F0E3" Margin="0,5,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ProgressFillCol" Width="0*"/>
                                                    <ColumnDefinition x:Name="ProgressRestCol" Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ProgressFill" Grid.Column="0" CornerRadius="3" Background="#0F6B43"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Expires " FontSize="11" Foreground="#6B6470" FontFamily="Segoe UI"/>
                                            <TextBlock x:Name="TxtValidUntil" Text=""
                                                       FontSize="11" FontWeight="Bold" Foreground="#1B1722" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border BorderBrush="#E6E0E3" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,-1">
                                    <RadioButton x:Name="TabProfile"
                                                 Content="Profile details"
                                                 IsChecked="True"
                                                 GroupName="RecordViewTabs"
                                                 Style="{StaticResource UnderlineTabStyle}"
                                                 Click="TabProfile_Click"/>
                                    <RadioButton x:Name="TabTimeline"
                                                 Content="Activity history / Timeline"
                                                 IsChecked="False"
                                                 GroupName="RecordViewTabs"
                                                 Style="{StaticResource UnderlineTabStyle}"
                                                 Click="TabTimeline_Click"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="CardPanel"/>
                            <Border x:Name="TimelineContainer" Visibility="Collapsed"
                                    Background="White" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="12">
                                <StackPanel>
                                    <Border Background="#F8ECF0" BorderBrush="#702943" BorderThickness="0,0,0,1"
                                            CornerRadius="11,11,0,0" Padding="16,10">
                                        <TextBlock Text="CITIZEN AUDIT &amp; ACTIVITY TIMELINE"
                                                   FontSize="11" FontWeight="Bold" Foreground="#702943" FontFamily="Segoe UI"/>
                                    </Border>
                                    <Grid Margin="16,10,16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Chronological event history, profile updates, and annual renewals for this record."
                                                   FontSize="12" Foreground="#6B6470" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="BtnRefreshTimeline" Grid.Column="1"
                                                Click="BtnRefreshTimeline_Click"
                                                Height="28" Padding="12,0" Cursor="Hand" Margin="12,0,0,0"
                                                Background="White" BorderBrush="#702943" BorderThickness="1.2"
                                                VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="↻" FontSize="12" Foreground="#702943" Margin="0,-1,6,0"
                                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Refresh" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#702943" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" Background="#EDE6EA" Margin="16,0,16,0"/>
                                    <Border x:Name="TimelineLoadingPanel" Padding="20,36" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Loading activity timeline..." FontSize="14" FontWeight="Bold"
                                                       Foreground="#702943" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Retrieving audit history from server..." FontSize="11.5"
                                                       Foreground="#6B6470" FontFamily="Segoe UI" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="TimelineEmptyPanel" Padding="20,40" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="No activity history recorded yet" FontSize="17" FontWeight="Bold"
                                                       Foreground="#1B1722" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                            <TextBlock Text="There are no audit events or modification logs registered for this citizen profile."
                                                       FontSize="12.5" Foreground="#6B6470" FontFamily="Segoe UI"
                                                       Margin="0,6,0,0" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="TimelineErrorPanel" Background="#FEF2F2" CornerRadius="10"
                                            BorderBrush="#FECACA" BorderThickness="1.2"
                                            Padding="16,12" Margin="16,16,16,16" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Failed to load timeline" FontSize="12.5" FontWeight="Bold"
                                                           Foreground="#B91C1C" FontFamily="Segoe UI"/>
                                                <TextBlock x:Name="TxtTimelineError" Text="Network error" FontSize="11.5"
                                                           Foreground="#7F1D1D" FontFamily="Segoe UI" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="BtnRefreshTimeline_Click"
                                                    Content="Try Again" Height="28" Padding="14,0" Cursor="Hand"
                                                    Background="#B91C1C" Foreground="White" BorderThickness="0"
                                                    FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <StackPanel x:Name="TimelineItemsPanel" Margin="16,14,16,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="White" BorderBrush="#EDE6EA"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,17,17" Padding="26,10">
                        <Grid>
                            <TextBlock x:Name="TxtSpId" Visibility="Collapsed"
                                       FontSize="12" Foreground="#A06080"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"
                                       FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <Button HorizontalAlignment="Right" Height="32" Padding="26,0"
                                    Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#702943" CornerRadius="16"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Close" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="White" FontFamily="Segoe UI"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DeleteConfirmOverlay"
                          Visibility="{Binding IsDeleteOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                          Panel.ZIndex="99">
                        <Rectangle Fill="#88000000" RadiusX="18" RadiusY="18"/>
                        <Border Background="White" CornerRadius="16" BorderBrush="#C62828" BorderThickness="1.5"
                                Padding="32,28" Width="520"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Width="54" Height="54" CornerRadius="27"
                                        Background="#FFEBEE" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                          Fill="#C62828" Stretch="Uniform" Width="24" Height="24"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Delete Record"
                                           FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                           Foreground="#111111" HorizontalAlignment="Center"
                                           Margin="0,0,0,0"/>
                                <TextBlock Text="Are you sure you want to delete this record? This action is permanent and cannot be undone."
                                           FontFamily="Segoe UI" FontSize="14" Foreground="#666666"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" Margin="0,16,0,28" LineHeight="22"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="48" Cursor="Hand"
                                            Click="DeleteCancel_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="White" CornerRadius="10"
                                                        BorderBrush="#C62828" BorderThickness="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#FFF0F1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#C62828"/>
                                    </Button>
                                    <Button Grid.Column="2" Height="48" Cursor="Hand"
                                            Click="DeleteConfirm_Click" Background="#C62828">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                                        BorderBrush="#C62828" BorderThickness="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="Yes, Delete" FontFamily="Segoe UI" FontSize="14"
                                                   FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <components:NotificationCardComponent
                        Grid.Row="0" Grid.RowSpan="3"
                        Panel.ZIndex="100"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,16,16"
                        Title="{Binding NotificationTitle}"
                        Message="{Binding NotificationMessage}"
                        IsSuccess="{Binding IsNotificationSuccess}"
                        Visibility="{Binding IsNotificationVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
