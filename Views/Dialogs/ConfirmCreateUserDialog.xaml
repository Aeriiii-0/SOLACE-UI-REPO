<Window x:Class="SOLUM_UI.Views.Dialogs.ConfirmCreateUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="500" SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Global crispy text rendering -->
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
    </Window.Resources>
    <Border Background="Transparent" Padding="16">
        <Border Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True"
                UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Icon / Title -->
                <StackPanel Grid.Row="0" Margin="32,26,32,0" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#F0E8EC" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"
                              Fill="#702943" Stretch="Uniform" Width="26" Height="26"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtHeading" Text="Confirm New User Account" FontFamily="Segoe UI"
                               FontSize="20" FontWeight="Bold" Foreground="#111111"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSubheading" Text="Please review the user account details before creating."
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Details Card -->
                <StackPanel Grid.Row="1" Margin="28,18,28,20">
                    <Border Background="#FDF8F9" CornerRadius="12"
                            BorderBrush="#E8D2DA" BorderThickness="1.5" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="USER ACCOUNT DETAILS" FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="Bold" Foreground="#702943" Margin="0,0,0,12"/>

                            <!-- Full Name -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Full Name" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFullName" Text="JUANA DELA CRUZ" FontFamily="Segoe UI"
                                           FontSize="13" FontWeight="Bold" Foreground="#111111" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Role / Position -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Position / Role" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <Border Background="#F0E8EC" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtRole" Text="CASEWORKER (ENCODER)" FontFamily="Segoe UI"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#702943"/>
                                </Border>
                            </Grid>

                            <!-- Scope / Assigned Barangay -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Assigned Scope" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtScope" Text="Citywide (All Barangays)" FontFamily="Segoe UI"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Background="#EFE0E5" Margin="0,4,0,10"/>

                            <!-- Email -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Email Address" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEmail" Text="user@solace.gov.ph" FontFamily="Segoe UI"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#111111" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Contact Number -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Contact Number" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtContact" Text="09171234567" FontFamily="Segoe UI"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#111111" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Temporary Password -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Initial Password" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#D4A0B0" BorderThickness="1"
                                        Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtPassword" Text="Solace#2026!" FontFamily="Consolas"
                                               FontSize="12.5" FontWeight="Bold" Foreground="#702943"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notice Banner -->
                    <Border Background="#F9F9FB" CornerRadius="8" BorderBrush="#E4E4EC" BorderThickness="1"
                            Padding="12,9" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                  Fill="#702943" Stretch="Uniform" Width="15" Height="15"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Upon confirmation, the system will register this account and display credentials you can copy for the employee."
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#555555" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Action Buttons -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="28,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button x:Name="BtnCancel" Grid.Column="0" Height="44" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="20"
                                            BorderBrush="#D0D0D0" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="#444444"/>
                        </Button>

                        <!-- Confirm Create Button -->
                        <Button x:Name="BtnConfirm" Grid.Column="2" Height="44" Cursor="Hand" Click="BtnConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"
                                      Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Create Account" FontFamily="Segoe UI" FontSize="13.5"
                                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
