<Window x:Class="SOLUM_UI.Views.Dialogs.AccountCreatedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="480" SizeToContent="Height">

    <Border Background="Transparent" Padding="16">
        <Border Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Success Icon / Title -->
                <StackPanel Grid.Row="0" Margin="32,26,32,0" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#EBF6EE" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z"
                              Fill="#2E7D32" Stretch="Uniform" Width="26" Height="26"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtHeading" Text="User Account Created" FontFamily="Segoe UI"
                               FontSize="20" FontWeight="Bold" Foreground="#111111"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtSubheading" Text="The user account has been registered. Share the credentials below with the employee."
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Credentials Card -->
                <StackPanel Grid.Row="1" Margin="28,18,28,20">
                    <Border Background="#FDF8F9" CornerRadius="12"
                            BorderBrush="#E8D2DA" BorderThickness="1.5" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="LOGIN CREDENTIALS" FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="Bold" Foreground="#702943" Margin="0,0,0,12"/>

                            <!-- Name -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Full Name" FontFamily="Segoe UI" FontSize="12" Foreground="#777777"/>
                                <TextBlock x:Name="TxtFullName" Text="Juana Dela Cruz" FontFamily="Segoe UI"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#111111" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Role -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Position / Role" FontFamily="Segoe UI" FontSize="12" Foreground="#777777"/>
                                <TextBlock x:Name="TxtRole" Text="Encoder" FontFamily="Segoe UI"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Background="#EFE0E5" Margin="0,4,0,10"/>

                            <!-- Email -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Email Address" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEmail" Text="juana@solace.gov.ph" FontFamily="Segoe UI"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#111111" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Temporary Password -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Temporary Password" FontFamily="Segoe UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/>
                                <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#D4A0B0" BorderThickness="1"
                                        Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtPassword" Text="Solace#2026!" FontFamily="Consolas"
                                               FontSize="13.5" FontWeight="Bold" Foreground="#702943"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notice banner -->
                    <Border Background="#FFF9E6" CornerRadius="8" BorderBrush="#FFE082" BorderThickness="1"
                            Padding="12,9" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M11,15H13V17H11V15M11,7H13V13H11V7M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z"
                                  Fill="#B78103" Stretch="Uniform" Width="14" Height="14"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="For security, this temporary password cannot be viewed again once you close this window. Please advise the user to change their password upon first login."
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#855B00" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Action Buttons -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="28,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Copy Credentials Button -->
                        <Button x:Name="BtnCopy" Grid.Column="0" Height="42" Cursor="Hand" Click="BtnCopy_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                      Fill="White" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCopyBtn" Text="Copy Credentials" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Done Button -->
                        <Button x:Name="BtnDone" Grid.Column="2" Width="100" Height="42" Cursor="Hand" Click="BtnDone_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="8"
                                            BorderBrush="#D0D0D0" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Done" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#444444"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
