<Window x:Class="SOLUM_UI.Views.Dialogs.CancelRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="540" SizeToContent="Height">
    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#C62828" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Header / Icon / Title -->
                <StackPanel Grid.Row="0" Margin="32,28,32,0" HorizontalAlignment="Center">
                    <Border x:Name="IconCircle" Width="54" Height="54" CornerRadius="27"
                            Background="#FFEBEE" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                              Fill="#C62828" Stretch="Uniform" Width="24" Height="24"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Cancel Application" FontFamily="Segoe UI"
                               FontSize="22" FontWeight="Bold" Foreground="#111111"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
                <!-- Message Body -->
                <StackPanel Grid.Row="1" Margin="32,16,32,28">
                    <TextBlock Text="You are about to cancel this solo parent application. The applicant can reapply after one (1) year."
                               FontFamily="Segoe UI" FontSize="14" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="0,0,0,18"/>
                    
                    <TextBlock Text="Reason for cancellation" FontFamily="Segoe UI" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtReason" 
                             Height="80" Padding="12,10" FontFamily="Segoe UI" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             BorderBrush="#C0A0AA" BorderThickness="1.2" Background="White"
                             VerticalContentAlignment="Top">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#702943"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="TxtError" Text="" FontFamily="Segoe UI" FontSize="11.5"
                               Foreground="#C62828" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <!-- Action Buttons Footer -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="28,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Cancel Button -->
                        <Button x:Name="BtnCancel" Grid.Column="0" Height="48" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="10"
                                            BorderBrush="#C62828" BorderThickness="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FFEBEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Go Back" FontFamily="Segoe UI" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#C62828"/>
                        </Button>
                        <!-- Confirm Action Button -->
                        <Button x:Name="BtnConfirm" Grid.Column="2" Height="48" Cursor="Hand" Click="BtnConfirm_Click" Background="#C62828">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                            BorderBrush="#C62828" BorderThickness="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel Application" FontFamily="Segoe UI" FontSize="14"
                                       FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
