<Window x:Class="SOLUM_UI.Views.Dialogs.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOLUM UI Update"
        Width="520" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Modern ProgressBar Style -->
        <Style x:Key="SolumProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#F2E4E9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border Name="PART_Indicator" Background="#702943" CornerRadius="5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Card Container with Drop Shadow -->
    <Border Background="White" CornerRadius="16" BorderBrush="#E0D0D5" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#702943" BlurRadius="22" ShadowDepth="4" Opacity="0.16"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar (Draggable) -->
            <Border Grid.Row="0" Background="#702943" CornerRadius="14,14,0,0" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cloud / Update Icon -->
                        <Path Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14A6,6 0 0,0 6,20H19A5,5 0 0,0 24,15C24,12.36 21.95,10.22 19.35,10.04M13,13V17H11V13H8L12,9L16,13H13Z"
                              Fill="White" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Software Update" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#8A3756"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Content Body Area -->
            <Grid Grid.Row="1" Margin="24,20,24,22">

                <!-- VIEW A: Update Available Prompt -->
                <Grid x:Name="PnlPrompt" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Subtitle -->
                    <TextBlock Grid.Row="0" Text="A New Version is Available!" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#111111" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Text="An update is ready to download for SOLUM UI." FontSize="12.5" Foreground="#666666" Margin="0,26,0,12"/>

                    <!-- Version Chips Card -->
                    <Border Grid.Row="1" Background="#FAF4F6" BorderBrush="#EBD9DF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Installed:" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="#ECEFF1" CornerRadius="6" Padding="8,3">
                                    <TextBlock x:Name="TxtInstalledVersion" Text="v0.0.1" FontSize="12" FontWeight="SemiBold" Foreground="#37474F"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="➔" FontSize="13" Foreground="#888888" VerticalAlignment="Center" Margin="14,0"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Latest:" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="#E8F8EE" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock x:Name="TxtLatestVersion" Text="v0.0.2" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Release Notes Card -->
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="RELEASE HIGHLIGHTS" FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtChangelog" Text="Loading changelog..." FontSize="12" Foreground="#333333" TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRemindLater" Content="Remind Me Later" Style="{StaticResource SolumSecondaryButton}" Height="38" Padding="16,0" Margin="0,0,10,0" Click="BtnRemindLater_Click"/>
                        <Button x:Name="BtnDownloadNow" Content="Download &amp; Update Now" Style="{StaticResource SolumPrimaryButton}" Height="38" Padding="18,0" Click="BtnDownloadNow_Click"/>
                    </StackPanel>
                </Grid>

                <!-- VIEW B: Custom Downloading Interface -->
                <Grid x:Name="PnlDownloading" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,10,0,20">
                        <TextBlock Text="Downloading SOLUM UI Update" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock x:Name="TxtDownloadingSubtitle" Text="Please wait while the update is downloading..." FontSize="12.5" Foreground="#666666" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Progress Bar & Metrics -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Progress Percentage & Size -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="TxtProgressPercent" Text="0%" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock x:Name="TxtProgressBytes" Text="Connecting..." FontFamily="Segoe UI" FontSize="12" Foreground="#777777" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Custom Progress Bar -->
                        <ProgressBar x:Name="UpdateProgressBar" Style="{StaticResource SolumProgressBarStyle}" Height="12" Minimum="0" Maximum="100" Value="0"/>

                        <!-- Status Message -->
                        <TextBlock x:Name="TxtDownloadStatus" Text="Connecting to GitHub Releases..." FontSize="11.5" Foreground="#888888" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Cancel / Footer Action -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelDownload" Content="Cancel" Style="{StaticResource SolumSecondaryButton}" Height="36" Padding="18,0" Click="BtnCancelDownload_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
