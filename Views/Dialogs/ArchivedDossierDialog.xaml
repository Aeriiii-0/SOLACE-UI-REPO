<Window x:Class="SOLUM_UI.Views.Dialogs.ArchivedDossierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="940" Height="680">

    <Window.Resources>
        <!-- Underline Tab Style -->
        <Style x:Key="UnderlineTabStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#6B6470"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2,9,2,10"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Underline" Height="2.5" VerticalAlignment="Bottom" Background="#702943" CornerRadius="2,2,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#702943"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Read-Only Field Styles -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Nested Table Header -->
        <Style x:Key="SubHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#FBF1F4"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FBF1F4" BorderBrush="#702943" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nested Table Row -->
        <Style x:Key="SubRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0E4E9"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <GridViewRowPresenter VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent" Padding="16">
        <Border x:Name="Shell" Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.18" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Top Bar -->
                    <RowDefinition Height="Auto"/> <!-- Tabs Navigation -->
                    <RowDefinition Height="*"/>    <!-- Tab Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#F0E8EC" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="M3,3H21V7H3V3M4,8H20V21H4V8M9.5,11A1.5,1.5 0 0,0 8,12.5A1.5,1.5 0 0,0 9.5,14H14.5A1.5,1.5 0 0,0 16,12.5A1.5,1.5 0 0,0 14.5,11H9.5Z"
                              Fill="#702943" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCitizenName" Text="Archived Record" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#111111"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="32" Height="32" Cursor="Hand" Click="BtnClose_Click" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="16">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="#702943" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#EBD5DC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── Navigation Tabs ── -->
                <Border Grid.Row="1" Margin="28,0,28,14" BorderBrush="#EAD8DE" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabProfile" Content="Record Profile" Style="{StaticResource UnderlineTabStyle}" IsChecked="True" Click="Tab_Click"/>
                        <RadioButton x:Name="TabFamily" Content="Family Composition" Style="{StaticResource UnderlineTabStyle}" Click="Tab_Click"/>
                        <RadioButton x:Name="TabTerms" Content="Record Term History" Style="{StaticResource UnderlineTabStyle}" Click="Tab_Click"/>
                    </StackPanel>
                </Border>

                <!-- ── Tab Content Area ── -->
                <Grid Grid.Row="2" Margin="28,0,28,14">
                    <!-- Tab 1: Record Profile -->
                    <ScrollViewer x:Name="PanelProfile" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Section 1: Demographics -->
                            <Border Background="White" BorderBrush="#EAD8DE" BorderThickness="1.2" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="PERSONAL INFORMATION" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,14"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PhilSys Card ID" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtPhilsysId" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Date of Birth &amp; Age" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtDob" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Sex" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtSex" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Civil Status" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtCivilStatus" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Section 2: Contact & Address -->
                            <Border Background="White" BorderBrush="#EAD8DE" BorderThickness="1.2" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CONTACT &amp; RESIDENTIAL ADDRESS" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,14"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mobile / Contact" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtContact" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Barangay" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtBarangay" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Residential Address" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtAddress" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Section 3: Socio-Economic -->
                            <Border Background="White" BorderBrush="#EAD8DE" BorderThickness="1.2" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="SOCIO-ECONOMIC INFORMATION" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,14"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Employment Status" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtEmploymentStatus" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Occupation" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtOccupation" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Monthly Income" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtMonthlyIncome" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Subsidy Eligibility" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtSubsidyEligibility" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Section 4: Archival Metadata -->
                            <Border Background="White" BorderBrush="#EAD8DE" BorderThickness="1.2" CornerRadius="10" Padding="20,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="ARCHIVAL INFORMATION" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,14"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Date Archived" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtDateArchived" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Archive Reason" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtArchiveReason" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Retention Horizon" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="TxtShredDate" Text="-" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 2: Family Composition -->
                    <Grid x:Name="PanelFamily" Visibility="Collapsed">
                        <Border BorderBrush="#702943" BorderThickness="1.2" CornerRadius="12" Background="White" ClipToBounds="True">
                            <Grid x:Name="FamilyTableGrid" SizeChanged="TableClipGrid_SizeChanged">
                                <ListView x:Name="ListFamilyMembers" BorderThickness="0" Background="Transparent"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          ItemContainerStyle="{StaticResource SubRow}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource SubHeader}">
                                            <GridViewColumn Header="DEPENDENT NAME" Width="240">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#111111" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="RELATIONSHIP" Width="140">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Relationship}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="AGE" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Age}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="BIRTHDATE" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Birthdate, StringFormat='{}{0:yyyy-MM-dd}'}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="EDUCATION / OCCUPATION" Width="260">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding EducationalLevel}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Tab 3: Record Term History -->
                    <Grid x:Name="PanelTerms" Visibility="Collapsed">
                        <Border BorderBrush="#702943" BorderThickness="1.2" CornerRadius="12" Background="White" ClipToBounds="True">
                            <Grid x:Name="TermsTableGrid" SizeChanged="TableClipGrid_SizeChanged">
                                <ListView x:Name="ListRecordTerms" BorderThickness="0" Background="Transparent"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          ItemContainerStyle="{StaticResource SubRow}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource SubHeader}">
                                            <GridViewColumn Header="TERM TYPE" Width="170">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#111111" VerticalAlignment="Center" Margin="14,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="VALIDITY START" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StartsAt}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="EXPIRATION DATE" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ExpiresAt}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="ISSUANCE DATE" Width="240">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DateCreated, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="14,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Loading Overlay -->
                    <Border x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                        <TextBlock Text="Loading archived record details..." FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- ── Footer Actions ── -->
                <Grid Grid.Row="3" Margin="28,10,28,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Height="38" Padding="22,0" Cursor="Hand" Click="BtnClose_Click" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Close" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnReactivateRecord" Height="38" Padding="20,0" Cursor="Hand" Click="BtnReactivate_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Reactivate Record" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#5A1F34"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
