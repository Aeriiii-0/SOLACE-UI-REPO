<Window x:Class="SOLUM_UI.Views.Dialogs.ReviewAlertPopoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Width="520" SizeToContent="Height">
    <Border Background="Transparent" Padding="16">
        <!-- Main Card with Rounded Corners -->
        <Border Background="White" CornerRadius="18"
                BorderBrush="#702943" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.20"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Header Banner (No Exit Icon) -->
                <Border Grid.Row="0" Background="#702943" CornerRadius="16,16,0,0" Padding="22,18">
                    <TextBlock Text="Subsidy Recommendation Notice" FontSize="17" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </Border>

                <!-- Main Content Body -->
                <StackPanel Grid.Row="1" Margin="22,20,22,18">
                    <TextBlock Text="The following items currently require your attention:"
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#475569" Margin="0,0,0,14"/>

                    <!-- Card: Pending Subsidy Reviews -->
                    <Border x:Name="CardPendingReview" Background="#FDF8F9" CornerRadius="12" BorderBrush="#E8D4DA" BorderThickness="1.5"
                            Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#F5E1E8" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🎯" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPendingCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#702943" Margin="0,0,6,0"/>
                                    <TextBlock Text="records pending subsidy review" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Actions: Only "Dismiss" and "Review" -->
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,16,16" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dismiss Button -->
                        <Button x:Name="BtnDismiss" Grid.Column="0" Height="38" Cursor="Hand" Click="Dismiss_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Dismiss" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Review Button -->
                        <Button x:Name="BtnReviewSubsidy" Grid.Column="2" Height="38" Background="#702943" Cursor="Hand" Click="ReviewSubsidy_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Review" FontSize="12.5" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
