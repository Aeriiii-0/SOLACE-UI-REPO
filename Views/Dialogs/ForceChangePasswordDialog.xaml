<Window x:Class="SOLUM_UI.Views.Dialogs.ForceChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Width="480" SizeToContent="Height">
    <Border Background="Transparent" Padding="16">
        <Border Background="White" CornerRadius="16"
                BorderBrush="#702943" BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.22"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Header Banner -->
                <Border Grid.Row="0" Background="#702943" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#FFD54F" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="SECURITY REQUIREMENT" FontSize="9.5" FontWeight="Bold" Foreground="#4E342E"/>
                                </Border>
                                <TextBlock Text="First Login Setup" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#F5DCE3" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Change Temporary Password" FontSize="18" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Body Content -->
                <StackPanel Grid.Row="1" Margin="24,18,24,16">
                    <!-- Informative Banner -->
                    <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="#92400E" TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center" MaxWidth="370">
                                Your account is currently using a temporary password. You must set a new personal password before you can proceed.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Error Alert -->
                    <Border x:Name="BorderError" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="TxtError" Text="Error message" FontSize="11.5" Foreground="#B91C1C" TextWrapping="Wrap"/>
                    </Border>
                    <!-- Current Password -->
                    <TextBlock Text="Current (Temporary) Password" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border x:Name="BorderCurrent" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Margin="0,0,0,12" Height="36">
                        <Grid>
                            <PasswordBox x:Name="PwdCurrent" VerticalContentAlignment="Center" Padding="10,0" BorderThickness="0" Background="Transparent"
                                         PasswordChanged="Fields_Changed"/>
                            <TextBox x:Name="TxtCurrentVisible" VerticalContentAlignment="Center" Padding="10,0" BorderThickness="0" Background="Transparent"
                                     Visibility="Collapsed" TextChanged="TxtCurrentVisible_TextChanged"/>
                            <Button HorizontalAlignment="Right" Width="36" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleCurrentVisibility_Click">
                                <TextBlock x:Name="TxtToggleCurrent" Text="👁" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- New Password -->
                    <TextBlock Text="New Password" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border x:Name="BorderNew" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Margin="0,0,0,12" Height="36">
                        <Grid>
                            <PasswordBox x:Name="PwdNew" VerticalContentAlignment="Center" Padding="10,0" BorderThickness="0" Background="Transparent"
                                         PasswordChanged="Fields_Changed"/>
                            <TextBox x:Name="TxtNewVisible" VerticalContentAlignment="Center" Padding="10,0" BorderThickness="0" Background="Transparent"
                                     Visibility="Collapsed" TextChanged="TxtNewVisible_TextChanged"/>
                            <Button HorizontalAlignment="Right" Width="36" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleNewVisibility_Click">
                                <TextBlock x:Name="TxtToggleNew" Text="👁" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Confirm New Password -->
                    <TextBlock Text="Confirm New Password" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border x:Name="BorderConfirm" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Margin="0,0,0,4" Height="36">
                        <Grid>
                            <PasswordBox x:Name="PwdConfirm" VerticalContentAlignment="Center" Padding="10,0" BorderThickness="0" Background="Transparent"
                                         PasswordChanged="Fields_Changed"/>
                            <TextBox x:Name="TxtConfirmVisible" VerticalContentAlignment="Center" Padding="10,0" BorderThickness="0" Background="Transparent"
                                     Visibility="Collapsed" TextChanged="TxtConfirmVisible_TextChanged"/>
                            <Button HorizontalAlignment="Right" Width="36" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleConfirmVisibility_Click">
                                <TextBlock x:Name="TxtToggleConfirm" Text="👁" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="Must be at least 6 characters and different from temporary password." FontSize="10.5" Foreground="#64748B" Margin="2,4,0,0"/>
                </StackPanel>
                <!-- Footer Actions -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel &amp; Sign Out" Height="36" Padding="16,0"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"
                                Click="Cancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" x:Name="BtnSave" Content="Update &amp; Continue →" Height="36" Padding="20,0"
                                Background="#702943" BorderThickness="0" Cursor="Hand" Click="Save_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                            <Setter Property="Cursor" Value="Wait"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>