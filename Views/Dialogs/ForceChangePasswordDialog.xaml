<Window x:Class="SOLUM_UI.Views.Dialogs.ForceChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI"
        Width="480" SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Global crispy text rendering -->
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
    </Window.Resources>
    <Border Background="Transparent" Padding="16">
        <Border Background="White" CornerRadius="24"
                BorderBrush="#702943" BorderThickness="1"
                Padding="32,28,32,32"
                UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="32" ShadowDepth="4" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>

                <!-- Badge -->
                <Border Background="#FEEBB8" CornerRadius="14" Padding="14,6"
                        HorizontalAlignment="Left" Margin="0,0,0,18">
                    <TextBlock Text="SECURITY REQUIREMENT" FontSize="10.5" FontWeight="Bold"
                               Foreground="#8A3B12"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="Change Temporary Password" FontSize="26" FontWeight="Bold"
                           Foreground="#702943" TextWrapping="Wrap" LineHeight="32"
                           LineStackingStrategy="BlockLineHeight"/>
                <TextBlock Text="First login setup" FontSize="12.5"
                           Foreground="#8C6B79" Margin="0,2,0,20"/>

                <!-- Informative Banner -->
                <Border Background="#FFF4DE" CornerRadius="16" Padding="18,14" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Foreground="#B4531A"
                                   VerticalAlignment="Top" Margin="0,5,12,0"/>
                        <TextBlock Grid.Column="1" FontSize="13.5" Foreground="#A8480F"
                                   TextWrapping="Wrap" LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight">
                            Your account is using a temporary password. You must set a new personal password before you can proceed.
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Error Alert -->
                <Border x:Name="BorderError" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Text="Error message" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap"/>
                </Border>

                <!-- Current Password -->
                <TextBlock Text="Current (Temporary) Password" FontSize="13" FontWeight="Bold"
                           Foreground="#1F1A1D" Margin="0,0,0,8"/>
                <Border x:Name="BorderCurrent" BorderBrush="#E6CCD8" BorderThickness="1" CornerRadius="14"
                        Background="White" Margin="0,0,0,20" Height="48">
                    <Grid>
                        <PasswordBox x:Name="PwdCurrent" VerticalContentAlignment="Center" Padding="16,0,48,0"
                                     BorderThickness="0" Background="Transparent" FontSize="14"
                                     PasswordChanged="Fields_Changed"/>
                        <TextBox x:Name="TxtCurrentVisible" VerticalContentAlignment="Center" Padding="16,0,48,0"
                                 BorderThickness="0" Background="Transparent" FontSize="14"
                                 Visibility="Collapsed" TextChanged="TxtCurrentVisible_TextChanged"/>
                        <Button HorizontalAlignment="Right" Width="48" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="ToggleCurrentVisibility_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtToggleCurrent" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="#8C6B79"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- New Password -->
                <TextBlock Text="New Password" FontSize="13" FontWeight="Bold"
                           Foreground="#1F1A1D" Margin="0,0,0,8"/>
                <Border x:Name="BorderNew" BorderBrush="#E6CCD8" BorderThickness="1" CornerRadius="14"
                        Background="White" Margin="0,0,0,20" Height="48">
                    <Grid>
                        <PasswordBox x:Name="PwdNew" VerticalContentAlignment="Center" Padding="16,0,48,0"
                                     BorderThickness="0" Background="Transparent" FontSize="14"
                                     PasswordChanged="Fields_Changed"/>
                        <TextBox x:Name="TxtNewVisible" VerticalContentAlignment="Center" Padding="16,0,48,0"
                                 BorderThickness="0" Background="Transparent" FontSize="14"
                                 Visibility="Collapsed" TextChanged="TxtNewVisible_TextChanged"/>
                        <Button HorizontalAlignment="Right" Width="48" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="ToggleNewVisibility_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtToggleNew" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="#8C6B79"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Confirm New Password -->
                <TextBlock Text="Confirm New Password" FontSize="13" FontWeight="Bold"
                           Foreground="#1F1A1D" Margin="0,0,0,8"/>
                <Border x:Name="BorderConfirm" BorderBrush="#E6CCD8" BorderThickness="1" CornerRadius="14"
                        Background="White" Margin="0,0,0,10" Height="48">
                    <Grid>
                        <PasswordBox x:Name="PwdConfirm" VerticalContentAlignment="Center" Padding="16,0,48,0"
                                     BorderThickness="0" Background="Transparent" FontSize="14"
                                     PasswordChanged="Fields_Changed"/>
                        <TextBox x:Name="TxtConfirmVisible" VerticalContentAlignment="Center" Padding="16,0,48,0"
                                 BorderThickness="0" Background="Transparent" FontSize="14"
                                 Visibility="Collapsed" TextChanged="TxtConfirmVisible_TextChanged"/>
                        <Button HorizontalAlignment="Right" Width="48" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="ToggleConfirmVisibility_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtToggleConfirm" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="#8C6B79"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Hint -->
                <TextBlock Text="Must be at least 6 characters and different from the temporary password."
                           FontSize="11.5" Foreground="#8C6B79" TextWrapping="Wrap" Margin="0,0,0,22"/>

                <!-- Footer Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancel &amp; Sign Out" Height="46"
                            Background="White" BorderBrush="#702943" BorderThickness="1" Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" x:Name="BtnSave" Content="Update &amp; Continue" Height="46"
                            Background="#702943" BorderThickness="0" Cursor="Hand" Click="Save_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="23">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                        <Setter Property="Cursor" Value="Wait"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>
    </Border>
</Window>
