                                                            <TextBlock Text="III. PROBLEM PRESENTED / CIRCUMSTANCE OF BEING SOLO PARENT"
                                                                       Style="{StaticResource SectionLabel}"/>
                                                            <Border x:Name="BadgeCircumstanceDetected" Grid.Column="1" Background="#E6F9EE" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                                                                <TextBlock x:Name="TxtCircumstanceBadge" Text="● Encircled Detected" FontSize="10" FontWeight="Bold" Foreground="#27AE60"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Column 1: A1, A2, A3, A4 -->
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <RadioButton x:Name="ChkA1" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a1" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A1. " FontWeight="Bold"/><Run Text="Birth as result of rape"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>

                                                            <RadioButton x:Name="ChkA2" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a2" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A2. " FontWeight="Bold"/><Run Text="Death of Spouse"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>
                                                            <StackPanel x:Name="PnlA2" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="8"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Cause of death" Style="{StaticResource FieldLabelSm}"/>
                                                                        <TextBox x:Name="TxtA2Cause" Style="{StaticResource FormBoxSm}" Tag="circ_a2_cause" GotFocus="Field_GotFocus"
                                                                                 MaxLength="100"
                                                                                 TextChanged="TxtA2Cause_TextChanged"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Date" Style="{StaticResource FieldLabelSm}"/>
                                                                        <DatePicker x:Name="DpA2Date" Style="{StaticResource FormDateSm}" Tag="circ_a2_date"
                                                                                    GotFocus="Field_GotFocus" GotKeyboardFocus="Field_GotFocus"
                                                                                    PreviewMouseLeftButtonDown="Field_PreviewMouseDown"
                                                                                    CalendarOpened="DatePicker_CalendarOpened"
                                                                                    DateValidationError="DatePicker_DateValidationError"
                                                                                    LostFocus="DatePicker_LostFocus"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>

                                                            <RadioButton x:Name="ChkA3" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a3" GotFocus="Field_GotFocus">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A3. " FontWeight="Bold"/><Run Text="Detention of Spouse"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>

                                                            <RadioButton x:Name="ChkA4" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a4" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A4. " FontWeight="Bold"/><Run Text="Physical/Mental Incapacity"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>
                                                            <StackPanel x:Name="PnlA4" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Type of disability" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtA4Disability" Style="{StaticResource FormBoxSm}" Tag="circ_a4_disability" GotFocus="Field_GotFocus"
                                                                         TextChanged="TxtA4Disability_TextChanged"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Column 2: A5, A6, A7, B -->
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <RadioButton x:Name="ChkA5" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a5" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A5. " FontWeight="Bold"/><Run Text="Separation from spouse"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>
                                                            <StackPanel x:Name="PnlA5" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Period of separation" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtA5Period" Style="{StaticResource FormBoxSm}" Tag="circ_a5_period" GotFocus="Field_GotFocus"/>
                                                            </StackPanel>

                                                            <RadioButton x:Name="ChkA6" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a6" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A6. " FontWeight="Bold"/><Run Text="Nullity / Annulment"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>
                                                            <StackPanel x:Name="PnlA6" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Type of Declaration" Style="{StaticResource FieldLabelSm}"/>
                                                                <ComboBox x:Name="CmbA6Declaration" Style="{StaticResource FormCombo}" Height="34">
                                                                    <ComboBoxItem Content=""/>
                                                                    <ComboBoxItem Content="Nullity of marriage"/>
                                                                    <ComboBoxItem Content="Annulment of marriage"/>
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <RadioButton x:Name="ChkA7" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_a7" GotFocus="Field_GotFocus">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A7. " FontWeight="Bold"/><Run Text="Abandonment (6+ mos)"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>

                                                            <RadioButton x:Name="ChkB" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_b" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="B. " FontWeight="Bold"/><Run Text="OFW Spouse / Family"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>
                                                            <StackPanel x:Name="PnlB" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Length of stay abroad" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtBStayAbroad" Style="{StaticResource FormBoxSm}" Tag="circ_b_stay" GotFocus="Field_GotFocus"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Column 3: C, D, E, F -->
                                                        <StackPanel Grid.Column="2">
                                                            <RadioButton x:Name="ChkC" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_c" GotFocus="Field_GotFocus">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="C. " FontWeight="Bold"/><Run Text="Unmarried Mother/Father"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>

                                                            <RadioButton x:Name="ChkD" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_d" GotFocus="Field_GotFocus">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="D. " FontWeight="Bold"/><Run Text="Legal Guardian / Foster"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>

                                                            <RadioButton x:Name="ChkE" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_e" GotFocus="Field_GotFocus">
                                                                <RadioButton.Content>
                                                                    <TextBlock TextWrapping="Wrap" FontSize="11">
                                                                        <Run Text="E. " FontWeight="Bold"/><Run Text="Relative 4th degree"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>

                                                            <RadioButton x:Name="ChkF" Style="{StaticResource FormCheck}" GroupName="Circumstance" Tag="circ_f" GotFocus="Field_GotFocus">
                                                                <RadioButton.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="F. " FontWeight="Bold"/><Run Text="Pregnant Woman"/>
                                                                    </TextBlock>
                                                                </RadioButton.Content>
                                                            </RadioButton>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: IV. FAMILY COMPOSITION -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <!-- Header row with title and '+ Add Member' button -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Border Style="{StaticResource CardSectionHeader}" Margin="0" VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <TextBlock Text="IV. FAMILY COMPOSITION" Style="{StaticResource SectionLabel}"/>
                                                                <TextBlock Text="Include children and other dependents residing in the household."
                                                                           FontSize="11" Foreground="#777777" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Button x:Name="BtnAddFamilyMember" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Style="{StaticResource PrimaryMaroonBtn}" Height="34" Padding="14,0"
                                                                Click="BtnAddFamilyMember_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Add Member" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Collapsible Add/Edit Member Inline Sub-Card -->
                                                    <Border x:Name="AddMemberSubCard" Background="#FFF9FB" BorderBrush="#702943" BorderThickness="1.5"
                                                            CornerRadius="10" Padding="0" Margin="0,0,0,16" Visibility="Collapsed" ClipToBounds="True">
                                                        <StackPanel>
                                                            <!-- Header Banner with deep maroon tint -->
                                                            <Border Background="#702943" Padding="16,10">
                                                                <TextBlock x:Name="TxtAddMemberTitle" Text="Add Household Member"
                                                                           FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <Border Padding="16,14">
                                                                <StackPanel>
                                                                    <!-- Row 1: Name, Relationship, Sex, Civil Status -->
                                                                    <Grid Margin="0,0,0,12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="1.2*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                                Full Name <Run Text="*" Foreground="#E53935"/>
                                                                            </TextBlock>
                                                                            <TextBox x:Name="TxtMemberName" Style="{StaticResource FormBoxSm}" MaxLength="60"
                                                                                     PreviewTextInput="NameOnly_PreviewTextInput"/>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                                Relationship <Run Text="*" Foreground="#E53935"/>
                                                                            </TextBlock>
                                                                            <ComboBox x:Name="CmbMemberRel" Style="{StaticResource FormCombo}" Height="32" FontSize="12">
                                                                                <ComboBoxItem Content="Child"/>
                                                                                <ComboBoxItem Content="Spouse"/>
                                                                                <ComboBoxItem Content="Parent"/>
                                                                                <ComboBoxItem Content="Sibling"/>
                                                                                <ComboBoxItem Content="Grandchild"/>
                                                                                <ComboBoxItem Content="Grandparent"/>
                                                                                <ComboBoxItem Content="Relative"/>
                                                                                <ComboBoxItem Content="Ward"/>
                                                                                <ComboBoxItem Content="Other"/>
                                                                            </ComboBox>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="4">
                                                                            <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                                Sex <Run Text="*" Foreground="#E53935"/>
                                                                            </TextBlock>
                                                                            <ComboBox x:Name="CmbMemberSex" Style="{StaticResource FormCombo}" Height="32" FontSize="12">
                                                                                <ComboBoxItem Content="Female"/>
                                                                                <ComboBoxItem Content="Male"/>
                                                                            </ComboBox>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="6">
                                                                            <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                                Civil Status <Run Text="*" Foreground="#E53935"/>
                                                                            </TextBlock>
                                                                            <ComboBox x:Name="CmbMemberCivil" Style="{StaticResource FormCombo}" Height="32" FontSize="12">
                                                                                <ComboBoxItem Content="Single"/>
                                                                                <ComboBoxItem Content="Married"/>
                                                                                <ComboBoxItem Content="Widowed"/>
                                                                                <ComboBoxItem Content="Separated"/>
                                                                                <ComboBoxItem Content="Divorced"/>
                                                                                <ComboBoxItem Content="Annulled"/>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Row 2: Birthdate, Age (auto), Education/Employment, Income -->
                                                                    <Grid Margin="0,0,0,12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="1.4*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="0.7*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="2*"/>
                                                                            <ColumnDefinition Width="10"/>
                                                                            <ColumnDefinition Width="1.3*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                                Birthdate <Run Text="*" Foreground="#E53935"/>
                                                                            </TextBlock>
                                                                            <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Height="32">
                                                                                <DatePicker x:Name="DpMemberDob" Style="{StaticResource FormDateSm}"
                                                                                            SelectedDateChanged="DpMemberDob_SelectedDateChanged"/>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="Age" Style="{StaticResource FieldLabelSm}"/>
                                                                            <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="#F5F5F5" Height="32">
                                                                                <TextBox x:Name="TxtMemberAge" Style="{StaticResource FormBoxSm}" IsReadOnly="True"
                                                                                         Focusable="False" Cursor="Arrow" BorderThickness="0" Background="Transparent"
                                                                                         HorizontalContentAlignment="Center" ToolTip="Auto-calculated from Birthdate"/>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="4">
                                                                            <TextBlock Text="Educ. Attainment / Employment" Style="{StaticResource FieldLabelSm}"/>
                                                                            <TextBox x:Name="TxtMemberEdu" Style="{StaticResource FormBoxSm}" MaxLength="80"/>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="6">
                                                                            <TextBlock Text="Monthly Income (₱)" Style="{StaticResource FieldLabelSm}"/>
                                                                            <TextBox x:Name="TxtMemberIncome" Style="{StaticResource FormBoxSm}"
                                                                                     PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Row 3: Special Needs Integration Box (Revealed columns, starts disabled until checked) -->
                                                                    <Border Background="#FAFAFA" BorderBrush="#EAD3DC" BorderThickness="1" CornerRadius="8"
                                                                            Padding="14,12" Margin="0,0,0,14">
                                                                        <StackPanel>
                                                                            <CheckBox x:Name="ChkMemberSpecialNeeds" Content="Person with Special Needs / Disability (PWD)"
                                                                                      FontSize="12" FontWeight="SemiBold" Foreground="#702943"
                                                                                      Checked="ChkMemberSpecialNeeds_Changed" Unchecked="ChkMemberSpecialNeeds_Changed"
                                                                                      VerticalContentAlignment="Center" Cursor="Hand" Margin="0,0,0,10"/>

                                                                            <!-- Columns revealed already, starts uneditable until ChkMemberSpecialNeeds is checked -->
                                                                            <Grid x:Name="PnlSpecialNeedsDetails" IsEnabled="False" Opacity="0.5">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="1.5*"/>
                                                                                    <ColumnDefinition Width="12"/>
                                                                                    <ColumnDefinition Width="2.5*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel Grid.Column="0">
                                                                                    <TextBlock Text="Special Needs Category" Style="{StaticResource FieldLabelSm}"/>
                                                                                    <ComboBox x:Name="CmbSpecialNeedsCategory" Style="{StaticResource FormCombo}" Height="32" FontSize="12">
                                                                                        <ComboBoxItem Content="Visual Impairment"/>
                                                                                        <ComboBoxItem Content="Hearing Impairment"/>
                                                                                        <ComboBoxItem Content="Mobility / Physical Disability"/>
                                                                                        <ComboBoxItem Content="Intellectual Disability"/>
                                                                                        <ComboBoxItem Content="Learning Disability"/>
                                                                                        <ComboBoxItem Content="Autism Spectrum"/>
                                                                                        <ComboBoxItem Content="Chronic Illness / Medical Condition"/>
                                                                                        <ComboBoxItem Content="Mental Health Condition"/>
                                                                                        <ComboBoxItem Content="Multiple Disabilities"/>
                                                                                        <ComboBoxItem Content="Other"/>
                                                                                    </ComboBox>
                                                                                </StackPanel>

                                                                                <StackPanel Grid.Column="2">
                                                                                    <TextBlock Text="Description / Special Accommodations (Optional)" Style="{StaticResource FieldLabelSm}"/>
                                                                                    <TextBox x:Name="TxtSpecialNeedsDescription" Style="{StaticResource FormBoxSm}" MaxLength="120"
                                                                                             ToolTip="E.g., Requires wheelchair accessibility, SPED Grade 4, Maintenance medication"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Actions: Cancel and Save -->
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Button Content="Cancel" Style="{StaticResource OutlineMaroonBtn}" Height="32" Padding="14,0"
                                                                                Margin="0,0,8,0" Click="BtnCancelMember_Click"/>
                                                                        <Button x:Name="BtnSaveMember" Content="Save Member" Style="{StaticResource PrimaryMaroonBtn}"
                                                                                Height="32" Padding="16,0" Click="BtnSaveMember_Click"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Deeper Colored Table Header Banner for the Dependents Cards List -->
                                                    <Border Background="#702943" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.6*"/>
                                                                <ColumnDefinition Width="84"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="NAME &amp; RELATIONSHIP" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                            <TextBlock Grid.Column="1" Text="AGE &amp; SEX" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                            <TextBlock Grid.Column="2" Text="EDUCATION &amp; INCOME" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                            <TextBlock Grid.Column="3" Text="DISABILITY / SPECIAL NEEDS" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                            <TextBlock Grid.Column="4" Text="ACTIONS" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ItemsControl for Cards List -->
                                                    <ItemsControl x:Name="FamilyCardsList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1.2"
                                                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*"/>
                                                                            <ColumnDefinition Width="1.1*"/>
                                                                            <ColumnDefinition Width="1.5*"/>
                                                                            <ColumnDefinition Width="1.6*"/>
                                                                            <ColumnDefinition Width="84"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Column 0: Name + Relationship (+ NEW Highlight Tag) -->
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding MemberName}" FontSize="13" FontWeight="SemiBold"
                                                                                           Foreground="#111827" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                                                <Border Visibility="{Binding NewBadgeVisibility}" Background="#702943" CornerRadius="4"
                                                                                        Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Relationship}" FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- Column 1: Age & Sex -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding AgeDisplay}" FontSize="12" Foreground="#1F2937"/>
                                                                            <TextBlock Text="{Binding SexDisplay}" FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- Column 2: Education / Work & Income -->
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding EducationDisplay}" FontSize="12" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding IncomeDisplay}" FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- Column 3: Disability / Special Needs (Direct Typography, No Badges) -->
                                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding SpecialNeedsTooltip}" Margin="0,0,10,0">
                                                                            <TextBlock Text="{Binding DisabilityTitleDisplay}" FontSize="12"
                                                                                       FontWeight="{Binding DisabilityTextWeight}"
                                                                                       Foreground="{Binding DisabilityTextColor}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding DisabilitySubtitleDisplay}" FontSize="11" Foreground="#6B7280"
                                                                                       Visibility="{Binding DisabilitySubtitleVisibility}"
                                                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- Column 4: Actions (Prominent Edit & Delete Icons) -->
                                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <!-- Prominent Edit Button -->
                                                                            <Button Width="32" Height="32" Margin="0,0,6,0" Cursor="Hand"
                                                                                    ToolTip="Edit member" Click="BtnEditFamilyMember_Click" Tag="{Binding}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="BtnBg" Background="#FDF2F5" BorderBrush="#E5B8C9" BorderThickness="1.2" CornerRadius="6">
                                                                                            <Path x:Name="BtnIcon" Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87M3,17.25V21H6.75L17.81,9.93L14.07,6.19L3,17.25Z"
                                                                                                  Fill="#702943" Stretch="Uniform" Width="14" Height="14"
                                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="BtnBg" Property="Background" Value="#702943"/>
                                                                                                <Setter TargetName="BtnBg" Property="BorderBrush" Value="#702943"/>
                                                                                                <Setter TargetName="BtnIcon" Property="Fill" Value="White"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>

                                                                            <!-- Prominent Delete Button -->
                                                                            <Button Width="32" Height="32" Cursor="Hand"
                                                                                    ToolTip="Remove member" Click="BtnRemoveFamilyMember_Click" Tag="{Binding}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="DelBg" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="6">
                                                                                            <Path x:Name="DelIcon" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                                                                  Fill="#DC2626" Stretch="Uniform" Width="14" Height="14"
                                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="DelBg" Property="Background" Value="#DC2626"/>
                                                                                                <Setter TargetName="DelBg" Property="BorderBrush" Value="#DC2626"/>
                                                                                                <Setter TargetName="DelIcon" Property="Fill" Value="White"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Empty state placeholder -->
                                                    <Border x:Name="PnlNoFamilyMembers" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="1"
                                                            CornerRadius="8" Padding="20,16" Margin="0,4,0,0" Visibility="Collapsed">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="No household members recorded yet." FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#6B7280" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Click '+ Add Member' above to add qualified children or other household dependents."
                                                                       FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: V. NEEDS AND PROBLEMS -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="V. NEEDS AND PROBLEMS" Style="{StaticResource SectionLabel}"/>
                                                            <Border x:Name="Badge_Needs" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                <TextBlock x:Name="TxtConf_Needs" Text="—" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBox x:Name="TxtNeeds" Style="{StaticResource FormBox}"
                                                             Tag="needs" GotFocus="Field_GotFocus"
                                                             MaxLength="500"
                                                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             VerticalContentAlignment="Top" Padding="10,6"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: VI. OTHER SOURCES OF INCOME -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="VI. OTHER SOURCES OF INCOME" Style="{StaticResource SectionLabel}"/>
                                                            <Border x:Name="Badge_OtherIncome" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                <TextBlock x:Name="TxtConf_OtherIncome" Text="—" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBox x:Name="TxtOtherIncome" Style="{StaticResource FormBox}"
                                                             Tag="other_income" GotFocus="Field_GotFocus"
                                                             MaxLength="500"
                                                             Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             VerticalContentAlignment="Top" Padding="10,6"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: VII. APPLICATION STATUS -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <TextBlock Text="VII. APPLICATION STATUS" Style="{StaticResource SectionLabel}"/>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox x:Name="CmbStatus" Style="{StaticResource FormCombo}"
                                                                      Tag="status" GotFocus="Field_GotFocus"
                                                                      SelectionChanged="CmbStatus_SelectionChanged">
                                                                <ComboBoxItem Content="Valid" IsSelected="True"/>
                                                                <ComboBoxItem Content="Inactive"/>
                                                            </ComboBox>
                                                            <TextBlock x:Name="ErrStatus" Text="Required." Style="{StaticResource ErrorText}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- FOOTER ACTIONS -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0" Padding="28,12" CornerRadius="0,0,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ValidationMessage"
                                           Text=""
                                           FontSize="12" Foreground="#E53935"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" Margin="0,0,12,0"/>
                                <Border Background="#F9F2F4" CornerRadius="12" Padding="10,4" BorderBrush="#EBD6DC" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                                              Fill="#702943" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtOverallConfBadge"
                                                   Text="Overall AI Confidence: 0%"
                                                   FontSize="11" Foreground="#702943" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Close_Click"/>
                                <Button x:Name="BtnBack" Content="&#x2190; Back" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
                                <Button x:Name="BtnNext" Content="Next &#x2192;" Style="{StaticResource SaveBtn}"
                                        Click="Next_Click"/>
                                <Button x:Name="BtnSave" Content="Save Record" Style="{StaticResource SaveBtn}"
                                        Click="Save_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OCR PROCESSING MODAL OVERLAY -->
                    <Grid x:Name="OverlayProcessing" Grid.RowSpan="4" Visibility="Collapsed" Background="#77000000">
                        <Border Background="White" CornerRadius="16" Width="420" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="50" Height="50" CornerRadius="25" Background="#F9F2F4" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#702943" Data="M19,8H5C3.34,8 2,9.34 2,11V17H6V21H18V17H22V11C22,9.34 20.66,8 19,8M16,19H8V15H16V19M19,12C18.45,12 18,11.55 18,11C18,10.45 18.45,10 19,10C19.55,10 20,10.45 20,11C20,11.55 19.55,12 19,12M18,3H6V7H18V3Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Ingesting Application Form..." FontSize="15" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtProcessingStep" Text="Analyzing document structure..." FontSize="11" Foreground="#702943" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <ProgressBar x:Name="OcrStageProgressBar" Height="6" Minimum="0" Maximum="100" Value="10" Foreground="#702943" Background="#F0E8EA" BorderThickness="0" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="⏱ Elapsed: " FontSize="10" FontWeight="SemiBold" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtLiveElapsedTime" Text="0.0s" FontSize="10" FontWeight="Bold" Foreground="#702943"/>
                                </StackPanel>
                                <Border Background="#FAF7F8" CornerRadius="6" Padding="10,6" BorderBrush="#EADCE0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Active Task:" FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtCurrentExtractingField" Grid.Column="1" Text="Deskewing and enhancing scan..." FontSize="10" Foreground="#555" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>
        </Border>
    </Border>
</Window>

