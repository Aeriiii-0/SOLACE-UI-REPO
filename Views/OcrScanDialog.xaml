<Window x:Class="SOLUM_UI.OcrScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solace — OCR Document Ingestion &amp; Verification"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Width="1380" Height="860">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#D0B8C0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#C0A0AA"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#BBBBBB" FontSize="14"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="10" BorderBrush="#C0A0AA"
                                        BorderThickness="1.2" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="ComboBg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="14,9"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#222222"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   HorizontalContentAlignment="Left"
                                                   VerticalContentAlignment="Center"
                                                   FontSize="13" Foreground="#111111"
                                                   BorderThickness="0" Background="Transparent"
                                                   Padding="8,0"
                                                   FocusVisualStyle="{x:Null}"
                                                   SelectionBrush="#702943"
                                                   Focusable="True">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                            <!-- Suppress the native watermark by not displaying PART_Watermark -->
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <!-- Custom clean placeholder - only visible when input is empty -->
                                <TextBlock Text="DD/MM/YYYY" Foreground="#999999" FontSize="13"
                                           Padding="8,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ToggleButton x:Name="PART_Button" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="18" Height="18" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    IsChecked="{Binding IsOpen, ElementName=PART_Popup, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.9 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                              Fill="#702943" Stretch="Uniform" Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Grid.Column="0" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False">
                                <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0"
                                        BorderThickness="1" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.12"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="White"
                                              BorderThickness="0" Foreground="#222222"
                                              FontSize="12"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCheck" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,4,14,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#EDE0E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardSectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FormBoxSm" TargetType="TextBox" BasedOn="{StaticResource FormBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="FormDateSm" TargetType="DatePicker" BasedOn="{StaticResource FormDate}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldLabelSm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="PrimaryMaroonBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineMaroonBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow and Dialog Shell -->
    <Border Background="#44000000" Padding="0">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Border x:Name="DialogShell" Background="White" CornerRadius="16"
                    ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#C8E6C9" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Mode Stripe -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Main Body (Split Viewport + Form) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 3: Footer Actions -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TOP HEADER (Clean White Theme matching RecordDialog) -->
                    <Border x:Name="HeaderBorder" Grid.Row="0" Background="White" CornerRadius="16,16,0,0"
                            BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="28,16">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Mode badge pill -->
                                <Border CornerRadius="20" Padding="10,4" Background="#E8F5E9" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                              Fill="#2E7D32" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="OCR Auto-Ingestion &amp; Verification" FontSize="11" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="FormSubtitle" Text="Solo Parent Application Form" FontSize="19" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock x:Name="FormStepHint" Text="Step 1 of 3 — Primary Information" FontSize="13" Foreground="#666666" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Engine Status Badge Pill -->
                                <Border x:Name="PillEngineStatus"
                                        Background="#FBF5F7" BorderBrush="#EDE0E5" BorderThickness="1"
                                        CornerRadius="14" Padding="10,5" Margin="0,0,14,0"
                                        Cursor="Hand" VerticalAlignment="Center"
                                        MouseLeftButtonUp="ServerStatusBadge_MouseLeftButtonUp"
                                        ToolTipService.InitialShowDelay="150"
                                        ToolTip="Click to check OCR engine status or restart server">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="ServerStatusBadge"
                                                Width="9" Height="9" CornerRadius="4.5"
                                                Background="#FFA500" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="BadgeGlow" Color="#FFA500" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                            </Border.Effect>
                                        </Border>
                                        <TextBlock x:Name="TxtHeaderEngineStatus" Text="AI Engine: Checking..."
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Circular Close Button -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="32" Height="32" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBg" Background="Transparent" CornerRadius="16">
                                                <TextBlock Text="✕" FontSize="14" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBg" Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="Foreground" Value="#222222"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MODE STRIPE (Matching RecordDialog) -->
                    <Border x:Name="ModeStripe" Grid.Row="1"
                            Background="#F0FAF1" BorderBrush="#C8E6C9" BorderThickness="0,0,0,1"
                            Padding="28,8,28,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ModeStripeIcon"
                                      Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                      Fill="#2E7D32" Stretch="Uniform" Width="13" Height="13"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ModeStripeLabel" Text="New Registration"
                                           FontSize="12" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModeStripeHint"
                                           Text=" — Scanned CSWDO-066-2 form. Review fields on the right, synchronized with the scan preview."
                                           FontSize="12" Foreground="#558B5A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN WORKSPACE -->
                    <Grid Grid.Row="2" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Document Viewport (~44% width) -->
                            <ColumnDefinition Width="520"/>
                            <ColumnDefinition Width="12"/>
                            <!-- Right: 1:1 Partitioned Record Verification (~56% width) -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: INTERACTIVE LIVE DOCUMENT VIEWPORT -->
                        <Border Grid.Column="0" Background="#F8F4F6" BorderBrush="#DDD0D5" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- OCR ENGINE WARMUP / PROGRESS BANNER -->
                                <Border x:Name="OcrWarmupBanner" Grid.Row="0"
                                        Background="#FFF5F7" BorderBrush="#E0B8C4" BorderThickness="1" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon, Title, and Estimated Time / Controls -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Warmup Status Icon / Spinner Badge -->
                                            <Border x:Name="IconWarmupBadge" Width="22" Height="22" CornerRadius="11"
                                                    Background="#702943" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <RotateTransform x:Name="WarmupIconRotate" Angle="0"/>
                                                </Border.RenderTransform>
                                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path x:Name="IconWarmupPath" Fill="White"
                                                              Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtWarmupTitle" Text="AI OCR Engine Warming Up..."
                                                           FontSize="12" FontWeight="Bold" Foreground="#702943"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="BadgeWarmupTime" Background="#F3E5EB" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock x:Name="TxtWarmupEstimatedTime" Text="~6s remaining"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                                </Border>
                                                <Button x:Name="BtnWarmupRetry" Content="Retry" Click="WarmupRetry_Click" Visibility="Collapsed"
                                                        Background="#702943" Foreground="White" FontSize="10" FontWeight="Bold"
                                                        Padding="8,2" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button x:Name="BtnDismissWarmup" Content="✕" Click="DismissWarmup_Click" Visibility="Collapsed"
                                                        Background="Transparent" Foreground="#888888" FontSize="11" FontWeight="Bold"
                                                        Width="20" Height="20" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Current Active Process Step Description -->
                                        <Grid Grid.Row="1" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtWarmupStepDetail"
                                                       Text="Initializing local AI background service &amp; OpenVINO models..."
                                                       FontSize="11" Foreground="#444444" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtWarmupElapsed" Grid.Column="1" Text="0.0s elapsed"
                                                       FontSize="10" Foreground="#888888" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- Warmup Progress Bar -->
                                        <ProgressBar x:Name="WarmupProgressBar" Grid.Row="2" Height="5" Minimum="0" Maximum="100" Value="15"
                                                     Foreground="#702943" Background="#EBD6DC" BorderThickness="0">
                                            <ProgressBar.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="2.5"/>
                                                </Style>
                                            </ProgressBar.Resources>
                                        </ProgressBar>
                                    </Grid>
                                </Border>

                                <!-- Viewport Toolbar -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnScanHardware" Content="Scan Document" Click="ScanHardware_Click"
                                                Height="28" Padding="12,0" Background="#702943" Foreground="White" FontWeight="SemiBold"
                                                FontSize="11" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="BtnScannerSettings" Content="Scanner Settings" Click="ScannerSettings_Click"
                                                Height="28" Padding="10,0" Background="White" Foreground="#702943" FontWeight="SemiBold"
                                                FontSize="11" BorderBrush="#D0B8C0" BorderThickness="1" Cursor="Hand" Margin="5,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="BtnSelectImage" Content="Upload File" Click="SelectImage_Click"
                                                Height="28" Padding="10,0" Background="White" Foreground="#702943" FontWeight="SemiBold"
                                                FontSize="11" BorderBrush="#D0B8C0" BorderThickness="1" Cursor="Hand" Margin="5,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="BtnAdjustTemplate" Content="Adjust Boxes" Click="AdjustTemplate_Click"
                                                Height="28" Padding="10,0" Background="White" Foreground="#555555" FontWeight="SemiBold"
                                                FontSize="11" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" Margin="5,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="BtnViewDetections" Content="View AI Boxes" Click="ViewDetections_Click"
                                                Height="28" Padding="10,0" Background="White" Foreground="#555555" FontWeight="SemiBold"
                                                FontSize="11" BorderBrush="#D0C0C6" BorderThickness="1" Cursor="Hand" Margin="5,0,0,0" ToolTip="Open the visual detections overlay">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- Zoom Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="-" Click="ZoomOut_Click" Width="26" Height="28" Background="White" Foreground="#555555" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,3,0" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="Fit" Click="ZoomFit_Click" Height="28" Padding="6,0" Background="White" Foreground="#555555" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="+" Click="ZoomIn_Click" Width="26" Height="28" Background="White" Foreground="#555555" BorderBrush="#D0C0C6" BorderThickness="1" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Scrollable Pan & Zoom Document Canvas -->
                                <Border Grid.Row="2" Background="#E8E2E4" CornerRadius="8" ClipToBounds="True" BorderBrush="#D0C0C6" BorderThickness="1">
                                    <Grid>
                                        <ScrollViewer x:Name="DocScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                      PreviewMouseLeftButtonDown="DocScrollViewer_PreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="DocScrollViewer_PreviewMouseMove"
                                                      PreviewMouseLeftButtonUp="DocScrollViewer_PreviewMouseLeftButtonUp"
                                                      Cursor="Hand">
                                            <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image x:Name="ImgDocument" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False"
                                                        Width="{Binding ActualWidth, ElementName=ImgDocument}"
                                                        Height="{Binding ActualHeight, ElementName=ImgDocument}"/>
                                            </Grid>
                                        </ScrollViewer>

                                        <!-- Empty State Canvas Graphic -->
                                        <Grid x:Name="EmptyCanvasState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Visible">
                                            <Border Background="White" CornerRadius="12" Padding="22,18" BorderBrush="#D0C0C6" BorderThickness="1" MaxWidth="360">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="44" Height="44" CornerRadius="22" Background="#FBF6F8" BorderBrush="#E5D8DC" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="#702943" Data="M19,8H5C3.34,8 2,9.34 2,11V17H6V21H18V17H22V11C22,9.34 20.66,8 19,8M16,19H8V15H16V19M19,12C18.45,12 18,11.55 18,11C18,10.45 18.45,10 19,10C19.55,10 20,10.45 20,11C20,11.55 19.55,12 19,12M18,3H6V7H18V3Z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Document Scanner Ready" FontSize="14" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Place application form on scanner glass and click Scan Document, or select an existing file."
                                                               FontSize="11" Foreground="#777777" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                    <Border Background="#F9F5F6" CornerRadius="6" Padding="8,5" Margin="0,0,0,12" BorderBrush="#EADCE0" BorderThickness="1">
                                                        <TextBlock x:Name="TxtScannerStatusBadge" Text="Status: Scanner Ready (300 DPI)" FontSize="10" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Scan Document" Click="ScanHardware_Click" Height="28" Padding="12,0"
                                                                Background="#702943" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Content="Upload File" Click="SelectImage_Click" Height="28" Padding="10,0"
                                                                Background="#F6F0F2" Foreground="#702943" BorderBrush="#D0B8C0" BorderThickness="1"
                                                                FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT: 1:1 RECORD DIALOG FORM WITH STEP 1 & STEP 2 PARTITIONING -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#DDD0D5" BorderThickness="1" CornerRadius="10" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Step Wizard Indicator -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Scrollable Partitioned Content -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- STEP INDICATOR HEADER (3-STEP WIZARD) -->
                                <Border Grid.Row="0" Background="#FDFAFB" BorderBrush="#EDE0E5"
                                        BorderThickness="0,0,0,1" Padding="20,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Step 1: Primary Info -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Step1Header_Click">
                                            <Border x:Name="Step1Dot" Width="26" Height="26" CornerRadius="13"
                                                    Background="#702943">
                                                <TextBlock x:Name="Step1DotLabel" Text="1" Foreground="White" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="Step1Title" Text="Primary Info" FontSize="12" FontWeight="Bold"
                                                           Foreground="#702943"/>
                                                <TextBlock Text="Identity &amp; verification" FontSize="10" Foreground="#888888"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Height="2" Background="#E0E0E0"
                                                VerticalAlignment="Center" Margin="4,0"/>

                                        <!-- Step 2: Secondary Info -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Step2Header_Click">
                                            <Border x:Name="Step2Dot" Width="26" Height="26" CornerRadius="13"
                                                    Background="#E0E0E0">
                                                <TextBlock x:Name="Step2DotLabel" Text="2" Foreground="#AAAAAA"
                                                           FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="Step2Title" Text="Secondary Info"
                                                           FontSize="12" FontWeight="Bold" Foreground="#AAAAAA"/>
                                                <TextBlock Text="Address &amp; background" FontSize="10" Foreground="#AAAAAA"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="3" Height="2" Background="#E0E0E0"
                                                VerticalAlignment="Center" Margin="4,0"/>

                                        <!-- Step 3: Circumstances & Family -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Step3Header_Click">
                                            <Border x:Name="Step3Dot" Width="26" Height="26" CornerRadius="13"
                                                    Background="#E0E0E0">
                                                <TextBlock x:Name="Step3DotLabel" Text="3" Foreground="#AAAAAA"
                                                           FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="Step3Title" Text="Circumstances"
                                                           FontSize="12" FontWeight="Bold" Foreground="#AAAAAA"/>
                                                <TextBlock Text="Family &amp; circumstance" FontSize="10" Foreground="#AAAAAA"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- SCROLLABLE STEP CONTENT AREA -->
                                <Grid Grid.Row="1">

                                    <!-- ======================== STEP 1: PERSONAL INFO ======================== -->
                                    <ScrollViewer x:Name="ScrollStep1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="#F4F6F9" Visibility="Visible">
                                        <StackPanel Margin="20,12,20,16">

                                            <!-- CARD: I. IDENTIFYING INFORMATION -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <Grid>
                                                            <TextBlock Text="I. IDENTIFYING INFORMATION" Style="{StaticResource SectionLabel}" Padding="0,4,0,0"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="Date of Application:" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="#222222" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Border BorderBrush="#7B1426" BorderThickness="1.5" CornerRadius="6" Background="White" Width="180" Height="44" Padding="8,0,8,0">
                                                                    <DatePicker x:Name="DpDateOfApplication" Style="{StaticResource FormDateSm}"
                                                                                Tag="application_date" GotFocus="Field_GotFocus"
                                                                                GotKeyboardFocus="Field_GotFocus"
                                                                                PreviewMouseLeftButtonDown="Field_PreviewMouseDown"
                                                                                CalendarOpened="DatePicker_CalendarOpened"
                                                                                DateValidationError="DatePicker_DateValidationError"
                                                                                LostFocus="DatePicker_LostFocus"
                                                                                BorderThickness="0" Background="Transparent"
                                                                                Foreground="#222222" Cursor="Hand"/>
                                                                </Border>
                                                                <Border x:Name="Badge_AppDate" CornerRadius="3" Padding="4,1" Visibility="Collapsed" Margin="6,0,0,0">
                                                                    <TextBlock x:Name="TxtConf_AppDate" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ROW 1: Full Name (Last Name | First Name | Middle Name | Ext.) -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="75"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Last Name *" Style="{StaticResource FieldLabel}"/>
                                                                <Border x:Name="Badge_LastName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                    <TextBlock x:Name="TxtConf_LastName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBox x:Name="TxtLastName" Style="{StaticResource FormBox}"
                                                                     Tag="last_name" GotFocus="Field_GotFocus"
                                                                     MaxLength="50"
                                                                     PreviewTextInput="NameOnly_PreviewTextInput"
                                                                     TextChanged="TxtLastName_TextChanged"/>
                                                            <TextBlock x:Name="ErrLastName" Text="Required." Style="{StaticResource ErrorText}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="First Name *" Style="{StaticResource FieldLabel}"/>
                                                                <Border x:Name="Badge_FirstName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                    <TextBlock x:Name="TxtConf_FirstName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBox x:Name="TxtFirstName" Style="{StaticResource FormBox}"
                                                                     Tag="first_name" GotFocus="Field_GotFocus"
                                                                     MaxLength="50"
                                                                     PreviewTextInput="NameOnly_PreviewTextInput"
                                                                     TextChanged="TxtFirstName_TextChanged"/>
                                                            <TextBlock x:Name="ErrFirstName" Text="Required." Style="{StaticResource ErrorText}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Middle Name" Style="{StaticResource FieldLabel}"/>
                                                                <Border x:Name="Badge_MiddleName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                    <TextBlock x:Name="TxtConf_MiddleName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBox x:Name="TxtMiddleName" Style="{StaticResource FormBox}"
                                                                     Tag="middle_name" GotFocus="Field_GotFocus"
                                                                     MaxLength="50"
                                                                     PreviewTextInput="NameOnly_PreviewTextInput"
                                                                     TextChanged="TxtMiddleName_TextChanged"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3">
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Ext." Style="{StaticResource FieldLabel}"/>
                                                                <Border x:Name="Badge_Extension" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                    <TextBlock x:Name="TxtConf_Extension" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBox x:Name="TxtExtension" Style="{StaticResource FormBox}"
                                                                     Tag="ext_name" GotFocus="Field_GotFocus"
                                                                     MaxLength="10"
                                                                     PreviewTextInput="NameOnly_PreviewTextInput"
                                                                     TextChanged="TxtExtension_TextChanged"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- ROW 2: Birthdate | Age | PhilSys Card Number -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Birthdate *" Style="{StaticResource FieldLabel}"/>
                                                                <Border x:Name="Badge_Birthdate" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                    <TextBlock x:Name="TxtConf_Birthdate" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                                <DatePicker x:Name="DpBirthdate" Style="{StaticResource FormDate}"
                                                                            Tag="birthdate" GotFocus="Field_GotFocus"
                                                                            GotKeyboardFocus="Field_GotFocus"
                                                                            PreviewMouseLeftButtonDown="Field_PreviewMouseDown"
                                                                            CalendarOpened="DatePicker_CalendarOpened"
                                                                            SelectedDateChanged="DpBirthdate_SelectedDateChanged"
                                                                            DateValidationError="DatePicker_DateValidationError"
                                                                            LostFocus="DatePicker_LostFocus"
                                                                            BorderThickness="0" Background="Transparent"/>
                                                            </Border>
                                                            <TextBlock x:Name="ErrBirthdate" Text="Required." Style="{StaticResource ErrorText}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                                                            <TextBox x:Name="TxtAge" Style="{StaticResource FormBox}"
                                                                     Tag="age" GotFocus="Field_GotFocus"
                                                                     IsReadOnly="True" Background="#F0F0F0"
                                                                     HorizontalContentAlignment="Center"
                                                                     VerticalContentAlignment="Center"
                                                                     FontWeight="SemiBold"
