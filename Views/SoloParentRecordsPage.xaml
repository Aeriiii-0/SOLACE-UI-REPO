                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LAST NAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#702943" Margin="0,0,0,6"/>
                        <Border Background="White" CornerRadius="10"
                                BorderBrush="#D4A0B0" BorderThickness="1.5">
                            <TextBox x:Name="EncSearchLastName"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Foreground="#111111" VerticalAlignment="Center"
                                     Height="40" Padding="12,0"
                                     TextChanged="EncoderFields_TextChanged"
                                     KeyDown="SearchBox_KeyDown"
                                     ToolTip="Enter last name to search">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock Text="e.g. Dela Cruz" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BARANGAY" FontSize="10" FontWeight="Bold"
                                   Foreground="#702943" Margin="0,0,0,6"/>
                        <Border Background="White" CornerRadius="10"
                                BorderBrush="#D4A0B0" BorderThickness="1.5">
                            <TextBox x:Name="EncSearchBarangay"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Foreground="#111111" VerticalAlignment="Center"
                                     Height="40" Padding="12,0"
                                     TextChanged="EncoderFields_TextChanged"
                                     KeyDown="SearchBox_KeyDown"
                                     ToolTip="Enter barangay name to filter">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock Text="e.g. Loma" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DATE OF BIRTH" FontSize="10" FontWeight="Bold"
                                   Foreground="#702943" Margin="0,0,0,6"/>
                        <Border Background="White" CornerRadius="10"
                                BorderBrush="#D4A0B0" BorderThickness="1.5">
                            <TextBox x:Name="EncSearchBirthday"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Foreground="#111111" VerticalAlignment="Center"
                                     Height="40" Padding="12,0"
                                     TextChanged="EncoderFields_TextChanged"
                                     KeyDown="SearchBox_KeyDown"
                                     ToolTip="Enter date (yyyy-MM-dd format)">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock Text="yyyy-MM-dd" Foreground="#C0A8B0" FontSize="13"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="EncoderClearSearchBtn" Height="42" Padding="18,0" Margin="0,0,8,0" Cursor="Hand"
                            Click="ClearSearch_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="21"
                                        BorderBrush="#D4A0B0" BorderThickness="1.5"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Clear" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                    </Button>

                    <Button x:Name="EncoderAddBtn" Height="42" Padding="18,0" Margin="0,0,8,0" Cursor="Hand"
                            Click="BasicUserAddRecord_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="21"
                                        BorderBrush="#D4A0B0" BorderThickness="1.5"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ Add New Record" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                        </StackPanel>
                    </Button>

                    <Button Height="42" Padding="24,0" Cursor="Hand"
                            Click="EncoderSearchBtn_Click" ToolTip="Search for records">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#702943" CornerRadius="21"
                                        Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.22"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="White" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Search" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>


            </StackPanel>
        </Border>

        <!-- Paging row (Row 4, hidden for Encoder) -->
        <Grid x:Name="PagingRow" Grid.Row="4" Margin="24,4,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Size Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rows per page:" FontFamily="Segoe UI" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbPageSize" Width="80" Height="34" SelectedIndex="0"
                          SelectionChanged="CmbPageSize_SelectionChanged"
                          Style="{StaticResource FilterComboBox}">
                    <ComboBoxItem Content="10" IsSelected="True"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                </ComboBox>
            </StackPanel>

            <!-- Centered Navigation Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnBack" Width="105" Height="34" Cursor="Hand"
                        Click="BtnBack_Click" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="17"
                                    BorderBrush="#E0D0D5" BorderThickness="1.5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                          Fill="#702943" Stretch="Uniform" Width="10" Height="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="Previous" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Background="#FAF2F5" CornerRadius="14" Padding="14,6"
                        BorderBrush="#EBD8DE" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#702943"/>
                </Border>

                <Button x:Name="BtnNext" Width="105" Height="34" Cursor="Hand"
                        Click="BtnNext_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="17"
                                    BorderBrush="#E0D0D5" BorderThickness="1.5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Next" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Fill="#702943" Stretch="Uniform" Width="10" Height="10" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Grid.ColumnSpan="99"
                                   x:Name="PageLoadingOverlay"
                                   IsLoading="True"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Panel.ZIndex="9999"/>

    </Grid>
</Page>