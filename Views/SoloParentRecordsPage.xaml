                              Width="34" Height="34"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,5,3" Opacity="0.9"/>
                    </Grid>

                    <!-- Bold heading -->
                    <TextBlock Text="No data to display yet"
                               FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- Helper text -->
                    <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#888888"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="400"
                               Text="To view, edit, renew a record, please use the search bar above to verify identity."/>
                </StackPanel>

                <components:TableSkeletonLoader x:Name="RecordsSkeletonLoader"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Panel.ZIndex="30"/>
            </Grid>
        </Border>

        <Border x:Name="BasicUserToolbar" Grid.Row="1" Visibility="Collapsed" Margin="24,6,24,10">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#FFFFFF" CornerRadius="22"
                        BorderBrush="#E0D0D5" BorderThickness="1.5"
                        Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#C0A0AA" BlurRadius="15" ShadowDepth="3" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#702943" VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <TextBox x:Name="BasicSearchName" Grid.Column="1"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                                 ToolTip="Full name searches require exact matches (e.g., 'Juan Dela Cruz')"
                                 TextChanged="BasicSearchName_TextChanged"
                                 KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock Text="Search exact full name..." Foreground="#C0A8B0" FontSize="13"
                                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2"
                                Width="34" Height="34" Margin="2,0,5,0"
                                Cursor="Hand" Click="SearchBtn_Click" ToolTip="Search">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#702943" CornerRadius="17">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Height="44" Padding="18,0" Cursor="Hand"
                        Click="BasicUserAddRecord_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#702943" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.22"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="+ Add New Record" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- ENCODER / BASIC USER PANEL: Simple top banner with search box -->
        <Border x:Name="EncoderSearchPanel" Grid.Row="1"
                Visibility="Collapsed"
                Background="#E8F5E8EE" CornerRadius="16"
                Margin="24,16,24,12"
                BorderBrush="#702943" BorderThickness="2.5"
                Padding="28,36,28,36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Row: Title + Subtitle + Not Registered Text + Add Button -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title + Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Find a solo parent" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock Text="Search by name or PhilSys ID to open their record." FontFamily="Segoe UI" FontSize="12" Foreground="#A06080" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Center: Not Registered Text (moved left, before button) -->
                    <TextBlock Grid.Column="1" Text="Not registered?" FontFamily="Segoe UI" FontSize="12" Foreground="#A06080" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Right: Add Button -->
                    <Button Grid.Column="2" Height="40" Padding="18,0" Cursor="Hand" Click="BasicUserAddRecord_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#702943" CornerRadius="20" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.22"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ " FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Add new record" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Box Row: Rounded white search bar + round search button -->
                <Border Grid.Row="1" Background="White" CornerRadius="28" Height="56" BorderBrush="#702943" BorderThickness="1.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mode Dropdown -->
                        <ComboBox x:Name="EncSearchMode" Grid.Column="0" Style="{StaticResource SearchModeCombo}" Margin="12,0,0,0" VerticalAlignment="Center" SelectionChanged="EncSearchMode_SelectionChanged">
                            <ComboBoxItem Content="All / Auto" Tag="AUTO" IsSelected="True"/>
                            <ComboBoxItem Content="First Name" Tag="FIRST_NAME"/>
                            <ComboBoxItem Content="Last Name" Tag="LAST_NAME"/>
                            <ComboBoxItem Content="Full Name" Tag="FULL_NAME"/>
                            <ComboBoxItem Content="PhilSys ID" Tag="PHILSYS_ID"/>
                        </ComboBox>

                        <!-- Divider -->
                        <Rectangle Grid.Column="1" Fill="#D4A0B0" Width="1.5" Margin="8,12,8,12"/>

                        <!-- Search Text Box -->
                        <TextBox x:Name="EncSearchQuery" Grid.Column="2" BorderThickness="0" Background="Transparent" FontFamily="Segoe UI" FontSize="13" Foreground="#333333" Padding="16,0" VerticalAlignment="Center" TextChanged="EncoderFields_TextChanged" KeyDown="SearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock Text="Search records (name, PhilSys ID)..." Foreground="#C0A8B0" FontSize="13" VerticalAlignment="Center" Padding="16,0" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="16,0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Search Button (fully round, 48x48) -->
                        <Button Grid.Column="3" Width="48" Height="48" Margin="8,0,8,0" Cursor="Hand" Click="EncoderSearchBtn_Click" ToolTip="Search records">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#702943" CornerRadius="24">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.82"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z" Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>


        <!-- Paging row (Row 4, hidden for Encoder) -->
        <Grid x:Name="PagingRow" Grid.Row="4" Margin="24,4,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Size Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Rows per page:" FontFamily="Segoe UI" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbPageSize" Width="80" Height="34" SelectedIndex="0"
                          SelectionChanged="CmbPageSize_SelectionChanged"
                          Style="{StaticResource FilterComboBox}">
                    <ComboBoxItem Content="10" IsSelected="True"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                </ComboBox>
            </StackPanel>

            <!-- Centered Navigation Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnBack" Width="105" Height="34" Cursor="Hand"
                        Click="BtnBack_Click" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="17"
                                    BorderBrush="#E0D0D5" BorderThickness="1.5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                          Fill="#702943" Stretch="Uniform" Width="10" Height="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="Previous" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Background="#FAF2F5" CornerRadius="14" Padding="14,6"
                        BorderBrush="#EBD8DE" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#702943"/>
                </Border>

                <Button x:Name="BtnNext" Width="105" Height="34" Cursor="Hand"
                        Click="BtnNext_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="17"
                                    BorderBrush="#E0D0D5" BorderThickness="1.5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Next" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Fill="#702943" Stretch="Uniform" Width="10" Height="10" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Grid.ColumnSpan="99"
                                   x:Name="PageLoadingOverlay"
                                   IsLoading="False"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Panel.ZIndex="9999" Loaded="PageLoadingOverlay_Loaded"/>

    </Grid>
</Page>
