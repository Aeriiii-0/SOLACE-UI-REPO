<Page x:Class="SOLUM_UI.Views.Pages.SubsidyRecommendationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:c="clr-namespace:SOLUM_UI.Views.Components"
      xmlns:vm="clr-namespace:SOLUM_UI.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1200"
      Title="Subsidy Recommendation"
      Background="#FFFFFF">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PageTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#A06080"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBg" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="#FDF5F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Row 0: Page Title & Metrics Header -->
        <Grid Grid.Row="0" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Subsidy Recommendation" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#702943"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Last Refreshed Timestamp Pill -->
                <Border VerticalAlignment="Center" Background="#FAF2F5" CornerRadius="12" Padding="10,6" BorderBrush="#EBD8DE" BorderThickness="1" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                              Fill="#702943" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" Opacity="0.75"/>
                        <TextBlock Text="{Binding LastRefreshedText, FallbackValue='Updated: Just now'}" FontSize="11.5" FontFamily="Segoe UI" FontWeight="Medium" Foreground="#702943"/>
                    </StackPanel>
                </Border>
                <!-- Circular Refresh Button -->
                <Button x:Name="BtnRefreshSubsidy"
                        Width="40" Height="40" Margin="8,0,0,0"
                        BorderThickness="0" Background="White"
                        Cursor="Hand" ToolTip="{Binding RefreshTooltip, FallbackValue='Refresh subsidy recommendations'}"
                        Command="{Binding RefreshCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    CornerRadius="20" BorderBrush="#E0D0D5" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                          Fill="#702943" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>
        <!-- Row 1: Cycle & Fiscal Year Management Control Bar -->
        <c:SubsidyCycleControlBar Grid.Row="1" Margin="24,0,24,10"/>
        <!-- Row 2: Tab Navigation Bar -->
        <Border Grid.Row="2" BorderBrush="#E8D8DE" BorderThickness="0,0,0,1" Margin="24,0,24,0">
            <StackPanel Orientation="Horizontal">
                <!-- Tab 0: Recommendations Queue (Active Cycle only) -->
                <Button Style="{StaticResource PageTabBtn}" Command="{Binding SwitchTabCommand}" CommandParameter="0"
                        IsEnabled="{Binding CanAccessActivePipelineTabs}">
                    <Button.ToolTip>
                        <ToolTip Content="{Binding TabDisabledTooltipText}"/>
                    </Button.ToolTip>
                    <TextBlock Text="Recommendations Queue" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A06080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabRecommendationsVisible}" Value="True">
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <!-- Tab 1: Approved Selection & Audit (Active Cycle only) -->
                <Button Style="{StaticResource PageTabBtn}" Command="{Binding SwitchTabCommand}" CommandParameter="1"
                        IsEnabled="{Binding CanAccessActivePipelineTabs}">
                    <Button.ToolTip>
                        <ToolTip Content="{Binding TabDisabledTooltipText}"/>
                    </Button.ToolTip>
                    <TextBlock Text="Approved Selection &amp; Audit" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A06080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabShortlistVisible}" Value="True">
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <!-- Tab 2: Final Grantees & Archive (Always Accessible) -->
                <Button Style="{StaticResource PageTabBtn}" Command="{Binding SwitchTabCommand}" CommandParameter="2">
                    <TextBlock Text="Final Grantees" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A06080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabFinalVisible}" Value="True">
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>
        <!-- Row 3: Tab Content Area -->
        <Grid Grid.Row="3" Margin="24,10,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Tab Grids -->
            <Grid Grid.Column="0">
                <c:RecommendationQueueGrid Visibility="{Binding TabRecommendationsVisible, Converter={StaticResource BoolToVis}}"/>
                <c:ShortlistAuditGrid Visibility="{Binding TabShortlistVisible, Converter={StaticResource BoolToVis}}"/>
                <c:FinalGranteesArchiveGrid Visibility="{Binding TabFinalVisible, Converter={StaticResource BoolToVis}}"/>
                <c:SubsidyTableSkeletonLoader x:Name="SubsidySkeleton"
                                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                              Panel.ZIndex="10"/>
            </Grid>
            <!-- Detail / Explain Drawer (Accessible on Tab 0 and Tab 1) -->
            <c:SubsidyExplainDrawer Grid.Column="1" Margin="12,0,0,0"
                                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}"/>
        </Grid>
        <!-- Outlier Rejection Modal Overlay (Spans all rows) -->
        <c:ModalOutlierRejection Grid.RowSpan="4"/>
        <!-- Disqualified Candidates Audit Log Modal Overlay (Spans all rows) -->
        <c:ModalDisqualifiedCandidates Grid.RowSpan="4"/>
        <!-- Loading Overlay (Disabled in favor of modern Skeleton Loader) -->
        <c:LoadingOverlay Grid.RowSpan="4" IsLoading="False" Visibility="Collapsed" Panel.ZIndex="9999"/>
    </Grid>
</Page>