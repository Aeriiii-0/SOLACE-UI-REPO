<Page x:Class="SOLUM_UI.Views.Pages.SubsidyRecommendationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:c="clr-namespace:SOLUM_UI.Views.Components"
      xmlns:vm="clr-namespace:SOLUM_UI.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1200"
      Title="Subsidy Recommendation"
      Background="#FFFFFF">
    
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PageTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#A06080"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBg" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="#FDF5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Page Title & Metrics Header -->
        <Grid Grid.Row="0" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Subsidy Recommendation" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#702943"/>
                <TextBlock Text="ML vulnerability triage and quota allocation awaiting staff review." FontFamily="Segoe UI" FontSize="12" Foreground="#A06080" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- Quota Status Section (Structured Section, No Emojis) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5D5DC" BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Progress Bar & Acceptance Label -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="180" Margin="0,0,14,0">
                        <TextBlock Text="ACCEPTED RECIPIENTS" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,4"/>
                        <Border Height="6" Background="#F5E8EC" CornerRadius="3" ClipToBounds="True">
                            <ProgressBar Value="{Binding QuotaFillPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="#27AE60"/>
                        </Border>
                        <TextBlock Text="{Binding QuotaProgressText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#27AE60" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Vertical Divider -->
                    <Border Grid.Column="1" Width="1" Background="#EEDDE2" Margin="0,2,14,2"/>

                    <!-- Slots Indicators & Details Action -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total Slots -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="TOTAL SLOTS" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                            <TextBlock Text="{Binding GranteeSlots}" FontSize="14" FontWeight="Bold" Foreground="#702943" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Remaining Slots -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="REMAINING" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                            <TextBlock Text="{Binding RemainingSlots}" FontSize="14" FontWeight="Bold" Foreground="#B45309" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Details Flyout Button -->
                        <Grid VerticalAlignment="Center">
                            <Button x:Name="SlotBreakdownBtn" Height="28" Padding="10,0" Cursor="Hand" Click="SlotBreakdownBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#FBF5F7" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Details ▾" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Popup x:Name="SlotPopup" PlacementTarget="{Binding ElementName=SlotBreakdownBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1.5" Padding="14,10" MinWidth="220">
                                    <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="14" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Quota Slots Breakdown" FontSize="11.5" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,8"/>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Total Allocated Quota:" FontSize="11" Foreground="#555555"/>
                                            <TextBlock Text="{Binding GranteeSlots}" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Confirmed Grantees:" FontSize="11" Foreground="#555555"/>
                                            <TextBlock Text="{Binding ConfirmedGranteesCount}" FontSize="11" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Shortlisted in Review:" FontSize="11" Foreground="#555555"/>
                                            <TextBlock Text="{Binding ShortlistRows.Count}" FontSize="11" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6" Background="#F0E2E7"/>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Remaining Open Slots:" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                            <TextBlock Text="{Binding RemainingSlots}" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Tab Navigation Bar -->
        <Border Grid.Row="1" BorderBrush="#E8D8DE" BorderThickness="0,0,0,1" Margin="24,0,24,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PageTabBtn}" Command="{Binding SwitchTabCommand}" CommandParameter="0">
                    <TextBlock Text="Recommendations Queue" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A06080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabRecommendationsVisible}" Value="True">
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PageTabBtn}" Command="{Binding SwitchTabCommand}" CommandParameter="1">
                    <TextBlock Text="Approved Selection &amp; Audit" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A06080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabShortlistVisible}" Value="True">
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PageTabBtn}" Command="{Binding SwitchTabCommand}" CommandParameter="2">
                    <TextBlock Text="Final Grantees &amp; Archive" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A06080"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabFinalVisible}" Value="True">
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- Row 2: Tab Content Area -->
        <Grid Grid.Row="2" Margin="24,10,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tab Grids -->
            <Grid Grid.Column="0">
                <c:RecommendationQueueGrid Visibility="{Binding TabRecommendationsVisible, Converter={StaticResource BoolToVis}}"/>
                <c:ShortlistAuditGrid Visibility="{Binding TabShortlistVisible, Converter={StaticResource BoolToVis}}"/>
                <c:FinalGranteesArchiveGrid Visibility="{Binding TabFinalVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Detail / Explain Drawer (Accessible on Tab 0 and Tab 1) -->
            <c:SubsidyExplainDrawer Grid.Column="1" Margin="12,0,0,0"
                                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Outlier Rejection Modal Overlay (Spans all rows) -->
        <c:ModalOutlierRejection Grid.RowSpan="3"/>
    </Grid>
</Page>
