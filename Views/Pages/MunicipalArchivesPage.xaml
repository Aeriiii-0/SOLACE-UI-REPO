<Page x:Class="SOLUM_UI.Views.Pages.MunicipalArchivesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1200"
      Title="Municipal Archives"
      Background="#FFFFFF"
      TextOptions.TextRenderingMode="ClearType"
      TextOptions.TextFormattingMode="Display">

    <Page.Resources>
        <!-- Table Header Style -->
        <Style x:Key="ArchiveHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#FBF1F4"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FBF1F4" BorderBrush="#702943" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveHeaderCenter" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ArchiveHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Table Row Style -->
        <Style x:Key="ArchiveTableRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0E4E9"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <GridViewRowPresenter VerticalAlignment="Stretch" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#F8E9EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Style -->
        <Style x:Key="ArchiveCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20" Padding="14,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M7,10L12,15L17,10H7Z" Fill="#702943" Width="11" Height="11"
                                          Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1.5"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Padding="4" Margin="0,0,8,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FAF2F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent" CornerRadius="6" Margin="2,1" Padding="12,8">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#FAF2F5"/>
                                            <Setter Property="Foreground" Value="#702943"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#F3E5EB"/>
                                            <Setter Property="Foreground" Value="#702943"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#FFFFFF" Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Bar -->
            <RowDefinition Height="Auto"/> <!-- Search & Filter Controls -->
            <RowDefinition Height="*"/>    <!-- Masterlist Grid -->
            <RowDefinition Height="Auto"/> <!-- Pagination Footer -->
        </Grid.RowDefinitions>

        <!-- ── Top Action Header ── -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBackToRecords" Grid.Column="0" Height="36" Cursor="Hand" Click="BtnBackToRecords_Click" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFFFFF" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="18" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                      Fill="#702943" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Back to Records" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Admin Action: Run Retention Pipeline -->
            <Button x:Name="BtnRunPipeline" Grid.Column="2" Height="40" Padding="18,0" Cursor="Hand" Click="BtnRunPipeline_Click" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFFFFF" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                      Fill="#702943" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Run Retention Pipeline" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ── Search & Filter Controls ── -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>        <!-- Blind-Index Search Box -->
                <ColumnDefinition Width="Auto"/>     <!-- Barangay Filter -->
                <ColumnDefinition Width="Auto"/>     <!-- Archive Reason Filter -->
                <ColumnDefinition Width="Auto"/>     <!-- Year Filter -->
                <ColumnDefinition Width="Auto"/>     <!-- Refresh Button -->
            </Grid.ColumnDefinitions>

            <!-- Blind Index Search -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="20" BorderBrush="#702943" BorderThickness="1.2" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="#702943" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <TextBox x:Name="TxtSearchQuery" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             FontSize="13.5" FontFamily="Segoe UI" Foreground="#111111" VerticalAlignment="Center"
                             KeyDown="TxtSearchQuery_KeyDown"/>
                    <TextBlock Grid.Column="1" Text="Encrypted Blind-Index Search (Citizen Name or PhilSys ID)..."
                               FontFamily="Segoe UI" FontSize="13.5" Foreground="#B098A0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Width="32" Height="32" Margin="0,0,4,0" Cursor="Hand" Click="BtnSearch_Click" ToolTip="Search">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#702943" CornerRadius="16">
                                    <Path Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"
                                          Fill="White" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Barangay Filter -->
            <ComboBox x:Name="CmbBarangay" Grid.Column="1" Style="{StaticResource ArchiveCombo}" Width="150" Margin="0,0,10,0" SelectionChanged="FilterControl_Changed">
                <ComboBoxItem Content="All Barangays" IsSelected="True"/>
                <ComboBoxItem Content="Bi&#241;an (Poblacion)"/>
                <ComboBoxItem Content="Bungahan"/>
                <ComboBoxItem Content="Canlalay"/>
                <ComboBoxItem Content="Casile"/>
                <ComboBoxItem Content="De La Paz"/>
                <ComboBoxItem Content="Ganado"/>
                <ComboBoxItem Content="Langkiwa"/>
                <ComboBoxItem Content="Loma"/>
                <ComboBoxItem Content="Malaban"/>
                <ComboBoxItem Content="Malamig"/>
                <ComboBoxItem Content="Mampalasan"/>
                <ComboBoxItem Content="Platero"/>
                <ComboBoxItem Content="Poblacion"/>
                <ComboBoxItem Content="Santo Ni&#241;o"/>
                <ComboBoxItem Content="San Antonio"/>
                <ComboBoxItem Content="San Francisco"/>
                <ComboBoxItem Content="San Jose"/>
                <ComboBoxItem Content="San Vicente"/>
                <ComboBoxItem Content="Santo Tomas"/>
                <ComboBoxItem Content="Sorrento"/>
                <ComboBoxItem Content="Timbao"/>
                <ComboBoxItem Content="Tubigan"/>
                <ComboBoxItem Content="Zapote"/>
            </ComboBox>

            <!-- Archive Reason Filter -->
            <ComboBox x:Name="CmbReason" Grid.Column="2" Style="{StaticResource ArchiveCombo}" Width="170" Margin="0,0,10,0" SelectionChanged="FilterControl_Changed">
                <ComboBoxItem Content="All Reasons" IsSelected="True"/>
                <ComboBoxItem Content="Inactive 5+ Years" Tag="Inactive5Years"/>
                <ComboBoxItem Content="Deletion Expired" Tag="DeletionExpired"/>
            </ComboBox>

            <!-- Year Filter -->
            <ComboBox x:Name="CmbYear" Grid.Column="3" Style="{StaticResource ArchiveCombo}" Width="120" Margin="0,0,10,0" SelectionChanged="FilterControl_Changed">
                <ComboBoxItem Content="All Years" IsSelected="True"/>
                <ComboBoxItem Content="2026"/>
                <ComboBoxItem Content="2025"/>
                <ComboBoxItem Content="2024"/>
                <ComboBoxItem Content="2023"/>
                <ComboBoxItem Content="2022"/>
                <ComboBoxItem Content="2021"/>
                <ComboBoxItem Content="2020"/>
            </ComboBox>

            <!-- Refresh Button -->
            <Button x:Name="BtnRefresh" Grid.Column="4" Width="40" Height="40" Cursor="Hand" Click="BtnRefresh_Click" ToolTip="Refresh Archives">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFFFFF" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="20">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="#702943" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ── Main DataGrid ── -->
        <Border Grid.Row="2" CornerRadius="16" BorderBrush="#702943" BorderThickness="1.2" Background="White" ClipToBounds="True">
            <Grid x:Name="ArchivesTableGrid" SizeChanged="ArchivesTableGrid_SizeChanged">
                <ListView x:Name="ArchivesList" BorderThickness="0" Background="Transparent"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          ItemContainerStyle="{StaticResource ArchiveTableRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource ArchiveHeader}">
                            <!-- Citizen Name -->
                            <GridViewColumn x:Name="ColName" Header="NAME" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#111111" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Barangay -->
                            <GridViewColumn x:Name="ColBarangay" Header="BARANGAY" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Barangay}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- PhilSys Card -->
                            <GridViewColumn x:Name="ColPhilsys" Header="PHILSYS CARD" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PhilsysCardNumber}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Archived Date -->
                            <GridViewColumn x:Name="ColArchivedDate" Header="ARCHIVED DATE" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateArchived, StringFormat='{}{0:yyyy-MM-dd}'}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Archive Reason (Clean typography, no colored pill) -->
                            <GridViewColumn x:Name="ColReason" Header="ARCHIVE REASON" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ArchiveReasonDisplay}" FontFamily="Segoe UI" FontSize="12.5" Foreground="#111111" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Case Actions -->
                            <GridViewColumn x:Name="ColActions" Header="ACTIONS" Width="220" HeaderContainerStyle="{StaticResource ArchiveHeaderCenter}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- View Details -->
                                            <Button Height="30" Cursor="Hand" Click="BtnViewDossier_Click" Tag="{Binding Id}" Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="#FFFFFF" BorderBrush="#702943" BorderThickness="1.2" CornerRadius="8" Padding="12,0">
                                                            <TextBlock Text="View Details" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Reactivate -->
                                            <Button Height="30" Cursor="Hand" Click="BtnReactivate_Click" Tag="{Binding Id}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="#059669" CornerRadius="8" Padding="12,0">
                                                            <TextBlock Text="Reactivate" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#047857"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#F5EEF1" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="M3,3H21V7H3V3M4,8H20V21H4V8M9.5,11A1.5,1.5 0 0,0 8,12.5A1.5,1.5 0 0,0 9.5,14H14.5A1.5,1.5 0 0,0 16,12.5A1.5,1.5 0 0,0 14.5,11H9.5Z"
                              Fill="#702943" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No archived records found" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try adjusting your blind-index search query or filter parameters."
                               FontFamily="Segoe UI" FontSize="12.5" Foreground="#777777" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Shimmering Skeleton Loader -->
                <components:ArchiveTableSkeletonLoader x:Name="ArchivesSkeletonLoader"
                                                       Visibility="Collapsed"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       Panel.ZIndex="30"/>
            </Grid>
        </Border>

        <!-- ── Pagination Footer ── -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtPaginationInfo" Grid.Column="0" Text="Showing 0 of 0 archived records"
                       FontFamily="Segoe UI" FontSize="12.5" Foreground="#666666" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
