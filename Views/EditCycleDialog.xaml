<Window x:Class="SOLUM_UI.Views.EditCycleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Cycle Settings"
        Height="520"
        Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5C1D38"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4B6C2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#5C1D38"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#5C1D38"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ReadOnlyBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#5C1D38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#E5D8DC"/>
        </Style>
    </Window.Resources>
    
    <Border Background="White" 
            CornerRadius="16" 
            BorderBrush="#5C1D38" 
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#5C1D38" BlurRadius="20" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="#5C1D38" 
                    CornerRadius="14,14,0,0" 
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="10" 
                            Width="40" 
                            Height="40" 
                            Margin="0,0,14,0">
                        <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75,-3.75L3,17.25Z M20.71,7.04c.39,-.39.39,-1.02 0,-1.41l-2.34,-2.34c-.39,-.39,-1.02,-.39,-1.41,0l-1.83,1.83 3.75,3.75 1.83,-1.83Z" 
                              Fill="#5C1D38" 
                              Stretch="Uniform" 
                              Width="18" 
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Edit Cycle Settings" 
                                   FontFamily="Segoe UI" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock x:Name="TxtFiscalYear"
                                   Text="Fiscal Year 2026" 
                                   FontFamily="Segoe UI" 
                                   FontSize="12" 
                                   Foreground="#E5D8DC"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2" 
                            Width="32" 
                            Height="32" 
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBg" 
                                        Background="Transparent" 
                                        CornerRadius="8">
                                    <Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" 
                                          Fill="White" 
                                          Stretch="Uniform" 
                                          Width="14" 
                                          Height="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBg" Property="Background" Value="#702943"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          Padding="28,24">
                <StackPanel>
                    <!-- Target Grantees (Slots) -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Target Grantees (Slots)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtTargetGrantees"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding TargetGrantees, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="InputField_TextChanged"/>
                        <TextBlock Text="Number of solo parents allocated for this cycle"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="#888888"
                                   Margin="2,6,0,0"/>
                    </StackPanel>
                    
                    <!-- Grant Amount Per Recipient -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Grant Amount per Recipient (PHP)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="TxtGrantAmount"
                                     Style="{StaticResource InputBox}"
                                     Text="{Binding GrantAmountPerRecipient, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="38,0,14,0"
                                     TextChanged="InputField_TextChanged"/>
                            <TextBlock Text="₱" 
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock Text="Financial assistance amount per qualified solo parent"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="#888888"
                                   Margin="2,6,0,0"/>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Border Height="1" 
                            Background="#EDE2E6" 
                            Margin="0,4,0,20"/>
                    
                    <!-- Total Budget (Calculated) -->
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Total Budget (Auto-calculated)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="TxtTotalBudget"
                                     Style="{StaticResource ReadOnlyBox}"
                                     Text="{Binding TotalBudgetFormatted, Mode=OneWay}"
                                     Padding="38,0,14,0"/>
                            <TextBlock Text="₱" 
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#5C1D38"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Border Background="#FFF8F0"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2L1,21H23M12,6L19.5,19H4.5M11,10V14H13V10M11,16V18H13V16" 
                                      Fill="#F59E0B" 
                                      Stretch="Uniform" 
                                      Width="16" 
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="#92400E">
                                    <Run Text="Total Budget = Target Grantees × Grant Amount per Recipient" FontWeight="SemiBold"/>
                                    <LineBreak/>
                                    <Run Text="This value is automatically calculated and cannot be edited directly."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Actions -->
            <Border Grid.Row="2" 
                    Background="#FAFAFA" 
                    BorderBrush="#EDE2E6" 
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Validation Message -->
                    <TextBlock x:Name="TxtValidation"
                               Grid.Column="0"
                               Text=""
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#DC2626"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    
                    <!-- Cancel Button -->
                    <Button Grid.Column="1"
                            Height="40"
                            Padding="20,0"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CancelBg" 
                                        Background="Transparent" 
                                        BorderBrush="#D4B6C2" 
                                        BorderThickness="1.5" 
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Cancel" 
                                               FontFamily="Segoe UI"
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               Foreground="#5C1D38"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CancelBg" Property="Background" Value="#FBF5F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Save Button (Rounded) -->
                    <Button Grid.Column="2"
                            Height="40"
                            Padding="28,0"
                            Cursor="Hand"
                            Click="SaveButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SaveBg" 
                                        Background="#5C1D38" 
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center">
                                        <Path Data="M17,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12A3,3 0 0,0 9,15A3,3 0 0,0 12,18A3,3 0 0,0 15,15A3,3 0 0,0 12,12M6,6H15V10H6V6Z" 
                                              Fill="White" 
                                              Stretch="Uniform" 
                                              Width="14" 
                                              Height="14"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="Save Changes" 
                                                   FontFamily="Segoe UI"
                                                   FontSize="13" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SaveBg" Property="Background" Value="#702943"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="SaveBg" Property="Background" Value="#D4B6C2"/>
                                        <Setter TargetName="SaveBg" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
