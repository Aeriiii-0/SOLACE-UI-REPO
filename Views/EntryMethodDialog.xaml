<Window x:Class="SOLUM_UI.EntryMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="640" Height="440"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="MethodCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E8D4DA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="22,22,22,20">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Card" Property="Background" Value="#FFFAFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FBF1F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="White" BorderBrush="#E0D0D5" BorderThickness="1" CornerRadius="17">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#702943" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBF1F4"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Border Background="White" CornerRadius="22">
            <Border.Effect>
                <DropShadowEffect Color="#3A1020" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.22"/>
            </Border.Effect>
        </Border>
        <Border Background="White" CornerRadius="22" BorderBrush="#EBDDE2" BorderThickness="1" Padding="32,28,32,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Add new record" FontSize="22" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock Text="Choose how you want to enter the solo parent's information."
                                   FontSize="13" Foreground="#5F4F55" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click" VerticalAlignment="Top" ToolTip="Close"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CardScan" Grid.Column="0" Style="{StaticResource MethodCard}" Click="ScanDocument_Click">
                        <StackPanel>
                            <Border Width="52" Height="52" CornerRadius="26" Background="#FBF1F4" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,8 V5 A1,1 0 0 1 5,4 H8 M16,4 H19 A1,1 0 0 1 20,5 V8 M20,16 V19 A1,1 0 0 1 19,20 H16 M8,20 H5 A1,1 0 0 1 4,19 V16 M4,12 H20"
                                              Stroke="#702943" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Scan a document" FontSize="16" FontWeight="Bold" Foreground="#111111"/>
                            <TextBlock Text="Upload an ID or form and let the system read the details for you."
                                       FontSize="12.5" Foreground="#5F4F55" TextWrapping="Wrap" Margin="0,6,0,20" MinHeight="36"/>
                            <Border Background="#702943" CornerRadius="17" Height="34" Padding="16,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Start scanning" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CardManual" Grid.Column="2" Style="{StaticResource MethodCard}" Click="ManualFill_Click">
                        <StackPanel>
                            <Border Width="52" Height="52" CornerRadius="26" Background="#FBF1F4" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,20 H21 M16.5,3.5 A2.12,2.12 0 0 1 20.5,7.5 L7.5,20.5 L3,21 L3.5,16.5 Z"
                                              Stroke="#702943" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Fill in manually" FontSize="16" FontWeight="Bold" Foreground="#111111"/>
                            <TextBlock Text="Type in the details yourself, step by step."
                                       FontSize="12.5" Foreground="#5F4F55" TextWrapping="Wrap" Margin="0,6,0,20" MinHeight="36"/>
                            <Border Background="#702943" CornerRadius="17" Height="34" Padding="16,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Add a record" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                   
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
