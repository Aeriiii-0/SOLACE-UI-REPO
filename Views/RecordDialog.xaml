<Window x:Class="SOLUM_UI.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solo Parent Application Form"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Width="900" Height="760">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="Transparent" BorderThickness="0">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#BBBBBB" FontSize="14"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="14,9"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#222222"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Foreground="#111111" Background="Transparent"
                                               BorderThickness="0" Padding="10,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                            <Button x:Name="PART_Button" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="20" Height="20"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19Z"
                                              Fill="#702943" Stretch="Uniform" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Grid.Column="0" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0"
                                        BorderThickness="1" Padding="8,6" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="White"
                                              BorderThickness="0" Foreground="#222222"
                                              FontSize="13">
                                        <Calendar.Resources>
                                            <Style TargetType="CalendarDayButton">
                                                <Setter Property="Width" Value="30"/>
                                                <Setter Property="Height" Value="30"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarDayButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsToday" Value="True">
                                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                                                    <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                </MultiTrigger>
                                                                <Trigger Property="IsInactive" Value="True">
                                                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                                                </Trigger>
                                                                <Trigger Property="IsBlackedOut" Value="True">
                                                                    <Setter Property="Foreground" Value="#DDDDDD"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="CalendarButton">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="2">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="HasSelectedDays" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="HasSelectedDays" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Calendar.Resources>
                                    </Calendar>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCheck" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,5,20,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="Margin" Value="2,3,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#EDE0E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardSectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FormBoxSm" TargetType="TextBox" BasedOn="{StaticResource FormBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="FormDateSm" TargetType="DatePicker" BasedOn="{StaticResource FormDate}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldLabelSm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

    </Window.Resources>

    <!-- Dimmed overlay -->
    <Border Background="#44000000" Padding="0">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Border x:Name="DialogShell" Background="White" CornerRadius="16"
                    ClipToBounds="True"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="White" CornerRadius="16,16,0,0"
                            BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="32,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="FormSubtitle" Text="Add New Record"
                                           FontSize="19" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock x:Name="FormStepHint" Text="Step 1 of 2 — Personal Information"
                                           FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="32" Height="32" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBg" Background="Transparent" CornerRadius="16">
                                            <TextBlock Text="&#x2715;" FontSize="14" Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBg" Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Step indicator -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1" Padding="32,12,32,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step1Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#702943">
                                    <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Personal Info" FontSize="13" FontWeight="Bold"
                                               Foreground="#702943"/>
                                    <TextBlock Text="Identity, contact &amp; family" FontSize="11" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Height="2" Background="#E0E0E0"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step2Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#E0E0E0">
                                    <TextBlock x:Name="Step2DotLabel" Text="2" Foreground="#AAAAAA"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step2Title" Text="Circumstances &amp; Status"
                                               FontSize="13" FontWeight="Bold" Foreground="#AAAAAA"/>
                                    <TextBlock Text="Referral, needs &amp; status" FontSize="11" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable content area -->
                    <Grid Grid.Row="2">

                        <!-- STEP 1 -->
                        <ScrollViewer x:Name="ScrollStep1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9" Visibility="Visible">
                            <StackPanel Margin="32,12,32,16">

                                <!-- CARD: APPLICANT TYPE -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="APPLICANT TYPE" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="ChkNewApplicant" Content="New Applicant"
                                                      Style="{StaticResource FormCheck}" Margin="0,0,0,0"
                                                      Checked="ApplicantType_Changed" Unchecked="ApplicantType_Changed"/>
                                            <CheckBox Grid.Column="1" x:Name="ChkRenewal" Content="For Renewal"
                                                      Style="{StaticResource FormCheck}" Margin="0,0,0,0"
                                                      Checked="ApplicantType_Changed" Unchecked="ApplicantType_Changed"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Date of This Application:" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#222222" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Width="220">
                                                    <DatePicker x:Name="DpDateOfApplication" Style="{StaticResource FormDate}" Height="36"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: I. IDENTIFYING INFORMATION -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="I. IDENTIFYING INFORMATION" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- name row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Last Name *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtLastName" Style="{StaticResource FormBox}"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                         TextChanged="TxtLastName_TextChanged"/>
                                                <TextBlock x:Name="ErrLastName" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="First Name *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtFirstName" Style="{StaticResource FormBox}"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                         TextChanged="TxtFirstName_TextChanged"/>
                                                <TextBlock x:Name="ErrFirstName" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Text="Middle Name" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMiddleName" Style="{StaticResource FormBox}"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                                <TextBlock Text="Ext." Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtExtension" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                                <TextBlock Text="Civil Status *" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbCivilStatus" Style="{StaticResource FormCombo}"
                                                              SelectionChanged="CmbCivilStatus_SelectionChanged">
                                                        <ComboBoxItem Content="Single"/>
                                                        <ComboBoxItem Content="Married"/>
                                                        <ComboBoxItem Content="Widowed"/>
                                                        <ComboBoxItem Content="Separated"/>
                                                        <ComboBoxItem Content="Divorced"/>
                                                        <ComboBoxItem Content="Annulled"/>
                                                    </ComboBox>
                                                </Border>
                                                <TextBlock x:Name="ErrCivilStatus" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="5">
                                                <TextBlock Text="Sex *" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbSex" Style="{StaticResource FormCombo}"
                                                              SelectionChanged="CmbSex_SelectionChanged">
                                                        <ComboBoxItem Content="Male"/>
                                                        <ComboBoxItem Content="Female"/>
                                                    </ComboBox>
                                                </Border>
                                                <TextBlock x:Name="ErrSex" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- birth / education row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Birthdate *" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <DatePicker x:Name="DpBirthdate" Style="{StaticResource FormDate}"
                                                                SelectedDateChanged="DpBirthdate_SelectedDateChanged"/>
                                                </Border>
                                                <TextBlock x:Name="ErrBirthdate" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Birthplace *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtPlaceOfBirth" Style="{StaticResource FormBox}"
                                                         TextChanged="TxtPlaceOfBirth_TextChanged"/>
                                                <TextBlock x:Name="ErrPlaceOfBirth" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtAge" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Background="#F0F0F0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                                <TextBlock Text="Educational Attainment" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbEducation" Style="{StaticResource FormCombo}">
                                                        <ComboBoxItem Content="Elementary"/>
                                                        <ComboBoxItem Content="High School"/>
                                                        <ComboBoxItem Content="Vocational"/>
                                                        <ComboBoxItem Content="College"/>
                                                        <ComboBoxItem Content="Post Graduate"/>
                                                    </ComboBox>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="PhilSys Card Number" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtPhilSys" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- religion / occupation / income / employment row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Religion" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtReligion" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Occupation / Source of Income" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtOccupation" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Text="Monthly Income" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMonthlyIncome" Style="{StaticResource FormBox}"
                                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Employment Status" Style="{StaticResource FieldLabel}"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="44">
                                                    <RadioButton x:Name="ChkEmployed"     Content="Employed"      Style="{StaticResource FormCheck}" GroupName="Employment"/>
                                                    <RadioButton x:Name="ChkSelfEmployed" Content="Self-Employed" Style="{StaticResource FormCheck}" GroupName="Employment"/>
                                                    <RadioButton x:Name="ChkNotEmployed"  Content="Not Employed"  Style="{StaticResource FormCheck}" GroupName="Employment"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- address row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Address (House No. / Street / Subdivision / Zone or Purok) *"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtAddress" Style="{StaticResource FormBox}"
                                                         TextChanged="TxtAddress_TextChanged"/>
                                                <TextBlock x:Name="ErrAddress" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Barangay *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtBarangay" Style="{StaticResource FormBox}"
                                                         TextChanged="TxtBarangay_TextChanged"/>
                                                <TextBlock x:Name="ErrBarangay" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Applicant's Contact Number *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtContact" Style="{StaticResource FormBox}"
                                                         MaxLength="13"
                                                         PreviewTextInput="Phone_PreviewTextInput"
                                                         PreviewKeyDown="Phone_PreviewKeyDown"
                                                         TextChanged="TxtContact_TextChanged"/>
                                                <TextBlock x:Name="ErrContact" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- emergency contact row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Person to Contact in Case of Emergency" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtEmergencyContact" Style="{StaticResource FormBox}"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Relationship" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtRelationship" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Text="Emergency Contact Address" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtEmergencyAddress" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtEmergencyNumber" Style="{StaticResource FormBox}"
                                                         MaxLength="13"
                                                         PreviewTextInput="Phone_PreviewTextInput"
                                                         PreviewKeyDown="Phone_PreviewKeyDown"
                                                         TextChanged="TxtEmergencyNumber_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- STEP 2 -->
                        <ScrollViewer x:Name="ScrollStep2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9" Visibility="Collapsed">
                            <StackPanel Margin="32,12,32,16">

                                <!-- CARD: II. PROBLEM PRESENTED -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="II. PROBLEM PRESENTED / CIRCUMSTANCE OF BEING SOLO PARENT"
                                                       Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- 3-column circumstances: A1-A4 | A5-B | C-F -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- col 1: A1–A4 -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <RadioButton x:Name="ChkA1" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A1. " FontWeight="Bold"/>
                                                        <Run Text="Gives birth as a result of rape"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkA2" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A2. " FontWeight="Bold"/>
                                                        <Run Text="Death of Spouse"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA2" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="140"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Cause of death" Style="{StaticResource FieldLabelSm}"/>
                                                            <TextBox x:Name="TxtA2Cause" Style="{StaticResource FormBoxSm}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Date" Style="{StaticResource FieldLabelSm}"/>
                                                            <DatePicker x:Name="DpA2Date" Style="{StaticResource FormDateSm}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <RadioButton x:Name="ChkA3" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A3. " FontWeight="Bold"/>
                                                        <Run Text="Detention of Spouse"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkA4" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A4. " FontWeight="Bold"/>
                                                        <Run Text="Physical &amp; Mental Incapacity of Spouse"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA4" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Type of disability" Style="{StaticResource FieldLabelSm}"/>
                                                    <TextBox x:Name="TxtA4Disability" Style="{StaticResource FormBoxSm}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- col 2: A5–B -->
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <RadioButton x:Name="ChkA5" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A5. " FontWeight="Bold"/>
                                                        <Run Text="Legal or de facto Separation"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA5" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Period of separation" Style="{StaticResource FieldLabelSm}"/>
                                                    <TextBox x:Name="TxtA5Period" Style="{StaticResource FormBoxSm}"/>
                                                </StackPanel>

                                                <RadioButton x:Name="ChkA6" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A6. " FontWeight="Bold"/>
                                                        <Run Text="Declaration of:"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA6" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Type of Declaration" Style="{StaticResource FieldLabelSm}"/>
                                                    <ComboBox x:Name="CmbA6Declaration" Style="{StaticResource FormCombo}" Height="36">
                                                        <ComboBoxItem Content=""/>
                                                        <ComboBoxItem Content="Nullity of marriage"/>
                                                        <ComboBoxItem Content="Annulment of marriage"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <RadioButton x:Name="ChkA7" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A7. " FontWeight="Bold"/>
                                                        <Run Text="Abandonment of spouse for at least 6 months"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkB" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="B. " FontWeight="Bold"/>
                                                        <Run Text="Spouse or any family member of an OFW"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlB" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Length of Stay Abroad" Style="{StaticResource FieldLabelSm}"/>
                                                    <TextBox x:Name="TxtBStayAbroad" Style="{StaticResource FormBoxSm}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- col 3: C–F -->
                                            <StackPanel Grid.Column="2">
                                                <RadioButton x:Name="ChkC" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="C. " FontWeight="Bold"/>
                                                        <Run Text="Unmarried Mother or Father"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkD" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="D. " FontWeight="Bold"/>
                                                        <Run Text="Legal Guardian / Adoptive / Foster Parent"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkE" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="E. " FontWeight="Bold"/>
                                                        <Run Text="Relative within the fourth (4th) civil degree of consanguinity or affinity"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkF" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="F. " FontWeight="Bold"/>
                                                        <Run Text="Pregnant Woman"/>
                                                    </TextBlock>
                                                </RadioButton>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: III. FAMILY COMPOSITION -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="III. FAMILY COMPOSITION (Include other members of the household.)"
                                                       Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- family composition -->
                                        <StackPanel Grid.IsSharedSizeScope="True">

                                            <!-- table header -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="270" SharedSizeGroup="C0"/>
                                                    <ColumnDefinition Width="95"  SharedSizeGroup="C1"/>
                                                    <ColumnDefinition Width="50"   SharedSizeGroup="C2"/>
                                                    <ColumnDefinition Width="155"  SharedSizeGroup="C3"/>
                                                    <ColumnDefinition Width="105"  SharedSizeGroup="C4"/>
                                                    <ColumnDefinition Width="135"  SharedSizeGroup="C5"/>
                                                    <ColumnDefinition Width="205"  SharedSizeGroup="C6"/>
                                                    <ColumnDefinition Width="145"   SharedSizeGroup="C7"/>
                                                    <ColumnDefinition Width="36"   SharedSizeGroup="C8"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="9" Background="#F8F0F3" CornerRadius="6" Margin="0,0,0,2" Padding="4,8"/>
                                                <TextBlock Grid.Column="0" Text="Name" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Sex" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Age" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Birthdate" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Civil Status" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="Relationship" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="Emp. / Highest Educ. Attainment" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="Income" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,8"/>
                                            </Grid>

                                            <!-- data rows -->
                                            <ItemsControl x:Name="FamilyRows">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="270" SharedSizeGroup="C0"/>
                                                                <ColumnDefinition Width="95"  SharedSizeGroup="C1"/>
                                                                <ColumnDefinition Width="50"   SharedSizeGroup="C2"/>
                                                                <ColumnDefinition Width="155"  SharedSizeGroup="C3"/>
                                                                <ColumnDefinition Width="105"  SharedSizeGroup="C4"/>
                                                                <ColumnDefinition Width="135"  SharedSizeGroup="C5"/>
                                                                <ColumnDefinition Width="205"  SharedSizeGroup="C6"/>
                                                                <ColumnDefinition Width="145"   SharedSizeGroup="C7"/>
                                                                <ColumnDefinition Width="36"   SharedSizeGroup="C8"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <TextBox Height="38" FontSize="13"
                                                                         BorderThickness="0"
                                                                         Background="Transparent" Padding="10,0"
                                                                         VerticalContentAlignment="Center"
                                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                                         LostFocus="FamilyMemberName_LostFocus"
                                                                         Text="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Border>
                                                            <Border Grid.Column="1" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <ComboBox Height="38"
                                                                          Style="{StaticResource FormCombo}"
                                                                          BorderThickness="0" Background="Transparent"
                                                                          SelectedValue="{Binding Sex, UpdateSourceTrigger=PropertyChanged}">
                                                                    <ComboBoxItem Content=""/>
                                                                    <ComboBoxItem Content="Female"/>
                                                                    <ComboBoxItem Content="Male"/>
                                                                </ComboBox>
                                                            </Border>
                                                            <Border Grid.Column="2" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="#F5F5F5" Margin="0,0,5,0">
                                                                <TextBox Height="38" FontSize="13"
                                                                         BorderThickness="0"
                                                                         Background="Transparent" Padding="4,0"
                                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"
                                                                         ToolTip="Auto-calculated from Birthdate"
                                                                         Text="{Binding Age, Mode=OneWay}"/>
                                                            </Border>
                                                            <Border Grid.Column="3" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <DatePicker Height="38"
                                                                            Style="{StaticResource FormDate}"
                                                                            BorderThickness="0" Background="Transparent"
                                                                            SelectedDate="{Binding BirthdateDate, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Border>
                                                            <Border Grid.Column="4" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <ComboBox Height="38"
                                                                          Style="{StaticResource FormCombo}"
                                                                          BorderThickness="0" Background="Transparent"
                                                                          SelectedValue="{Binding CivilStatus, UpdateSourceTrigger=PropertyChanged}">
                                                                    <ComboBoxItem Content=""/>
                                                                    <ComboBoxItem Content="Single"/>
                                                                    <ComboBoxItem Content="Married"/>
                                                                    <ComboBoxItem Content="Widowed"/>
                                                                    <ComboBoxItem Content="Separated"/>
                                                                    <ComboBoxItem Content="Annulled"/>
                                                                </ComboBox>
                                                            </Border>
                                                            <Border Grid.Column="5" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <ComboBox Height="38"
                                                                          Style="{StaticResource FormCombo}"
                                                                          BorderThickness="0" Background="Transparent"
                                                                          SelectedValue="{Binding Relationship, UpdateSourceTrigger=PropertyChanged}">
                                                                    <ComboBoxItem Content=""/>
                                                                    <ComboBoxItem Content="Child"/>
                                                                    <ComboBoxItem Content="Spouse"/>
                                                                    <ComboBoxItem Content="Parent"/>
                                                                    <ComboBoxItem Content="Sibling"/>
                                                                    <ComboBoxItem Content="Grandchild"/>
                                                                    <ComboBoxItem Content="Grandparent"/>
                                                                    <ComboBoxItem Content="Relative"/>
                                                                    <ComboBoxItem Content="Ward"/>
                                                                    <ComboBoxItem Content="Other"/>
                                                                </ComboBox>
                                                            </Border>
                                                            <Border Grid.Column="6" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <TextBox Height="38" FontSize="13"
                                                                         BorderThickness="0"
                                                                         Background="Transparent" Padding="10,0"
                                                                         VerticalContentAlignment="Center"
                                                                         Text="{Binding EducationEmployment, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Border>
                                                            <Border Grid.Column="7" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Margin="0,0,5,0">
                                                                <TextBox Height="38" FontSize="13"
                                                                         BorderThickness="0"
                                                                         Background="Transparent" Padding="10,0"
                                                                         VerticalContentAlignment="Center"
                                                                         Text="{Binding Income, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Border>
                                                            <Button Grid.Column="8" Height="38" Width="32" Cursor="Hand"
                                                                    ToolTip="Remove row" Command="{Binding DeleteCommand}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                                                            <Path Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z"
                                                                                  Fill="#C0392B" Stretch="Uniform" Width="13" Height="13"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="#FDEDEC"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>

                                        <Button Content="+ Add Row" Click="AddFamilyRow_Click"
                                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Height="38" Padding="16,0"
                                                Background="White" Foreground="#702943"
                                                FontSize="12" FontWeight="SemiBold"
                                                BorderBrush="#702943" BorderThickness="1"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: IV. NEEDS AND PROBLEMS -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="IV. NEEDS AND PROBLEMS" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <TextBox x:Name="TxtNeeds" Style="{StaticResource FormBox}"
                                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="14,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: V. OTHER SOURCES OF INCOME -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="V. OTHER SOURCES OF INCOME" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <TextBox x:Name="TxtOtherIncome" Style="{StaticResource FormBox}"
                                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="14,10"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: VI. APPLICATION STATUS -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="VI. APPLICATION STATUS" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbStatus" Style="{StaticResource FormCombo}"
                                                          SelectionChanged="CmbStatus_SelectionChanged">
                                                    <ComboBoxItem Content="Valid"/>
                                                    <ComboBoxItem Content="Inactive"/>
                                                </ComboBox>
                                                <TextBlock x:Name="ErrStatus" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="VII. ADDITIONAL CLASSIFICATIONS" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <CheckBox x:Name="ChkPantawid" Content="Pantawid Beneficiary"
                                                  FontSize="13" Foreground="#333333" Margin="0,8,0,10"/>
                                        <CheckBox x:Name="ChkIndigenous" Content="Indigenous Person"
                                                  FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkLGBTQ" Content="LGBTQ+"
                                                  FontSize="13" Foreground="#333333" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                    <!-- End content area -->

                    <!-- Footer bar -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0" Padding="32,14">
                        <Grid>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ValidationMessage"
                                       Text=""
                                       FontSize="12" Foreground="#E53935"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Close_Click"/>
                                <Button x:Name="BtnBack" Content="&#x2190; Back" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
                                <Button x:Name="BtnNext" Content="Next &#x2192;" Style="{StaticResource SaveBtn}"
                                        Click="Next_Click"/>
                                <Button x:Name="BtnSave" Content="Save Record" Style="{StaticResource SaveBtn}"
                                        Click="Save_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Border>

</Window>
