<Window x:Class="SOLUM_UI.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solo Parent Application Form"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Width="900" Height="760">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#BBBBBB" FontSize="14"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="10" BorderBrush="#C0A0AA"
                                        BorderThickness="1.2" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="ComboBg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="14,9"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#222222"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Foreground="#111111" Background="Transparent"
                                                   BorderThickness="0" Padding="10,0"
                                                   VerticalAlignment="Center" FontSize="14">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                            <!-- Suppress the native watermark by not displaying PART_Watermark -->
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <!-- Custom clean placeholder - only visible when input is empty -->
                                <TextBlock Text="DD/MM/YYYY" Foreground="#999999" FontSize="14"
                                           Padding="10,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ToggleButton x:Name="PART_Button" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="20" Height="20"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Focusable="False"
                                    IsChecked="{Binding IsOpen, ElementName=PART_Popup, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19Z"
                                                  Fill="#702943" Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Grid.Column="0" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0"
                                        BorderThickness="1" Padding="8,6" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="White"
                                              BorderThickness="0" Foreground="#222222"
                                              FontSize="13">
                                        <Calendar.Resources>
                                            <Style TargetType="CalendarDayButton">
                                                <Setter Property="Width" Value="30"/>
                                                <Setter Property="Height" Value="30"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarDayButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsToday" Value="True">
                                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                                                    <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                </MultiTrigger>
                                                                <Trigger Property="IsInactive" Value="True">
                                                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                                                </Trigger>
                                                                <Trigger Property="IsBlackedOut" Value="True">
                                                                    <Setter Property="Foreground" Value="#DDDDDD"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="CalendarButton">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CalendarButton">
                                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="2">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="HasSelectedDays" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="HasSelectedDays" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Calendar.Resources>
                                    </Calendar>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCheck" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,5,20,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="Margin" Value="2,3,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryMaroonBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#8B3555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#5A1F34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineMaroonBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#F8E5EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#EDE0E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardSectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FormBoxSm" TargetType="TextBox" BasedOn="{StaticResource FormBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="FormDateSm" TargetType="DatePicker" BasedOn="{StaticResource FormDate}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldLabelSm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

    </Window.Resources>

    <!-- Dimmed overlay -->
    <Border Background="#44000000" Padding="0">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>
            <Border x:Name="DialogShell" Background="White" CornerRadius="16"
                    ClipToBounds="True"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#C8E6C9" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- header -->
                        <RowDefinition Height="Auto"/><!-- mode stripe -->
                        <RowDefinition Height="Auto"/><!-- step indicator -->
                        <RowDefinition Height="*"/>  <!-- content -->
                        <RowDefinition Height="Auto"/><!-- footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border x:Name="HeaderBorder" Grid.Row="0" Background="White" CornerRadius="16,16,0,0"
                            BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="32,20">
                        <Grid>
                            <StackPanel>
                                <!-- Mode badge -->
                                <StackPanel x:Name="ModeBadge" Orientation="Horizontal"
                                            Margin="0,0,0,10" Visibility="Collapsed">
                                    <Border x:Name="ModeBadgePill"
                                            CornerRadius="20" Padding="10,4"
                                            Background="#E8F5E9">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="ModeBadgeIcon"
                                                  Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M13.96,12.29L11.21,15.83L9.25,13.47L6.5,17H17.5L13.96,12.29Z"
                                                  Fill="#2E7D32" Stretch="Uniform" Width="13" Height="13"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="ModeBadgeText"
                                                       Text="New Registration"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#2E7D32"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="FormSubtitle" Text="Add New Record"
                                           FontSize="19" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock x:Name="FormStepHint" Text="Step 1 of 2 — Personal Information"
                                           FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="32" Height="32" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBg" Background="Transparent" CornerRadius="16">
                                            <TextBlock Text="&#x2715;" FontSize="14" Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBg" Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Mode stripe (hidden by default, shown for Add and Renewal) -->
                    <Border x:Name="ModeStripe" Grid.Row="1"
                            Background="#F0FAF1"
                            BorderBrush="#C8E6C9" BorderThickness="0,0,0,1"
                            Padding="32,9,32,9" Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ModeStripeIcon"
                                      Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19Z"
                                      Fill="#2E7D32" Stretch="Uniform" Width="14" Height="14"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ModeStripeLabel"
                                           Text="New Registration"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModeStripeHint"
                                           Text=" — Fill in all sections to complete the record."
                                           FontSize="12" Foreground="#558B5A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Step indicator -->
                    <Border x:Name="StepIndicatorRow" Grid.Row="2" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1" Padding="32,12,32,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Step 1 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step1Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#702943">
                                    <TextBlock x:Name="Step1DotLabel" Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step1Title" Text="Primary Info" FontSize="13" FontWeight="Bold"
                                               Foreground="#702943"/>
                                    <TextBlock Text="Identity &amp; verification" FontSize="11" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Height="2" Background="#E0E0E0"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <!-- Step 2 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step2Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#E0E0E0">
                                    <TextBlock x:Name="Step2DotLabel" Text="2" Foreground="#AAAAAA"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step2Title" Text="Secondary Info"
                                               FontSize="13" FontWeight="Bold" Foreground="#AAAAAA"/>
                                    <TextBlock Text="Address &amp; background" FontSize="11" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3" Height="2" Background="#E0E0E0"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <!-- Step 3 -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step3Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#E0E0E0">
                                    <TextBlock x:Name="Step3DotLabel" Text="3" Foreground="#AAAAAA"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step3Title" Text="Circumstances"
                                               FontSize="13" FontWeight="Bold" Foreground="#AAAAAA"/>
                                    <TextBlock Text="Family &amp; circumstance" FontSize="11" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable content area -->
                    <Grid Grid.Row="3">

                        <!-- STEP 1 -->
                        <ScrollViewer x:Name="ScrollStep1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9" Visibility="Visible">
                            <StackPanel Margin="32,12,32,16">

                                <!-- CARD: I. IDENTIFYING INFORMATION -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <Grid>
                                                <TextBlock Text="I. IDENTIFYING INFORMATION" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Date of Application:" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#555555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Width="180">
                                                        <DatePicker x:Name="DpDateOfApplication" Style="{StaticResource FormDate}" Height="32"
                                                                    DateValidationError="DatePicker_DateValidationError"
                                                                    LostFocus="DatePicker_LostFocus"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Name Row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Last Name <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <TextBox x:Name="TxtLastName" Style="{StaticResource FormBox}"
                                                         MaxLength="50"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                         TextChanged="TxtLastName_TextChanged"/>
                                                <TextBlock x:Name="ErrLastName" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    First Name <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <TextBox x:Name="TxtFirstName" Style="{StaticResource FormBox}"
                                                         MaxLength="50"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                         TextChanged="TxtFirstName_TextChanged"/>
                                                <TextBlock x:Name="ErrFirstName" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Middle Name" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMiddleName" Style="{StaticResource FormBox}"
                                                         MaxLength="50"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                         TextChanged="TxtMiddleName_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Extension" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbExtension" Style="{StaticResource FormCombo}"
                                                          SelectionChanged="CmbExtension_SelectionChanged">
                                                    <ComboBoxItem Content=""/>
                                                    <ComboBoxItem Content="Jr."/>
                                                    <ComboBoxItem Content="Sr."/>
                                                    <ComboBoxItem Content="II"/>
                                                    <ComboBoxItem Content="III"/>
                                                    <ComboBoxItem Content="IV"/>
                                                    <ComboBoxItem Content="V"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Birthdate, Age, PhilSys Row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Birthdate <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <Border x:Name="BorderBirthdate" BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <DatePicker x:Name="DpBirthdate" Style="{StaticResource FormDate}"
                                                                SelectedDateChanged="DpBirthdate_SelectedDateChanged"
                                                                DateValidationError="DatePicker_DateValidationError"
                                                                LostFocus="DatePicker_LostFocus"/>
                                                </Border>
                                                <TextBlock x:Name="ErrBirthdate" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Age" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtAge" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Background="#F0F0F0"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         FontWeight="SemiBold"
                                                         Foreground="#222222"
                                                         Padding="0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="PhilSys Card Number (Optional)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtPhilSys" Style="{StaticResource FormBox}"
                                                         MaxLength="19"
                                                         PreviewKeyDown="PhilSys_PreviewKeyDown"
                                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                                         TextChanged="TxtPhilSys_TextChanged"/>
                                                <TextBlock x:Name="ErrPhilSys" Text="Invalid format." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Duplicate Banner in Step 1 -->
                                        <Border x:Name="DuplicateBannerPanel" Visibility="Collapsed" CornerRadius="10"
                                                Background="#B71C1C" Padding="16,12" Margin="0,8,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                        Background="#22FFFFFF" Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <TextBlock Text="&#x26A0;" FontSize="16" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="DuplicateBannerTitle" FontSize="13" FontWeight="Bold"
                                                               Foreground="White" Text="Existing Record Found" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DuplicateBannerText" Foreground="White" FontSize="12"
                                                               TextWrapping="Wrap" Opacity="0.95"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button x:Name="BtnViewExistingRecord" Content="View Existing Record"
                                                                Height="32" Padding="14,0" Background="White" Foreground="#702943"
                                                                FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                                                Click="ViewExistingRecord_Click" Margin="0,0,10,0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button x:Name="BtnContinueAnyway" Content="Continue to Step 2 &#x2192;"
                                                                Height="32" Padding="14,0" Background="#33FFFFFF" Foreground="White"
                                                                FontSize="12" FontWeight="SemiBold" BorderBrush="White" BorderThickness="1"
                                                                Cursor="Hand" Click="ContinueAnyway_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- STEP 2: Secondary Information -->
                        <ScrollViewer x:Name="ScrollStep2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9" Visibility="Collapsed">
                            <StackPanel Margin="32,12,32,16">

                                <!-- CARD: SECONDARY DEMOGRAPHIC & BACKGROUND -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="II. SECONDARY &amp; BACKGROUND INFORMATION" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- civil status & sex row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Civil Status <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <ComboBox x:Name="CmbCivilStatus" Style="{StaticResource FormCombo}"
                                                          SelectionChanged="CmbCivilStatus_SelectionChanged">
                                                    <ComboBoxItem Content="Single"/>
                                                    <ComboBoxItem Content="Married"/>
                                                    <ComboBoxItem Content="Widowed"/>
                                                    <ComboBoxItem Content="Separated"/>
                                                    <ComboBoxItem Content="Divorced"/>
                                                    <ComboBoxItem Content="Annulled"/>
                                                </ComboBox>
                                                <TextBlock x:Name="ErrCivilStatus" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Sex <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <ComboBox x:Name="CmbSex" Style="{StaticResource FormCombo}"
                                                          SelectionChanged="CmbSex_SelectionChanged">
                                                    <ComboBoxItem Content="Male"/>
                                                    <ComboBoxItem Content="Female"/>
                                                </ComboBox>
                                                <TextBlock x:Name="ErrSex" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Birthplace <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <TextBox x:Name="TxtPlaceOfBirth" Style="{StaticResource FormBox}"
                                                         MaxLength="100"
                                                         TextChanged="TxtPlaceOfBirth_TextChanged"/>
                                                <TextBlock x:Name="ErrPlaceOfBirth" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- address row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Address (House No. / Street / Subdivision / Zone or Purok) <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <TextBox x:Name="TxtAddress" Style="{StaticResource FormBox}"
                                                         MaxLength="200"
                                                         TextChanged="TxtAddress_TextChanged"/>
                                                <TextBlock x:Name="ErrAddress" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Barangay <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <ComboBox x:Name="CmbBarangay" Style="{StaticResource FormCombo}"
                                                           SelectionChanged="CmbBarangay_SelectionChanged">
                                                    <ComboBoxItem Content=""/>
                                                    <ComboBoxItem Content="Biñan (Poblacion)"/>
                                                    <ComboBoxItem Content="Bungahan"/>
                                                    <ComboBoxItem Content="Canlalay"/>
                                                    <ComboBoxItem Content="Casile"/>
                                                    <ComboBoxItem Content="De La Paz"/>
                                                    <ComboBoxItem Content="Ganado"/>
                                                    <ComboBoxItem Content="Langkiwa"/>
                                                    <ComboBoxItem Content="Loma"/>
                                                    <ComboBoxItem Content="Malaban"/>
                                                    <ComboBoxItem Content="Malamig"/>
                                                    <ComboBoxItem Content="Mambog"/>
                                                    <ComboBoxItem Content="Platero"/>
                                                    <ComboBoxItem Content="Poblacion"/>
                                                    <ComboBoxItem Content="San Antonio"/>
                                                    <ComboBoxItem Content="San Francisco (Halang)"/>
                                                    <ComboBoxItem Content="San Jose"/>
                                                    <ComboBoxItem Content="San Vicente"/>
                                                    <ComboBoxItem Content="Santo Domingo"/>
                                                    <ComboBoxItem Content="Santo Niño"/>
                                                    <ComboBoxItem Content="Santo Tomas (Calabuso)"/>
                                                    <ComboBoxItem Content="Soro-Soro"/>
                                                    <ComboBoxItem Content="Timbao"/>
                                                    <ComboBoxItem Content="Tubigan"/>
                                                    <ComboBoxItem Content="Zapote"/>
                                                </ComboBox>
                                                <TextBlock x:Name="ErrBarangay" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}">
                                                    Applicant's Contact Number <Run Text="*" Foreground="#E53935"/>
                                                </TextBlock>
                                                <TextBox x:Name="TxtContact" Style="{StaticResource FormBox}"
                                                         MaxLength="13"
                                                         PreviewTextInput="Phone_PreviewTextInput"
                                                         PreviewKeyDown="Phone_PreviewKeyDown"
                                                         TextChanged="TxtContact_TextChanged"/>
                                                <TextBlock x:Name="ErrContact" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- education & religion row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Educational Attainment" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbEducation" Style="{StaticResource FormCombo}">
                                                    <ComboBoxItem Content="Elementary"/>
                                                    <ComboBoxItem Content="High School"/>
                                                    <ComboBoxItem Content="Vocational"/>
                                                    <ComboBoxItem Content="College"/>
                                                    <ComboBoxItem Content="Post Graduate"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Religion" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtReligion" Style="{StaticResource FormBox}"
                                                         MaxLength="60"
                                                         TextChanged="TxtReligion_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- occupation & monthly income row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Occupation / Source of Income" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtOccupation" Style="{StaticResource FormBox}"
                                                         MaxLength="80"
                                                         TextChanged="TxtOccupation_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <TextBlock Text="Monthly Income" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMonthlyIncome" Style="{StaticResource FormBox}"
                                                         MaxLength="12"
                                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Employment Status" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbEmploymentStatus" Style="{StaticResource FormCombo}"
                                                              BorderThickness="0" Background="Transparent">
                                                        <ComboBoxItem Content=""/>
                                                        <ComboBoxItem Content="Employed"/>
                                                        <ComboBoxItem Content="Self-Employed"/>
                                                        <ComboBoxItem Content="Not Employed"/>
                                                    </ComboBox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- CARD: PERSON IN CASE OF EMERGENCY -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="III. PERSON IN CASE OF EMERGENCY" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Person to Contact in Case of Emergency" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtEmergencyContact" Style="{StaticResource FormBox}"
                                                         MaxLength="50"
                                                         PreviewTextInput="NameOnly_PreviewTextInput"
                                                         TextChanged="TxtEmergencyContact_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="Relationship" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbRelationship" Style="{StaticResource FormCombo}"
                                                              BorderThickness="0" Background="Transparent">
                                                        <ComboBoxItem Content=""/>
                                                        <ComboBoxItem Content="Child"/>
                                                        <ComboBoxItem Content="Spouse"/>
                                                        <ComboBoxItem Content="Parent"/>
                                                        <ComboBoxItem Content="Sibling"/>
                                                        <ComboBoxItem Content="Grandchild"/>
                                                        <ComboBoxItem Content="Grandparent"/>
                                                        <ComboBoxItem Content="Relative"/>
                                                        <ComboBoxItem Content="Ward"/>
                                                        <ComboBoxItem Content="Other"/>
                                                    </ComboBox>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Emergency Contact Address" Style="{StaticResource FieldLabel}"/>
                                                </StackPanel>
                                                <TextBox x:Name="TxtEmergencyAddress" Style="{StaticResource FormBox}"
                                                         MaxLength="200"
                                                         TextChanged="TxtEmergencyAddress_TextChanged"/>
                                                <CheckBox x:Name="ChkSameAsApplicant" Content="Same as Applicant"
                                                          FontSize="12" Foreground="#666666" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtEmergencyNumber" Style="{StaticResource FormBox}"
                                                         MaxLength="13"
                                                         PreviewTextInput="Phone_PreviewTextInput"
                                                         PreviewKeyDown="Phone_PreviewKeyDown"
                                                         TextChanged="TxtEmergencyNumber_TextChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: ADDITIONAL INFORMATION -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="ADDITIONAL INFORMATION" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <CheckBox x:Name="ChkPantawid" Content="Pantawid Beneficiary"
                                                  FontSize="13" Foreground="#333333" Margin="0,8,0,10"/>
                                        <CheckBox x:Name="ChkIndigenous" Content="Indigenous Person"
                                                  FontSize="13" Foreground="#333333" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkLGBTQ" Content="LGBTQ+"
                                                  FontSize="13" Foreground="#333333" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- STEP 3: Circumstances & Family Composition -->
                        <ScrollViewer x:Name="ScrollStep3" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9" Visibility="Collapsed">
                            <StackPanel Margin="32,12,32,16">

                                <!-- CARD: III. PROBLEM PRESENTED -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="III. PROBLEM PRESENTED / CIRCUMSTANCE OF BEING SOLO PARENT"
                                                       Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- 3-column circumstances: A1-A4 | A5-B | C-F -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- col 1: A1–A4 -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <RadioButton x:Name="ChkA1" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A1. " FontWeight="Bold"/>
                                                        <Run Text="Gives birth as a result of rape"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkA2" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A2. " FontWeight="Bold"/>
                                                        <Run Text="Death of Spouse"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA2" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="140"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Cause of death" Style="{StaticResource FieldLabelSm}"/>
                                                            <TextBox x:Name="TxtA2Cause" Style="{StaticResource FormBoxSm}"
                                                                     MaxLength="100"
                                                                     TextChanged="TxtA2Cause_TextChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Date" Style="{StaticResource FieldLabelSm}"/>
                                                            <DatePicker x:Name="DpA2Date" Style="{StaticResource FormDateSm}"
                                                                        DateValidationError="DatePicker_DateValidationError"
                                                                        LostFocus="DatePicker_LostFocus"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <RadioButton x:Name="ChkA3" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A3. " FontWeight="Bold"/>
                                                        <Run Text="Detention of Spouse"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkA4" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A4. " FontWeight="Bold"/>
                                                        <Run Text="Physical &amp; Mental Incapacity of Spouse"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA4" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Type of disability" Style="{StaticResource FieldLabelSm}"/>
                                                    <TextBox x:Name="TxtA4Disability" Style="{StaticResource FormBoxSm}"
                                                             TextChanged="TxtA4Disability_TextChanged"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- col 2: A5–B -->
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <RadioButton x:Name="ChkA5" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A5. " FontWeight="Bold"/>
                                                        <Run Text="Legal or de facto Separation"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA5" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Period of separation" Style="{StaticResource FieldLabelSm}"/>
                                                    <TextBox x:Name="TxtA5Period" Style="{StaticResource FormBoxSm}"
                                                             TextChanged="TxtA5Period_TextChanged"/>
                                                </StackPanel>

                                                <RadioButton x:Name="ChkA6" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A6. " FontWeight="Bold"/>
                                                        <Run Text="Declaration of:"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlA6" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Type of Declaration" Style="{StaticResource FieldLabelSm}"/>
                                                    <ComboBox x:Name="CmbA6Declaration" Style="{StaticResource FormCombo}" Height="36">
                                                        <ComboBoxItem Content=""/>
                                                        <ComboBoxItem Content="Nullity of marriage"/>
                                                        <ComboBoxItem Content="Annulment of marriage"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <RadioButton x:Name="ChkA7" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="A7. " FontWeight="Bold"/>
                                                        <Run Text="Abandonment of spouse for at least 6 months"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkB" Style="{StaticResource FormCheck}" GroupName="Circumstance"
                                                          Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="B. " FontWeight="Bold"/>
                                                        <Run Text="Spouse or any family member of an OFW"/>
                                                    </TextBlock>
                                                </RadioButton>
                                                <StackPanel x:Name="PnlB" Visibility="Collapsed" Margin="22,2,0,6">
                                                    <TextBlock Text="Length of Stay Abroad" Style="{StaticResource FieldLabelSm}"/>
                                                    <TextBox x:Name="TxtBStayAbroad" Style="{StaticResource FormBoxSm}"
                                                             TextChanged="TxtBStayAbroad_TextChanged"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- col 3: C–F -->
                                            <StackPanel Grid.Column="2">
                                                <RadioButton x:Name="ChkC" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="C. " FontWeight="Bold"/>
                                                        <Run Text="Unmarried Mother or Father"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkD" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="D. " FontWeight="Bold"/>
                                                        <Run Text="Legal Guardian / Adoptive / Foster Parent"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkE" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="E. " FontWeight="Bold"/>
                                                        <Run Text="Relative within the fourth (4th) civil degree of consanguinity or affinity"/>
                                                    </TextBlock>
                                                </RadioButton>

                                                <RadioButton x:Name="ChkF" Style="{StaticResource FormCheck}" GroupName="Circumstance">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="F. " FontWeight="Bold"/>
                                                        <Run Text="Pregnant Woman"/>
                                                    </TextBlock>
                                                </RadioButton>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: IV. FAMILY COMPOSITION -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <!-- Header row with title and '+ Add Member' button -->
                                        <Grid Margin="0,0,0,14">
                                            <Border Style="{StaticResource CardSectionHeader}" Margin="0" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="IV. FAMILY COMPOSITION" Style="{StaticResource SectionLabel}"/>
                                                    <TextBlock Text="Include children and other dependents residing in the household."
                                                               FontSize="11" Foreground="#777777" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="BtnAddFamilyMember" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Style="{StaticResource PrimaryMaroonBtn}" Height="34" Padding="14,0"
                                                    Click="BtnAddFamilyMember_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add Member" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Collapsible Add/Edit Member Inline Sub-Card -->
                                        <Border x:Name="AddMemberSubCard" Background="#FFF9FB" BorderBrush="#702943" BorderThickness="1.5"
                                                CornerRadius="10" Padding="0" Margin="0,0,0,16" Visibility="Collapsed" ClipToBounds="True">
                                            <StackPanel>
                                                <!-- Header Banner with deep maroon tint -->
                                                <Border Background="#702943" Padding="16,10">
                                                    <TextBlock x:Name="TxtAddMemberTitle" Text="Add Household Member"
                                                               FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Padding="16,14">
                                                    <StackPanel>
                                                        <!-- Row 1: Name, Relationship, Sex, Civil Status -->
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                    Full Name <Run Text="*" Foreground="#E53935"/>
                                                                </TextBlock>
                                                                <TextBox x:Name="TxtMemberName" Style="{StaticResource FormBoxSm}" MaxLength="60"
                                                                         PreviewTextInput="NameOnly_PreviewTextInput"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                    Relationship <Run Text="*" Foreground="#E53935"/>
                                                                </TextBlock>
                                                                <ComboBox x:Name="CmbMemberRel" Style="{StaticResource FormCombo}" Height="34" FontSize="12">
                                                                    <ComboBoxItem Content="Child"/>
                                                                    <ComboBoxItem Content="Spouse"/>
                                                                    <ComboBoxItem Content="Parent"/>
                                                                    <ComboBoxItem Content="Sibling"/>
                                                                    <ComboBoxItem Content="Grandchild"/>
                                                                    <ComboBoxItem Content="Grandparent"/>
                                                                    <ComboBoxItem Content="Relative"/>
                                                                    <ComboBoxItem Content="Ward"/>
                                                                    <ComboBoxItem Content="Other"/>
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                    Sex <Run Text="*" Foreground="#E53935"/>
                                                                </TextBlock>
                                                                <ComboBox x:Name="CmbMemberSex" Style="{StaticResource FormCombo}" Height="34" FontSize="12">
                                                                    <ComboBoxItem Content="Female"/>
                                                                    <ComboBoxItem Content="Male"/>
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="6">
                                                                <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                    Civil Status <Run Text="*" Foreground="#E53935"/>
                                                                </TextBlock>
                                                                <ComboBox x:Name="CmbMemberCivil" Style="{StaticResource FormCombo}" Height="34" FontSize="12">
                                                                    <ComboBoxItem Content="Single"/>
                                                                    <ComboBoxItem Content="Married"/>
                                                                    <ComboBoxItem Content="Widowed"/>
                                                                    <ComboBoxItem Content="Separated"/>
                                                                    <ComboBoxItem Content="Divorced"/>
                                                                    <ComboBoxItem Content="Annulled"/>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: Birthdate, Age (auto), Education/Employment, Income -->
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.4*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="0.7*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="1.3*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Style="{StaticResource FieldLabelSm}">
                                                                    Birthdate <Run Text="*" Foreground="#E53935"/>
                                                                </TextBlock>
                                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White" Height="34">
                                                                    <DatePicker x:Name="DpMemberDob" Style="{StaticResource FormDateSm}"
                                                                                SelectedDateChanged="DpMemberDob_SelectedDateChanged"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Age" Style="{StaticResource FieldLabelSm}"/>
                                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="#F5F5F5" Height="34">
                                                                    <TextBox x:Name="TxtMemberAge" Style="{StaticResource FormBoxSm}" IsReadOnly="True"
                                                                             Focusable="False" Cursor="Arrow" BorderThickness="0" Background="Transparent"
                                                                             HorizontalContentAlignment="Center" ToolTip="Auto-calculated from Birthdate"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Educ. Attainment / Employment" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtMemberEdu" Style="{StaticResource FormBoxSm}" MaxLength="80"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="6">
                                                                <TextBlock Text="Monthly Income (₱)" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtMemberIncome" Style="{StaticResource FormBoxSm}"
                                                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 3: Special Needs Integration Box (Revealed columns, starts disabled until checked) -->
                                                        <Border Background="#FAFAFA" BorderBrush="#EAD3DC" BorderThickness="1" CornerRadius="8"
                                                                Padding="14,12" Margin="0,0,0,14">
                                                            <StackPanel>
                                                                <CheckBox x:Name="ChkMemberSpecialNeeds" Content="Person with Special Needs / Disability (PWD)"
                                                                          FontSize="12" FontWeight="SemiBold" Foreground="#702943"
                                                                          Checked="ChkMemberSpecialNeeds_Changed" Unchecked="ChkMemberSpecialNeeds_Changed"
                                                                          VerticalContentAlignment="Center" Cursor="Hand" Margin="0,0,0,10"/>

                                                                <!-- Columns revealed already, starts uneditable until ChkMemberSpecialNeeds is checked -->
                                                                <Grid x:Name="PnlSpecialNeedsDetails" IsEnabled="False" Opacity="0.5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.5*"/>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="2.5*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Special Needs Category" Style="{StaticResource FieldLabelSm}"/>
                                                                        <ComboBox x:Name="CmbSpecialNeedsCategory" Style="{StaticResource FormCombo}" Height="34" FontSize="12">
                                                                            <ComboBoxItem Content="Visual Impairment"/>
                                                                            <ComboBoxItem Content="Hearing Impairment"/>
                                                                            <ComboBoxItem Content="Mobility / Physical Disability"/>
                                                                            <ComboBoxItem Content="Intellectual Disability"/>
                                                                            <ComboBoxItem Content="Learning Disability"/>
                                                                            <ComboBoxItem Content="Autism Spectrum"/>
                                                                            <ComboBoxItem Content="Chronic Illness / Medical Condition"/>
                                                                            <ComboBoxItem Content="Mental Health Condition"/>
                                                                            <ComboBoxItem Content="Multiple Disabilities"/>
                                                                            <ComboBoxItem Content="Other"/>
                                                                        </ComboBox>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Description / Special Accommodations (Optional)" Style="{StaticResource FieldLabelSm}"/>
                                                                        <TextBox x:Name="TxtSpecialNeedsDescription" Style="{StaticResource FormBoxSm}" MaxLength="120"
                                                                                 ToolTip="E.g., Requires wheelchair accessibility, SPED Grade 4, Maintenance medication"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Actions: Cancel and Save -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Cancel" Style="{StaticResource OutlineMaroonBtn}" Height="32" Padding="14,0"
                                                                    Margin="0,0,8,0" Click="BtnCancelMember_Click"/>
                                                            <Button x:Name="BtnSaveMember" Content="Save Member" Style="{StaticResource PrimaryMaroonBtn}"
                                                                    Height="32" Padding="16,0" Click="BtnSaveMember_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Deeper Colored Table Header Banner for the Dependents Cards List -->
                                        <Border Background="#702943" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="84"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="NAME &amp; RELATIONSHIP" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Grid.Column="1" Text="AGE &amp; SEX" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Grid.Column="2" Text="EDUCATION &amp; INCOME" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Grid.Column="3" Text="DISABILITY / SPECIAL NEEDS" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Grid.Column="4" Text="ACTIONS" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- ItemsControl for Cards List -->
                                        <ItemsControl x:Name="FamilyCardsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding CardBg}" BorderBrush="{Binding BorderColor}" BorderThickness="1.2"
                                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.6*"/>
                                                                <ColumnDefinition Width="84"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Column 0: Name + Relationship (+ NEW Highlight Tag) -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding MemberName}" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="#111827" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                                    <Border Visibility="{Binding NewBadgeVisibility}" Background="#702943" CornerRadius="4"
                                                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Relationship}" FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Column 1: Age & Sex -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AgeDisplay}" FontSize="12" Foreground="#1F2937"/>
                                                                <TextBlock Text="{Binding SexDisplay}" FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Column 2: Education / Work & Income -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding EducationDisplay}" FontSize="12" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding IncomeDisplay}" FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Column 3: Disability / Special Needs (Direct Typography, No Badges) -->
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding SpecialNeedsTooltip}" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding DisabilityTitleDisplay}" FontSize="12"
                                                                           FontWeight="{Binding DisabilityTextWeight}"
                                                                           Foreground="{Binding DisabilityTextColor}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DisabilitySubtitleDisplay}" FontSize="11" Foreground="#6B7280"
                                                                           Visibility="{Binding DisabilitySubtitleVisibility}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Column 4: Actions (Prominent Edit & Delete Icons) -->
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <!-- Prominent Edit Button -->
                                                                <Button Width="32" Height="32" Margin="0,0,6,0" Cursor="Hand"
                                                                        ToolTip="Edit member" Click="BtnEditFamilyMember_Click" Tag="{Binding}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="BtnBg" Background="#FDF2F5" BorderBrush="#E5B8C9" BorderThickness="1.2" CornerRadius="6">
                                                                                <Path x:Name="BtnIcon" Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87M3,17.25V21H6.75L17.81,9.93L14.07,6.19L3,17.25Z"
                                                                                      Fill="#702943" Stretch="Uniform" Width="14" Height="14"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="BtnBg" Property="Background" Value="#702943"/>
                                                                                    <Setter TargetName="BtnBg" Property="BorderBrush" Value="#702943"/>
                                                                                    <Setter TargetName="BtnIcon" Property="Fill" Value="White"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <!-- Prominent Delete Button -->
                                                                <Button Width="32" Height="32" Cursor="Hand"
                                                                        ToolTip="Remove member" Click="BtnRemoveFamilyMember_Click" Tag="{Binding}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="DelBg" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="6">
                                                                                <Path x:Name="DelIcon" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                                                      Fill="#DC2626" Stretch="Uniform" Width="14" Height="14"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="DelBg" Property="Background" Value="#DC2626"/>
                                                                                    <Setter TargetName="DelBg" Property="BorderBrush" Value="#DC2626"/>
                                                                                    <Setter TargetName="DelIcon" Property="Fill" Value="White"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty state placeholder -->
                                        <Border x:Name="PnlNoFamilyMembers" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="1"
                                                CornerRadius="8" Padding="20,16" Margin="0,4,0,0" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="No household members recorded yet." FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#6B7280" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Click '+ Add Member' above to add qualified children or other household dependents."
                                                           FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: V. NEEDS AND PROBLEMS -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="V. NEEDS AND PROBLEMS" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <TextBox x:Name="TxtNeeds" Style="{StaticResource FormBox}"
                                                 MaxLength="500"
                                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="14,10"
                                                 TextChanged="TxtNeeds_TextChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: VI. OTHER SOURCES OF INCOME -->
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardSectionHeader}">
                                            <TextBlock Text="VI. OTHER SOURCES OF INCOME" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <TextBox x:Name="TxtOtherIncome" Style="{StaticResource FormBox}"
                                                 MaxLength="500"
                                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="14,10"
                                                 TextChanged="TxtOtherIncome_TextChanged"/>
                                    </StackPanel>
                                </Border>


                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                    <!-- End content area -->

                    <!-- Footer bar -->
                    <Border Grid.Row="4" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0" Padding="32,14" CornerRadius="0,0,16,16">
                        <Grid>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ValidationMessage"
                                       Text=""
                                       FontSize="12" Foreground="#E53935"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Close_Click"/>
                                <Button x:Name="BtnBack" Content="&#x2190; Back" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
                                <Button x:Name="BtnNext" Content="Next &#x2192;" Style="{StaticResource SaveBtn}"
                                        Click="Next_Click"/>
                                <Button x:Name="BtnSave" Content="Save Record" Style="{StaticResource SaveBtn}"
                                        Click="Save_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Border>

</Window>
