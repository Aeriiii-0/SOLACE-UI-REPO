<Window x:Class="SOLUM_UI.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border Background="#66000000">
        <Border x:Name="Shell" Background="White" CornerRadius="18"
                ClipToBounds="True" Width="720"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.26"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="40,36,40,24">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="#27AE60" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="✓" FontSize="32" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="Review Information"
                               FontSize="26" FontWeight="Bold" Foreground="#111111"
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Please review the information before saving"
                               FontSize="15" Foreground="#777777" Margin="0,8,0,0"
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#F5F6F8" Padding="32,4,32,16">
                    <StackPanel x:Name="ContentPanel"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="32,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnBack" Grid.Column="0" Height="54" Cursor="Hand"
                                Click="BtnBack_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="12"
                                            BorderBrush="#D8D8D8" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F2F2F2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#444444" FontFamily="Segoe UI"/>
                        </Button>
                        <Button x:Name="BtnConfirm" Grid.Column="2" Height="54" Cursor="Hand"
                                Click="BtnConfirm_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#27AE60" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtConfirmBtn" Text="Confirm Save"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
