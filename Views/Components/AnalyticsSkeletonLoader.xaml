<UserControl x:Class="SOLUM_UI.Views.Components.AnalyticsSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FBF9FE">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SkeletonRoot">

            <!-- 4 KPI Cards Row -->
            <Grid Margin="0,0,0,24" Height="165">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Registered -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="6" Width="26" Height="26"/>
                            <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="85" Height="22" CornerRadius="11"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,6">
                            <Border Style="{StaticResource SkPill}" Width="95" Height="36" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="110" Height="12" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="140" Height="20" CornerRadius="6" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 2: Active -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="6" Width="24" Height="24"/>
                            <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="75" Height="20" CornerRadius="10"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,6">
                            <Border Style="{StaticResource SkPill}" Width="80" Height="32" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="65" Height="11" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="125" Height="18" CornerRadius="6" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 3: Inactive -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="6" Width="24" Height="24"/>
                            <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="65" Height="20" CornerRadius="10"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,6">
                            <Border Style="{StaticResource SkPill}" Width="70" Height="32" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="90" Height="11" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="105" Height="18" CornerRadius="6" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 4: Top Barangay -->
                <Border Grid.Column="6" Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="6" Width="24" Height="24"/>
                            <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="80" Height="20" CornerRadius="10"/>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,6">
                            <Border Style="{StaticResource SkPill}" Width="65" Height="32" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="80" Height="11" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="115" Height="18" CornerRadius="6" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Barangay Chart Panel -->
            <Border Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,18" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource SkPill}" Width="180" Height="16" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SkPill}" Width="280" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SkPill}" Width="70" Height="14" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 10 Vertical Bars of Barangay Distribution -->
                    <Grid Height="240" Margin="10,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="160" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="210" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="2" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="120" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="3" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="185" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="4" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="230" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="5" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="95" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="6" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="150" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="7" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="195" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="8" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="130" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="9" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="28" Height="170" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Bottom Bar Labels -->
                    <Grid Margin="10,6,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkPill}" Width="45" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource SkPill}" Width="52" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="40" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="3" Style="{StaticResource SkPill}" Width="48" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="4" Style="{StaticResource SkPill}" Width="55" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="5" Style="{StaticResource SkPill}" Width="38" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="6" Style="{StaticResource SkPill}" Width="46" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="7" Style="{StaticResource SkPill}" Width="50" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="8" Style="{StaticResource SkPill}" Width="42" Height="10" HorizontalAlignment="Center"/>
                        <Border Grid.Column="9" Style="{StaticResource SkPill}" Width="48" Height="10" HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Row: Top Categories (6*) | Age groups (5*) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Top Categories -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,18">
                    <StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="130" Height="16" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkPill}" Width="240" Height="12" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                        <!-- 5 Horizontal Bars -->
                        <StackPanel Margin="0,4">
                            <Border Style="{StaticResource SkPill}" Width="160" Height="11" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Background="#EDE2E6" CornerRadius="5" Height="18" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SkPill}" Width="140" Height="11" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Background="#EDE2E6" CornerRadius="5" Height="18" HorizontalAlignment="Left" Width="380" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SkPill}" Width="120" Height="11" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Background="#EDE2E6" CornerRadius="5" Height="18" HorizontalAlignment="Left" Width="290" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SkPill}" Width="150" Height="11" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Background="#EDE2E6" CornerRadius="5" Height="18" HorizontalAlignment="Left" Width="210" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SkPill}" Width="110" Height="11" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Background="#EDE2E6" CornerRadius="5" Height="18" HorizontalAlignment="Left" Width="140"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: Age Groups -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,18">
                    <StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="100" Height="16" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkPill}" Width="220" Height="12" HorizontalAlignment="Left" Margin="0,0,0,24"/>

                        <Grid Height="220" Margin="10,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="6,6,0,0" Width="34" Height="90" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="2" Background="#EDE2E6" CornerRadius="6,6,0,0" Width="34" Height="180" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="4" Background="#EDE2E6" CornerRadius="6,6,0,0" Width="34" Height="140" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="6" Background="#EDE2E6" CornerRadius="6,6,0,0" Width="34" Height="70" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Grid Margin="10,4,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SkPill}" Width="45" Height="10" HorizontalAlignment="Center"/>
                            <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="45" Height="10" HorizontalAlignment="Center"/>
                            <Border Grid.Column="4" Style="{StaticResource SkPill}" Width="45" Height="10" HorizontalAlignment="Center"/>
                            <Border Grid.Column="6" Style="{StaticResource SkPill}" Width="45" Height="10" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
