<UserControl x:Class="SOLUM_UI.Views.Components.UserTableSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRowsContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="UserPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SkeletonRowsContainer">

            <!-- Row 1 -->
            <Grid MinHeight="56" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20,10,12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="19" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="135" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="85" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="24" Width="95" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="6" Height="22" Width="130" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Style="{StaticResource UserPill}" Width="100" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="22" Width="68" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="52" Height="28" Margin="0,0,6,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2 -->
            <Grid MinHeight="56" Background="#FCF9FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20,10,12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="19" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="115" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="70" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="24" Width="80" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="6" Height="22" Width="115" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Style="{StaticResource UserPill}" Width="90" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="22" Width="68" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="52" Height="28" Margin="0,0,6,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3 -->
            <Grid MinHeight="56" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20,10,12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="19" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="150" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="95" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="24" Width="105" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="6" Height="22" Width="140" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Style="{StaticResource UserPill}" Width="105" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="22" Width="68" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="52" Height="28" Margin="0,0,6,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 4 -->
            <Grid MinHeight="56" Background="#FCF9FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20,10,12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="19" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="120" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="75" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="24" Width="85" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="6" Height="22" Width="120" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Style="{StaticResource UserPill}" Width="95" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="22" Width="68" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="52" Height="28" Margin="0,0,6,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 5 -->
            <Grid MinHeight="56" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20,10,12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="19" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="140" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="80" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="24" Width="90" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="6" Height="22" Width="135" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Style="{StaticResource UserPill}" Width="100" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="22" Width="68" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="52" Height="28" Margin="0,0,6,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 6 -->
            <Grid MinHeight="56" Background="#FCF9FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20,10,12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="19" Width="38" Height="38" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="125" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="85" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="24" Width="78" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="6" Height="22" Width="118" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Padding="12,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Style="{StaticResource UserPill}" Width="92" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <Border Background="#EDE2E6" CornerRadius="12" Height="22" Width="68" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Padding="8,10" VerticalAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#F2EAEF">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="52" Height="28" Margin="0,0,6,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
