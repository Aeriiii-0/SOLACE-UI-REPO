<UserControl x:Class="SOLUM_UI.Views.Components.UserTableSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRowsContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="UserCellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F2EAEF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UserPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SkeletonRowsContainer">

            <!-- Row 1 -->
            <Grid Height="52" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource UserCellBorder}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="18" Width="36" Height="36" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="85" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource UserCellBorder}">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="80" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource UserCellBorder}">
                    <Border Style="{StaticResource UserPill}" Width="105" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource UserCellBorder}" Padding="8,0">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="60" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2 -->
            <Grid Height="52" Background="#FCF9FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource UserCellBorder}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="18" Width="36" Height="36" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="115" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="70" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource UserCellBorder}">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="70" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource UserCellBorder}">
                    <Border Style="{StaticResource UserPill}" Width="95" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource UserCellBorder}" Padding="8,0">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="60" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3 -->
            <Grid Height="52" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource UserCellBorder}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="18" Width="36" Height="36" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="155" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="90" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource UserCellBorder}">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="85" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource UserCellBorder}">
                    <Border Style="{StaticResource UserPill}" Width="110" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource UserCellBorder}" Padding="8,0">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="60" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 4 -->
            <Grid Height="52" Background="#FCF9FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource UserCellBorder}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="18" Width="36" Height="36" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="125" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="75" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource UserCellBorder}">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="70" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource UserCellBorder}">
                    <Border Style="{StaticResource UserPill}" Width="90" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource UserCellBorder}" Padding="8,0">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="60" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 5 -->
            <Grid Height="52" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource UserCellBorder}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="18" Width="36" Height="36" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="145" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="80" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource UserCellBorder}">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="80" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource UserCellBorder}">
                    <Border Style="{StaticResource UserPill}" Width="105" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource UserCellBorder}" Padding="8,0">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="60" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 6 -->
            <Grid Height="52" Background="#FCF9FA">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource UserCellBorder}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="18" Width="36" Height="36" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource UserPill}" Width="135" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <Border Style="{StaticResource UserPill}" Width="85" Height="11" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource UserCellBorder}">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="75" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource UserCellBorder}">
                    <Border Style="{StaticResource UserPill}" Width="100" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource UserCellBorder}" Padding="8,0">
                    <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="60" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" Padding="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                        <Border Background="#EDE2E6" CornerRadius="6" Width="28" Height="28" Margin="3,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
