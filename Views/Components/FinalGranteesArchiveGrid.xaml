<UserControl x:Class="SOLUM_UI.Views.Components.FinalGranteesArchiveGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#FAF2F5"/><Setter Property="Foreground" Value="#702943"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FAF2F5" BorderBrush="#EBD8DE" BorderThickness="0,0,0,1">
                            <Border BorderBrush="#EBD8DE" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextBlock.Foreground="#702943" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="11" TextBlock.FontWeight="SemiBold"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5ECEE"/></Trigger>
                            <Trigger Property="Column" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelRow" TargetType="ListViewItem">
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F2EAEF"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Rectangle x:Name="AccentIndicator" HorizontalAlignment="Left" Width="3" Fill="#27AE60" VerticalAlignment="Stretch"/>
                            <GridViewRowPresenter VerticalAlignment="Stretch" Margin="2,0,2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#94A3B8"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Top Banner: Title, Summary & Export Final Ledger -->
        <Border Grid.Row="0" MinHeight="98" Background="#FBF5F7" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1" Padding="16,12" Margin="0,0,0,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Final Grantees Ledger" FontSize="13" FontWeight="Bold" Foreground="#702943"/>
                        <Border Background="{Binding RosterStatusBadgeBg}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RosterStatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding RosterStatusBadgeFg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding FinalSummaryText}" FontSize="11" Foreground="#A06080" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Export Final Ledger -->
                <Button Grid.Column="1" Height="32" Padding="16,0" Cursor="Hand" Command="{Binding ExportFinalLedgerCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#702943" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="Export Final Ledger" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Ledger Table Container: Record Management Card Design with Radial Mask -->
        <Border Grid.Row="1" CornerRadius="14" BorderBrush="#E8D4DA" BorderThickness="1.5" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="16" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid x:Name="TableClipGrid">
                <Grid.OpacityMask>
                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="12.5"
                                    Width="{Binding ActualWidth, ElementName=TableClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=TableClipGrid}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>

                <!-- ListView (Row 0: Column headers start immediately at top) -->
                <ListView Grid.Row="0" x:Name="FinalGranteesListView" ItemsSource="{Binding PagedFinalGrantees}"
                          BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SelRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SizeChanged="FinalGranteesListView_SizeChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <!-- Col 1: BENEFICIARY NAME -->
                            <GridViewColumn x:Name="ColName" Header="BENEFICIARY NAME" Width="170">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColName}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="12,10"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 2: CONTACT NUMBER -->
                            <GridViewColumn x:Name="ColContact" Header="CONTACT NUMBER" Width="130">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColContact}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Text="{Binding ContactNumberFormatted}" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 3: BARANGAY -->
                            <GridViewColumn x:Name="ColBarangay" Header="BARANGAY" Width="120">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColBarangay}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><TextBlock Text="{Binding Barangay}" FontSize="11" Foreground="#333333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 4: RESIDENTIAL ADDRESS -->
                            <GridViewColumn x:Name="ColAddress" Header="RESIDENTIAL ADDRESS" Width="170">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColAddress}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><TextBlock Text="{Binding FullAddress}" FontSize="11" Foreground="#333333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 5: EMERGENCY CONTACT -->
                            <GridViewColumn x:Name="ColEmergencyName" Header="EMERGENCY CONTACT" Width="140">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColEmergencyName}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><TextBlock Text="{Binding EmergencyContactName}" FontSize="11" Foreground="#333333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 6: EMERGENCY PHONE -->
                            <GridViewColumn x:Name="ColEmergencyPhone" Header="EMERGENCY PHONE" Width="130">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColEmergencyPhone}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Text="{Binding EmergencyContactFormatted}" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 7: STATUS (Final column - No trailing vertical divider line) -->
                            <GridViewColumn x:Name="ColStatus" Header="STATUS" Width="90">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColStatus}" Margin="-6,0,-6,0" BorderThickness="0" Padding="6,10"><Border CornerRadius="10" Padding="8,2" Background="{Binding RecordStatusBg}" HorizontalAlignment="Center"><TextBlock Text="{Binding RecordStatus}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RecordStatusFg}"/></Border></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Pagination Footer (Row 1: Combined live stats with page numbers) -->
                <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#EBD8DE" BorderThickness="0,1,0,0" Height="42" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#27AE60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding FinalSummaryText}" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="#CBD5E1" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalPageSummary}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PagerBtn}" Margin="0,0,6,0" Command="{Binding FinalPrevPageCommand}" IsEnabled="{Binding CanFinalPrevPage}" ToolTip="Previous page">
                                <TextBlock Text="‹ Previous" FontSize="10.5" FontWeight="SemiBold"/>
                            </Button>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FinalPageNumberLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#702943"/>
                            </Border>
                            <Button Style="{StaticResource PagerBtn}" Command="{Binding FinalNextPageCommand}" IsEnabled="{Binding CanFinalNextPage}" ToolTip="Next page">
                                <TextBlock Text="Next ›" FontSize="10.5" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
