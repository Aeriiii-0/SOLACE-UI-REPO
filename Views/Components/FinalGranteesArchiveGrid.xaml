<UserControl x:Class="SOLUM_UI.Views.Components.FinalGranteesArchiveGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <!-- Reusable Sleek Translucent Maroon ScrollBar -->
        <Style x:Key="SolumScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#5C1D38" CornerRadius="2" Opacity="0.22"
                                Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="0.80"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/><Setter TargetName="ThumbBorder" Property="Background" Value="#5C1D38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Stretch">
                                        <Track.Thumb><Thumb Style="{StaticResource SolumScrollBarThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Width" Value="7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" HorizontalAlignment="Stretch">
                                        <Track.Thumb><Thumb Style="{StaticResource SolumScrollBarThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Height" Value="7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#FBF5F7"/>
            <Setter Property="Foreground" Value="#5C1D38"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FBF5F7" BorderBrush="#5C1D38" BorderThickness="0,0,0,1">
                            <Border BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextBlock.Foreground="#5C1D38" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="11" TextBlock.FontWeight="Bold"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5ECEE"/></Trigger>
                            <Trigger Property="Column" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelRow" TargetType="ListViewItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="{DynamicResource SolumTableRowHeight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EDE2E6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <GridViewRowPresenter VerticalAlignment="Stretch" Margin="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBg" Property="Background" Value="{DynamicResource SolumTableRowHoverBrush}"/><Setter TargetName="RowBg" Property="BorderBrush" Value="{DynamicResource SolumTableRowHoverBorderBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/><Setter TargetName="RowBg" Property="BorderBrush" Value="{DynamicResource SolumTableRowSelectedBorderBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Single Compact Ribbon: Summary & Export Final Ledger -->
        <Border Grid.Row="0" Background="#FBF5F7" MinHeight="48" CornerRadius="10" BorderBrush="#5C1D38" BorderThickness="1" Padding="14,8" Margin="0,-15,0,17">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left: Summary Counter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF0F5" CornerRadius="8" BorderBrush="#5C1D38" BorderThickness="1.2" Padding="12,5">
                        <TextBlock Text="{Binding FinalSummaryText}" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#5C1D38" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <!-- Right: Export Final Ledger -->
                <Button Grid.Column="1" Height="30" Padding="14,0" Cursor="Hand" Command="{Binding ExportFinalLedgerCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#5C1D38" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="Export Final List" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <!-- Main Ledger Table Container: Record Management Card Design with Radial Mask -->
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="#5C1D38" BorderThickness="1" Background="White" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display" Margin="0,-12,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#5C1D38" BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid x:Name="TableClipGrid">
                <Grid.OpacityMask>
                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="11"
                                    Width="{Binding ActualWidth, ElementName=TableClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=TableClipGrid}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ListView (Row 0: Column headers start immediately at top) -->
                <ListView Grid.Row="0" x:Name="FinalGranteesListView" SelectionMode="Single" ItemsSource="{Binding FinalGranteesList}"
                          BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SelRow}"
                          FontFamily="Segoe UI"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SizeChanged="FinalGranteesListView_SizeChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <!-- Col 1: BENEFICIARY NAME -->
                            <GridViewColumn x:Name="ColName" Header="BENEFICIARY NAME" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColName}" Margin="-6,0,-6,0" BorderBrush="#EDE2E6" BorderThickness="0" Padding="12,10">
                                            <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 2: CONTACT NUMBER -->
                            <GridViewColumn x:Name="ColContact" Header="CONTACT NUMBER" Width="135">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColContact}" Margin="-6,0,-6,0" BorderBrush="#EDE2E6" BorderThickness="0" Padding="8,10">
                                            <TextBlock Text="{Binding ContactNumberFormatted}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 3: BARANGAY -->
                            <GridViewColumn x:Name="ColBarangay" Header="BARANGAY" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColBarangay}" Margin="-6,0,-6,0" BorderBrush="#EDE2E6" BorderThickness="0" Padding="10,10">
                                            <TextBlock Text="{Binding Barangay}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 4: RESIDENTIAL ADDRESS -->
                            <GridViewColumn x:Name="ColAddress" Header="RESIDENTIAL ADDRESS" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColAddress}" Margin="-6,0,-6,0" BorderBrush="#EDE2E6" BorderThickness="0" Padding="10,10">
                                            <TextBlock Text="{Binding FullAddress}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullAddress}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 5: EMERGENCY CONTACT -->
                            <GridViewColumn x:Name="ColEmergencyName" Header="EMERGENCY CONTACT" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColEmergencyName}" Margin="-6,0,-6,0" BorderBrush="#EDE2E6" BorderThickness="0" Padding="10,10">
                                            <TextBlock Text="{Binding DisplayEmergencyContact}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayEmergencyContact}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 6: EMERGENCY PHONE -->
                            <GridViewColumn x:Name="ColEmergencyPhone" Header="EMERGENCY NUMBER" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColEmergencyPhone}" Margin="-6,0,-6,0" BorderBrush="#EDE2E6" BorderThickness="0" Padding="8,10">
                                            <TextBlock Text="{Binding EmergencyContactFormatted}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 7: STATUS (Final column - No trailing vertical divider line) -->
                            <GridViewColumn x:Name="ColStatus" Header="STATUS" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColStatus}" Margin="-6,0,-6,0" BorderThickness="0" Padding="6,10">
                                            <Border CornerRadius="10" Padding="8,2" Background="{Binding RecordStatusBg}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding RecordStatus}" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RecordStatusFg}"/>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <!-- Summary footer -->
                <Border Grid.Row="1" Background="#FAF6F8" BorderBrush="#EFE4E8" BorderThickness="0,1.2,0,0" Padding="18,10">
                    <TextBlock Text="{Binding FinalSummaryText}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="#5C1D38" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
