<UserControl x:Class="SOLUM_UI.Views.Components.SubsidyExplainDrawer"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             mc:Ignorable="d" 

             d:DesignHeight="700" d:DesignWidth="360">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Reusable Sleek Translucent Maroon ScrollBar -->
        <Style x:Key="SolumScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#5C1D38" CornerRadius="2" Opacity="0.22"
                                Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="0.80"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/><Setter TargetName="ThumbBorder" Property="Background" Value="#5C1D38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Stretch">
                                        <Track.Thumb><Thumb Style="{StaticResource SolumScrollBarThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Width" Value="7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" HorizontalAlignment="Stretch">
                                        <Track.Thumb><Thumb Style="{StaticResource SolumScrollBarThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Height" Value="7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Width="360" Background="#FFFFFF" CornerRadius="16" BorderBrush="#5C1D38" BorderThickness="1" ClipToBounds="True">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- Drawer Header -->

            <Border Grid.Row="0" Background="#FBF5F7" BorderBrush="#EFE5E8" BorderThickness="0,0,0,1" Padding="16,12" CornerRadius="16,16,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="{Binding ActiveCandidate.Name}" FontSize="14" FontWeight="Bold" Foreground="#702943" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="{Binding ActiveCandidate.Barangay}" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand"

                            Command="{Binding CloseExplainDrawerCommand}" Padding="4">

                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#888888"/>

                    </Button>

                </Grid>

            </Border>

            <!-- Drawer Scrollable Content -->
            <ScrollViewer x:Name="DrawerScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">

                <StackPanel>

                    <!-- Upper Metrics Card: Score Hero Card with ML Badge -->

                    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E5D9DF" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">

                        <Grid>

                            <!-- Top Right Re-assess Icon Button -->

                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"

                                    Width="30" Height="30" Cursor="Hand"

                                    BorderThickness="0" Background="White"

                                    ToolTip="{Binding ActiveCandidateReassessmentTooltip}"

                                    ToolTipService.ShowOnDisabled="True"

                                    IsEnabled="{Binding CanReassessActiveCandidate}"

                                    Command="{Binding QuickPredictCandidateCommand}"

                                    CommandParameter="{Binding ActiveCandidate}">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"

                                                CornerRadius="15" BorderBrush="#E0D0D5" BorderThickness="1.2">

                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>

                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">

                                                <Setter Property="Opacity" Value="0.45"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                                <Button.ContextMenu>

                                    <ContextMenu>

                                        <MenuItem Header="Quick Re-assess (Live ML Model)" Command="{Binding QuickPredictCandidateCommand}" CommandParameter="{Binding ActiveCandidate}"/>

                                        <MenuItem Header="Edit Circumstances &amp; Re-assess..." Command="{Binding OpenReassessmentFormCommand}" CommandParameter="{Binding ActiveCandidate}"/>

                                    </ContextMenu>

                                </Button.ContextMenu>

                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"

                                      Fill="#702943" Stretch="Uniform" Width="14" Height="14"/>

                            </Button>

                            <!-- Centered Metrics -->

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="{Binding ActiveCandidate.ScoreLabel}" FontSize="28" FontWeight="Bold" Foreground="#5C1D38" HorizontalAlignment="Center"/>

                                <TextBlock Text="Vulnerability Priority Score" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                <!-- ML Model Badge - Blue Rectangle Styling -->

                                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Center" ToolTip="{Binding ActiveCandidate.ModelSourceTooltip}">

                                    <TextBlock Text="{Binding ActiveCandidate.ModelSourceFullBadge}" FontSize="9" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                </Border>

                                <!-- Model Confidence directly underneath (Visible for live ML model) -->

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"

                                            Visibility="{Binding ActiveCandidate.ShowModelConfidence, Converter={StaticResource BoolToVis}}">

                                    <TextBlock Text="Model Confidence: " FontSize="10.5" Foreground="#64748B"/>

                                    <TextBlock Text="{Binding ActiveCandidate.ConfidencePercentLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- Card Expiration Alert Banner (Conditional when card is expired) -->

                    <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"

                            Visibility="{Binding ActiveCandidate.IsCardExpired, Converter={StaticResource BoolToVis}}">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="⚠️ Solo Parent ID Expired" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>

                                <Border Background="#DC2626" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">

                                    <TextBlock Text="Renewal Required" FontSize="9" FontWeight="Bold" Foreground="White"/>

                                </Border>

                            </StackPanel>

                            <TextBlock Text="This applicant's Solo Parent ID card has expired. Under RA 11861, annual card validity is mandatory before final grant confirmation."

                                       FontSize="10.5" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Button Height="28" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand"

                                    Command="{Binding OpenReassessmentFormCommand}" CommandParameter="{Binding ActiveCandidate}">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">

                                            <TextBlock Text="Open Renewal Form" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </StackPanel>

                    </Border>

                    <!-- Fallback Notice Banner (Conditional when IsFallbackScore is true) -->

                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"

                            Visibility="{Binding ActiveCandidate.IsFallbackScore, Converter={StaticResource BoolToVis}}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="{Binding ActiveCandidate.FallbackAlertTitle}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>

                                <TextBlock Text="{Binding ActiveCandidate.FallbackAlertDesc}" FontSize="10" Foreground="#78350F" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            </StackPanel>

                            <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"

                                    Command="{Binding QuickPredictCandidateCommand}"

                                    CommandParameter="{Binding ActiveCandidate}"

                                    Cursor="Hand" Background="#F59E0B" Padding="8,4" BorderThickness="0"

                                    ToolTip="Trigger live ML scoring for this applicant">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="Fbg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fbg" Property="Background" Value="#D97706"/></Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                                <TextBlock Text="Run ML ↺" FontSize="10" FontWeight="Bold" Foreground="White"/>

                            </Button>

                        </Grid>

                    </Border>

                    <!-- Audit Notice Banner (Conditional) -->

                    <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"

                            Visibility="{Binding ActiveCandidate.HasAuditNotice, Converter={StaticResource BoolToVis}}">

                        <StackPanel>

                            <TextBlock Text="{Binding ActiveCandidate.AuditBannerTitle}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>

                            <TextBlock Text="{Binding ActiveCandidate.AuditBannerDesc}" FontSize="10" Foreground="#78350F" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- Needs & Other Income (Prominently Placed at Top) -->
                    <Border Background="#FDF8FA" CornerRadius="10" BorderBrush="#E8D8DF" BorderThickness="1.2" Padding="14,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Needs &amp; Other Income" FontSize="13" FontWeight="Bold" Foreground="#5C1D38" Margin="0,0,0,10"/>

                            <TextBlock Text="PROBLEM PRESENTED (SOLO PARENT)" FontSize="10.5" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.ProblemPresentedDisplay}" FontSize="12.5" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="17"/>

                            <TextBlock Text="NEEDS AND PROBLEMS" FontSize="10.5" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.NeedsAndProblemsDisplay}" FontSize="12.5" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="17"/>

                            <TextBlock Text="OTHER SOURCES OF INCOME" FontSize="10.5" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.OtherIncomeDisplay}" FontSize="12.5" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,2" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- 4-Dimension Breakdown Section with Prominent Content -->
                    <TextBlock Text="Case Vulnerability Indicators" FontSize="12" FontWeight="Bold" Foreground="#5C1D38" Margin="0,0,0,8"/>

                    <!-- Dimension 1: Economic Strain -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. Economic Strain" FontSize="11" FontWeight="Bold" Foreground="#5C1D38" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.EcoPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.EcoSecondaryMetric}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 2: Dependency Burden -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. Dependency Burden" FontSize="11" FontWeight="Bold" Foreground="#5C1D38" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.DepPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.DepSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,8"/>

                            <!-- Dual Side-by-Side Cards for Dependents -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Card 1: Aged 0–6 yrs -->
                                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="10,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveCandidate.Children0To6Count}" FontSize="20" FontWeight="Bold" Foreground="#5C1D38" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Aged 0–6 yrs" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Card 2: Aged 7–22 yrs -->
                                <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="10,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveCandidate.Children7To22Count}" FontSize="20" FontWeight="Bold" Foreground="#5C1D38" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Aged 7–22 yrs" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Collapsible List of Dependents -->
                            <Expander Header="{Binding ActiveCandidate.DependentsExpanderHeader}"
                                      IsExpanded="False"
                                      Margin="0,8,0,0"
                                      FontSize="11" FontWeight="SemiBold" Foreground="#5C1D38"
                                      Visibility="{Binding ActiveCandidate.HasChildrenDetails, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding ActiveCandidate.ChildrenDetails}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FDF8FA" CornerRadius="5" BorderBrush="#F0E2E7" BorderThickness="1" Padding="8,5" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1F2937" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="#F3E5EC" BorderBrush="#D4B6C2" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AgeDisplay}" FontSize="9.5" FontWeight="SemiBold" Foreground="#5C1D38"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 3: Care Burden (Kept only if candidate only has children aged 0-6) -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"
                            Visibility="{Binding ActiveCandidate.ShowCareBurden, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="3. Care Burden" FontSize="11" FontWeight="Bold" Foreground="#5C1D38" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.CarePrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.CareSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,0"/>
                            <Border Visibility="{Binding ActiveCandidate.HasSpecialNeedsDependent, Converter={StaticResource BoolToVis}}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ActiveCandidate.SpecialNeedsBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- In-Drawer Lazy / Shimmer Loader Overlay (Active when switching candidates) -->
            <Border Grid.Row="1" Background="White"
                    Visibility="{Binding IsDrawerLoading, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="5">
                <Border.Resources>
                    <Storyboard x:Key="DrawerPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="DrawerSkeletonContainer"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.95" To="0.32"
                                         Duration="0:0:0.85">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Style x:Key="DrawerPill" TargetType="Border">
                        <Setter Property="Background" Value="#EDE2E6"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Height" Value="13"/>
                    </Style>
                </Border.Resources>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource DrawerPulseStoryboard}"/>
                    </EventTrigger>
                </Border.Triggers>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                    <StackPanel x:Name="DrawerSkeletonContainer">
                        <!-- Score Card Skeleton -->
                        <Border Background="#FDF8FA" CornerRadius="12" BorderBrush="#E5D9DF" BorderThickness="1" Padding="16,16" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource DrawerPill}" Width="70" Height="28" CornerRadius="8" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource DrawerPill}" Width="150" Height="11" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource DrawerPill}" Width="90" Height="18" CornerRadius="6"/>
                            </StackPanel>
                        </Border>
                        <!-- Needs & Other Income Skeleton -->
                        <Border Background="#FDF8FA" CornerRadius="10" BorderBrush="#E8D8DF" BorderThickness="1.2" Padding="14,14" Margin="0,0,0,14">
                            <StackPanel>
                                <Border Style="{StaticResource DrawerPill}" Width="140" Height="13" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource DrawerPill}" Width="110" Height="10" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource DrawerPill}" Width="260" Height="12" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource DrawerPill}" Width="120" Height="10" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource DrawerPill}" Width="240" Height="12" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource DrawerPill}" Width="130" Height="10" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource DrawerPill}" Width="180" Height="12"/>
                            </StackPanel>
                        </Border>
                        <!-- Case Indicators Skeleton -->
                        <Border Style="{StaticResource DrawerPill}" Width="160" Height="12" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Style="{StaticResource DrawerPill}" Width="110" Height="11" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource DrawerPill}" Width="150" Height="14" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource DrawerPill}" Width="190" Height="10"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <Border Style="{StaticResource DrawerPill}" Width="120" Height="11" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource DrawerPill}" Width="160" Height="14" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Height="44"/>
                                    <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E5D9DF" BorderThickness="1" Height="44"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Drawer Footer Actions -->

            <Border Grid.Row="2" Background="#FBF5F7" BorderBrush="#EFE5E8" BorderThickness="0,1,0,0" Padding="14,10" CornerRadius="0,0,16,16">

                <StackPanel>

                    <Button Height="40" Cursor="Hand" Command="{Binding DrawerShortlistCommand}" IsEnabled="{Binding CanModifyGrantees}" Margin="0,0,0,10">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bg" Background="#5C1D38" BorderBrush="#5C1D38" BorderThickness="1" CornerRadius="8" Padding="8,0">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>

                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                        <TextBlock Text="Move to Shortlist" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                    </Button>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="40" Cursor="Hand" Command="{Binding OpenOutlierModalCommand}" IsEnabled="{Binding CanModifyGrantees}"

                                CommandParameter="{Binding ActiveCandidate}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="Bg" Background="Transparent" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="8,0">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>

                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/></Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                            <TextBlock Text="Disqualify Outlier" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                        </Button>

                        <Button Grid.Column="2" Height="40" Cursor="Hand" Command="{Binding ViewFullRecordCommand}"

                                CommandParameter="{Binding ActiveCandidate}">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="Bg" Background="Transparent" BorderBrush="#5C1D38" BorderThickness="1" CornerRadius="8" Padding="8,0">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#FBF5F7"/>
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#5C1D38"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Button.Template>

                            <TextBlock Text="Full Record" FontSize="13" FontWeight="SemiBold" Foreground="#5C1D38" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                        </Button>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>
