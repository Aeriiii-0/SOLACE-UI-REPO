<UserControl x:Class="SOLUM_UI.Views.Components.SubsidyExplainDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Width="360" Background="#FFFFFF" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drawer Header -->
            <Border Grid.Row="0" Background="#FBF5F7" BorderBrush="#EFE5E8" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ActiveCandidate.Name}" FontSize="14" FontWeight="Bold" Foreground="#702943" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding ActiveCandidate.SpId}" FontSize="11" FontWeight="SemiBold" Foreground="#994466"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="#AAAAAA"/>
                            <TextBlock Text="{Binding ActiveCandidate.Barangay}" FontSize="11" Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CloseExplainDrawerCommand}" Padding="4">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#888888"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Drawer Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                <StackPanel>
                    <!-- Upper Metrics Card: Score with Model Confidence underneath -->
                    <Border Background="#FDF8FA" CornerRadius="10" BorderBrush="#E5D5DC" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ActiveCandidate.ScoreLabel}" FontSize="28" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vulnerability Priority Score" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,1,0,0"/>

                            <!-- Model Confidence directly underneath, smaller -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="Model Confidence: " FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ActiveCandidate.ConfidencePercentLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audit Notice Banner (Conditional) -->
                    <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding ActiveCandidate.HasAuditNotice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveCandidate.AuditBannerTitle}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="{Binding ActiveCandidate.AuditBannerDesc}" FontSize="10" Foreground="#78350F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4-Dimension Breakdown Section with Prominent Content -->
                    <TextBlock Text="Vulnerability Dimensions" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,8"/>

                    <!-- Dimension 1: Economic Strain -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="1. Economic Strain" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                <Border Background="#FFF1F2" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActiveCandidate.EconomicStrainPercentLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#DC3545"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ActiveCandidate.EcoPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.EcoSecondaryMetric}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ActiveCandidate.PerCapitaFg}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 2: Dependency Burden -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="2. Dependency Burden" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                <Border Background="#FFF1F2" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActiveCandidate.DependencyBurdenPercentLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#DC3545"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ActiveCandidate.DepPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.DepSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,0"/>

                            <!-- Small vertical list of children & ages -->
                            <ItemsControl ItemsSource="{Binding ActiveCandidate.ChildrenDetails}" Margin="0,8,0,0"
                                          Visibility="{Binding ActiveCandidate.HasChildrenDetails, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FDF8FA" CornerRadius="4" BorderBrush="#F0E2E7" BorderThickness="1" Padding="6,3" Margin="0,0,0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#222222" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="3" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AgeDisplay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 3: Care Burden -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="3. Care Burden" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                <Border Background="#FFFBEB" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActiveCandidate.CareBurdenPercentLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ActiveCandidate.CarePrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.CareSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 4: Resource Adequacy -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="4. Resource Adequacy" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                <Border Background="#FFFBEB" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActiveCandidate.ResourceAdequacyPercentLabel}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ActiveCandidate.ResPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.ResSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Drawer Footer Actions -->
            <Border Grid.Row="2" Background="#FBF5F7" BorderBrush="#EFE5E8" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel>
                    <Button Height="36" Cursor="Hand" Command="{Binding DrawerShortlistCommand}" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#702943" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="+ Move to Shortlist" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="32" Cursor="Hand" Command="{Binding OpenOutlierModalCommand}"
                                CommandParameter="{Binding ActiveCandidate}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#FFF0F3" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FDE2E8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Disqualify Outlier" FontSize="10.5" FontWeight="SemiBold" Foreground="#C53030"/>
                        </Button>
                        <Button Grid.Column="2" Height="32" Cursor="Hand" Command="{Binding ViewFullRecordCommand}"
                                CommandParameter="{Binding ActiveCandidate}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#EAEAEA"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Full Record ↗" FontSize="10" FontWeight="SemiBold" Foreground="#555555"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
