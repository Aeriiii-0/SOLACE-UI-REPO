<UserControl x:Class="SOLUM_UI.Views.Components.SubsidyExplainDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Width="360" Background="#FFFFFF" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drawer Header -->
            <Border Grid.Row="0" Background="#FBF5F7" BorderBrush="#EFE5E8" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ActiveCandidate.Name}" FontSize="14" FontWeight="Bold" Foreground="#702943" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveCandidate.Barangay}" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CloseExplainDrawerCommand}" Padding="4">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#888888"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Drawer Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                <StackPanel>
                    <!-- Upper Metrics Card: Score with Origin Badge & Model Confidence underneath -->
                    <Border Background="#FDF8FA" CornerRadius="10" BorderBrush="#E5D5DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <!-- Top Right Re-assess Icon Button (Brand Maroon) -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="30" Height="30" Cursor="Hand"
                                    BorderThickness="0" Background="White"
                                    ToolTip="Re-assess &amp; re-score applicant via live ML model (Right-click to edit circumstances)"
                                    Command="{Binding QuickPredictCandidateCommand}"
                                    CommandParameter="{Binding ActiveCandidate}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                CornerRadius="15" BorderBrush="#E0D0D5" BorderThickness="1.2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Quick Re-assess (Live ML Model)" Command="{Binding QuickPredictCandidateCommand}" CommandParameter="{Binding ActiveCandidate}"/>
                                        <MenuItem Header="Edit Circumstances &amp; Re-assess..." Command="{Binding OpenReassessmentFormCommand}" CommandParameter="{Binding ActiveCandidate}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Fill="#702943" Stretch="Uniform" Width="14" Height="14"/>
                            </Button>

                            <!-- Centered Metrics -->
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ActiveCandidate.ScoreLabel}" FontSize="28" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center"/>
                                <TextBlock Text="Vulnerability Priority Score" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                <!-- Calculation Origin Badge (ML Model vs Fallback Heuristic) -->
                                <Border Background="{Binding ActiveCandidate.ModelSourceBg}" BorderBrush="{Binding ActiveCandidate.ModelSourceBorder}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center" ToolTip="{Binding ActiveCandidate.ModelSourceTooltip}">
                                    <TextBlock Text="{Binding ActiveCandidate.ModelSourceFullBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ActiveCandidate.ModelSourceFg}" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Model Confidence directly underneath (Visible for live ML model) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0"
                                            Visibility="{Binding ActiveCandidate.ShowModelConfidence, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Model Confidence: " FontSize="10.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ActiveCandidate.ConfidencePercentLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fallback Notice Banner (Conditional when IsFallbackScore is true) -->
                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding ActiveCandidate.IsFallbackScore, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ActiveCandidate.FallbackAlertTitle}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                <TextBlock Text="{Binding ActiveCandidate.FallbackAlertDesc}" FontSize="10" Foreground="#78350F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Command="{Binding QuickPredictCandidateCommand}"
                                    CommandParameter="{Binding ActiveCandidate}"
                                    Cursor="Hand" Background="#F59E0B" Padding="8,4" BorderThickness="0"
                                    ToolTip="Trigger live ML scoring for this applicant">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Fbg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fbg" Property="Background" Value="#D97706"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Run ML ↺" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Audit Notice Banner (Conditional) -->
                    <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding ActiveCandidate.HasAuditNotice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveCandidate.AuditBannerTitle}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="{Binding ActiveCandidate.AuditBannerDesc}" FontSize="10" Foreground="#78350F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4-Dimension Breakdown Section with Prominent Content -->
                    <TextBlock Text="Case Vulnerability Indicators" FontSize="12" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,8"/>

                    <!-- Dimension 1: Economic Strain -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. Economic Strain" FontSize="11" FontWeight="SemiBold" Foreground="#702943" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.EcoPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.EcoSecondaryMetric}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 2: Dependency Burden -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. Dependency Burden" FontSize="11" FontWeight="SemiBold" Foreground="#702943" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.DepPrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.DepSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,6"/>

                            <!-- Small Column for Children Age Groups -->
                            <Border Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,9" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveCandidate.Children7To22Text}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,1,0,3"/>
                                    <Border Height="1" Background="#F3F4F6" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding ActiveCandidate.Children0To6Text}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,1,0,1"/>
                                </StackPanel>
                            </Border>

                            <!-- Small vertical list of children & ages -->
                            <ItemsControl ItemsSource="{Binding ActiveCandidate.ChildrenDetails}" Margin="0,10,0,0"
                                          Visibility="{Binding ActiveCandidate.HasChildrenDetails, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FDF8FA" CornerRadius="5" BorderBrush="#F0E2E7" BorderThickness="1" Padding="8,5" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1F2937" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="3" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AgeDisplay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Dimension 3: Care Burden (Kept only if candidate only has children aged 0-6) -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"
                            Visibility="{Binding ActiveCandidate.ShowCareBurden, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="3. Care Burden" FontSize="11" FontWeight="SemiBold" Foreground="#702943" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveCandidate.CarePrimaryMetric}" FontSize="13.5" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding ActiveCandidate.CareSecondaryMetric}" FontSize="10.5" Foreground="#555555" Margin="0,2,0,0"/>
                            <Border Visibility="{Binding ActiveCandidate.HasSpecialNeedsDependent, Converter={StaticResource BoolToVis}}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ActiveCandidate.SpecialNeedsBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Needs & Other Income (Replaced Resource Adequacy) -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Needs &amp; Other Income" FontSize="11" FontWeight="SemiBold" Foreground="#702943" Margin="0,0,0,8"/>

                            <TextBlock Text="PROBLEM PRESENTED (SOLO PARENT)" FontSize="9.5" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding ActiveCandidate.ProblemPresentedDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="NEEDS AND PROBLEMS" FontSize="9.5" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding ActiveCandidate.NeedsAndProblemsDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="OTHER SOURCES OF INCOME" FontSize="9.5" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding ActiveCandidate.OtherIncomeDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Drawer Footer Actions -->
            <Border Grid.Row="2" Background="#FBF5F7" BorderBrush="#EFE5E8" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel>
                    <Button Height="36" Cursor="Hand" Command="{Binding DrawerShortlistCommand}" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#702943" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="+ Move to Shortlist" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="32" Cursor="Hand" Command="{Binding OpenOutlierModalCommand}"
                                CommandParameter="{Binding ActiveCandidate}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#FFF0F3" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FDE2E8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Disqualify Outlier" FontSize="10.5" FontWeight="SemiBold" Foreground="#C53030"/>
                        </Button>
                        <Button Grid.Column="2" Height="32" Cursor="Hand" Command="{Binding ViewFullRecordCommand}"
                                CommandParameter="{Binding ActiveCandidate}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#EAEAEA"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Full Record ↗" FontSize="10" FontWeight="SemiBold" Foreground="#555555"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
