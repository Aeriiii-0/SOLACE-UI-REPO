<UserControl x:Class="SOLUM_UI.Views.Components.QuotaAllocatorBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="1100" d:DesignHeight="54">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Border Height="54" Background="#FBF5F7" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1" Padding="14,0" Margin="0,0,0,10">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Recommendations Queue" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                <TextBlock Text="Ranked applicants evaluated by ML vulnerability triage." FontSize="10.5" Foreground="#A06080" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Right: Actions Toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                
                <!-- Refresh Queue Button -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32" Padding="10,0" Command="{Binding RefreshCommand}" ToolTip="Refresh recommendations queue from server">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Refresh" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                    </Button>
                </Border>

                <!-- Run ML Evaluations Button -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0"
                        Visibility="{Binding CanModifyGrantees, Converter={StaticResource BoolToVis}}">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32" Padding="10,0" Command="{Binding GenerateRecommendationsCommand}" ToolTip="Run ML triage batch scoring for active applicants">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Run ML Triage" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                    </Button>
                </Border>

                <!-- Cross-Check Filter Dropdown -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0">
                    <Button x:Name="FilterDropBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32" Padding="10,0" Click="FilterDrop_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#702943" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AuditFilterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Cross-Check Filter Popup -->
                <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="6" MinWidth="220">
                        <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                        <StackPanel>
                            <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="All" Padding="10,6">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="All Records" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                            </Border>
                            <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="Clean" Padding="10,6">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="Cleared (Standard)" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>
                            <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="CollegeAge" Padding="10,6">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="City Educ Check (17–24y)" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Grantee Slots & Budget Allocator -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Padding="8,2" Margin="0,0,8,0" Height="32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Grantees:" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border Background="#FDF5F8" CornerRadius="4" BorderBrush="#D0B8C0" BorderThickness="1" Padding="4,1" Height="24">
                            <TextBox Text="{Binding GranteeSlots, UpdateSourceTrigger=PropertyChanged}" Width="44" Height="20"
                                     FontSize="11" FontWeight="Bold"
                                     BorderThickness="0" Background="Transparent" Foreground="#702943"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Border>
                        <Border Background="#FFF0F5" CornerRadius="4" Padding="6,2" Margin="5,0,3,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CommittedBudgetText, StringFormat='Budget: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#702943"/>
                        </Border>
                        <Border Background="#EAF6F0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCountSummary}" FontSize="10.5" FontWeight="SemiBold" Foreground="#27AE60"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Batch Selecting Toggle Button -->
                <Button Height="32" Padding="12,0" Cursor="Hand" Command="{Binding ToggleBatchModeCommand}" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FBF5F7"/>
                                        <Setter Property="BorderBrush" Value="#702943"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                                <Setter Property="Background" Value="#702943"/>
                                                <Setter Property="BorderBrush" Value="#702943"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding BatchModeButtonText}" FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#702943"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Batch Action Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                    <Button Height="32" Padding="10,0" Cursor="Hand" Command="{Binding SelectTopNCommand}" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#FBF5F7" BorderBrush="#702943" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F5E4E8"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding SelectTopNLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                    </Button>
                    <Button Height="32" Padding="12,0" Cursor="Hand" Command="{Binding ShortlistSelectedCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#702943" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="+ Shortlist Selected" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
