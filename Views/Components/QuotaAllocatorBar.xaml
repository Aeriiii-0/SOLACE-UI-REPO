<UserControl x:Class="SOLUM_UI.Views.Components.QuotaAllocatorBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="1100" d:DesignHeight="50">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid Margin="24,8,24,10">
        <!-- Right-Aligned Toolbar: Filter, Budget, Slots, Batch Select & Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            
            <!-- Cross-Check Filter Dropdown (Placed on left side of Budget & Batch select) -->
            <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0D0D5" BorderThickness="1.5" Margin="0,0,10,0">
                <Button x:Name="FilterDropBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="38" Padding="12,0" Click="FilterDrop_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#702943" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AuditFilterLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Cross-Check Filter Popup -->
            <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="White" CornerRadius="12" BorderBrush="#E0D0D5" BorderThickness="1" Padding="6" MinWidth="220">
                    <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="14" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                    <StackPanel>
                        <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="All">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="👥 All Records" FontSize="11.5" FontWeight="SemiBold" Foreground="#702943" Padding="12,7"/>
                        </Border>
                        <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="Clean">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="✓ No Overlap (Clean)" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D" Padding="12,7"/>
                        </Border>
                        <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="CollegeAge">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="⚠️ City Educ Check" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309" Padding="12,7"/>
                        </Border>
                        <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="Pantawid">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="ℹ️ Pantawid 4Ps" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" Padding="12,7"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Budget & Quota Live Allocator -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E0D0D5" BorderThickness="1.5" Padding="10,4" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Budget:" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="#FDF5F8" CornerRadius="6" BorderBrush="#D0B8C0" BorderThickness="1" Padding="6,2" Height="34">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="₱" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center" Margin="2,0,2,0"/>
                            <TextBox Text="{Binding BudgetAmount, UpdateSourceTrigger=PropertyChanged}" Width="68" Height="28"
                                     FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                     BorderThickness="0" Background="Transparent" Foreground="#1A1A1A"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF0F5" CornerRadius="6" Padding="8,4" Margin="6,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GranteeSlotsText}" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                    </Border>
                    <Border Background="#EAF6F0" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCountSummary}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#27AE60"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Batch Selecting Toggle Button -->
            <Button Height="38" Padding="14,0" Cursor="Hand" Command="{Binding ToggleBatchModeCommand}" Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="19" Padding="{TemplateBinding Padding}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FBF5F7"/>
                                    <Setter Property="BorderBrush" Value="#702943"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                            <Setter Property="Background" Value="#702943"/>
                                            <Setter Property="BorderBrush" Value="#702943"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding BatchModeButtonText}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#702943"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <!-- Batch Action Buttons (Revealed when Batch Mode is Active) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                <Button Height="38" Padding="14,0" Cursor="Hand" Command="{Binding SelectTopNCommand}" Margin="0,0,6,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#FBF5F7" BorderBrush="#702943" BorderThickness="1" CornerRadius="19" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F5E4E8"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding SelectTopNLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                </Button>
                <Button Height="38" Padding="14,0" Cursor="Hand" Command="{Binding ShortlistSelectedCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#702943" CornerRadius="19" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="+ Shortlist Selected" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
