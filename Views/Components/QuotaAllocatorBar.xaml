<UserControl x:Class="SOLUM_UI.Views.Components.QuotaAllocatorBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <!-- Single Unified Ribbon Container with Upper Configuration Row and Lower Batch Row -->
    <Border Background="#FBF5F7" MinHeight="98" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1" Padding="16,12" Margin="0,0,0,6">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Upper Row: Title, Filters & Configuration -->
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Recommendations Queue" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                    <TextBlock Text="Ranked applicants evaluated by ML vulnerability triage." FontSize="10.5" Foreground="#A06080" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: Actions Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Refresh Queue Button -->
                    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0">
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Height="30" Padding="10,0" Command="{Binding RefreshCommand}" ToolTip="Refresh recommendations queue from server">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Refresh" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#FDF2F4"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                            <Setter Property="Cursor" Value="Wait"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- Export Queue Button -->
                    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0">
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Height="30" Padding="10,0" Command="{Binding ExportAllQueueCommand}" ToolTip="Export all recommendation queue records to CSV">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Export Queue" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#FDF2F4"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                            <Setter Property="Cursor" Value="Wait"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- Run ML Evaluations Button -->
                    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0"
                            Visibility="{Binding CanModifyGrantees, Converter={StaticResource BoolToVis}}">
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Height="30" Padding="10,0" Command="{Binding GenerateRecommendationsCommand}" ToolTip="Run ML triage batch scoring for active applicants">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="Run ML Triage" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#FDF2F4"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                            <Setter Property="Cursor" Value="Wait"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- Cross-Check Filter Dropdown -->
                    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Margin="0,0,8,0">
                        <Button x:Name="FilterDropBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="30" Padding="10,0" Click="FilterDrop_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#702943" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AuditFilterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Cross-Check Filter Popup -->
                    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="6" MinWidth="220">
                            <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                            <StackPanel>
                                <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="All" Padding="10,6">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="All Records" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                                </Border>
                                <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="Clean" Padding="10,6">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="Cleared (Standard)" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                </Border>
                                <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="AuditFilterOpt_Click" Tag="CollegeAge" Padding="10,6">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="City Educ Check (17–24y)" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Grantee Slots, Grant Rate & Total Budget Allocator -->
                    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Padding="8,2" Height="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Grantees:" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Border Background="#FDF5F8" CornerRadius="4" BorderBrush="#D0B8C0" BorderThickness="1" Padding="4,1" Height="22">
                                <TextBox Text="{Binding GranteeSlots, UpdateSourceTrigger=PropertyChanged}" Width="38" Height="18"
                                         FontSize="11" FontWeight="Bold"
                                         BorderThickness="0" Background="Transparent" Foreground="#702943"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Number of target grantee slots"/>
                            </Border>
                            <TextBlock Text="Grant:" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <Border Background="#FDF5F8" CornerRadius="4" BorderBrush="#D0B8C0" BorderThickness="1" Padding="4,1" Height="22">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="₱" FontSize="10.5" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center" Margin="2,0,1,0"/>
                                    <TextBox Text="{Binding GrantAmountPerRecipient, UpdateSourceTrigger=PropertyChanged}" Width="46" Height="18"
                                             FontSize="11" FontWeight="Bold"
                                             BorderThickness="0" Background="Transparent" Foreground="#702943"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Subsidy grant amount per recipient (PHP)"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF0F5" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CommittedBudgetText, StringFormat='Budget: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#702943" ToolTip="Total committed budget = Grantees × Grant Rate"/>
                            </Border>
                            <!-- Save Quota Button -->
                            <Button Command="{Binding SaveQuotaCommand}" IsEnabled="{Binding CanModifyGrantees}" Margin="6,0,0,0" Height="22" Cursor="Hand" ToolTip="Save quota allocations and grant rate">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SaveBtnBg" Background="#702943" CornerRadius="4" Padding="7,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                                      Fill="White" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Save" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SaveBtnBg" Property="Opacity" Value="0.88"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SaveBtnBg" Property="Opacity" Value="0.45"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Lower Row: Batch Select & Bulk Actions Strip (Spaced from Upper Row) -->
            <Grid Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Batch Selection Toggle Button (Always anchored in exact same position) -->
                <Button Grid.Column="0" Height="28" Padding="14,0" Cursor="Hand" Command="{Binding ToggleBatchModeCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#D4A0B0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                                <Setter Property="Background" Value="#702943"/>
                                                <Setter Property="BorderBrush" Value="#702943"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BatchModeButtonText}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#702943"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Alongside: Bulk Operations (Visible when IsBatchMode is True) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                    <!-- Select All Button (Replaces Select Top 100) -->
                    <Button Height="28" Cursor="Hand" Command="{Binding SelectTopNCommand}" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="6" Padding="12,0">
                                    <TextBlock Text="{Binding SelectAllQueueButtonText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#702943"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FDF3F5"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Selected Count Badge -->
                    <Border Background="#EAF6F0" CornerRadius="6" Padding="8,0" Height="28" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCountSummary}" FontSize="10.5" FontWeight="Bold" Foreground="#27AE60"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <!-- Shortlist Selected Button -->
                    <Button Height="28" Cursor="Hand" Command="{Binding ShortlistSelectedCommand}"
                            IsEnabled="{Binding HasQueueSelection}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#702943" CornerRadius="6" Padding="14,0">
                                    <TextBlock Text="Shortlist Selected" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
