<UserControl x:Class="SOLUM_UI.Views.Components.ModalDisqualifiedCandidates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Global Typography Style: Crispy Text Rendering -->
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>

        <SolidColorBrush x:Key="Maroon" Color="#702943"/>
        <SolidColorBrush x:Key="MaroonDark" Color="#5A2037"/>
        <SolidColorBrush x:Key="MaroonSoft" Color="#F8EFF3"/>
        <SolidColorBrush x:Key="MaroonLine" Color="#E3CCD4"/>
        <SolidColorBrush x:Key="Ink" Color="#1F1A1C"/>
        <SolidColorBrush x:Key="Muted" Color="#6F6469"/>
        <SolidColorBrush x:Key="Hairline" Color="#F0E5EA"/>

        <Style x:Key="AuditSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaroonLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Fill="{StaticResource Maroon}" Width="16" Height="16" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Grid.Column="1" Text="Search name, ID, or reason" Foreground="#A99FA4"
                                           FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuditCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaroonLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource MaroonSoft}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource MaroonSoft}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                <Grid Margin="18,0,36,0">
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Data="M7,10L12,15L17,10H7Z" Fill="{StaticResource Maroon}" Stretch="Uniform" Width="10" Height="10" IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource MaroonLine}" BorderThickness="1.5" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Margin="0,6,0,14" Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#702943" BlurRadius="16" ShadowDepth="4" Opacity="0.18"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarPillBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Maroon}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MaroonSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MaroonLine}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReinstateSmallBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaroonLine}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Maroon}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalPageBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaroonLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MaroonSoft}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalCloseIconBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Maroon}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaroonLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MaroonSoft}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Maroon}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="34,0"/>
            <Setter Property="Background" Value="{StaticResource Maroon}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource MaroonDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="1" CornerRadius="3" Background="{StaticResource MaroonLine}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsDisqualifiedModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000">
        <Border Background="White" CornerRadius="20" BorderBrush="{StaticResource Maroon}" BorderThickness="1.5"
                MinWidth="960" MaxWidth="1040" MaxHeight="720" Margin="24"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="30,26,30,26"
                UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.28"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="{StaticResource MaroonSoft}" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12C20,13.85 19.38,15.55 18.32,16.91L7.09,5.68C8.45,4.62 10.15,4 12,4M4,12C4,10.15 4.62,8.45 5.68,7.09L16.91,18.32C15.55,19.38 13.85,20 12,20A8,8 0 0,1 4,12Z"
                              Fill="{StaticResource Maroon}" Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Disqualified &amp; Rejected Candidates Audit Log" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Review statutory disqualifications, reviewer justifications, and audit trails for this cycle." FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEE2E2" CornerRadius="15" Padding="14,0" Height="30" Margin="0,0,14,0" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <TextBlock Text="{Binding DisqualifiedButtonText}" FontSize="11.5" FontWeight="Bold" Foreground="#991B1B" VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource ModalCloseIconBtn}" Command="{Binding CloseDisqualifiedModalCommand}" VerticalAlignment="Center">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding DisqualifiedSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AuditSearchBox}"
                             Margin="0,0,12,0"/>

                    <ComboBox Grid.Column="1"
                              SelectedValue="{Binding DisqualifiedReasonFilter, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Style="{StaticResource AuditCombo}"
                              Width="270" Margin="0,0,12,0">
                        <ComboBoxItem Content="All Reasons" IsSelected="True"/>
                        <ComboBoxItem Content="Ineligible Income / Undisclosed Assets"/>
                        <ComboBoxItem Content="City Educ Scholarship Overlap / Conflict"/>
                        <ComboBoxItem Content="Duplicate / Existing Government Grantee"/>
                        <ComboBoxItem Content="Child Over Age / No Qualified Minor Dependents"/>
                        <ComboBoxItem Content="Falsified Circumstance or Documentation"/>
                        <ComboBoxItem Content="Voluntary Withdrawal by Applicant"/>
                        <ComboBoxItem Content="Other Statutory Disqualification"/>
                    </ComboBox>

                    <Button Grid.Column="2"
                            Command="{Binding RefreshDisqualifiedCommand}"
                            Style="{StaticResource ToolbarPillBtn}"
                            Margin="0,0,12,0"
                            ToolTip="Refresh disqualified records from server">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Command="{Binding ExportDisqualifiedCsvCommand}"
                            Style="{StaticResource ToolbarPillBtn}"
                            ToolTip="Export all matching disqualified candidate records to CSV">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{StaticResource MaroonLine}" BorderThickness="1.5" CornerRadius="16" Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource MaroonSoft}" BorderBrush="{StaticResource MaroonLine}"
                                BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Height="42" Padding="22,0"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="118"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CANDIDATE &amp; ID" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Maroon}"/>
                                <TextBlock Grid.Column="1" Text="DEMOGRAPHICS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Maroon}"/>
                                <TextBlock Grid.Column="2" Text="SCORE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Maroon}"/>
                                <TextBlock Grid.Column="3" Text="DISQUALIFICATION REASON" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Maroon}"/>
                                <TextBlock Grid.Column="4" Text="JUSTIFICATION &amp; AUDIT TRAIL" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Maroon}"/>
                                <TextBlock Grid.Column="5" Text="ACTION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Maroon}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" MinHeight="200" MaxHeight="340">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding PagedDisqualifiedCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RowBd" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="22,12" Background="Transparent" MinHeight="76">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="175"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="118"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SpId}" FontSize="10.5" FontFamily="Consolas" Foreground="#888888" Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Barangay}" FontSize="12" Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10.5" Foreground="#666666" Margin="0,3,0,0">
                                                            <Run Text="{Binding FormattedIncome, Mode=OneWay}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding Dependents, Mode=OneWay}"/>
                                                            <Run Text=" dep."/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding PriorityScore, StringFormat='{}{0:F1}'}" FontSize="13" FontWeight="Bold" Foreground="#333333"/>
                                                        <Border Background="{Binding PriorityBadgeBg}" CornerRadius="8" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Priority}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding PriorityBadgeFg}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Grid.Column="3" Background="{Binding ReasonBadgeBg}" BorderBrush="{Binding ReasonBadgeBorder}" BorderThickness="1"
                                                            CornerRadius="14" Padding="12,6" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding RejectionReason}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ReasonBadgeFg}" TextWrapping="Wrap"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding DisplayNotes}" FontSize="11.5" Foreground="#222222" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayNotes}"/>
                                                        <TextBlock FontSize="10" Foreground="#888888" Margin="0,4,0,0">
                                                            <Run Text="By: "/>
                                                            <Run Text="{Binding DisqualifiedBy, Mode=OneWay}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding FormattedDisqualifiedAt, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="5"
                                                            Style="{StaticResource ReinstateSmallBtn}"
                                                            ToolTip="Restore candidate to active recommendations queue"
                                                            Command="{Binding DataContext.ReinstateCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Reinstate" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#FCF7F9"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32"
                                        Visibility="{Binding HasNoDisqualifiedCandidates, Converter={StaticResource BoolToVis}}">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,22A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12C20,13.85 19.38,15.55 18.32,16.91L7.09,5.68C8.45,4.62 10.15,4 12,4M4,12C4,10.15 4.62,8.45 5.68,7.09L16.91,18.32C15.55,19.38 13.85,20 12,20A8,8 0 0,1 4,12Z"
                                      Fill="#CBD5E1" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock Text="No Disqualified Candidates Found" FontSize="13.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                <TextBlock Text="No candidate records match the current search or rejection filter for this cycle." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                              Fill="#888888" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Disqualified candidates are excluded from quota allocations."
                                   FontSize="11.5" Foreground="#777777" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,24,0">
                        <TextBlock Text="{Binding DisqualifiedPageSummary}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource ModalPageBtn}" Command="{Binding DisqualifiedPrevPageCommand}">
                            <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Border Background="{StaticResource MaroonSoft}" CornerRadius="18" Height="36" MinWidth="64" Padding="16,0" VerticalAlignment="Center" Margin="8,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <TextBlock Text="{Binding DisqualifiedPageNumberLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Maroon}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource ModalPageBtn}" Command="{Binding DisqualifiedNextPageCommand}">
                            <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding CloseDisqualifiedModalCommand}"
                            Style="{StaticResource ModalPrimaryBtn}"
                            Content="Close"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
