<UserControl x:Class="SOLUM_UI.Views.Components.NotificationCardComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Visibility="Collapsed">

    <!-- Compact toast-style notification card.
         Bindable: Title, Message, IsSuccess.
         Visibility and auto-hide are driven by the code-behind. -->

    <Border x:Name="CardBorder" CornerRadius="10" Padding="14,10"
            MinWidth="260" MaxWidth="340"
            Background="#FFFFFF" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.13"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- State dot -->
            <Border Grid.Column="0" x:Name="DotBadge"
                    Width="8" Height="8" CornerRadius="4"
                    VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- Text -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="{Binding Title, ElementName=Root}"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           Foreground="#111111"/>
                <TextBlock x:Name="TxtMessage" Text="{Binding Message, ElementName=Root}"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#555555"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Dismiss button -->
            <Button Grid.Column="2" Width="20" Height="20" Margin="10,0,0,0"
                    Cursor="Hand" Click="Dismiss_Click" VerticalAlignment="Top">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                            <TextBlock Text="&#x2715;" FontSize="9" Foreground="#999999"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0E4E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
