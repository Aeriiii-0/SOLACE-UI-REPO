<UserControl x:Class="SOLUM_UI.Views.Components.CivilStatusListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardContainerStyle}" Padding="16">
        <Grid>
            <StackPanel x:Name="ItemsStackPanel"/>
            <StackPanel x:Name="NoDataPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="No data" Foreground="#7A5C60" FontSize="12" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
