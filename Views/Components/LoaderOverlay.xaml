<UserControl x:Class="SOLUM_UI.Views.Components.LoaderOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Opacity="0"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="OuterArc"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="0" To="360" Duration="0:0:1.1"/>
                    <DoubleAnimation Storyboard.TargetName="InnerArc"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="360" To="0" Duration="0:0:1.7"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <!-- Click-blocking transparent background -->
    <Grid Background="Transparent" IsHitTestVisible="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="170"
                Background="White" BorderBrush="#E8D4DA" BorderThickness="1"
                CornerRadius="16" Padding="30,24,30,22">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="30" ShadowDepth="6" Opacity="0.16" RenderingBias="Quality"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="48" Height="48" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <!-- Track rings -->
                    <Ellipse Width="48" Height="48" Stroke="#F4E8EC" StrokeThickness="4"/>
                    <Ellipse Width="31" Height="31" Stroke="#FAF0F3" StrokeThickness="3"/>
                    <!-- Outer maroon arc -->
                    <Path x:Name="OuterArc" Width="48" Height="48" Stretch="None"
                          Data="M 24,2 A 22,22 0 1 1 2,24"
                          Stroke="#702943" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <!-- Inner pink arc -->
                    <Path x:Name="InnerArc" Width="48" Height="48" Stretch="None"
                          Data="M 24,10 A 14,14 0 1 1 10,24"
                          Stroke="#DF9BB1" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock x:Name="TxtMessage" Text="Loading..." HorizontalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#702943"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
