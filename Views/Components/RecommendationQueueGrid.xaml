<UserControl x:Class="SOLUM_UI.Views.Components.RecommendationQueueGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:c="clr-namespace:SOLUM_UI.Views.Components"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#FAF2F5"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FAF2F5" BorderBrush="#EBD8DE" BorderThickness="0,0,0,1">
                            <Border BorderBrush="#EBD8DE" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextBlock.Foreground="#702943" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="11" TextBlock.FontWeight="SemiBold"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5ECEE"/></Trigger>
                            <Trigger Property="Column" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubRow" TargetType="ListViewItem">
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F2EAEF"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Rectangle x:Name="AccentIndicator" HorizontalAlignment="Left" Width="3" Fill="#27AE60" VerticalAlignment="Stretch"/>
                            <GridViewRowPresenter VerticalAlignment="Stretch" Margin="2,0,2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWithinQuota}" Value="False"><Setter TargetName="AccentIndicator" Property="Fill" Value="#F59E0B"/></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Ribbon -->
        <c:QuotaAllocatorBar Grid.Row="0"/>

        <!-- Main Queue Table Container: Record Management Card Design with Radial Mask -->
        <Border Grid.Row="1" CornerRadius="14" BorderBrush="#E8D4DA" BorderThickness="1.5" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="16" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid x:Name="TableClipGrid">
                <Grid.OpacityMask>
                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="12.5"
                                    Width="{Binding ActualWidth, ElementName=TableClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=TableClipGrid}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ListView (Row 0: Column headers start immediately at top) -->
                <ListView Grid.Row="0" x:Name="QueueListView" ItemsSource="{Binding PagedRecommendations}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SubRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SizeChanged="QueueListView_SizeChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <!-- Col 0: Checkbox Selection (Visible only in Batch Mode) -->
                            <GridViewColumn x:Name="ColSelect" Width="0">
                                <GridViewColumn.Header><TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColSelect}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="0,10"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RowCheckBox_Click"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 1: Clean Rank -->
                            <GridViewColumn x:Name="ColRank" Header="RANK" Width="56">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColRank}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="0,10"><TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontSize="12" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 2: Solo Parent Details -->
                            <GridViewColumn x:Name="ColName" Header="SOLO PARENT" Width="150">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColName}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Barangay}" FontSize="10" Foreground="#666666" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 3: Vulnerability Score & Origin Badge -->
                            <GridViewColumn x:Name="ColScore" Header="SCORE" Width="76">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColScore}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="4,8"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding ScoreLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding ScoreBarColor}" HorizontalAlignment="Center"/><Border Background="{Binding ModelSourceBg}" BorderBrush="{Binding ModelSourceBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Center" ToolTip="{Binding ModelSourceTooltip}"><TextBlock Text="{Binding ModelSourceBadge}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding ModelSourceFg}" HorizontalAlignment="Center"/></Border></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 4: Income -->
                            <GridViewColumn x:Name="ColIncome" Header="INCOME" Width="145">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColIncome}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><TextBlock Text="{Binding IncomeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 5: Care Burden & Dependents -->
                            <GridViewColumn x:Name="ColCare" Header="CARE &amp; DEPENDENTS" Width="135">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColCare}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding MinorsLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937"/><TextBlock Text="{Binding ToddlersLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ToddlersFg}" Margin="0,2,0,0"/><Border Visibility="{Binding HasSpecialNeedsDependent, Converter={StaticResource BoolToVis}}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,3,0,0" HorizontalAlignment="Left"><TextBlock Text="{Binding SpecialNeedsBadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="#1D4ED8"/></Border></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 6: Circumstance -->
                            <GridViewColumn x:Name="ColCircumstance" Header="CIRCUMSTANCE" Width="140">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColCircumstance}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><TextBlock Text="{Binding CircumstanceDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Circumstance}"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 7: Needs and Problems -->
                            <GridViewColumn x:Name="ColNeeds" Header="NEEDS &amp; PROBLEMS" Width="140">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColNeeds}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><TextBlock Text="{Binding NeedsAndProblemsDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding NeedsAndProblems}"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 8: Quick Action Buttons (Final Column - No right vertical divider line) -->
                            <GridViewColumn x:Name="ColAction" Header="ACTIONS" Width="145">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColAction}" Margin="-6,0,-6,0" BorderThickness="0" Padding="0,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Height="26" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" ToolTip="Approve candidate and move to Shortlist &amp; Audit" Command="{Binding DataContext.QuickShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="Shortlist" FontSize="10.5" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DCFCE7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                                    <Button Height="26" Padding="10,0" Cursor="Hand" ToolTip="Disqualify candidate and remove from queue" Command="{Binding DataContext.QuickRejectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="Reject" FontSize="10.5" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                                </StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Integrated Card Footer for Pagination -->
                <Border Grid.Row="1" Background="#FAF6F8" BorderBrush="#EFE4E8" BorderThickness="0,1.2,0,0" Padding="18,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding RecommendationsSummary}" FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontFamily="Segoe UI" FontSize="12" Foreground="#CBD5E1" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding QueuePageSummary}" FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Width="105" Height="34" Cursor="Hand" Command="{Binding QueuePrevPageCommand}" IsEnabled="{Binding CanQueuePrevPage}" ToolTip="Previous page" Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="White" CornerRadius="17" BorderBrush="#E0D0D5" BorderThickness="1.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                                      Fill="#702943" Stretch="Uniform" Width="10" Height="10" Margin="0,0,6,0"/>
                                                <TextBlock Text="Previous" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border Background="#FAF2F5" CornerRadius="14" Padding="14,6"
                                    BorderBrush="#EBD8DE" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueuePageNumberLabel}" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#702943"/>
                            </Border>
                            <Button Width="105" Height="34" Cursor="Hand" Command="{Binding QueueNextPageCommand}" IsEnabled="{Binding CanQueueNextPage}" ToolTip="Next page">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="White" CornerRadius="17" BorderBrush="#E0D0D5" BorderThickness="1.5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Next" FontSize="12" FontWeight="SemiBold" Foreground="#702943"/>
                                                <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                      Fill="#702943" Stretch="Uniform" Width="10" Height="10" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#FAF2F5"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
