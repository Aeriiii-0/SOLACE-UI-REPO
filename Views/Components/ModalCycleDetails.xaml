<UserControl x:Class="SOLUM_UI.Views.Components.ModalCycleDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextFormattingMode="Display">
    <Border Background="White"
            CornerRadius="18"
            BorderBrush="#702943"
            BorderThickness="1.5"
            Width="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="28,24,28,24"
            Margin="24">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.26"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="10" Background="#FDF0F4" BorderBrush="#E8D2DA" BorderThickness="1" Margin="0,0,14,0">
                    <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.9 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                          Fill="#702943" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle" Text="Fiscal Year Cycle Details" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#1F1A1C"/>
                        <Border x:Name="StatusBadge" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="#F3F4F6">
                            <TextBlock x:Name="TxtStatusBadge" Text="ARCHIVED" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#4B5563"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Certified fiscal cycle parameters and allocation ledger summary" FontFamily="Segoe UI" FontSize="11.5" Foreground="#6F6469" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Width="30" Height="30" Cursor="Hand" Click="Close_Click" ToolTip="Close" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F9F5F7" CornerRadius="15" BorderBrush="#EDE2E6" BorderThickness="1">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#6F6469" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#FCE8EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Height="1" Background="#F0E5EA" Margin="0,0,0,18"/>

            <!-- Period & Identity Card -->
            <Border Background="#FBF5F7" BorderBrush="#E8D2DA" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FISCAL YEAR" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock x:Name="TxtFiscalYear" Text="FY 2025" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SEMESTER / CYCLE" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock x:Name="TxtSemester" Text="1st Semester" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PERIOD COVERAGE" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock x:Name="TxtDateRange" Text="Jan 2025 – Jun 2025" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Budget & Allocation Breakdown -->
            <TextBlock Text="BUDGET &amp; ALLOCATION PARAMETERS" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#6F6469" Margin="2,0,0,8"/>
            <Border Background="White" BorderBrush="#EDE2E6" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Allocated Slots" FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"/>
                        <TextBlock x:Name="TxtAllocatedSlots" Text="100" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Grant Per Recipient" FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"/>
                        <TextBlock x:Name="TxtPerGranteeAmount" Text="₱1,000.00" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#5C1D38" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Total Cycle Budget" FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"/>
                        <TextBlock x:Name="TxtTotalBudget" Text="₱100,000.00" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#166534" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Disbursement & Outcome Summary -->
            <TextBlock Text="DISBURSEMENT &amp; AUDIT OUTCOME" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#6F6469" Margin="2,0,0,8"/>
            <Border Background="White" BorderBrush="#EDE2E6" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Confirmed Grantees" FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"/>
                        <TextBlock x:Name="TxtConfirmedCount" Text="0" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#166534" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Remaining Slots" FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"/>
                        <TextBlock x:Name="TxtRemainingSlots" Text="0" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Disqualified Records" FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"/>
                        <TextBlock x:Name="TxtDisqualifiedCount" Text="0" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#B91C1C" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid>
                <TextBlock x:Name="TxtFooterNote"
                           Text="Completed historical cycles are certified and locked for audit."
                           FontFamily="Segoe UI" FontSize="11" Foreground="#6F6469"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="Close" Height="36" Padding="22,0" HorizontalAlignment="Right" Cursor="Hand" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#5C1D38" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#702943"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
