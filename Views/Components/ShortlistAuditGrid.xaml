<UserControl x:Class="SOLUM_UI.Views.Components.ShortlistAuditGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FBF5F7"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBg" Background="#FBF5F7" BorderBrush="#702943" BorderThickness="0,0,0,1">
                            <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextBlock.Foreground="#702943"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelRow" TargetType="ListViewItem">
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="OuterBorder" Background="White" BorderBrush="#EFE5E8" BorderThickness="0,0,0,1">
                            <Border x:Name="AccentBorder" BorderThickness="4,0,0,0" BorderBrush="#27AE60" Background="Transparent">
                                <GridViewRowPresenter VerticalAlignment="Center" Margin="0,6"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWaitlisted}" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="#F59E0B"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AccentBorder" Property="Background" Value="#FDF0F3"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="AccentBorder" Property="Background" Value="#F5E2E8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Bar -->
        <Border Grid.Row="0" Background="#FBF5F7" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Shortlisted Candidates for Audit &amp; Verification" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                    <TextBlock Text="Audit 4Ps overlap &amp; City Educ scholarship records before final grant confirmation." FontFamily="Segoe UI" FontSize="11" Foreground="#A06080" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Search Box for Tab 2 Audit -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Height="34" Margin="18,0,14,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="10,0,6,0" VerticalAlignment="Center" Foreground="#A06080"/>
                        <TextBox Grid.Column="1" Text="{Binding ShortlistSearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="11.5" FontFamily="Segoe UI" Foreground="#1F2937" Padding="0,0,8,0" ToolTip="Search shortlist by name, SP ID, 4Ps, or college-age keywords"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#FFF0F5" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tab2QuotaSummary}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                </Border>
                <Button Grid.Column="3" Height="34" Padding="14,0" Cursor="Hand" Command="{Binding ExportCityEducCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#702943" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="📥 Export City Educ Roster (17–24 yrs)" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Shortlist Table -->
        <Border Grid.Row="1" BorderBrush="#702943" BorderThickness="1.5" ClipToBounds="True" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EAF6F0" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#27AE60" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Within Budget" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#27AE60" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ShortlistSummary}" FontFamily="Segoe UI" FontSize="11" Foreground="#555555" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
                <ListView x:Name="ShortlistListView" Grid.Row="1" ItemsSource="{Binding FilteredShortlistRows}"
                          BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SelRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SizeChanged="ShortlistListView_SizeChanged" Margin="0,4,0,0">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <!-- Col 0: Rank -->
                            <GridViewColumn x:Name="ColRank" Header="RANK" Width="48">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontSize="12" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 1: SP ID -->
                            <GridViewColumn x:Name="ColSpId" Header="SP ID" Width="80">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding SpId}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 2: Solo Parent Details (Name + Barangay stacked) -->
                            <GridViewColumn x:Name="ColName" Header="SOLO PARENT" Width="160">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0" Padding="8,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Barangay}" FontSize="10" Foreground="#666666" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 3: Score -->
                            <GridViewColumn x:Name="ColScore" Header="SCORE" Width="68">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0" Padding="4,0">
                                        <TextBlock Text="{Binding ScoreLabel}" FontSize="14" FontWeight="Bold" Foreground="{Binding ScoreBarColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 4: Cross-Check Column (Clean Text, No Badges) -->
                            <GridViewColumn x:Name="ColCrossCheck" Header="CROSS-CHECK" Width="125">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0" Padding="8,0">
                                        <TextBlock Text="{Binding CrossCheckText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CrossCheckFg}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 5: Compliance Detail (Clean Text, NOT a badge) -->
                            <GridViewColumn x:Name="ColCompliance" Header="AUDIT &amp; COMPLIANCE DETAIL" Width="280">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0" Padding="8,0">
                                        <TextBlock Text="{Binding ComplianceRemark}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ComplianceRemarkFg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 6: Quota Status (Shortlisted vs Waitlisted) -->
                            <GridViewColumn x:Name="ColStatus" Header="STATUS" Width="95">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <Border BorderBrush="#D4A0B0" BorderThickness="0,0,1,0" Padding="6,0">
                                        <Border CornerRadius="10" Padding="10,3" Background="{Binding RankBg}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RankFg}"/>
                                        </Border>
                                    </Border>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col 7: Actions (Confirm ✓, Reject ✕, Details ▸) -->
                            <GridViewColumn x:Name="ColAction" Header="ACTIONS" Width="108">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Confirm Button (✓) -->
                                        <Button Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" ToolTip="Confirm Grantee (Promote to Final Grantees)"
                                                Command="{Binding DataContext.ConfirmShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#EAF6F0" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="13">
                                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DCFCE7"/></Trigger></ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Reject Button (✕) -->
                                        <Button Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" ToolTip="Reject &amp; Return to Recommendations Queue"
                                                Command="{Binding DataContext.RejectShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="13">
                                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/></Trigger></ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Details Button (▸) -->
                                        <Button Width="26" Height="26" Cursor="Hand" ToolTip="Review Details"
                                                Command="{Binding DataContext.OpenExplainDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#702943" CornerRadius="13">
                                                        <TextBlock Text="▸" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
