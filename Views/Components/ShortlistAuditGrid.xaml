<UserControl x:Class="SOLUM_UI.Views.Components.ShortlistAuditGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#FAF2F5"/><Setter Property="Foreground" Value="#702943"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="4,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FAF2F5" BorderBrush="#EBD8DE" BorderThickness="0,0,0,1">
                            <Border BorderBrush="#EBD8DE" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextBlock.Foreground="#702943" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="11" TextBlock.FontWeight="SemiBold"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5ECEE"/></Trigger>
                            <Trigger Property="Column" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelRow" TargetType="ListViewItem">
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F2EAEF"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Grid>
                    <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    <Rectangle x:Name="AccentIndicator" HorizontalAlignment="Left" Width="3" Fill="#27AE60" VerticalAlignment="Stretch"/>
                    <GridViewRowPresenter VerticalAlignment="Stretch" Margin="2,0,2,0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFinalGrantee}" Value="False"><Setter TargetName="AccentIndicator" Property="Fill" Value="#F59E0B"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#94A3B8"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Single Unified Ribbon: Upper Configuration & Lower Batch Selection Row -->
        <Border Grid.Row="0" Background="#FBF5F7" MinHeight="98" CornerRadius="12" BorderBrush="#D4A0B0" BorderThickness="1" Padding="16,12" Margin="0,0,0,6">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Shortlisted Candidates for Audit &amp; Verification" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
                        <TextBlock Text="Verify records and manage candidate shortlist before final grant confirmation." FontSize="10.5" Foreground="#A06080" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="FilterDropBtn" Height="30" Padding="10,0" Cursor="Hand" Click="FilterDropBtn_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#702943" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ShortlistAuditFilterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="6" MinWidth="220">
                                <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                                <StackPanel>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="All" Padding="10,6"><TextBlock Text="All Candidates" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/></Border>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="Pending" Padding="10,6"><TextBlock Text="Yet to be Confirmed" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/></Border>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="Confirmed" Padding="10,6"><TextBlock Text="Confirmed Grantees" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/></Border>
                                    <Border Height="1" Background="#F0E0E6" Margin="4,2"/>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="CollegeAge" Padding="10,6"><TextBlock Text="City Educ Scholars (17–24y)" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/></Border>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="Clean" Padding="10,6"><TextBlock Text="Cleared Standard" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/></Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.29,20.42L13.03,15.15C11.9,16 10.46,16.5 9.5,16.5A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="#A06080" Stretch="Uniform" Width="12" Height="12" Margin="8,0,5,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ShortlistSearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="#1F2937" Padding="0,0,6,0" ToolTip="Search shortlist by name, 4Ps, or college-age keywords"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" Background="#FFF0F5" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tab2QuotaSummary}" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/>
                    </Border>
                    <Grid Grid.Column="4">
                        <Button x:Name="ExportDropBtn" Height="30" Padding="12,0" Cursor="Hand" Click="ExportDropBtn_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="#702943" CornerRadius="8" Padding="{TemplateBinding Padding}"><TextBlock Text="Export Rosters ▾" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        </Button>
                        <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="6" MinWidth="250">
                                <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                                <StackPanel>
                                    <Border CornerRadius="6" Cursor="Hand" Padding="10,7" MouseLeftButtonDown="ExportCityEducOpt_Click"><StackPanel><TextBlock Text="City Educ Roster (17–24 yrs)" FontSize="11.5" FontWeight="SemiBold" Foreground="#702943"/><TextBlock Text="Exports college students with names &amp; ages" FontSize="10" Foreground="#888888" Margin="0,1,0,0"/></StackPanel></Border>
                                    <Border Height="1" Background="#F0E0E6" Margin="4,2"/>
                                    <Border CornerRadius="6" Cursor="Hand" Padding="10,7" MouseLeftButtonDown="ExportPantawidOpt_Click"><StackPanel><TextBlock Text="4Ps Beneficiaries List" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8"/><TextBlock Text="Exports all Pantawid Pamilya recipients" FontSize="10" Foreground="#888888" Margin="0,1,0,0"/></StackPanel></Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="28" Padding="14,0" Cursor="Hand" Command="{Binding ToggleShortlistBatchModeCommand}">
                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D4A0B0"/><Style.Triggers><DataTrigger Binding="{Binding IsShortlistBatchMode}" Value="True"><Setter Property="Background" Value="#702943"/><Setter Property="BorderBrush" Value="#702943"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ShortlistBatchModeButtonText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#702943"/><Style.Triggers><DataTrigger Binding="{Binding IsShortlistBatchMode}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></ControlTemplate></Button.Template>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding IsShortlistBatchMode, Converter={StaticResource BoolToVis}}">
                        <Button Height="28" Cursor="Hand" Command="{Binding SelectAllShortlistCommand}" Margin="0,0,6,0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="White" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="6" Padding="12,0"><TextBlock Text="{Binding SelectAllShortlistButtonText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FAF0F3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                        <Border Background="#FDF0F3" CornerRadius="6" Padding="8,0" Height="28" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasShortlistSelection, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding ShortlistBatchActionLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border>
                        <Button Height="28" Cursor="Hand" Command="{Binding BatchConfirmShortlistCommand}" IsEnabled="{Binding HasShortlistSelection}" Margin="0,0,6,0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="#27AE60" CornerRadius="6" Padding="14,0"><TextBlock Text="Confirm Selected" FontSize="10.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                        <Button Height="28" Cursor="Hand" Command="{Binding BatchRevokeShortlistCommand}" IsEnabled="{Binding HasShortlistSelection}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="#E11D48" CornerRadius="6" Padding="14,0"><TextBlock Text="Revoke Selected" FontSize="10.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Shortlist Table Container: Record Management Card Design with Radial Mask -->
        <Border Grid.Row="1" CornerRadius="14" BorderBrush="#E8D4DA" BorderThickness="1.5" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="16" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid x:Name="TableClipGrid">
                <Grid.OpacityMask>
                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="12.5"
                                    Width="{Binding ActualWidth, ElementName=TableClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=TableClipGrid}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>

                <!-- ListView (Row 0: Column headers start immediately at top) -->
                <ListView x:Name="ShortlistListView" Grid.Row="0" ItemsSource="{Binding PagedShortlistRows}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SelRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SizeChanged="ShortlistListView_SizeChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <GridViewColumn x:Name="ColSelect" Width="0">
                                <GridViewColumn.Header><TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColSelect}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="0,10"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RowCheckBox_Click"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColRank" Header="RANK" Width="56">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColRank}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="0,10"><TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontSize="12" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColName" Header="SOLO PARENT" Width="150">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColName}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Barangay}" FontSize="10" Foreground="#666666" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColScore" Header="SCORE" Width="76">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColScore}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="4,8"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding ScoreLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding ScoreBarColor}" HorizontalAlignment="Center"/><Border Background="{Binding ModelSourceBg}" BorderBrush="{Binding ModelSourceBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,2,0,0" ToolTip="{Binding ModelSourceTooltip}"><TextBlock Text="{Binding ModelSourceBadge}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding ModelSourceFg}" HorizontalAlignment="Center"/></Border></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColCrossCheck" Header="CROSS-CHECK" Width="110">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColCrossCheck}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Text="{Binding CrossCheckText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CrossCheckFg}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColCompliance" Header="AUDIT &amp; COMPLIANCE DETAIL" Width="280">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColCompliance}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,8"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DependantsDetailLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScholarshipEligibilityNotice}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ScholarshipEligibilityFg}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColValidUntil" Header="VALID UNTIL" Width="95">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColValidUntil}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Text="{Binding ValidUntilFormatted}" FontSize="11" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColStatus" Header="STATUS" Width="90">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColStatus}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="6,10"><Border CornerRadius="10" Padding="8,2" Background="{Binding RankBg}" HorizontalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RankFg}"/></Border></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- ColAction: Final column - No trailing vertical divider line -->
                            <GridViewColumn x:Name="ColAction" Header="ACTIONS" Width="150">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColAction}" Margin="-6,0,-6,0" BorderThickness="0" Padding="0,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Height="26" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding ConfirmButtonToolTip}" Command="{Binding DataContext.ConfirmShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{Binding ConfirmButtonBg}" BorderBrush="{Binding ConfirmButtonBorder}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="{Binding ConfirmButtonText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ConfirmButtonFg}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border></ControlTemplate></Button.Template></Button>
                                    <Button Height="26" Padding="10,0" Cursor="Hand" ToolTip="Revoke Grant / Selection" Command="{Binding DataContext.RevokeShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="#FFF1F2" BorderBrush="#FDA4AF" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="Revoke" FontSize="10.5" FontWeight="SemiBold" Foreground="#E11D48" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border></ControlTemplate></Button.Template></Button>
                                </StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Pagination Footer (Row 1: Combined live stats with page numbers) -->
                <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#EBD8DE" BorderThickness="0,1,0,0" Height="42" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#27AE60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ShortlistSummary}" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="#CBD5E1" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ShortlistPageSummary}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PagerBtn}" Margin="0,0,6,0" Command="{Binding ShortlistPrevPageCommand}" IsEnabled="{Binding CanShortlistPrevPage}" ToolTip="Previous page">
                                <TextBlock Text="‹ Previous" FontSize="10.5" FontWeight="SemiBold"/>
                            </Button>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShortlistPageNumberLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#702943"/>
                            </Border>
                            <Button Style="{StaticResource PagerBtn}" Command="{Binding ShortlistNextPageCommand}" IsEnabled="{Binding CanShortlistNextPage}" ToolTip="Next page">
                                <TextBlock Text="Next ›" FontSize="10.5" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
