<UserControl x:Class="SOLUM_UI.Views.Components.ShortlistAuditGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <!-- Reusable Sleek Translucent Maroon ScrollBar -->
        <Style x:Key="SolumScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#702943" CornerRadius="2" Opacity="0.22"
                                Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="0.80"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/><Setter TargetName="ThumbBorder" Property="Background" Value="#5C2036"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Stretch">
                                        <Track.Thumb><Thumb Style="{StaticResource SolumScrollBarThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Width" Value="7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" HorizontalAlignment="Stretch">
                                        <Track.Thumb><Thumb Style="{StaticResource SolumScrollBarThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Height" Value="7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#FAF2F5"/><Setter Property="Foreground" Value="#702943"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="4,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FAF2F5" BorderBrush="#EBD8DE" BorderThickness="0,0,0,1">
                            <Border BorderBrush="#EBD8DE" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextBlock.Foreground="#702943" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="11" TextBlock.FontWeight="SemiBold"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5ECEE"/></Trigger>
                            <Trigger Property="Column" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelRow" TargetType="ListViewItem">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F2EAEF"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Grid>
                    <Border x:Name="RowBg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                        <GridViewRowPresenter VerticalAlignment="Stretch" Margin="0"/>
                </Grid>
                <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#FDF6F8"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBg" Property="Background" Value="#F5E2E8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#94A3B8"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Single Unified Compact Ribbon: Single Row Controls & Batch Selection -->
        <Border Grid.Row="0" Background="#FBF5F7" MinHeight="48" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="14,8" Margin="0,0,0,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Batch Selection Toggle & Bulk Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Height="28" Padding="14,0" Cursor="Hand" Command="{Binding ToggleShortlistBatchModeCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#D4A0B0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShortlistBatchMode}" Value="True">
                                                    <Setter Property="Background" Value="#702943"/>
                                                    <Setter Property="BorderBrush" Value="#702943"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ShortlistBatchModeButtonText}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#702943"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShortlistBatchMode}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Alongside: Bulk Operations (Visible when IsShortlistBatchMode is True) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                Visibility="{Binding IsShortlistBatchMode, Converter={StaticResource BoolToVis}}">
                        <!-- Selected Count Badge (Green styling identical to Recommendations Queue) -->
                        <Border Background="#EAF6F0" CornerRadius="6" Padding="8,0" Height="28" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShortlistBatchActionLabel}" FontSize="10.5" FontWeight="Bold" Foreground="#27AE60"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </Border>

                        <!-- Confirm Selected Button -->
                        <Button Height="28" Cursor="Hand" Command="{Binding BatchConfirmShortlistCommand}"
                                IsEnabled="{Binding HasShortlistSelection}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="6" Padding="14,0">
                                        <TextBlock Text="Confirm Selected" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#853250"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Revoke Selected Button -->
                        <Button Height="28" Cursor="Hand" Command="{Binding BatchRevokeShortlistCommand}"
                                IsEnabled="{Binding HasShortlistSelection}" Margin="6,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="6" Padding="14,0">
                                        <TextBlock Text="Revoke Selected" FontSize="10.5" FontWeight="SemiBold" Foreground="#702943"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FDF2F4"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Search Bar -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1" Height="30" Margin="14,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.29,20.42L13.03,15.15C11.9,16 10.46,16.5 9.5,16.5A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="#A06080" Stretch="Uniform" Width="12" Height="12" Margin="8,0,5,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ShortlistSearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="#1F2937" Padding="0,0,6,0" ToolTip="Search shortlist by name, 4Ps, or college-age keywords"/>
                    </Grid>
                </Border>

                <!-- Right: Filters, Status & Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filter Dropdown -->
                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="FilterDropBtn" Height="30" Padding="10,0" Cursor="Hand" Click="FilterDropBtn_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#702943" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ShortlistAuditFilterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="6" MinWidth="220">
                                <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                                <StackPanel>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="All" Padding="10,6"><TextBlock Text="All Candidates" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/></Border>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="Pending" Padding="10,6"><TextBlock Text="Yet to be Confirmed" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/></Border>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="Confirmed" Padding="10,6"><TextBlock Text="Confirmed Grantees" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/></Border>
                                    <Border Height="1" Background="#F0E0E6" Margin="4,2"/>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="CollegeAge" Padding="10,6"><TextBlock Text="City Educ Scholars (17–24y)" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/></Border>
                                    <Border CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="FilterOpt_Click" Tag="Clean" Padding="10,6"><TextBlock Text="Cleared Standard" FontSize="11" FontWeight="SemiBold" Foreground="#702943"/></Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Export Dropdown (Clean White & Maroon Border to match Export Queue) -->
                    <Grid>
                        <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#D4A0B0" BorderThickness="1">
                            <Button x:Name="ExportDropBtn" Background="Transparent" BorderThickness="0" Height="30" Padding="12,0" Cursor="Hand" Click="ExportDropBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Export Rosters ▾" FontSize="11" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnBorder" Property="Background" Value="#FDF2F4"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                        <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportDropBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1" Padding="6" MinWidth="250">
                                <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                                <StackPanel>
                                    <Border CornerRadius="6" Cursor="Hand" Padding="10,7" MouseLeftButtonDown="ExportCityEducOpt_Click"><StackPanel><TextBlock Text="City Educ Roster (17–24 yrs)" FontSize="11.5" FontWeight="SemiBold" Foreground="#702943"/><TextBlock Text="Exports college students with names &amp; ages" FontSize="10" Foreground="#888888" Margin="0,1,0,0"/></StackPanel></Border>
                                    <Border Height="1" Background="#F0E0E6" Margin="4,2"/>
                                    <Border CornerRadius="6" Cursor="Hand" Padding="10,7" MouseLeftButtonDown="ExportPantawidOpt_Click"><StackPanel><TextBlock Text="4Ps Beneficiaries List" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8"/><TextBlock Text="Exports all Pantawid Pamilya recipients" FontSize="10" Foreground="#888888" Margin="0,1,0,0"/></StackPanel></Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Shortlist Table Container: Record Management Card Design with Radial Mask -->
        <Border Grid.Row="1" CornerRadius="14" BorderBrush="#E8D4DA" BorderThickness="1.5" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#702943" BlurRadius="16" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid x:Name="TableClipGrid">
                <Grid.OpacityMask>
                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="12.5"
                                    Width="{Binding ActualWidth, ElementName=TableClipGrid}"
                                    Height="{Binding ActualHeight, ElementName=TableClipGrid}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>
                

                <!-- ListView (Row 0: Column headers start immediately at top) -->
                <ListView x:Name="ShortlistListView" ItemsSource="{Binding FilteredShortlistRows}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SelRow}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="ShortlistListView_ScrollChanged" SizeChanged="ShortlistListView_SizeChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                            <GridViewColumn x:Name="ColSelect" Width="0">
                                <GridViewColumn.Header><TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColSelect}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="0,10"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RowCheckBox_Click"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColRank" Header="RANK" Width="56">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColRank}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="0,10"><TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontSize="12" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColName" Header="SOLO PARENT" Width="150">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColName}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#000000" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Barangay}" FontSize="10" Foreground="#666666" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col 3: Vulnerability Score (Transparent cell, clean score, top-right '!' signal for concern/fallback) -->
                            <GridViewColumn x:Name="ColScore" Header="SCORE" Width="78">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColScore}" Margin="-6,0,-6,0"
                                                BorderBrush="#F2EAEF" BorderThickness="0,0,1,0"
                                                Background="Transparent" Padding="4,6"
                                                ToolTip="{Binding ScoreCellTooltip}">
                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ScoreLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding ScoreBarColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Small '!' warning indicator in top-right corner if low confidence or fallback -->
                                                <Border Visibility="{Binding HasAlertSignal, Converter={StaticResource BoolToVis}}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-12,0"
                                                        Background="{Binding AlertSignalBg}" CornerRadius="6" Width="12" Height="12"
                                                        ToolTip="{Binding AlertSignalTooltip}">
                                                    <TextBlock Text="!" FontSize="8.5" FontWeight="Bold" Foreground="{Binding AlertSignalFg}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColCrossCheck" Header="COMPLIANCE FLAGS" Width="135">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColCrossCheck}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Text="{Binding CrossCheckText}" FontSize="11" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col Dependents (Dedicated count column) -->
                            <GridViewColumn x:Name="ColDependents" Header="DEPENDENTS" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColDependents}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="4,10">
                                            <TextBlock Text="{Binding Dependants}" FontSize="12" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col Compliance: Specific flags only, otherwise empty/dash -->
                            <GridViewColumn x:Name="ColCompliance" Header="AUDIT &amp; COMPLIANCE DETAIL" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColCompliance}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="10,8">
                                            <TextBlock Text="{Binding AuditFlagsSummary}" FontSize="10.5" FontWeight="SemiBold" Foreground="#000000" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding AuditFlagsSummary}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColValidUntil" Header="VALID UNTIL" Width="95">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColValidUntil}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="8,10"><TextBlock Text="{Binding ValidUntilFormatted}" FontSize="11" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Col: Solo Parent ID Card Validity (Clean text, no pill) -->
                            <GridViewColumn x:Name="ColCardStatus" Header="VALIDITY" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColCardStatus}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="4,10">
                                            <TextBlock Text="{Binding CardStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CardStatusFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Col: Subsidy Grant Status (Confirmed vs Pending) -->
                            <GridViewColumn x:Name="ColSubsidyStatus" Header="SUBSIDY STATUS" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ActualWidth, ElementName=ColSubsidyStatus}" Margin="-6,0,-6,0" BorderBrush="#F2EAEF" BorderThickness="0,0,1,0" Padding="4,10">
                                            <Border Background="{Binding SubsidyStatusBg}" BorderBrush="{Binding SubsidyStatusBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SubsidyStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding SubsidyStatusFg}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- ColAction: Final column - No trailing vertical divider line -->
                            <GridViewColumn x:Name="ColAction" Header="ACTIONS" Width="150">
                                <GridViewColumn.CellTemplate><DataTemplate><Border Width="{Binding ActualWidth, ElementName=ColAction}" Margin="-6,0,-6,0" BorderThickness="0" Padding="0,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Height="26" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding ConfirmButtonToolTip}" IsEnabled="{Binding DataContext.CanModifyGrantees, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.ConfirmShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{Binding ConfirmButtonBg}" BorderBrush="{Binding ConfirmButtonBorder}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="{Binding ConfirmButtonText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ConfirmButtonFg}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                                    <Button Height="26" Padding="10,0" Cursor="Hand" ToolTip="Revoke Grant / Selection" IsEnabled="{Binding DataContext.CanModifyGrantees, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.RevokeShortlistCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="White" BorderBrush="#D4A0B0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><TextBlock Text="Revoke" FontSize="10.5" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FDF2F4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                                </StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Dynamic Floating Scroll-Down Arrow (Visible only while actively scrolling when more content exists) -->
                <Border x:Name="ScrollHintIndicator" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                        Background="#702943" CornerRadius="12" Width="24" Height="24"
                        Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
                    </Border.Effect>
                    <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                          Fill="White" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>