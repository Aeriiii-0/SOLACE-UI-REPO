<UserControl x:Class="SOLUM_UI.Views.Components.DashboardSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Strictly mirrors DashboardPage.xaml geometry and row definitions -->
    <Grid Margin="18,10,18,12" x:Name="SkeletonRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="290" MaxWidth="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Welcome Banner Skeleton (Spans all 3 columns!) -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" CornerRadius="22" Margin="0,0,0,16"
                BorderBrush="#702943" BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FDF1F5" Offset="0.55"/>
                    <GradientStop Color="#F8DFE8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="34,30,34,30">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Style="{StaticResource SkPill}" Width="260" Height="38" CornerRadius="8" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource SkPill}" Width="330" Height="14" CornerRadius="4"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border Style="{StaticResource SkPill}" Width="85" Height="10" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource SkPill}" Width="145" Height="15" HorizontalAlignment="Right" Margin="0,0,0,7"/>
                        <Border Style="{StaticResource SkPill}" Width="115" Height="22" CornerRadius="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <!-- 88x88 Circle Gauge -->
                    <Border Width="88" Height="88" CornerRadius="44" Background="#F1D9E2" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="34" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="36" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <!-- 38x38 Refresh Button placeholder -->
                    <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#702943" BorderThickness="1" Background="#F8DFE8" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1, Column 0: Left Column (3 KPI Cards + Quarterly Chart + Review Banner) -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 3 KPI Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Card 1: Total Registered -->
                <Border Grid.Column="0" Background="White" CornerRadius="20" BorderBrush="#702943" BorderThickness="1.5" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#FBE3EA" Margin="0,0,12,0"/>
                            <Border Style="{StaticResource SkPill}" Width="95" Height="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="110" Height="42" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource SkPill}" Width="75" Height="12" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SkPill}" Width="90" Height="22" CornerRadius="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <!-- Card 2: Active -->
                <Border Grid.Column="2" Background="White" CornerRadius="20" BorderBrush="#702943" BorderThickness="1.5" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#E3F5EE" Margin="0,0,12,0"/>
                            <Border Style="{StaticResource SkPill}" Width="65" Height="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="100" Height="42" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource SkPill}" Width="80" Height="12" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                        <Border Background="#D3F0E6" CornerRadius="4" Height="8" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
                <!-- Card 3: Inactive -->
                <Border Grid.Column="4" Background="White" CornerRadius="20" BorderBrush="#702943" BorderThickness="1.5" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#FDEBC8" Margin="0,0,12,0"/>
                            <Border Style="{StaticResource SkPill}" Width="70" Height="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="90" Height="42" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource SkPill}" Width="85" Height="12" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                        <Border Background="#FCE8C6" CornerRadius="4" Height="8" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 1: Quarterly Registrations Chart -->
            <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="24,20" Margin="0,0,0,16"
                    BorderBrush="#702943" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Left">
                            <Border Style="{StaticResource SkPill}" Width="180" Height="20" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource SkPill}" Width="90" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <!-- Segment Toggle Placeholder -->
                        <Border HorizontalAlignment="Right" Background="#FBF5F7" CornerRadius="14" BorderBrush="#EBD8DE" BorderThickness="1" Width="170" Height="30"/>
                    </Grid>
                    <!-- Chart Bars -->
                    <Grid Grid.Row="1" MinHeight="170">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="90" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="1" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="120" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="2" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="75" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="3" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="140" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="4" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="110" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="5" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="130" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="6" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="155" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="7" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="85" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="8" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="100" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="9" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="135" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="10" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="115" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="11" Background="#F8DFE8" CornerRadius="4,4,0,0" Width="18" Height="145" VerticalAlignment="Bottom"/>
                        </Grid>
                        <!-- Month labels -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="3" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="4" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="6" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="7" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="8" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="9" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="10" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                            <Border Grid.Column="11" Style="{StaticResource SkPill}" Width="22" Height="9" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Review Expiring Records Banner -->
            <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="20,14"
                    BorderBrush="#702943" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#FDEBC8" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource SkPill}" Width="170" Height="14" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource SkPill}" Width="130" Height="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#E8960C" CornerRadius="12" Width="170" Height="38" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1, Column 2: Right Column (Recent Activity / Audit Logs Sidebar) -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Border Background="White" CornerRadius="20" BorderBrush="#702943" BorderThickness="1.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="18,16,18,8">
                        <Border Style="{StaticResource SkPill}" Width="110" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource SkPill}" Width="65" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Activity Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="10,6,10,0">
                        <StackPanel>
                            <!-- Card 1 -->
                            <Border Background="Transparent" CornerRadius="12" Padding="6,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#FBE3EA" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkPill}" Width="120" Height="12" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource SkPill}" Width="90" Height="10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Card 2 -->
                            <Border Background="Transparent" CornerRadius="12" Padding="6,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#E3F5EE" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkPill}" Width="135" Height="12" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource SkPill}" Width="100" Height="10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Card 3 -->
                            <Border Background="Transparent" CornerRadius="12" Padding="6,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#FDEBC8" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkPill}" Width="110" Height="12" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource SkPill}" Width="85" Height="10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Card 4 -->
                            <Border Background="Transparent" CornerRadius="12" Padding="6,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#FBE3EA" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkPill}" Width="140" Height="12" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource SkPill}" Width="95" Height="10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Card 5 -->
                            <Border Background="Transparent" CornerRadius="12" Padding="6,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#E3F5EE" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkPill}" Width="125" Height="12" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Border Style="{StaticResource SkPill}" Width="90" Height="10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
