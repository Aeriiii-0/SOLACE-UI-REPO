<UserControl x:Class="SOLUM_UI.Views.Components.DashboardSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SkeletonRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: KPI Cards + Monthly Chart + ML Review Banner -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 3 KPI Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Registered -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EDE2E6" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SkPill}" Width="100" Height="10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,12">
                            <Border Style="{StaticResource SkPill}" Width="90" Height="38" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="65" Height="11" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="120" Height="22" CornerRadius="11" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 2: Active Solo Parents -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EDE2E6" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SkPill}" Width="80" Height="10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,12">
                            <Border Style="{StaticResource SkPill}" Width="85" Height="38" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="70" Height="11" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="110" Height="22" CornerRadius="11" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 3: Inactive / Renewals Due -->
                <Border Grid.Column="4" Background="White" CornerRadius="16" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EDE2E6" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SkPill}" Width="110" Height="10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,8,0,12">
                            <Border Style="{StaticResource SkPill}" Width="75" Height="38" HorizontalAlignment="Left" CornerRadius="6"/>
                            <Border Style="{StaticResource SkPill}" Width="80" Height="11" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="130" Height="22" CornerRadius="11" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 1: Monthly Registration Chart Card -->
            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,18" BorderBrush="#EBD8DE" BorderThickness="1.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Border Style="{StaticResource SkPill}" Width="160" Height="16" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkPill}" Width="240" Height="12" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="30,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 12 Bars -->
                        <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="65" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="90" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="2" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="45" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="3" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="110" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="4" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="80" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="5" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="95" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="6" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="60" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="7" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="125" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="8" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="70" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="9" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="85" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="10" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="100" VerticalAlignment="Bottom"/>
                        <Border Grid.Column="11" Background="#EDE2E6" CornerRadius="4,4,0,0" Width="22" Height="50" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: ML Review Banner Skeleton -->
            <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#EBD8DE" BorderThickness="1.5" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#EDE2E6" CornerRadius="20" Width="40" Height="40" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource SkPill}" Width="180" Height="13" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource SkPill}" Width="260" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource SkPill}" Width="80" Height="32" CornerRadius="9" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Column: Recent Activity / Audit Logs Sidebar (Matches real layout!) -->
        <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#EBD8DE" BorderThickness="1.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header: Recent Activity / Audit Logs -->
                <Border Grid.Row="0" Padding="22,20,22,16" BorderBrush="#F0E4E8" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="120" Height="16" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkPill}" Width="80" Height="12" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- List of Log Item Cards (Matching exact 4-line items!) -->
                <StackPanel Grid.Row="1" Margin="18,14,18,0">
                    <!-- Card 1 -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Border Style="{StaticResource SkPill}" Width="140" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="110" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="90" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="120" Height="10" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Border Style="{StaticResource SkPill}" Width="160" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="120" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="85" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="115" Height="10" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Border Style="{StaticResource SkPill}" Width="135" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="105" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="95" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="125" Height="10" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 4 -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Border Style="{StaticResource SkPill}" Width="150" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="115" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="80" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SkPill}" Width="110" Height="10" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer: "View all logs" Button Skeleton -->
                <Border Grid.Row="2" Padding="18,14" BorderBrush="#F0E4E8" BorderThickness="0,1,0,0">
                    <Border Background="#EDE2E6" CornerRadius="9" Height="44" HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
