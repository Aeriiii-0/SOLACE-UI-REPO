<UserControl x:Class="SOLUM_UI.Views.Components.DashboardSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Storyboard pulses placeholder elements smoothly while card backdrops stay 100% solid and crisp -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PulseKpi1" Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseKpi2" Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseKpi3" Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseChart" Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseMl" Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseSidebar" Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Single Unified Grid strictly mirroring DashboardPage.xaml geometry and row definitions -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Welcome Spacer + 3 KPI Cards + Monthly Chart + ML Review Banner -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Welcome Header spacer (75px) -->
                <RowDefinition Height="Auto"/> <!-- Row 1: 3 KPI Cards -->
                <RowDefinition Height="*"/>    <!-- Row 2: Monthly Registrations Chart Card -->
                <RowDefinition Height="Auto"/> <!-- Row 3: ML Review Banner -->
            </Grid.RowDefinitions>

            <!-- Row 0: Welcome Header spacer (Visibility="Hidden" so layout space is reserved identically and real header shows through) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20" Visibility="Hidden">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Welcome back!" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Here's what's happening with your solo parent program today."
                                   FontFamily="Segoe UI" FontSize="14" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                        <Border Height="32" Width="140" Margin="0,0,10,0"/>
                        <Border Width="40" Height="40"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Row 1: 3 KPI Cards (Solid White Cards, Drop Shadow, 1:1 Layout) -->
            <Grid Grid.Row="1" Margin="0,0,0,18" Height="205">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Registered -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="#D8A5AF" BorderThickness="2" Padding="20,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                    </Border.Effect>
                    <Grid x:Name="PulseKpi1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Header Label with Status Dot -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                            <Border Background="#EDE2E6" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SkPill}" Width="100" Height="10"/>
                        </StackPanel>
                        <!-- Primary Metric (48px line height equivalent) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                            <Border Style="{StaticResource SkPill}" Width="100" Height="48" HorizontalAlignment="Left" CornerRadius="8"/>
                            <Border Style="{StaticResource SkPill}" Width="140" Height="12" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Footer Trend Pill -->
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="110" Height="24" CornerRadius="12" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 2: Active Solo Parents -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="#D8A5AF" BorderThickness="2" Padding="20,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                    </Border.Effect>
                    <Grid x:Name="PulseKpi2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Header Label with Status Dot -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                            <Border Background="#EDE2E6" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SkPill}" Width="90" Height="10"/>
                        </StackPanel>
                        <!-- Primary Metric -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                            <Border Style="{StaticResource SkPill}" Width="90" Height="48" HorizontalAlignment="Left" CornerRadius="8"/>
                            <Border Style="{StaticResource SkPill}" Width="130" Height="12" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Footer Trend Pill -->
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="120" Height="24" CornerRadius="12" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- KPI Card 3: Inactive / Renewals Due -->
                <Border Grid.Column="4" Background="White" CornerRadius="16" BorderBrush="#D8A5AF" BorderThickness="2" Padding="20,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                    </Border.Effect>
                    <Grid x:Name="PulseKpi3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Header Label with Status Dot -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                            <Border Background="#EDE2E6" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SkPill}" Width="110" Height="10"/>
                        </StackPanel>
                        <!-- Primary Metric -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                            <Border Style="{StaticResource SkPill}" Width="80" Height="48" HorizontalAlignment="Left" CornerRadius="8"/>
                            <Border Style="{StaticResource SkPill}" Width="120" Height="12" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Footer Trend Pill -->
                        <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="115" Height="24" CornerRadius="12" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Monthly Registrations Chart Card (Matches exact layout, Y-axis 40px column, 12 bars, 32px month labels) -->
            <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,18" BorderBrush="#702943" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
                </Border.Effect>
                <Grid x:Name="PulseChart">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header: Title & Subtitle -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <Border Style="{StaticResource SkPill}" Width="170" Height="16" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource SkPill}" Width="220" Height="12" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Chart Grid: 40px Y-axis labels + 12 Uniform Month Columns -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Y-Axis labels (Margin="0,0,8,32" to align with bottom month labels) -->
                        <Grid Grid.Column="0" Margin="0,0,8,32">
                            <Border Style="{StaticResource SkPill}" Width="26" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Border Style="{StaticResource SkPill}" Width="22" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-10,0,0"/>
                            <Border Style="{StaticResource SkPill}" Width="18" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,32"/>
                            <Border Style="{StaticResource SkPill}" Width="12" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- 12 Month Columns: Each with upper bar area and lower 32px month label row -->
                        <UniformGrid Grid.Column="1" Rows="1">
                            <!-- Jan -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="65" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Feb -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="95" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Mar -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="45" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Apr -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="120" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- May -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="80" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Jun -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="105" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Jul -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="60" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Aug -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="135" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Sep -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="70" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Oct -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="90" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Nov -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="115" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Dec -->
                            <Grid Margin="4,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Border Grid.Row="1" Background="#EDE2E6" CornerRadius="4,4,0,0" Height="55" VerticalAlignment="Bottom"/>
                                <Border Grid.Row="2" Style="{StaticResource SkPill}" Width="20" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: ML Review Banner (Matches solid #702943 card and robot badge layout) -->
            <Border Grid.Row="3" Background="#702943" CornerRadius="14" Padding="20,16">
                <Grid x:Name="PulseMl">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Robot Icon Badge -->
                    <Border Grid.Column="0" Width="44" Height="44" Background="#9B3060" CornerRadius="22" Margin="0,0,16,0">
                        <TextBlock Text="🤖" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Notification Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource SkPill}" Width="280" Height="14" HorizontalAlignment="Left" Margin="0,0,0,6" Background="#A84068"/>
                        <Border Style="{StaticResource SkPill}" Width="380" Height="12" HorizontalAlignment="Left" Background="#8A2850"/>
                    </StackPanel>
                    <!-- Review Button Placeholder -->
                    <Border Grid.Column="2" Background="Transparent" BorderBrush="White" BorderThickness="1.5" CornerRadius="9" Padding="18,10" Opacity="0.8">
                        <Border Style="{StaticResource SkPill}" Width="55" Height="12" Background="#A84068"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Column: Recent Activity / Audit Logs Sidebar (Matches real layout and spans full height!) -->
        <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#D8A5AF" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect Color="#D4A0B0" BlurRadius="16" ShadowDepth="2" Opacity="0.16" Direction="270"/>
            </Border.Effect>
            <Grid x:Name="PulseSidebar">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header: Recent Activity / Audit Logs -->
                <Border Grid.Row="0" Padding="22,20,22,16" BorderBrush="#F0E4E8" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Border Style="{StaticResource SkPill}" Width="120" Height="16" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkPill}" Width="80" Height="12" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- List of Log Item Cards (Matching exact 4-line items!) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,0">
                    <StackPanel>
                        <!-- Card 1 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource SkPill}" Width="140" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="110" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="90" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="120" Height="10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource SkPill}" Width="160" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="120" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="85" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="115" Height="10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource SkPill}" Width="135" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="105" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="95" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="125" Height="10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 4 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource SkPill}" Width="150" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="115" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="80" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="110" Height="10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 5 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource SkPill}" Width="145" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="110" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="90" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="120" Height="10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 6 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E5D8DC" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EDE2E6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource SkPill}" Width="155" Height="11" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="125" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="85" Height="10" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource SkPill}" Width="115" Height="10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: "View all logs" Button Skeleton -->
                <Border Grid.Row="2" Padding="18,14" BorderBrush="#F0E4E8" BorderThickness="0,1,0,0">
                    <Border Background="#EDE2E6" CornerRadius="9" Height="44" HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
