<UserControl x:Class="SOLUM_UI.Views.Components.RecordsAdminToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="FcbStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="#333333"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Bd" Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1.5">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                  <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                    Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                    IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <Path Grid.Column="1" Data="M7,10L12,15L17,10H7Z" Fill="#702943" Stretch="Uniform"
                        Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <ToggleButton Grid.ColumnSpan="2" Focusable="False"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                    ClickMode="Press" Cursor="Hand">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="White" CornerRadius="10" BorderBrush="#D4A0B0" BorderThickness="1.5"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200" Padding="4">
                  <Border.Effect><DropShadowEffect Color="#702943" BlurRadius="14" ShadowDepth="3" Opacity="0.14"/></Border.Effect>
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#702943"/>
                <Setter TargetName="Bd" Property="Background" Value="#FDF5F7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="ItemBg" Background="Transparent" CornerRadius="6" Margin="2,2" Padding="12,8">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#F5E8EC"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#EDD4DC"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="20,16,20,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Multi-field search bar -->
    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="22" BorderBrush="#E0D0D5" BorderThickness="1.5" Margin="0,0,10,0">
      <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="15" ShadowDepth="3" Opacity="0.08"/></Border.Effect>
      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="ID" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center" Margin="14,0,6,0"/>
        <TextBox Grid.Column="1" x:Name="SearchId"
                 Text="{Binding SearchIdText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                 KeyDown="SearchBox_KeyDown">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TextBox">
                    <Grid>
                      <TextBlock Text="e.g. SP-001" Foreground="#C0A8B0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TextBox.Style>
        </TextBox>

        <Rectangle Grid.Column="2" Fill="#E0D0D5" Width="1" Margin="0,10"/>

        <TextBlock Grid.Column="3" Text="NAME" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center" Margin="10,0,6,0"/>
        <TextBox Grid.Column="4" x:Name="SearchName"
                 Text="{Binding SearchNameText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                 KeyDown="SearchBox_KeyDown">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TextBox">
                    <Grid>
                      <TextBlock Text="Search by name..." Foreground="#C0A8B0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TextBox.Style>
        </TextBox>

        <Rectangle Grid.Column="5" Fill="#E0D0D5" Width="1" Margin="0,10"/>

        <TextBlock Grid.Column="6" Text="BARANGAY" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center" Margin="10,0,6,0"/>
        <TextBox Grid.Column="7" x:Name="SearchBarangay"
                 Text="{Binding SearchBarangayText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#333333" VerticalAlignment="Center"
                 KeyDown="SearchBox_KeyDown">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TextBox">
                    <Grid>
                      <TextBlock Text="Search by barangay..." Foreground="#C0A8B0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TextBox.Style>
        </TextBox>

        <Button Grid.Column="8" Width="26" Height="26" Margin="4,0,2,0" Cursor="Hand"
                Visibility="{Binding IsClearSearchVisible, ElementName=Root}"
                Command="{Binding ClearSearchCommand, ElementName=Root}" ToolTip="Clear">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" CornerRadius="13">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                Fill="#C0A0AA" Stretch="Uniform" Width="11" Height="11"/>
        </Button>

        <Button Grid.Column="9" Width="34" Height="34" Margin="2,0,5,0" Cursor="Hand"
                Command="{Binding SearchCommand, ElementName=Root}" ToolTip="Search">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="#702943" CornerRadius="17">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                Fill="White" Stretch="Uniform" Width="14" Height="14"/>
        </Button>
      </Grid>
    </Border>

    <!-- Filter button -->
    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="22" BorderBrush="#E0D0D5" BorderThickness="1.5" Margin="0,0,8,0">
      <Button x:Name="FilterDropBtn" Background="Transparent" BorderThickness="0"
              Cursor="Hand" Height="44" Padding="14,0" Click="FilterDrop_Click">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" CornerRadius="22" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#702943" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="Filter" FontSize="13" FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Border>

    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterDropBtn}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="White" CornerRadius="16" BorderBrush="#E8D4DA" BorderThickness="1.5" Padding="22,20,22,20" MinWidth="300">
        <Border.Effect><DropShadowEffect Color="#702943" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="FILTER RECORDS" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,0,16"/>
          <TextBlock Text="Sex" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
          <ComboBox x:Name="CmbFilterSex" Style="{StaticResource FcbStyle}" Margin="0,0,0,14">
            <ComboBoxItem Content="All" IsSelected="True"/>
            <ComboBoxItem Content="Male"/>
            <ComboBoxItem Content="Female"/>
          </ComboBox>
          <TextBlock Text="Barangay" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
          <ComboBox x:Name="CmbFilterBarangay" Style="{StaticResource FcbStyle}" Margin="0,0,0,14">
            <ComboBoxItem Content="All" IsSelected="True"/>
            <ComboBoxItem Content="Bi&#241;an Poblacion"/><ComboBoxItem Content="Bungahan"/>
            <ComboBoxItem Content="Canlalay"/><ComboBoxItem Content="Casile"/>
            <ComboBoxItem Content="De La Paz"/><ComboBoxItem Content="Langkiwa"/>
            <ComboBoxItem Content="Loma"/><ComboBoxItem Content="Malaban"/>
            <ComboBoxItem Content="Malamig"/><ComboBoxItem Content="Mamplasan"/>
            <ComboBoxItem Content="Platero"/><ComboBoxItem Content="San Antonio"/>
            <ComboBoxItem Content="San Francisco"/><ComboBoxItem Content="San Jose"/>
            <ComboBoxItem Content="San Vicente"/><ComboBoxItem Content="Santo Tomas"/>
            <ComboBoxItem Content="Soro-Soro"/><ComboBoxItem Content="Timbao"/>
            <ComboBoxItem Content="Tubigan"/>
          </ComboBox>
          <TextBlock Text="Status" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
          <ComboBox x:Name="CmbFilterStatus" Style="{StaticResource FcbStyle}" Margin="0,0,0,18">
            <ComboBoxItem Content="All" IsSelected="True"/>
            <ComboBoxItem Content="Valid"/>
            <ComboBoxItem Content="Inactive"/>
          </ComboBox>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Height="42" Cursor="Hand" Click="FilterReset_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="10" BorderBrush="#DCC8CE" BorderThickness="1.5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#702943"/>
            </Button>
            <Button Grid.Column="2" Height="42" Cursor="Hand" Click="FilterApply_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                    <Border.Effect><DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Sort button -->
    <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="22" BorderBrush="#E0D0D5" BorderThickness="1.5" Margin="0,0,10,0">
      <Button x:Name="SortDropBtn" Background="Transparent" BorderThickness="0"
              Cursor="Hand" Width="44" Height="44" Click="SortDrop_Click" ToolTip="Sort">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" CornerRadius="22">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
        <Path Data="M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z" Fill="#702943" Stretch="Uniform" Width="18" Height="18"/>
      </Button>
    </Border>

    <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortDropBtn}"
           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="White" CornerRadius="12" BorderBrush="#E0D0D5" BorderThickness="1" Padding="4">
        <Border.Effect><DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
        <StackPanel MinWidth="160">
          <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Name A-Z">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Text="Name A-Z" FontSize="13" Foreground="#333333" Padding="12,9"/>
          </Border>
          <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Name Z-A">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Text="Name Z-A" FontSize="13" Foreground="#333333" Padding="12,9"/>
          </Border>
          <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Newest">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Text="Newest First" FontSize="13" Foreground="#333333" Padding="12,9"/>
          </Border>
          <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Oldest">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Text="Oldest First" FontSize="13" Foreground="#333333" Padding="12,9"/>
          </Border>
          <Border CornerRadius="8" Cursor="Hand" MouseLeftButtonDown="SortOpt_Click" Tag="Barangay">
            <Border.Style><Style TargetType="Border"><Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FDF3F5"/></Trigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Text="By Barangay" FontSize="13" Foreground="#333333" Padding="12,9"/>
          </Border>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Add New Record -->
    <Button Grid.Column="3" Height="44" Padding="18,0" Margin="0,0,10,0" Cursor="Hand"
            Command="{Binding AddRecordCommand, ElementName=Root}">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border Background="#702943" CornerRadius="22" Padding="{TemplateBinding Padding}">
            <Border.Effect><DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <TextBlock Text="+ Add New Record" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
    </Button>

    <!-- Refresh -->
    <Button Grid.Column="5" Width="44" Height="44" Margin="6,0,0,0"
            BorderThickness="0" Background="#FFFFFF" Cursor="Hand" ToolTip="Refresh records"
            Command="{Binding RefreshCommand, ElementName=Root}"
            IsEnabled="{Binding IsRefreshEnabled, ElementName=Root}">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="RefreshBg" Background="{TemplateBinding Background}"
                  CornerRadius="22" BorderBrush="#E0D0D5" BorderThickness="1.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RefreshBg" Property="Background" Value="#F5ECEE"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
            Fill="#702943" Stretch="Uniform" Width="16" Height="16"/>
    </Button>
  </Grid>
</UserControl>