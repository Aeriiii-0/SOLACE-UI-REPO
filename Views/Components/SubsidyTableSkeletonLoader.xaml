                        <TextBlock Grid.Column="1" Text="SOLO PARENT" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="SCORE" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="DEPENDENTS" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="INCOME" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="CARE &amp; DEPENDENTS" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="6" Text="CIRCUMSTANCE" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="7" Text="NEEDS &amp; PROBLEMS" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="8" Text="VALIDITY" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="VALID UNTIL" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Text="ACTIONS" Style="{StaticResource SkHeaderText}" HorizontalAlignment="Center"/>
                    </Grid>
