<UserControl x:Class="SOLUM_UI.Views.Components.SubsidyTableSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRowsContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SkColHeader" TargetType="Border">
            <Setter Property="Background" Value="#FBF5F7"/>
            <Setter Property="BorderBrush" Value="#5C1D38"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="SkHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C1D38"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SkeletonRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Skeleton Control / Search Ribbon (matches RecommendationQueueGrid exactly) -->
        <Border Grid.Row="0" Background="#FBF5F7" MinHeight="48" CornerRadius="10"
                BorderBrush="#5C1D38" BorderThickness="1" Padding="14,8" Margin="0,-15,0,17">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Search box placeholder -->
                <Border Grid.Column="0" Background="White" CornerRadius="20"
                        BorderBrush="#D4B6C2" BorderThickness="1.2" Height="34" Margin="0,0,10,0">
                    <Grid VerticalAlignment="Center" Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="#A06080" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource SkPill}" Width="180" Height="12" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
                <!-- Action pills placeholder -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SkPill}" Width="80" Height="30" CornerRadius="15" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource SkPill}" Width="100" Height="30" CornerRadius="15"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Skeleton Table Card (matches RecommendationQueueGrid Table Container exactly) -->
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="#5C1D38" BorderThickness="1" Background="White" Margin="0,-12,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#5C1D38" BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <!-- Table Header Row (matches exact columns of RecommendationQueueGrid) -->
