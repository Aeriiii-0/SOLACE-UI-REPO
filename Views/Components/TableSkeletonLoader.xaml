<UserControl x:Class="SOLUM_UI.Views.Components.TableSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRowsContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SkColHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EBD8DE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="SkColHeaderCenter" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EBD8DE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="SkHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SkCellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F2EAEF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="SkCellBorderCenter" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F2EAEF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Static Table Header Preview (matches GvHeader style) -->
        <Grid Grid.Row="0" Background="#FAF2F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SkColHeader}">
                <TextBlock Text="NAME" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SkColHeader}">
                <TextBlock Text="BARANGAY" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="SEX" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SkColHeader}">
                <TextBlock Text="CIVIL STATUS" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="DATE OF BIRTH" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="LAST UPDATED" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="VALID UNTIL" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="7" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="STATUS" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="8" BorderBrush="#EBD8DE" BorderThickness="0,0,0,1">
                <TextBlock Text="ACTIONS" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
        </Grid>

