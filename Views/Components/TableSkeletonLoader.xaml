<UserControl x:Class="SOLUM_UI.Views.Components.TableSkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonRowsContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.32"
                             Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SkColHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EBD8DE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="SkColHeaderCenter" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EBD8DE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="SkHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SkCellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F2EAEF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="SkCellBorderCenter" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F2EAEF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="SkPill" TargetType="Border">
            <Setter Property="Background" Value="#EDE2E6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Static Table Header Preview (matches 5-column GvHeader style) -->
        <Grid Grid.Row="0" Background="#FAF2F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="135"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SkColHeader}">
                <TextBlock Text="NAME" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SkColHeader}">
                <TextBlock Text="BARANGAY" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="VALID UNTIL" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SkColHeaderCenter}">
                <TextBlock Text="STATUS" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
            <Border Grid.Column="4" BorderBrush="#EBD8DE" BorderThickness="0,0,0,1">
                <TextBlock Text="ACTIONS" HorizontalAlignment="Center" Style="{StaticResource SkHeaderText}"/>
            </Border>
        </Grid>

        <!-- Shimmering Skeleton Data Rows (5 columns) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SkeletonRowsContainer">

                <!-- Row 1 -->
                <Grid Height="44" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SkCellBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="150" HorizontalAlignment="Left" Height="13"/>
                            <Border Style="{StaticResource SkPill}" Width="60" HorizontalAlignment="Left" Height="9" Margin="0,3,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SkCellBorder}">
                        <Border Style="{StaticResource SkPill}" Width="95" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SkCellBorderCenter}">
                        <Border Style="{StaticResource SkPill}" Width="75" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SkCellBorderCenter}">
                        <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2 -->
                <Grid Height="44" Background="#FCF9FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SkCellBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="125" HorizontalAlignment="Left" Height="13"/>
                            <Border Style="{StaticResource SkPill}" Width="55" HorizontalAlignment="Left" Height="9" Margin="0,3,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SkCellBorder}">
                        <Border Style="{StaticResource SkPill}" Width="80" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SkCellBorderCenter}">
                        <Border Style="{StaticResource SkPill}" Width="70" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SkCellBorderCenter}">
                        <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 3 -->
                <Grid Height="44" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SkCellBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="165" HorizontalAlignment="Left" Height="13"/>
                            <Border Style="{StaticResource SkPill}" Width="65" HorizontalAlignment="Left" Height="9" Margin="0,3,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SkCellBorder}">
                        <Border Style="{StaticResource SkPill}" Width="105" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SkCellBorderCenter}">
                        <Border Style="{StaticResource SkPill}" Width="72" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SkCellBorderCenter}">
                        <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 4 -->
                <Grid Height="44" Background="#FCF9FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SkCellBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="140" HorizontalAlignment="Left" Height="13"/>
                            <Border Style="{StaticResource SkPill}" Width="50" HorizontalAlignment="Left" Height="9" Margin="0,3,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SkCellBorder}">
                        <Border Style="{StaticResource SkPill}" Width="85" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SkCellBorderCenter}">
                        <Border Style="{StaticResource SkPill}" Width="78" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SkCellBorderCenter}">
                        <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 5 -->
                <Grid Height="44" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SkCellBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="130" HorizontalAlignment="Left" Height="13"/>
                            <Border Style="{StaticResource SkPill}" Width="55" HorizontalAlignment="Left" Height="9" Margin="0,3,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SkCellBorder}">
                        <Border Style="{StaticResource SkPill}" Width="90" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SkCellBorderCenter}">
                        <Border Style="{StaticResource SkPill}" Width="74" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SkCellBorderCenter}">
                        <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 6 -->
                <Grid Height="44" Background="#FCF9FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SkCellBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SkPill}" Width="155" HorizontalAlignment="Left" Height="13"/>
                            <Border Style="{StaticResource SkPill}" Width="60" HorizontalAlignment="Left" Height="9" Margin="0,3,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SkCellBorder}">
                        <Border Style="{StaticResource SkPill}" Width="75" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SkCellBorderCenter}">
                        <Border Style="{StaticResource SkPill}" Width="72" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource SkCellBorderCenter}">
                        <Border Background="#EDE2E6" CornerRadius="11" Height="22" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                            <Border Background="#EDE2E6" CornerRadius="8" Width="30" Height="30" Margin="3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>