<Window x:Class="SOLUM_UI.RenewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renew Record"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        Width="820" Height="700">

    <Window.Resources>

        <!-- ── Shared text styles ── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="Margin" Value="2,3,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ── Editable text box ── -->
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#C0A0AA"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#A08090"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2F2F2"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Combo box ── -->
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="ComboBg" Background="Transparent" BorderThickness="0">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#BBBBBB" FontSize="13"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ── Buttons ── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Card container ── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#EDE0E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ── Locked field display ── -->
        <Style x:Key="LockedValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- ── Review row ── -->
        <Style x:Key="ReviewLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="ReviewValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ReviewValueChanged" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </Window.Resources>

    <!-- Dimmed backdrop -->
    <Border Background="#44000000">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>

            <Border x:Name="DialogShell" Background="White" CornerRadius="16"
                    ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- header -->
                        <RowDefinition Height="Auto"/><!-- step bar -->
                        <RowDefinition Height="*"/>  <!-- content -->
                        <RowDefinition Height="Auto"/><!-- footer -->
                    </Grid.RowDefinitions>

                    <!-- ── HEADER ── -->
                    <Border Grid.Row="0" Background="White" CornerRadius="16,16,0,0"
                            BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="32,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="TxtDialogTitle" Text="Renew Record"
                                           FontSize="19" FontWeight="Bold" Foreground="#111111"/>
                                <TextBlock x:Name="TxtSubtitle" Text="Step 1 of 2 — Update Information"
                                           FontSize="13" Foreground="#666666" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="32" Height="32" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBg" Background="Transparent" CornerRadius="16">
                                            <TextBlock Text="✕" FontSize="14" Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBg" Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── STEP INDICATOR ── -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1" Padding="32,12,32,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step1Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#702943">
                                    <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Update Info" FontSize="13" FontWeight="Bold" Foreground="#702943"/>
                                    <TextBlock Text="Editable fields only" FontSize="11" Foreground="#888888"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Height="2" Background="#E0E0E0"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Step2Dot" Width="30" Height="30" CornerRadius="15"
                                        Background="#E0E0E0">
                                    <TextBlock x:Name="Step2DotLabel" Text="2" Foreground="#AAAAAA"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Step2Title" Text="Review &amp; Confirm"
                                               FontSize="13" FontWeight="Bold" Foreground="#AAAAAA"/>
                                    <TextBlock Text="Verify changes &amp; validity" FontSize="11" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── CONTENT ── -->
                    <Grid Grid.Row="2">

                        <!-- STEP 1: EDIT FORM -->
                        <ScrollViewer x:Name="PanelStep1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9"
                                      Visibility="Visible">
                            <StackPanel Margin="32,16,32,20">

                                <!-- Locked identity banner -->
                                <Border Background="#FFF7F9" CornerRadius="10"
                                        BorderBrush="#EDD0DA" BorderThickness="1"
                                        Padding="16,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,7H13V9H11V7M11,11H13V17H11V11Z"
                                              Fill="#702943" Stretch="Uniform" Width="14" Height="14"
                                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                   FontSize="12" Foreground="#702943"
                                                   TextWrapping="Wrap">
                                            <Run FontWeight="Bold">Identity fields are locked.</Run>
                                            <Run>Name, date of birth, and ID cannot be changed during renewal. To correct identity information, use Edit Record.</Run>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- CARD: IDENTITY (locked display) -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="IDENTITY — LOCKED" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="LAST NAME" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtLastName" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                <TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtFirstName" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                                <TextBlock Text="MIDDLE NAME" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMiddleName" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="EXT." Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtExtension" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="DATE OF BIRTH" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtDOB" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                <TextBlock Text="SEX" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtSex" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="PHILSYS ID" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtPhilSys" Style="{StaticResource FormBox}"
                                                         IsReadOnly="True" Focusable="False" Cursor="Arrow"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD: UPDATABLE FIELDS -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="UPDATE THESE FIELDS AS NEEDED" Style="{StaticResource SectionLabel}"/>
                                        </Border>

                                        <!-- Civil status + employment -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="Civil Status *" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbCivilStatus" Style="{StaticResource FormCombo}"
                                                              SelectionChanged="CmbCivilStatus_SelectionChanged">
                                                        <ComboBoxItem Content="Single"/>
                                                        <ComboBoxItem Content="Married"/>
                                                        <ComboBoxItem Content="Widowed"/>
                                                        <ComboBoxItem Content="Separated"/>
                                                        <ComboBoxItem Content="Divorced"/>
                                                        <ComboBoxItem Content="Annulled"/>
                                                    </ComboBox>
                                                </Border>
                                                <TextBlock x:Name="ErrCivilStatus" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                <TextBlock Text="Monthly Income" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtMonthlyIncome" Style="{StaticResource FormBox}"
                                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Employment Status" Style="{StaticResource FieldLabel}"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="42">
                                                    <RadioButton x:Name="ChkEmployed"     Content="Employed"
                                                                 FontSize="13" Foreground="#222222"
                                                                 Margin="0,0,18,0" VerticalContentAlignment="Center"
                                                                 GroupName="RenewEmployment"/>
                                                    <RadioButton x:Name="ChkSelfEmployed" Content="Self-Employed"
                                                                 FontSize="13" Foreground="#222222"
                                                                 Margin="0,0,18,0" VerticalContentAlignment="Center"
                                                                 GroupName="RenewEmployment"/>
                                                    <RadioButton x:Name="ChkNotEmployed"  Content="Not Employed"
                                                                 FontSize="13" Foreground="#222222"
                                                                 VerticalContentAlignment="Center"
                                                                 GroupName="RenewEmployment"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Address + contact -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="Address *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtAddress" Style="{StaticResource FormBox}"
                                                         TextChanged="TxtAddress_TextChanged"/>
                                                <TextBlock x:Name="ErrAddress" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                <TextBlock Text="Barangay *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtBarangay" Style="{StaticResource FormBox}"
                                                         TextChanged="TxtBarangay_TextChanged"/>
                                                <TextBlock x:Name="ErrBarangay" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Contact Number *" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtContact" Style="{StaticResource FormBox}"
                                                         MaxLength="13"
                                                         PreviewTextInput="Phone_PreviewTextInput"
                                                         PreviewKeyDown="Phone_PreviewKeyDown"
                                                         TextChanged="TxtContact_TextChanged"/>
                                                <TextBlock x:Name="ErrContact" Text="Required." Style="{StaticResource ErrorText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Occupation -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="Occupation / Source of Income" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtOccupation" Style="{StaticResource FormBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                                <Border BorderBrush="#C0A0AA" BorderThickness="1.2" CornerRadius="6" Background="White">
                                                    <ComboBox x:Name="CmbStatus" Style="{StaticResource FormCombo}">
                                                        <ComboBoxItem Content="Valid"/>
                                                        <ComboBoxItem Content="Inactive"/>
                                                    </ComboBox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- STEP 2: REVIEW -->
                        <ScrollViewer x:Name="PanelStep2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#F4F6F9"
                                      Visibility="Collapsed">
                            <StackPanel Margin="32,16,32,20">

                                <!-- Validity banner -->
                                <Border x:Name="ValidityBanner"
                                        Background="#EAF7EE" CornerRadius="10"
                                        BorderBrush="#A8DFBC" BorderThickness="1"
                                        Padding="18,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                                              Fill="#27AE60" Stretch="Uniform" Width="22" Height="22"
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Validity will be extended for 1 year"
                                                       FontSize="13" FontWeight="Bold" Foreground="#1A7A40"/>
                                            <TextBlock x:Name="TxtValidityDates"
                                                       Text="Renewed: — · Valid until: —"
                                                       FontSize="12" Foreground="#2E7D52" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#D4EFDF" CornerRadius="6" Padding="10,5"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtNewExpiry" Text="—"
                                                       FontSize="13" FontWeight="Bold" Foreground="#1A7A40"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Changes summary card -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="CHANGES SUMMARY" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <ItemsControl x:Name="ReviewList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   FontSize="12" Foreground="#888888"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Before"
                                                                       FontSize="10" Foreground="#AAAAAA" Margin="0,0,0,1"/>
                                                            <TextBlock Text="{Binding OldValue}"
                                                                       FontSize="13" Foreground="#555555"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBlock Text="After"
                                                                       FontSize="10" Foreground="#AAAAAA" Margin="0,0,0,1"/>
                                                            <TextBlock Text="{Binding NewValue}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{Binding ValueColor}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Locked identity reminder -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="IDENTITY (UNCHANGED)" Style="{StaticResource SectionLabel}"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,8,0,0">
                                                <TextBlock Text="NAME" Style="{StaticResource ReviewLabel}"/>
                                                <TextBlock x:Name="RevName" Style="{StaticResource ReviewValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,8,0,0">
                                                <TextBlock Text="DATE OF BIRTH" Style="{StaticResource ReviewLabel}"/>
                                                <TextBlock x:Name="RevDOB" Style="{StaticResource ReviewValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,8,0,0">
                                                <TextBlock Text="SEX" Style="{StaticResource ReviewLabel}"/>
                                                <TextBlock x:Name="RevSex" Style="{StaticResource ReviewValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,8,0,0">
                                                <TextBlock Text="PHILSYS ID" Style="{StaticResource ReviewLabel}"/>
                                                <TextBlock x:Name="RevPhilSys" Style="{StaticResource ReviewValue}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                    <!-- end content -->

                    <!-- ── FOOTER ── -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0" Padding="32,14">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtValidationMsg" Text="" FontSize="12"
                                           Foreground="#E53935" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnCancel" Content="Cancel"
                                        Style="{StaticResource GhostBtn}"
                                        Margin="0,0,8,0" Click="Cancel_Click"/>
                                <Button x:Name="BtnBack" Content="← Back"
                                        Style="{StaticResource GhostBtn}"
                                        Margin="0,0,8,0" Click="Back_Click"
                                        Visibility="Collapsed"/>
                                <Button x:Name="BtnNext" Content="Review →"
                                        Style="{StaticResource PrimaryBtn}"
                                        Click="Next_Click"/>
                                <Button x:Name="BtnConfirm" Content="Confirm Renewal"
                                        Style="{StaticResource PrimaryBtn}"
                                        Click="Confirm_Click"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Border>

</Window>
