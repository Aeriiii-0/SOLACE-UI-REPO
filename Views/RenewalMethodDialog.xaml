<Window x:Class="SOLUM_UI.RenewalMethodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="520" Height="360"
        ShowInTaskbar="False">

    <Border Background="Transparent">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>
            <Border Background="White" CornerRadius="16" Padding="32,28" Width="500"
                    BorderBrush="#702943" BorderThickness="1.5">
                <StackPanel>

                    <Grid Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Annual Renewal" FontSize="20" FontWeight="Bold"
                                       Foreground="#702943" VerticalAlignment="Center"/>
                            <TextBlock Text="Choose how you want to renew this solo parent record."
                                       FontSize="12" Foreground="#888888" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="30" Height="30" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                                        <TextBlock Text="&#x2715;" FontSize="13" Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Option 1: Quick Renew -->
                        <Border Grid.Column="0" x:Name="CardQuick"
                                BorderBrush="#D1E7DD" BorderThickness="1.5"
                                CornerRadius="12" Padding="16,20" Background="White"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#27AE60"/>
                                            <Setter Property="Background" Value="#F4FBF7"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="46" Height="46" Margin="0,0,0,12">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#27AE60"
                                              Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.04 17.73,14.01 17.27,14.86L18.74,16.33C19.54,15.08 20,13.6 20,12C20,7.58 16.42,4 12,4M12,18C8.69,18 6,15.31 6,12C6,10.96 6.27,9.99 6.73,9.14L5.26,7.67C4.46,8.92 4,10.4 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Quick Renew" FontSize="14" FontWeight="Bold"
                                           Foreground="#1E7E34" HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="No changes reported. Extends validity for 1 year from today." FontSize="11"
                                           Foreground="#666666" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,0,16" Height="32"/>
                                <Button Content="Quick Renew" Click="QuickRenew_Click"
                                        Height="36" Padding="0,0"
                                        Background="#27AE60" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="14,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Option 2: Re-assess & Renew -->
                        <Border Grid.Column="2" x:Name="CardReassess"
                                BorderBrush="#E8D0D7" BorderThickness="1.5"
                                CornerRadius="12" Padding="16,20" Background="White"
                                Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#702943"/>
                                            <Setter Property="Background" Value="#FFFAFB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="46" Height="46" Margin="0,0,0,12">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#702943"
                                              Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Re-assess &amp; Renew" FontSize="14" FontWeight="Bold"
                                           Foreground="#702943" HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Update civil status, income, dependents, or circumstances." FontSize="11"
                                           Foreground="#666666" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,0,16" Height="32"/>
                                <Button Content="Re-assess &amp; Renew" Click="ReassessRenew_Click"
                                        Height="36" Padding="0,0"
                                        Background="#702943" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="14,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Border>
</Window>
