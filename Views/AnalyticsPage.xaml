<Page x:Class="SOLUM_UI.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:SOLUM_UI.Converters"
      Title="Analytics" Background="#FBF9FE">

    <Page.Resources>
        <SolidColorBrush x:Key="MaroonPrimary" Color="#7D2245"/>
        <SolidColorBrush x:Key="RosePrimary" Color="#E58BA3"/>
        <SolidColorBrush x:Key="GoldPrimary" Color="#E3BF2E"/>
        <SolidColorBrush x:Key="GreenPrimary" Color="#7DBB57"/>
        <SolidColorBrush x:Key="BluePrimary" Color="#4FB0C6"/>
        <SolidColorBrush x:Key="GrayPrimary" Color="#A89AA0"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8A6A75"/>
        <SolidColorBrush x:Key="PageBackground" Color="#FBF9FE"/>

        <SolidColorBrush x:Key="StatCard1Bg" Color="#FCE4E8"/>
        <SolidColorBrush x:Key="StatCard1Border" Color="#9C2F55"/>
        <SolidColorBrush x:Key="StatCard2Bg" Color="#FFFBE3"/>
        <SolidColorBrush x:Key="StatCard2Border" Color="#8A6A00"/>
        <SolidColorBrush x:Key="StatCard3Bg" Color="#F2FAEA"/>
        <SolidColorBrush x:Key="StatCard3Border" Color="#3F7A1F"/>
        <SolidColorBrush x:Key="StatCard4Bg" Color="#EAF6FE"/>
        <SolidColorBrush x:Key="StatCard4Border" Color="#1F7A8C"/>

        <SolidColorBrush x:Key="BurundyPrimary" Color="#B03058"/>
        <SolidColorBrush x:Key="BurundyDark" Color="#8B1E3F"/>
        <SolidColorBrush x:Key="OrangePrimary" Color="#E59836"/>
        <SolidColorBrush x:Key="TealPrimary" Color="#16A085"/>
        <SolidColorBrush x:Key="PurpleDark" Color="#4A1525"/>
        <SolidColorBrush x:Key="TextDark" Color="#111827"/>
        <SolidColorBrush x:Key="TextGray" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLight" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="BgLight" Color="#F9FAFB"/>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="BrandDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DpBorder" Background="White"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                CornerRadius="8" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#333333"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="12,0,0,0"
                                                   VerticalContentAlignment="Center"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <TextBlock Text="MM/DD/YYYY" Foreground="#999999" FontSize="13"
                                           Padding="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBg" Background="Transparent"
                                                    Width="28" Height="28" CornerRadius="6">
                                                <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.9,4 3,4.9 3,6V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                                      Fill="#B090A0" Stretch="Uniform"
                                                      Width="13" Height="13"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBg" Property="Background" Value="#F5ECEE"/>
                                                    <Setter Property="Foreground" Value="#702943"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="DpBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="StyledComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="CbBg" Background="White" BorderBrush="#D0B8C0"
                        BorderThickness="1.5" CornerRadius="8">
                    <Grid Margin="12,0,32,0">
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                  RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False" Opacity="0"/>
                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                      Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="8" BorderBrush="#D0B8C0"
                            BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="200" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="StyledComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItBg" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#F0E4E8"/>
                                <Setter Property="Foreground" Value="#702943"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F5ECEE" CornerRadius="8"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDD8DF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,18"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
        </Style>

        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Analytics &amp; Demographics" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock Text="Comprehensive demographic breakdowns, statutory categories, and barangay distributions." FontFamily="Segoe UI" FontSize="12" Foreground="#A06080" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1.5"
                                CornerRadius="20" Margin="0,0,8,0">
                            <Button x:Name="FilterDropBtn"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Width="90" Height="40"
                                    Click="FilterDrop_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="20" Padding="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z"
                                          Fill="#702943" Stretch="Uniform"
                                          Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Filter" FontFamily="Segoe UI" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1.5"
                                CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0">
                            <Button x:Name="ExportBtn" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Export to Excel"
                                    Click="ExportBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H11V12H13V15H16L12,19Z"
                                      Fill="#10B981" Stretch="Uniform"
                                      Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>

                        <Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1.5"
                                CornerRadius="20" Width="40" Height="40"
                                Padding="0">
                            <Button x:Name="RefreshBtn" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Refresh Analytics Data"
                                    Click="RefreshBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5ECEE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Path x:Name="RefreshIcon"
                                          Data="M7,7H4V4M4,4C5.85,2.75 8.45,2 11,2C16.52,2 21,6.48 21,12C21,17.52 16.52,22 11,22C5.48,22 2,17.52 2,12H0C0,18.63 5.37,24 12,24C18.63,24 24,18.63 24,12C24,5.37 18.63,0 12,0C8.81,0 5.87,1.17 3.67,3.17L2,1.5V7Z"
                                          Fill="#702943" Stretch="Uniform"
                                          Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <StackPanel x:Name="LoadingSpinner" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⟳" FontSize="17" Foreground="#702943"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,18" Background="White" CornerRadius="12"
                        BorderBrush="#E5E7EB" BorderThickness="1.5" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FDF0F3" CornerRadius="8" Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                      Fill="#702943" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ACTIVE FILTER" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Viewing:" FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveFilterSummary}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource TextOnlyButtonStyle}"
                                Click="FilterReset_Click"
                                Cursor="Hand"
                                ToolTip="Reset filter to Citywide &amp; Current Month">
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reset Filter" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,18"
                        Background="#FFF8F0" CornerRadius="12"
                        BorderBrush="#F59E0B" BorderThickness="1.5"
                        Padding="20,14"
                        Visibility="{Binding IsNoData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M12,2L1,21H23M12,6L19.5,19H4.5M11,10V14H13V10M11,16V18H13V16"
                              Fill="#F59E0B" Stretch="Uniform"
                              Width="22" Height="22" Margin="0,0,14,0"
                              VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="No data for the selected filter"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#92400E"/>
                            <TextBlock Text="The selected barangay or date range returned no records. Try adjusting the filter or click Reset."
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,24" Height="165">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCard}"
                            Background="{StaticResource StatCard1Bg}" BorderBrush="{StaticResource StatCard1Border}"
                            Padding="22,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="26" Height="26">
                                    <TextBlock Text="👥" FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource StatCard1Border}"/>
                                </Viewbox>

                                <Border Grid.Column="2" Background="#1F9C2F55" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="● " FontSize="10" Foreground="{StaticResource StatCard1Border}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveChangeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource StatCard1Border}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding DisplayTotalEnrolled}" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource StatCard1Border}" TextAlignment="Left" LineHeight="38"/>
                                <TextBlock Text="Total Enrolled Solo Parents" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource StatCard1Border}" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1F9C2F55" CornerRadius="8" Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" TextAlignment="Left" FontSize="11" Foreground="{StaticResource StatCard1Border}">
                                        Active: <Bold><Run Text="{Binding DisplayActiveRecords, Mode=OneWay}"/></Bold>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="|" Foreground="{StaticResource StatCard1Border}" Opacity="0.5" Margin="4,0"/>
                                    <TextBlock Grid.Column="2" TextAlignment="Right" FontSize="11" Foreground="{StaticResource StatCard1Border}">
                                        Inactive: <Bold><Run Text="{Binding DisplayInactiveRecords, Mode=OneWay}"/></Bold>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiCard}"
                            Background="{StaticResource StatCard2Bg}" BorderBrush="{StaticResource StatCard2Border}"
                            Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24">
                                    <TextBlock Text="🔄" FontSize="18" Foreground="{StaticResource StatCard2Border}"/>
                                </Viewbox>
                                <Border Grid.Column="2" Background="#1F8A6A00" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="Due This Month" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatCard2Border}"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding RenewalsDueThisMonth}" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource StatCard2Border}" TextAlignment="Left" LineHeight="34"/>
                                <TextBlock Text="Renewals Due" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource StatCard2Border}" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1F8A6A00" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="11" Foreground="{StaticResource StatCard2Border}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding RenewalsThisMonth}"/> done · <Bold><Run Text="{Binding RenewalsCompletedToday}"/></Bold> today
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource KpiCard}"
                            Background="{StaticResource StatCard3Bg}" BorderBrush="{StaticResource StatCard3Border}"
                            Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24">
                                    <TextBlock Text="📝" FontSize="18" Foreground="{StaticResource StatCard3Border}"/>
                                </Viewbox>
                                <Border Grid.Column="2" Background="#1F3F7A1F" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="New Intake" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatCard3Border}"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding DisplayRegisteredCount}" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource StatCard3Border}" TextAlignment="Left" LineHeight="34"/>
                                <TextBlock Text="{Binding DisplayRegisteredLabel}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource StatCard3Border}" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1F3F7A1F" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="11" Foreground="{StaticResource StatCard3Border}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding TotalDependents}"/> Total Dependents
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource KpiCard}"
                            Background="{StaticResource StatCard4Bg}" BorderBrush="{StaticResource StatCard4Border}"
                            Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24">
                                    <TextBlock Text="🏘️" FontSize="18" Foreground="{StaticResource StatCard4Border}"/>
                                </Viewbox>
                                <Border Grid.Column="2" Background="#1F1F7A8C" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="Top Barangay" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatCard4Border}"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding TopBarangayCount}" FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource StatCard4Border}" TextAlignment="Left" LineHeight="34"/>
                                <TextBlock Text="Solo Parents" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource StatCard4Border}" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#1F1F7A8C" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="11" Foreground="{StaticResource StatCard4Border}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Top: "/><Run Text="{Binding TopBarangayName}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Solo parents per barangay -->
                <Border Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Solo parents per barangay" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Ranked by solo parent count, 10 barangays per page" Style="{StaticResource PanelSubtitle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Top">
                                <Run Text="Page "/><Run Text="{Binding CurrentBarangayPage, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalBarangayPages, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <Canvas x:Name="CvBarangay" Height="290" ClipToBounds="True" Background="Transparent"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource MaroonPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text="Solo parents count" FontSize="10" FontFamily="Segoe UI"
                                       Foreground="{StaticResource SecondaryText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="PreviousBarangayButton" Content="← Previous" FontSize="12"
                                    Foreground="{StaticResource MaroonPrimary}" IsEnabled="{Binding HasPreviousBarangayPage}"
                                    Click="PreviousBarangayButton_Click" FontWeight="SemiBold" Cursor="Hand"
                                    Style="{StaticResource TextOnlyButtonStyle}"/>
                            <Button Grid.Column="2" x:Name="NextBarangayButton" Content="Next →" FontSize="12"
                                    Foreground="{StaticResource MaroonPrimary}" IsEnabled="{Binding HasNextBarangayPage}"
                                    Click="NextBarangayButton_Click" FontWeight="SemiBold" Cursor="Hand"
                                    Style="{StaticResource TextOnlyButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Top categories (left, tall) | Age group + Child dependents (right, stacked) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Top categories" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Grid.Row="1" Text="Leading classification and circumstance reasons" Style="{StaticResource PanelSubtitle}"/>
                            <Canvas Grid.Row="2" x:Name="CvTopCategories" MinHeight="320" Background="Transparent"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Age group" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Solo parents by statutory age bracket (RA 11861)" Style="{StaticResource PanelSubtitle}"/>
                                <Canvas x:Name="CvAgeBars" Height="250" Background="Transparent"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}">
                            <StackPanel>
                                <TextBlock Text="Child dependents by age" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Developmental stages and childcare resource planning" Style="{StaticResource PanelSubtitle}"/>

                                <Grid Height="250">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                        <Border Background="#7D2245" CornerRadius="8,8,0,0"
                                                Height="{Binding AgeGroup0_5BarHeight}" MinHeight="3"/>
                                        <TextBlock Text="{Binding AgeGroup0_5}" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="0–6 yrs" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                        <TextBlock Text="Daycare age" FontSize="10" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Border Background="#A96B87" CornerRadius="8,8,0,0"
                                                Height="{Binding AgeGroup6_12BarHeight}" MinHeight="3"/>
                                        <TextBlock Text="{Binding AgeGroup6_12}" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="7–21 yrs" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                        <TextBlock Text="School and youth" FontSize="10" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                        <Border Background="#D8A7C0" CornerRadius="8,8,0,0"
                                                Height="{Binding AgeGroup13_17BarHeight}" MinHeight="3"/>
                                        <TextBlock Text="{Binding AgeGroup13_17}" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="22+ yrs" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                        <TextBlock Text="Adult / special" FontSize="10" FontFamily="Segoe UI"
                                                   Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Sex | Employment status -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}">
                        <StackPanel>
                            <TextBlock Text="Sex" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Distribution of solo parents" Style="{StaticResource PanelSubtitle}"/>

                            <!-- Donut with total in center -->
                            <Grid Width="170" Height="170" HorizontalAlignment="Center" Margin="0,4,0,18">
                                <Canvas x:Name="CvSexDonut" Width="170" Height="170"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalSoloParents}" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                    <TextBlock Text="total" FontSize="10" FontFamily="Segoe UI"
                                               Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Female / Male counts with percentages -->
                            <Grid Margin="24,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding FemaleCount, Mode=OneWay}" FontSize="40" FontWeight="Bold"
                                               FontFamily="Segoe UI" Foreground="#C9536E" LineHeight="44"/>
                                    <TextBlock Text="Female" FontSize="13" FontFamily="Segoe UI"
                                               Foreground="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding FemalePercent, StringFormat=F1, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" Foreground="#C9536E" Margin="0,4,0,0">
                                        <Run Text="{Binding FemalePercent, StringFormat=F1, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding MaleCount, Mode=OneWay}" FontSize="40" FontWeight="Bold"
                                               FontFamily="Segoe UI" Foreground="#3B9FC9" TextAlignment="Right" LineHeight="44"/>
                                    <TextBlock Text="Male" FontSize="13" FontFamily="Segoe UI"
                                               Foreground="{StaticResource SecondaryText}" TextAlignment="Right"/>
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                               FontFamily="Segoe UI" Foreground="#3B9FC9" TextAlignment="Right" Margin="0,4,0,0">
                                        <Run Text="{Binding MalePercent, StringFormat=F1, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding FemalePercentText}" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}">
                        <StackPanel>
                            <TextBlock Text="Employment status" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Work situation of parents" Style="{StaticResource PanelSubtitle}"/>

                            <Grid Width="170" Height="170" HorizontalAlignment="Center" Margin="0,4,0,16">
                                <Canvas x:Name="CvEmployDonut" Width="170" Height="170"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalSoloParents}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                    <TextBlock Text="solo parents" FontSize="11" FontFamily="Segoe UI"
                                               Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="{Binding EmployedText}">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#7D2245" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}" Margin="8,0,0,0">
                                        <Run Text="Employed: "/><Run Text="{Binding EmployedText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="{Binding SelfEmployedText}">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#E3BF2E" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}" Margin="8,0,0,0">
                                        <Run Text="Self-employed: "/><Run Text="{Binding SelfEmployedText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding NotEmployedText}">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#A89AA0" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}" Margin="8,0,0,0">
                                        <Run Text="Not employed: "/><Run Text="{Binding NotEmployedText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Civil status | Monthly income -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}">
                        <StackPanel>
                            <TextBlock Text="Civil status" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Marital status distribution" Style="{StaticResource PanelSubtitle}"/>
                            <Canvas x:Name="CvCivilBars" Height="240" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}" BorderBrush="{StaticResource MaroonPrimary}">
                        <StackPanel>
                            <TextBlock Text="Monthly income" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Poverty threshold and subsidy classification (RA 11861)" Style="{StaticResource PanelSubtitle}"/>

                            <Grid Margin="0,4,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Below minimum wage" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDark}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource StatCard3Border}" FontFamily="Segoe UI">
                                        <Run Text="{Binding IncomeBelowMinCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IncomeBelowMinPercent, StringFormat=N1, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}"
                                             Value="{Binding IncomeBelowMinPercent, Mode=OneWay}"
                                             Background="#F2FAEA" Foreground="{StaticResource GreenPrimary}"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Min. wage to ₱20,833" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDark}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource MaroonPrimary}" FontFamily="Segoe UI">
                                        <Run Text="{Binding IncomeMinWageCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IncomeMinWagePercent, StringFormat=N1, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}"
                                             Value="{Binding IncomeMinWagePercent, Mode=OneWay}"
                                             Background="#FCE4E8" Foreground="{StaticResource MaroonPrimary}"/>
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="₱20,834 and above" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDark}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource StatCard4Border}" FontFamily="Segoe UI">
                                        <Run Text="{Binding IncomeAboveMinCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IncomeAboveMinPercent, StringFormat=N1, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}"
                                             Value="{Binding IncomeAboveMinPercent, Mode=OneWay}"
                                             Background="#EAF6FE" Foreground="{StaticResource BluePrimary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="FilterModalOverlay"
              Visibility="Collapsed"
              Background="#66000000"
              Panel.ZIndex="100"
              MouseDown="FilterModalOverlay_MouseDown">

            <Border Background="White" CornerRadius="16"
                    BorderBrush="#E8D4DA" BorderThickness="1.5"
                    Padding="26,22"
                    Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="FilterModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.25"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FILTER ANALYTICS" FontFamily="Segoe UI" FontSize="11"
                                       FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Select timeframe and geographic scope" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="FilterModalClose_Click"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Width="28" Height="28"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F3F4F6" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock Text="Filter By" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbPeriodType"
                              Template="{StaticResource StyledComboTemplate}"
                              ItemContainerStyle="{StaticResource StyledComboItem}"
                              Height="40"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,14"
                              SelectionChanged="CmbPeriodType_SelectionChanged">
                        <ComboBoxItem Content="By Monthly" Tag="Monthly" IsSelected="True"/>
                        <ComboBoxItem Content="By Quarterly" Tag="Quarterly"/>
                        <ComboBoxItem Content="By Yearly" Tag="Yearly"/>
                        <ComboBoxItem Content="Custom Range" Tag="CustomRange"/>
                    </ComboBox>

                    <StackPanel x:Name="PnlYearly" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Select Year" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbYearlyYear"
                                  Template="{StaticResource StyledComboTemplate}"
                                  ItemContainerStyle="{StaticResource StyledComboItem}"
                                  Height="40"
                                  FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="PnlMonthly" Visibility="Visible" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMonthlyYear"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Month" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMonthlyMonth"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13">
                                    <ComboBoxItem Content="January" Tag="1"/>
                                    <ComboBoxItem Content="February" Tag="2"/>
                                    <ComboBoxItem Content="March" Tag="3"/>
                                    <ComboBoxItem Content="April" Tag="4"/>
                                    <ComboBoxItem Content="May" Tag="5"/>
                                    <ComboBoxItem Content="June" Tag="6"/>
                                    <ComboBoxItem Content="July" Tag="7"/>
                                    <ComboBoxItem Content="August" Tag="8"/>
                                    <ComboBoxItem Content="September" Tag="9"/>
                                    <ComboBoxItem Content="October" Tag="10"/>
                                    <ComboBoxItem Content="November" Tag="11"/>
                                    <ComboBoxItem Content="December" Tag="12"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PnlQuarterly" Visibility="Collapsed" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbQuarterlyYear"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quarter" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbQuarterlyQuarter"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13">
                                    <ComboBoxItem Content="Q1 (Jan–Mar)" Tag="1"/>
                                    <ComboBoxItem Content="Q2 (Apr–Jun)" Tag="2"/>
                                    <ComboBoxItem Content="Q3 (Jul–Sep)" Tag="3"/>
                                    <ComboBoxItem Content="Q4 (Oct–Dec)" Tag="4"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PnlCustomRange" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Custom Date Range" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DpStartDate" Grid.Column="0"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        Style="{StaticResource BrandDatePicker}"/>
                            <DatePicker x:Name="DpEndDate" Grid.Column="2"
                                        SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        Style="{StaticResource BrandDatePicker}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Barangay" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFilterBarangay"
                              Template="{StaticResource StyledComboTemplate}"
                              ItemContainerStyle="{StaticResource StyledComboItem}"
                              Height="40"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,18"
                              SelectionChanged="FilterCombo_Changed">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Biñan (Poblacion)"/>
                        <ComboBoxItem Content="Bungahan"/>
                        <ComboBoxItem Content="Canlalay"/>
                        <ComboBoxItem Content="Casile"/>
                        <ComboBoxItem Content="De La Paz"/>
                        <ComboBoxItem Content="Ganado"/>
                        <ComboBoxItem Content="Langkiwa"/>
                        <ComboBoxItem Content="Loma"/>
                        <ComboBoxItem Content="Malaban"/>
                        <ComboBoxItem Content="Malamig"/>
                        <ComboBoxItem Content="Mambog"/>
                        <ComboBoxItem Content="Platero"/>
                        <ComboBoxItem Content="Poblacion"/>
                        <ComboBoxItem Content="San Antonio"/>
                        <ComboBoxItem Content="San Francisco (Halang)"/>
                        <ComboBoxItem Content="San Jose"/>
                        <ComboBoxItem Content="San Vicente"/>
                        <ComboBoxItem Content="Santo Domingo"/>
                        <ComboBoxItem Content="Santo Niño"/>
                        <ComboBoxItem Content="Santo Tomas (Calabuso)"/>
                        <ComboBoxItem Content="Soro-Soro"/>
                        <ComboBoxItem Content="Timbao"/>
                        <ComboBoxItem Content="Tubigan"/>
                        <ComboBoxItem Content="Zapote"/>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="42" Cursor="Hand"
                                Click="FilterReset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="10"
                                            BorderBrush="#DCC8CE" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#702943"/>
                        </Button>
                        <Button Grid.Column="2" Height="42" Cursor="Hand"
                                Click="FilterApply_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>