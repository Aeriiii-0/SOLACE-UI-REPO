<Page x:Class="SOLUM_UI.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:converters="clr-namespace:SOLUM_UI.Converters"
      xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
      Title="Analytics" Background="#FBF9FE">
    <Page.Resources>
        <SolidColorBrush x:Key="MaroonPrimary" Color="#7D2245"/>
        <SolidColorBrush x:Key="RosePrimary" Color="#E58BA3"/>
        <SolidColorBrush x:Key="GoldPrimary" Color="#E3BF2E"/>
        <SolidColorBrush x:Key="GreenPrimary" Color="#7DBB57"/>
        <SolidColorBrush x:Key="BluePrimary" Color="#4FB0C6"/>
        <SolidColorBrush x:Key="GrayPrimary" Color="#A89AA0"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8A6A75"/>
        <SolidColorBrush x:Key="PageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StatCard1Bg" Color="#FCE4E8"/>
        <SolidColorBrush x:Key="StatCard1Border" Color="#9C2F55"/>
        <SolidColorBrush x:Key="StatCard2Bg" Color="#FFFBE3"/>
        <SolidColorBrush x:Key="StatCard2Border" Color="#8A6A00"/>
        <SolidColorBrush x:Key="StatCard3Bg" Color="#F2FAEA"/>
        <SolidColorBrush x:Key="StatCard3Border" Color="#3F7A1F"/>
        <SolidColorBrush x:Key="StatCard4Bg" Color="#EAF6FE"/>
        <SolidColorBrush x:Key="StatCard4Border" Color="#1F7A8C"/>
        <SolidColorBrush x:Key="BurundyPrimary" Color="#B03058"/>
        <SolidColorBrush x:Key="BurundyDark" Color="#8B1E3F"/>
        <SolidColorBrush x:Key="OrangePrimary" Color="#E59836"/>
        <SolidColorBrush x:Key="TealPrimary" Color="#16A085"/>
        <SolidColorBrush x:Key="PurpleDark" Color="#4A1525"/>
        <SolidColorBrush x:Key="TextDark" Color="#111827"/>
        <SolidColorBrush x:Key="TextGray" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLight" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="BgLight" Color="#F9FAFB"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="BrandDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DpBorder" Background="White"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                CornerRadius="8" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#333333"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="12,0,0,0"
                                                   VerticalContentAlignment="Center"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <TextBlock Text="MM/DD/YYYY" Foreground="#999999" FontSize="13"
                                           Padding="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBg" Background="Transparent"
                                                    Width="28" Height="28" CornerRadius="6">
                                                <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.9,4 3,4.9 3,6V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                                      Fill="#B090A0" Stretch="Uniform"
                                                      Width="13" Height="13"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBg" Property="Background" Value="#F5ECEE"/>
                                                    <Setter Property="Foreground" Value="#702943"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="DpBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="StyledComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="CbBg" Background="White" BorderBrush="#D0B8C0"
                        BorderThickness="1.5" CornerRadius="8">
                    <Grid Margin="12,0,32,0">
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                  RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False" Opacity="0"/>
                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                      Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="8" BorderBrush="#D0B8C0"
                            BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="200" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="StyledComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItBg" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#F0E4E8"/>
                                <Setter Property="Foreground" Value="#702943"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F5ECEE" CornerRadius="8"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDD8DF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,18"/>
        </Style>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>
        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
        </Style>
        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource PageBackground}" x:Name="AnalyticsRootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <StackPanel.Resources>
                    <Style x:Key="Card" TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="BorderBrush" Value="#7D2245"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Padding" Value="20,18"/>
                    </Style>
                    <Style x:Key="PillBorder" TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#7D2245"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                    <Style x:Key="KpiLabel" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#7D2245"/>
                    </Style>
                    <Style x:Key="KpiValue" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="40"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#111827"/>
                    </Style>
                    <Style x:Key="Pill" TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="Padding" Value="9,3"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>
                </StackPanel.Resources>

                <!-- ===== Toolbar: controls ===== -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,18">
                    <!-- Scope & date pill -->
                    <Border Style="{StaticResource PillBorder}" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"
                                  Fill="#7D2245" Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveFilterSummary}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#7D2245" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Reset (only when filter active) -->
                    <Button Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource TextOnlyButtonStyle}" Click="FilterReset_Click" Cursor="Hand"
                            ToolTip="Reset filter to Citywide &amp; Current Month" Margin="0,0,8,0">
                        <Border Style="{StaticResource PillBorder}" BorderThickness="1" Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#7D2245" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#7D2245" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Filter -->
                    <Border Style="{StaticResource PillBorder}" Margin="0,0,8,0">
                        <Button x:Name="FilterDropBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="82" Height="34" Click="FilterDrop_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="#7D2245" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Filter" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#7D2245" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Export -->
                    <Border Style="{StaticResource PillBorder}" Width="34" Height="34" Margin="0,0,8,0">
                        <Button x:Name="ExportBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Export to Excel" Click="ExportBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H11V12H13V15H16L12,19Z"
                                  Fill="#7D2245" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Border>

                    <!-- Last updated -->
                    <Border Style="{StaticResource PillBorder}" Padding="12,7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Fill="#7D2245" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" Opacity="0.75"/>
                            <TextBlock x:Name="TxtAnalyticsLastRefreshed" Text="Updated: Just now" FontSize="11" FontFamily="Segoe UI" FontWeight="Medium" Foreground="#7D2245"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh -->
                    <Border Style="{StaticResource PillBorder}" Width="34" Height="34">
                        <Button x:Name="RefreshBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Refresh Analytics Data" Click="RefreshBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5ECEE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Path x:Name="RefreshIcon"
                                      Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Fill="#7D2245" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Border>
                </StackPanel>

                <!-- No-data banner -->
                <Border Margin="0,0,0,18" Background="#FFF8F0" CornerRadius="12" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="20,14"
                        Visibility="{Binding IsNoData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M12,2L1,21H23M12,6L19.5,19H4.5M11,10V14H13V10M11,16V18H13V16" Fill="#F59E0B" Stretch="Uniform" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="No data for the selected filter" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#92400E"/>
                            <TextBlock Text="The selected barangay or date range returned no records. Try adjusting the filter or click Reset." FontFamily="Segoe UI" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Custom Range Window-Specific Banner Indicator -->
                <Border Margin="0,0,0,18" Background="#F0E4E4" CornerRadius="12" BorderBrush="#7D2245" BorderThickness="1.5" Padding="16,12"
                        Visibility="{Binding IsCustomRangeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#7D2245" BorderThickness="1.5" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                  Fill="#7D2245" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CustomRangeIndicatorTitle, Mode=OneWay}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#7D2245"/>
                            <TextBlock Text="{Binding CustomRangeIndicatorMessage, Mode=OneWay}" FontFamily="Segoe UI" FontSize="12" Foreground="#7D2245" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Row 1: four KPI cards ===== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total registered -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border BorderBrush="#7D2245" BorderThickness="1" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                    <Path Fill="#7D2245" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"/>
                                </Border>
                                <TextBlock Text="{Binding Card1Label, Mode=OneWay, FallbackValue='Total registered'}" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalRegisteredCount, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#111827"/>
                                <Border Style="{StaticResource Pill}" Background="Transparent" BorderBrush="#7D2245" BorderThickness="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding PreviousYearComparisonVisibility, Mode=OneWay}">
                                    <TextBlock Text="{Binding GrowthPercentageText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#7D2245"/>
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" Background="Transparent" BorderBrush="#7D2245" BorderThickness="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Card1Subtitle, Mode=OneWay}" FontSize="11" Foreground="#7D2245" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Active -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border BorderBrush="#7D2245" BorderThickness="1" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                    <Path Fill="#7D2245" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"/>
                                </Border>
                                <TextBlock Text="Active" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveRecordsCount, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#111827"/>
                            <Border Style="{StaticResource Pill}" Background="Transparent" BorderBrush="#7D2245" BorderThickness="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Card2Subtitle, Mode=OneWay}" FontSize="11" Foreground="#7D2245" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Inactive -->
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border BorderBrush="#7D2245" BorderThickness="1" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                    <Path Fill="#7D2245" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M13,16V8H15V16H13M9,16V8H11V16H9M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z"/>
                                </Border>
                                <TextBlock Text="Inactive records" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding InactiveRecordsCount, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#111827"/>
                            <Border Style="{StaticResource Pill}" Background="Transparent" BorderBrush="#7D2245" BorderThickness="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding InactiveSubtext, Mode=OneWay}" FontSize="11" Foreground="#7D2245" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Top barangay -->
                    <Border Grid.Column="6" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border BorderBrush="#7D2245" BorderThickness="1" CornerRadius="8" Width="26" Height="26" Margin="0,0,8,0">
                                    <Path Fill="#7D2245" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"/>
                                </Border>
                                <TextBlock Text="Top barangay" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TopBarangayName, Mode=OneWay}" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                       Foreground="#111827" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TopBarangayCount, Mode=OneWay}" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Text="solo parents" FontFamily="Segoe UI" FontSize="12" Foreground="#7D2245" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Row 2: solo parents per barangay ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Solo parents per barangay" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="{Binding BarangayChartSubtitle, Mode=OneWay, FallbackValue='Ranked by solo parent count, 10 barangays per page. Hover a point for the count.'}" Style="{StaticResource PanelSubtitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Run Text="Page "/><Run Text="{Binding CurrentBarangayPage, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalBarangayPages, Mode=OneWay}"/>
                                </TextBlock>
                                <Border BorderBrush="#7D2245" BorderThickness="1" CornerRadius="12" Padding="12,3" Margin="0,0,6,0">
                                    <Button x:Name="PreviousBarangayButton" Content="Previous" FontSize="11" FontWeight="SemiBold"
                                            Foreground="#7D2245" IsEnabled="{Binding HasPreviousBarangayPage}"
                                            Click="PreviousBarangayButton_Click" Cursor="Hand" Style="{StaticResource TextOnlyButtonStyle}"/>
                                </Border>
                                <Border Background="#7D2245" CornerRadius="12" Padding="16,3">
                                    <Button x:Name="NextBarangayButton" Content="Next" FontSize="11" FontWeight="SemiBold"
                                            Foreground="White" IsEnabled="{Binding HasNextBarangayPage}"
                                            Click="NextBarangayButton_Click" Cursor="Hand" Style="{StaticResource TextOnlyButtonStyle}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="CvBarangay" Height="290" Margin="0,16,0,0" ClipToBounds="True" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- ===== Row 3: top categories | age group + child dependents ===== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Top categories" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Grid.Row="1" Text="Leading classification and circumstance reasons" Style="{StaticResource PanelSubtitle}"/>
                            <Canvas Grid.Row="2" x:Name="CvTopCategories" MinHeight="320" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Age group" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Solo parents by statutory age bracket (RA 11861)" Style="{StaticResource PanelSubtitle}"/>
                                <StackPanel Margin="0,4,0,0">

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="19 &amp; below" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}" Height="8" Margin="0,0,10,0"
                                                 Maximum="{Binding TotalSoloParents, Mode=OneWay}" Value="{Binding ParentAge19Below, Mode=OneWay}" Background="#E6F4F1" Foreground="#16A085" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ParentAge19Below, Mode=OneWay}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="20–39" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}" Height="8" Margin="0,0,10,0"
                                                 Maximum="{Binding TotalSoloParents, Mode=OneWay}" Value="{Binding ParentAge20_39, Mode=OneWay}" Background="#E6F4F1" Foreground="#16A085" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ParentAge20_39, Mode=OneWay}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="40–59" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}" Height="8" Margin="0,0,10,0"
                                                 Maximum="{Binding TotalSoloParents, Mode=OneWay}" Value="{Binding ParentAge40_59, Mode=OneWay}" Background="#E6F4F1" Foreground="#16A085" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ParentAge40_59, Mode=OneWay}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="60 &amp; above" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}" Height="8" Margin="0,0,10,0"
                                                 Maximum="{Binding TotalSoloParents, Mode=OneWay}" Value="{Binding ParentAge60Above, Mode=OneWay}" Background="#E6F4F1" Foreground="#16A085" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ParentAge60Above, Mode=OneWay}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <!-- Canvas kept (hidden) so code-behind chart hooks stay intact -->
                                <Canvas x:Name="CvAgeBars" Height="0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Child dependents by age" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Developmental stages and childcare resource planning" Style="{StaticResource PanelSubtitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding AgeGroup0_5}" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="0–6 yrs" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="Daycare age" FontSize="10" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                        <ProgressBar x:Name="PbChild0" Style="{StaticResource MeterBar}" Height="8" Margin="0,10,0,0" Background="#FFF6D0" Foreground="#E3BF2E"/>
                                        <TextBlock x:Name="TxtChildPct0" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#8A6A00" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding AgeGroup6_12}" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="7–21 yrs" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="School and youth" FontSize="10" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                        <ProgressBar x:Name="PbChild1" Style="{StaticResource MeterBar}" Height="8" Margin="0,10,0,0" Background="#FFF6D0" Foreground="#E3BF2E"/>
                                        <TextBlock x:Name="TxtChildPct1" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#8A6A00" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding AgeGroup13_17}" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="22+ yrs" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="Adult / special" FontSize="10" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                        <ProgressBar x:Name="PbChild2" Style="{StaticResource MeterBar}" Height="8" Margin="0,10,0,0" Background="#FFF6D0" Foreground="#E3BF2E"/>
                                        <TextBlock x:Name="TxtChildPct2" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#8A6A00" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===== Row 4: sex | employment | civil status | monthly income ===== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sex -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Sex" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Grid.Row="1" Text="Distribution of solo parents" Style="{StaticResource PanelSubtitle}"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="150" Height="150" Margin="0,0,22,0" VerticalAlignment="Center">
                                        <Canvas x:Name="CvSexDonut" Width="150" Height="150"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalSoloParents}" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#111827" TextAlignment="Center"/>
                                            <TextBlock Text="total" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,18">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Female" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#C9536E">
                                                    <Run Text="{Binding FemaleCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FemalePercent, StringFormat=F1, Mode=OneWay}"/><Run Text="%"/>
                                                </TextBlock>
                                            </Grid>
                                            <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Height="10" Value="{Binding FemalePercent, Mode=OneWay}" Background="#FBE9EE" Foreground="#C9536E"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Male" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                                <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#3B9FC9">
                                                    <Run Text="{Binding MaleCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MalePercent, StringFormat=F1, Mode=OneWay}"/><Run Text="%"/>
                                                </TextBlock>
                                            </Grid>
                                            <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Height="10" Value="{Binding MalePercent, Mode=OneWay}" Background="#E8F4FA" Foreground="#3B9FC9"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding FemalePercentText}" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           Foreground="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Employment -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Employment status" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Grid.Row="1" Text="Work situation of parents" Style="{StaticResource PanelSubtitle}"/>
                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Width="150" Height="150" Margin="0,0,22,0" VerticalAlignment="Center">
                                    <Canvas x:Name="CvEmployDonut" Width="150" Height="150"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalSoloParents}" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#111827" TextAlignment="Center"/>
                                        <TextBlock Text="total" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,18" ToolTip="{Binding EmployedText}">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Employed" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EmployedText, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#7D2245"/>
                                        </Grid>
                                        <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Height="10" Value="{Binding EmployedPercent, Mode=OneWay}" Background="#F3E4EA" Foreground="#7D2245"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18" ToolTip="{Binding SelfEmployedText}">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Self-employed" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelfEmployedText, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#8A6A00"/>
                                        </Grid>
                                        <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Height="10" Value="{Binding SelfEmployedPercent, Mode=OneWay}" Background="#FFF6D0" Foreground="#E3BF2E"/>
                                    </Grid>
                                    <Grid ToolTip="{Binding NotEmployedText}">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Not employed" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource SecondaryText}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding NotEmployedText, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#6B5A61"/>
                                        </Grid>
                                        <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Height="10" Value="{Binding NotEmployedPercent, Mode=OneWay}" Background="#EFE9EB" Foreground="#A89AA0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Civil status -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,16">
                        <StackPanel>
                            <TextBlock Text="Civil status" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Marital status distribution" Style="{StaticResource PanelSubtitle}"/>
                            <Canvas x:Name="CvCivilBars" Height="240" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- Monthly income -->
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,16">
                        <StackPanel>
                            <TextBlock Text="Monthly income" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Poverty threshold and subsidy classification (RA 11861)" Style="{StaticResource PanelSubtitle}" TextWrapping="Wrap"/>
                            <Grid Margin="0,4,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Below minimum wage" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatCard3Border}" FontFamily="Segoe UI"><Run Text="{Binding IncomeBelowMinCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IncomeBelowMinPercent, StringFormat=N1, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                </Grid>
                                <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Value="{Binding IncomeBelowMinPercent, Mode=OneWay}" Background="#F2FAEA" Foreground="{StaticResource GreenPrimary}"/>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Min. wage to ₱20,833" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MaroonPrimary}" FontFamily="Segoe UI"><Run Text="{Binding IncomeMinWageCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IncomeMinWagePercent, StringFormat=N1, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                </Grid>
                                <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Value="{Binding IncomeMinWagePercent, Mode=OneWay}" Background="#FCE4E8" Foreground="{StaticResource MaroonPrimary}"/>
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="₱20,834 and above" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatCard4Border}" FontFamily="Segoe UI"><Run Text="{Binding IncomeAboveMinCount, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IncomeAboveMinPercent, StringFormat=N1, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                </Grid>
                                <ProgressBar Grid.Row="2" Style="{StaticResource MeterBar}" Value="{Binding IncomeAboveMinPercent, Mode=OneWay}" Background="#EAF6FE" Foreground="{StaticResource BluePrimary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="FilterModalOverlay"
              Visibility="Collapsed"
              Background="{DynamicResource ModalOverlayBrush}"
              Panel.ZIndex="100"
              MouseDown="FilterModalOverlay_MouseDown">
            <Border Background="White" CornerRadius="16"
                    BorderBrush="#E8D4DA" BorderThickness="1.5"
                    Padding="26,22"
                    Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="FilterModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FILTER ANALYTICS" FontFamily="Segoe UI" FontSize="11"
                                       FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Select timeframe and geographic scope" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="FilterModalClose_Click"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Width="28" Height="28"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F3F4F6" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="Filter By" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbPeriodType"
                              Template="{StaticResource StyledComboTemplate}"
                              ItemContainerStyle="{StaticResource StyledComboItem}"
                              Height="40"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,14"
                              SelectionChanged="CmbPeriodType_SelectionChanged">
                        <ComboBoxItem Content="By Monthly" Tag="Monthly" IsSelected="True"/>
                        <ComboBoxItem Content="By Quarterly" Tag="Quarterly"/>
                        <ComboBoxItem Content="By Yearly" Tag="Yearly"/>
                        <ComboBoxItem Content="Custom Range" Tag="CustomRange"/>
                    </ComboBox>
                    <StackPanel x:Name="PnlYearly" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Select Year" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbYearlyYear"
                                  Template="{StaticResource StyledComboTemplate}"
                                  ItemContainerStyle="{StaticResource StyledComboItem}"
                                  Height="40"
                                  FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>
                    <StackPanel x:Name="PnlMonthly" Visibility="Visible" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMonthlyYear"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Month" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMonthlyMonth"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13">
                                    <ComboBoxItem Content="January" Tag="1"/>
                                    <ComboBoxItem Content="February" Tag="2"/>
                                    <ComboBoxItem Content="March" Tag="3"/>
                                    <ComboBoxItem Content="April" Tag="4"/>
                                    <ComboBoxItem Content="May" Tag="5"/>
                                    <ComboBoxItem Content="June" Tag="6"/>
                                    <ComboBoxItem Content="July" Tag="7"/>
                                    <ComboBoxItem Content="August" Tag="8"/>
                                    <ComboBoxItem Content="September" Tag="9"/>
                                    <ComboBoxItem Content="October" Tag="10"/>
                                    <ComboBoxItem Content="November" Tag="11"/>
                                    <ComboBoxItem Content="December" Tag="12"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PnlQuarterly" Visibility="Collapsed" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbQuarterlyYear"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quarter" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbQuarterlyQuarter"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13">
                                    <ComboBoxItem Content="Q1 (Jan–Mar)" Tag="1"/>
                                    <ComboBoxItem Content="Q2 (Apr–Jun)" Tag="2"/>
                                    <ComboBoxItem Content="Q3 (Jul–Sep)" Tag="3"/>
                                    <ComboBoxItem Content="Q4 (Oct–Dec)" Tag="4"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PnlCustomRange" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Custom Date Range" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DpStartDate" Grid.Column="0"
                                        DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        Style="{StaticResource BrandDatePicker}"/>
                            <DatePicker x:Name="DpEndDate" Grid.Column="2"
                                        DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                        SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        Style="{StaticResource BrandDatePicker}"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="Barangay" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFilterBarangay"
                              Template="{StaticResource StyledComboTemplate}"
                              ItemContainerStyle="{StaticResource StyledComboItem}"
                              Height="40"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,18"
                              SelectionChanged="FilterCombo_Changed">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Bi&#241;an (Poblacion)"/>
                        <ComboBoxItem Content="Bungahan"/>
                        <ComboBoxItem Content="Canlalay"/>
                        <ComboBoxItem Content="Casile"/>
                        <ComboBoxItem Content="De La Paz"/>
                        <ComboBoxItem Content="Ganado"/>
                        <ComboBoxItem Content="Langkiwa"/>
                        <ComboBoxItem Content="Loma"/>
                        <ComboBoxItem Content="Malaban"/>
                        <ComboBoxItem Content="Malamig"/>
                        <ComboBoxItem Content="Mambog"/>
                        <ComboBoxItem Content="Platero"/>
                        <ComboBoxItem Content="Poblacion"/>
                        <ComboBoxItem Content="San Antonio"/>
                        <ComboBoxItem Content="San Francisco (Halang)"/>
                        <ComboBoxItem Content="San Jose"/>
                        <ComboBoxItem Content="San Vicente"/>
                        <ComboBoxItem Content="Santo Domingo"/>
                        <ComboBoxItem Content="Santo Ni&#241;o"/>
                        <ComboBoxItem Content="Santo Tomas (Calabuso)"/>
                        <ComboBoxItem Content="Soro-Soro"/>
                        <ComboBoxItem Content="Timbao"/>
                        <ComboBoxItem Content="Tubigan"/>
                        <ComboBoxItem Content="Zapote"/>
                    </ComboBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="42" Cursor="Hand"
                                Click="FilterReset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="10"
                                            BorderBrush="#DCC8CE" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#702943"/>
                        </Button>
                        <Button Grid.Column="2" Height="42" Cursor="Hand"
                                Click="FilterApply_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Analytics Skeleton Loader -->
        <components:AnalyticsSkeletonLoader x:Name="AnalyticsSkeleton"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Panel.ZIndex="50"/>
        <!-- Full-Page Loading Overlay -->
        <components:LoaderOverlay x:Name="PageLoadingOverlay"
                                  BlurTarget="{Binding ElementName=AnalyticsRootGrid}"
                                  Message="Loading analytics..."
                                  Panel.ZIndex="9999"/>
        <!-- Notification Card -->
        <components:NotificationCardComponent
            x:Name="NotificationCard"
            Panel.ZIndex="10000"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0"
            Title="{Binding NotificationTitle, RelativeSource={RelativeSource AncestorType=Page}}"
            Message="{Binding NotificationMessage, RelativeSource={RelativeSource AncestorType=Page}}"
            IsSuccess="{Binding IsNotificationSuccess, RelativeSource={RelativeSource AncestorType=Page}}"
            Visibility="{Binding IsNotificationVisible, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Page>