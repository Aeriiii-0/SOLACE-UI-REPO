<Page x:Class="SOLUM_UI.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:SOLUM_UI.Converters"
      Title="Analytics" Background="#F9FAFB">

    <Page.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="BurundyPrimary" Color="#B03058"/>
        <SolidColorBrush x:Key="BurundyDark" Color="#8B1E3F"/>
        <SolidColorBrush x:Key="OrangePrimary" Color="#E59836"/>
        <SolidColorBrush x:Key="TealPrimary" Color="#16A085"/>
        <SolidColorBrush x:Key="BluePrimary" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PurpleDark" Color="#4A1525"/>
        <SolidColorBrush x:Key="TextDark" Color="#111827"/>
        <SolidColorBrush x:Key="TextGray" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLight" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="BgLight" Color="#F9FAFB"/>

        <!-- Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ── Branded DatePicker style (from ViewAllLogsOverlay) ──────────────────────────── -->
        <Style x:Key="BrandDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Foreground"          Value="#333333"/>
            <Setter Property="Background"          Value="White"/>
            <Setter Property="IsTodayHighlighted"  Value="True"/>
            <Setter Property="SelectedDateFormat"  Value="Short"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DpBorder" Background="White"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                CornerRadius="8" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#333333"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="12,0,0,0"
                                                   VerticalContentAlignment="Center"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                            <!-- Suppress the native watermark by not displaying PART_Watermark -->
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <!-- Custom clean placeholder - only visible when input is empty -->
                                <TextBlock Text="MM/DD/YYYY" Foreground="#999999" FontSize="13"
                                           Padding="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Opacity="0.7">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalBg" Background="Transparent"
                                                    Width="28" Height="28" CornerRadius="6">
                                                <!-- Calendar icon (MDI path) -->
                                                <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.9,4 3,4.9 3,6V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                                      Fill="#B090A0" Stretch="Uniform"
                                                      Width="13" Height="13"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalBg" Property="Background" Value="#F5ECEE"/>
                                                    <Setter Property="Foreground" Value="#702943"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DpBorder" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="DpBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox template (from ViewAllLogsOverlay) ──────────────────────────── -->
        <ControlTemplate x:Key="StyledComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="CbBg" Background="White" BorderBrush="#D0B8C0"
                        BorderThickness="1.5" CornerRadius="8">
                    <Grid Margin="12,0,32,0">
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                  RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False" Opacity="0"/>
                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                      Fill="#702943" Stretch="Uniform" Width="12" Height="12" IsHitTestVisible="False"/>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="8" BorderBrush="#D0B8C0"
                            BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="200" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#C0A0AA" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="CbBg" Property="BorderBrush" Value="#702943"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── ComboBox item style ────────────────────────── -->
        <Style x:Key="StyledComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItBg" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#FDF0F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItBg" Property="Background" Value="#F0E4E8"/>
                                <Setter Property="Foreground" Value="#702943"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon Button style (from ViewAllLogsOverlay) ───────────────────────── -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F5ECEE" CornerRadius="8"
                                BorderBrush="#D0B8C0" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDD8DF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        </Style>

        <!-- Title Text Style -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Subtitle Text Style -->
        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- KPI Stat Style -->
        <Style x:Key="KpiStatStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- KPI Label Style -->
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Text-only Button Style (no background, no border) -->
        <Style x:Key="TextOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F9FAFB">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <!-- Page Title Header (matching Solum page header style) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Section Title -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Analytics &amp; Demographics" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#702943"/>
                        <TextBlock Text="Comprehensive demographic breakdowns, statutory categories, and barangay distributions." FontFamily="Segoe UI" FontSize="12" Foreground="#A06080" Margin="0,4,0,0"/>
                    </StackPanel>

                        <!-- Right: Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Filter Button (Barangay) - with Funnel icon and dropdown -->
                            <Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1.5" 
                                    CornerRadius="20" Margin="0,0,8,0">
                                <Button x:Name="FilterDropBtn"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Width="90" Height="40"
                                        Click="FilterDrop_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="20" Padding="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Funnel Icon (Filter) -->
                                        <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z"
                                              Fill="#702943" Stretch="Uniform"
                                              Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Filter" FontFamily="Segoe UI" FontSize="12" 
                                                   FontWeight="SemiBold" Foreground="#702943" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Export Button (Download) -->
                            <Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1.5" 
                                    CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0">
                                <Button x:Name="ExportBtn" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Export to Excel"
                                        Click="ExportBtn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- Download Icon (File with Down Arrow) -->
                                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H11V12H13V15H16L12,19Z"
                                          Fill="#10B981" Stretch="Uniform"
                                          Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Border>

                            <!-- Refresh Button -->
                            <Border Background="White" BorderBrush="#D4A0B0" BorderThickness="1.5" 
                                    CornerRadius="20" Width="40" Height="40"
                                    Padding="0">
                                <Button x:Name="RefreshBtn" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Refresh Analytics Data"
                                        Click="RefreshBtn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5ECEE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- Refresh Icon Container with Loader -->
                                    <Grid>
                                        <!-- Normal Refresh Icon -->
                                        <Path x:Name="RefreshIcon" 
                                              Data="M7,7H4V4M4,4C5.85,2.75 8.45,2 11,2C16.52,2 21,6.48 21,12C21,17.52 16.52,22 11,22C5.48,22 2,17.52 2,12H0C0,18.63 5.37,24 12,24C18.63,24 24,18.63 24,12C24,5.37 18.63,0 12,0C8.81,0 5.87,1.17 3.67,3.17L2,1.5V7Z"
                                              Fill="#702943" Stretch="Uniform"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Loading Spinner (hidden by default) -->
                                        <StackPanel x:Name="LoadingSpinner" Visibility="Collapsed"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⟳" FontSize="17" Foreground="#702943"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Grid>


                <!-- Active Filter & Date Range Status Indicator Bar -->
                <Border Margin="0,0,0,18" Background="White" CornerRadius="12" 
                        BorderBrush="#E5E7EB" BorderThickness="1.5" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Status Badge -->
                        <Border Grid.Column="0" Background="#FDF0F3" CornerRadius="8" Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Filter Pin / Lens Icon -->
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                      Fill="#702943" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ACTIVE FILTER" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Middle: Active Filter Text Summary -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Viewing:" FontFamily="Segoe UI" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveFilterSummary}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Reset Button (shown when custom filters applied) -->
                        <Button Grid.Column="2" 
                                Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource TextOnlyButtonStyle}"
                                Click="FilterReset_Click"
                                Cursor="Hand"
                                ToolTip="Reset filter to Citywide &amp; Current Month">
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reset Filter" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <!-- No-Data Empty State Banner (shown when filter returns 0 records) -->
                <Border Margin="0,0,0,18"
                        Background="#FFF8F0" CornerRadius="12"
                        BorderBrush="#F59E0B" BorderThickness="1.5"
                        Padding="20,14"
                        Visibility="{Binding IsNoData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Warning icon -->
                        <Path Grid.Column="0"
                              Data="M12,2L1,21H23M12,6L19.5,19H4.5M11,10V14H13V10M11,16V18H13V16"
                              Fill="#F59E0B" Stretch="Uniform"
                              Width="22" Height="22" Margin="0,0,14,0"
                              VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="No data for the selected filter"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#92400E"/>
                            <TextBlock Text="The selected barangay or date range returned no records. Try adjusting the filter or click Reset."
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: KPI Cards (Executive Operational KPIs) -->
                <Grid Margin="0,0,0,24" Height="165">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Featured Card 1: Total Solo Parents & MoM Health Trend -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="{StaticResource BurundyPrimary}" Padding="22,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top: Icon & Trend Badge -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="26" Height="26">
                                    <TextBlock Text="👥" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                                </Viewbox>

                                <!-- MoM Health Trend Badge -->
                                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="● " FontSize="10" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveChangeText}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Middle: Big Stat & Label -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding DisplayTotalEnrolled}" FontSize="36" FontWeight="Bold" 
                                           Foreground="White" TextAlignment="Left" LineHeight="38"/>
                                <TextBlock Text="Total Enrolled Solo Parents" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="White" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Bottom: Active vs Inactive ratio -->
                            <Border Grid.Row="2" Background="#26FFFFFF" CornerRadius="8" Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" TextAlignment="Left" FontSize="11" Foreground="White">
                                        Active: <Bold><Run Text="{Binding DisplayActiveRecords, Mode=OneWay}"/></Bold>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="|" Foreground="White" Opacity="0.5" Margin="4,0"/>
                                    <TextBlock Grid.Column="2" TextAlignment="Right" FontSize="11" Foreground="White">
                                        Inactive: <Bold><Run Text="{Binding DisplayInactiveRecords, Mode=OneWay}"/></Bold>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2: Renewals Due & Monthly Activity -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{StaticResource OrangePrimary}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top: Icon & Alert Tag -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24">
                                    <TextBlock Text="🔄" FontSize="18" Foreground="White"/>
                                </Viewbox>
                                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="Due This Month" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Middle: Big Stat & Label -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding RenewalsDueThisMonth}" FontSize="32" FontWeight="Bold" 
                                           Foreground="White" TextAlignment="Left" LineHeight="34"/>
                                <TextBlock Text="Renewals Due" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="White" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Bottom: Desk Transactions -->
                            <Border Grid.Row="2" Background="#26FFFFFF" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding RenewalsThisMonth}"/> done · <Bold><Run Text="{Binding RenewalsCompletedToday}"/></Bold> today
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 3: Registrations This Month (Desk Intake) -->
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Background="{StaticResource TealPrimary}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top: Icon & Badge -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24">
                                    <TextBlock Text="📝" FontSize="18" Foreground="White"/>
                                </Viewbox>
                                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="New Intake" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Middle: Big Stat & Label -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding DisplayRegisteredCount}" FontSize="32" FontWeight="Bold" 
                                           Foreground="White" TextAlignment="Left" LineHeight="34"/>
                                <TextBlock Text="{Binding DisplayRegisteredLabel}" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="White" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Bottom: Dependents Total -->
                            <Border Grid.Row="2" Background="#26FFFFFF" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding TotalDependents}"/> Total Dependents
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 4: Special Sectors (Pantawid, LGBT, Indigenous) -->
                    <Border Grid.Column="6" Style="{StaticResource CardStyle}" Background="{StaticResource PurpleDark}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top: Icon & Badge -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="24" Height="24">
                                    <TextBlock Text="🎁" FontSize="18" Foreground="White"/>
                                </Viewbox>
                                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="Special Sectors" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Middle: Big Stat & Label -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="{Binding PantawidBeneficiaryCount}" FontSize="32" FontWeight="Bold" 
                                           Foreground="White" TextAlignment="Left" LineHeight="34"/>
                                <TextBlock Text="4Ps Pantawid" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="White" Opacity="0.95" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Bottom: LGBT & Indigenous sub-counts -->
                            <Border Grid.Row="2" Background="#26FFFFFF" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding LgbtCount}"/> LGBT · <Run Text="{Binding IndigenousCount}"/> IP
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Barangays (65%) + Gender (35%) -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Barangays Card with Pagination -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <!-- Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Barangay Distribution" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="All 24 official Biñan barangays ranked by solo parent enrollment." Style="{StaticResource CardSubtitleStyle}"/>
                                </StackPanel>
                                <!-- Page Indicator -->
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center">
                                    <Run Text="Page "/><Run Text="{Binding CurrentBarangayPage}"/><Run Text=" of "/><Run Text="{Binding TotalBarangayPages}"/><Run Text=" (24 Barangays)"/>
                                </TextBlock>
                            </Grid>

                            <!-- Barangay List (10 items per page) -->
                            <ItemsControl ItemsSource="{Binding BarangayData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10" ToolTip="{Binding TooltipSummary}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Badge -->
                                            <Border Grid.Column="0" Background="#FDF0F3" CornerRadius="4" Width="22" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Barangay Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Progress Bar (12px height, rounded) -->
                                            <Border Grid.Column="2" Height="12" Background="#F3F4F6" CornerRadius="6" Margin="10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding BarGridLength}"/>
                                                        <ColumnDefinition Width="{Binding RemainingGridLength}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding Color}" CornerRadius="6"/>
                                                </Grid>
                                            </Border>

                                            <!-- Count -->
                                            <TextBlock Grid.Column="3" Text="{Binding Value}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Percentage Share Badge -->
                                            <Border Grid.Column="4" Background="#F5ECEE" CornerRadius="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PercentageShareText}" FontSize="10" FontWeight="SemiBold" Foreground="#702943" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pagination Controls -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Previous Button (Text-only) -->
                                <Button Grid.Column="0" x:Name="PreviousBarangayButton" Content="← Previous" FontSize="12" 
                                        Foreground="{StaticResource BurundyPrimary}" IsEnabled="{Binding HasPreviousBarangayPage}" 
                                        Click="PreviousBarangayButton_Click" FontWeight="SemiBold" Cursor="Hand" Style="{StaticResource TextOnlyButtonStyle}"/>

                                <!-- Next Button (Text-only) -->
                                <Button Grid.Column="2" x:Name="NextBarangayButton" Content="Next →" FontSize="12" 
                                        Foreground="{StaticResource BurundyPrimary}" IsEnabled="{Binding HasNextBarangayPage}" 
                                        Click="NextBarangayButton_Click" FontWeight="SemiBold" Cursor="Hand" Style="{StaticResource TextOnlyButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Gender Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Gender" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Distribution of solo parents" Style="{StaticResource CardSubtitleStyle}"/>

                            <!-- Large Count Numbers Grid (60px height) -->
                            <Grid Height="60" Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Female Count (Left) -->
                                <TextBlock Grid.Column="0" Text="{Binding FemaleCount}" FontSize="48" FontWeight="Bold" 
                                           Foreground="{StaticResource BurundyPrimary}" TextAlignment="Left" VerticalAlignment="Center"/>
                                <!-- Male Count (Right) -->
                                <TextBlock Grid.Column="1" Text="{Binding MaleCount}" FontSize="48" FontWeight="Bold" 
                                           Foreground="{StaticResource BluePrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Labels Below Numbers (Female/Male) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Female" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextGray}" TextAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Male" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextGray}" TextAlignment="Right"/>
                            </Grid>

                            <!-- Progress Bar (shows Female % + Male %, no gray space) -->
                            <Border Height="14" Background="#F3F4F6" CornerRadius="7" Margin="0,0,0,0">
                                <Grid Height="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding FemaleGridLength}"/>
                                        <ColumnDefinition Width="{Binding MaleGridLength}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource BurundyPrimary}" CornerRadius="7,0,0,7"/>
                                    <Border Grid.Column="1" Background="{StaticResource BluePrimary}" CornerRadius="0,7,7,0"/>
                                </Grid>
                            </Border>

                            <!-- Summary Text (percentage breakdown) -->
                            <TextBlock Text="{Binding FemalePercentText}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextGray}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 3: Age Group + Civil Status + Employment -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Solo Parent Statutory Age Groups Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Solo Parent Age Groups" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Distribution by statutory age bracket (RA 11861)" Style="{StaticResource CardSubtitleStyle}"/>

                            <StackPanel Margin="0,10,0,0">
                                <!-- 19 & Below -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="19 &amp; Below (Teen Parents)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Left"/>
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right">
                                            <Run Text="{Binding ParentAge19Below}"/> · <Run Text="{Binding ParentAge19BelowPercent, StringFormat=N1}"/>%
                                        </TextBlock>
                                    </Grid>
                                    <Border Grid.Row="2" Height="10" Background="#F3F4F6" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ParentAge19BelowGridLength}"/>
                                                <ColumnDefinition Width="{Binding ParentAge19BelowRemainingGridLength}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource BurundyDark}" CornerRadius="5"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 20-39 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="20 – 39 yrs (Young Adults)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Left"/>
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right">
                                            <Run Text="{Binding ParentAge20_39}"/> · <Run Text="{Binding ParentAge20_39Percent, StringFormat=N1}"/>%
                                        </TextBlock>
                                    </Grid>
                                    <Border Grid.Row="2" Height="10" Background="#F3F4F6" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ParentAge20_39GridLength}"/>
                                                <ColumnDefinition Width="{Binding ParentAge20_39RemainingGridLength}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource BurundyPrimary}" CornerRadius="5"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 40-59 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="40 – 59 yrs (Middle-Aged)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Left"/>
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right">
                                            <Run Text="{Binding ParentAge40_59}"/> · <Run Text="{Binding ParentAge40_59Percent, StringFormat=N1}"/>%
                                        </TextBlock>
                                    </Grid>
                                    <Border Grid.Row="2" Height="10" Background="#F3F4F6" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ParentAge40_59GridLength}"/>
                                                <ColumnDefinition Width="{Binding ParentAge40_59RemainingGridLength}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource OrangePrimary}" CornerRadius="5"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 60 & Above -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="60 &amp; Above (Senior Parents)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Left"/>
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right">
                                            <Run Text="{Binding ParentAge60Above}"/> · <Run Text="{Binding ParentAge60AbovePercent, StringFormat=N1}"/>%
                                        </TextBlock>
                                    </Grid>
                                    <Border Grid.Row="2" Height="10" Background="#F3F4F6" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ParentAge60AboveGridLength}"/>
                                                <ColumnDefinition Width="{Binding ParentAge60AboveRemainingGridLength}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource TealPrimary}" CornerRadius="5"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Civil Status Badge Grid -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Civil status" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Marital status" Style="{StaticResource CardSubtitleStyle}"/>

                            <!-- Badge Grid 2x2 + 1 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Single -->
                                <Border Grid.Column="0" Grid.Row="0" Background="#FBE8EF" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SingleCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BurundyPrimary}"/>
                                        <TextBlock Text="Single" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Married -->
                                <Border Grid.Column="2" Grid.Row="0" Background="#FEF5E7" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MarriedCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OrangePrimary}"/>
                                        <TextBlock Text="Married" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Widowed -->
                                <Border Grid.Column="0" Grid.Row="2" Background="#E8F8F5" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WidowedCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TealPrimary}"/>
                                        <TextBlock Text="Widowed" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Separated -->
                                <Border Grid.Column="2" Grid.Row="2" Background="#F0F4FF" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SeparatedCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="Separated" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Annulled (Full Width) -->
                            <Border Background="#F3F4F6" CornerRadius="12" Padding="16,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AnnulledCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Annulled" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Employment Ring Charts -->
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Employment" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Work situation" Style="{StaticResource CardSubtitleStyle}"/>

                            <!-- Employment Items (20px gap between rows) -->
                            <StackPanel Margin="0,12,0,0">
                                <!-- Employed -->
                                <Grid Margin="0,0,0,20" ToolTip="{Binding EmployedText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ring Chart: Employed (Purple) - 64x64 with centered layout -->
                                    <Grid Grid.Column="0" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="64" Height="64">
                                            <!-- Background track circle (full) -->
                                            <Path Data="M 32,4 A 28,28 0 1,1 31.99,4" Stroke="#F3F4F6" StrokeThickness="8" Fill="Transparent"/>

                                            <!-- Filled arc (dynamic based on EmployedPercent) -->
                                            <Path Data="{Binding EmployedArcPath, Mode=OneWay}" Stroke="{StaticResource PurpleDark}" StrokeThickness="8" Fill="Transparent"/>
                                        </Canvas>

                                        <!-- Center percentage text (centered) -->
                                        <TextBlock Text="{Binding EmployedPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Label (16px from chart) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Employed" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="{Binding EmployedText}" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Self-employed (20px gap) -->
                                <Grid Margin="0,0,0,20" ToolTip="{Binding SelfEmployedText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ring Chart: Self-employed (Teal) - 64x64 -->
                                    <Grid Grid.Column="0" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="64" Height="64">
                                            <!-- Background track circle (full) -->
                                            <Path Data="M 32,4 A 28,28 0 1,1 31.99,4" Stroke="#F3F4F6" StrokeThickness="8" Fill="Transparent"/>

                                            <!-- Filled arc (dynamic based on SelfEmployedPercent) -->
                                            <Path Data="{Binding SelfEmployedArcPath, Mode=OneWay}" Stroke="{StaticResource TealPrimary}" StrokeThickness="8" Fill="Transparent"/>
                                        </Canvas>

                                        <!-- Center percentage text (centered) -->
                                        <TextBlock Text="{Binding SelfEmployedPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Label (16px from chart) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Self-employed" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="{Binding SelfEmployedText}" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Not Employed -->
                                <Grid ToolTip="{Binding NotEmployedText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ring Chart: Not Employed (Orange) - 64x64 -->
                                    <Grid Grid.Column="0" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="64" Height="64">
                                            <!-- Background track circle (full) -->
                                            <Path Data="M 32,4 A 28,28 0 1,1 31.99,4" Stroke="#F3F4F6" StrokeThickness="8" Fill="Transparent"/>

                                            <!-- Filled arc (dynamic based on NotEmployedPercent) -->
                                            <Path Data="{Binding NotEmployedArcPath, Mode=OneWay}" Stroke="{StaticResource OrangePrimary}" StrokeThickness="8" Fill="Transparent"/>
                                        </Canvas>

                                        <!-- Center percentage text (centered) -->
                                        <TextBlock Text="{Binding NotEmployedPercent, Mode=OneWay, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Label (16px from chart) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Not employed" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="{Binding NotEmployedText}" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 4: Dependents Age + Income -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dependents Age Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Child Dependents by Age" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Developmental stages &amp; childcare resource planning" Style="{StaticResource CardSubtitleStyle}"/>

                            <!-- Bar Chart with Dynamic Heights (baseline aligned) -->
                            <Grid Height="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 6 & Below -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <Border Background="{StaticResource BurundyPrimary}" CornerRadius="6,6,0,0" 
                                            Height="{Binding AgeGroup0_5BarHeight}"/>
                                    <TextBlock Text="{Binding AgeGroup0_5}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="0–6 yrs" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                    <TextBlock Text="Daycare Age" FontSize="10" Foreground="{StaticResource TextGray}" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- 7 to 22 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Border Background="{StaticResource OrangePrimary}" CornerRadius="6,6,0,0"
                                            Height="{Binding AgeGroup6_12BarHeight}"/>
                                    <TextBlock Text="{Binding AgeGroup6_12}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="7–21 yrs" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                    <TextBlock Text="School &amp; Youth" FontSize="10" Foreground="{StaticResource TextGray}" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- 22 & Above -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                    <Border Background="#9CA3AF" CornerRadius="6,6,0,0"
                                            Height="{Binding AgeGroup13_17BarHeight}"/>
                                    <TextBlock Text="{Binding AgeGroup13_17}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="22+ yrs" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                    <TextBlock Text="Adult / Special" FontSize="10" Foreground="{StaticResource TextGray}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Income Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Margin="24">
                            <TextBlock Text="Monthly Household Income" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Poverty threshold &amp; subsidy classification (RA 11861)" Style="{StaticResource CardSubtitleStyle}"/>

                            <!-- Multi-segment Stacked Bar (3 segments, proportional widths) -->
                            <Border Height="14" Background="#F3F4F6" CornerRadius="7" Margin="0,12,0,0">
                                <Grid Height="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding IncomeBelowMinGridLength}"/>
                                        <ColumnDefinition Width="{Binding IncomeMinWageGridLength}"/>
                                        <ColumnDefinition Width="{Binding IncomeAboveMinGridLength}"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Below Minimum Wage (Orange) -->
                                    <Border Grid.Column="0" Background="{StaticResource OrangePrimary}" CornerRadius="7,0,0,7"/>
                                    <!-- Min Wage + Up to 20,833 (Burgundy) -->
                                    <Border Grid.Column="1" Background="{StaticResource BurundyPrimary}"/>
                                    <!-- Above 20,833 (Teal) -->
                                    <Border Grid.Column="2" Background="{StaticResource TealPrimary}" CornerRadius="0,7,7,0"/>
                                </Grid>
                            </Border>

                            <!-- Legend with Dynamic Values -->
                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="{StaticResource OrangePrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Below minimum wage" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}">
                                        <Run Text="{Binding IncomeBelowMinCount}"/> · <Run Text="{Binding IncomeBelowMinPercent, StringFormat=N1}"/>%
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="{StaticResource BurundyPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Min wage to ₱20,833" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}">
                                        <Run Text="{Binding IncomeMinWageCount}"/> · <Run Text="{Binding IncomeMinWagePercent, StringFormat=N1}"/>%
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="{StaticResource TealPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Above ₱20,833" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}">
                                        <Run Text="{Binding IncomeAboveMinCount}"/> · <Run Text="{Binding IncomeAboveMinPercent, StringFormat=N1}"/>%
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Filter Modal Overlay (In-Window, Non-Floating) -->
        <Grid x:Name="FilterModalOverlay"
              Visibility="Collapsed"
              Background="#66000000"
              Panel.ZIndex="100"
              MouseDown="FilterModalOverlay_MouseDown">

            <!-- Modal Dialog Card -->
            <Border Background="White" CornerRadius="16"
                    BorderBrush="#E8D4DA" BorderThickness="1.5"
                    Padding="26,22"
                    Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="FilterModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.25"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header with Title & Close Button -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FILTER ANALYTICS" FontFamily="Segoe UI" FontSize="11"
                                       FontWeight="Bold" Foreground="#702943"/>
                            <TextBlock Text="Select timeframe and geographic scope" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="FilterModalClose_Click"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Width="28" Height="28"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F3F4F6" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Filter Mode (Hierarchy) -->
                    <TextBlock Text="Filter By" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbPeriodType"
                              Template="{StaticResource StyledComboTemplate}"
                              ItemContainerStyle="{StaticResource StyledComboItem}"
                              Height="40"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,14"
                              SelectionChanged="CmbPeriodType_SelectionChanged">
                        <ComboBoxItem Content="By Monthly" Tag="Monthly" IsSelected="True"/>
                        <ComboBoxItem Content="By Quarterly" Tag="Quarterly"/>
                        <ComboBoxItem Content="By Yearly" Tag="Yearly"/>
                        <ComboBoxItem Content="Custom Range" Tag="CustomRange"/>
                    </ComboBox>

                    <!-- Mode 1: Yearly Selection -->
                    <StackPanel x:Name="PnlYearly" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Select Year" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbYearlyYear"
                                  Template="{StaticResource StyledComboTemplate}"
                                  ItemContainerStyle="{StaticResource StyledComboItem}"
                                  Height="40"
                                  FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>

                    <!-- Mode 2: Monthly Selection -->
                    <StackPanel x:Name="PnlMonthly" Visibility="Visible" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMonthlyYear"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Month" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMonthlyMonth"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13">
                                    <ComboBoxItem Content="January" Tag="1"/>
                                    <ComboBoxItem Content="February" Tag="2"/>
                                    <ComboBoxItem Content="March" Tag="3"/>
                                    <ComboBoxItem Content="April" Tag="4"/>
                                    <ComboBoxItem Content="May" Tag="5"/>
                                    <ComboBoxItem Content="June" Tag="6"/>
                                    <ComboBoxItem Content="July" Tag="7"/>
                                    <ComboBoxItem Content="August" Tag="8"/>
                                    <ComboBoxItem Content="September" Tag="9"/>
                                    <ComboBoxItem Content="October" Tag="10"/>
                                    <ComboBoxItem Content="November" Tag="11"/>
                                    <ComboBoxItem Content="December" Tag="12"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Mode 3: Quarterly Selection -->
                    <StackPanel x:Name="PnlQuarterly" Visibility="Collapsed" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbQuarterlyYear"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quarter" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbQuarterlyQuarter"
                                          Template="{StaticResource StyledComboTemplate}"
                                          ItemContainerStyle="{StaticResource StyledComboItem}"
                                          Height="40"
                                          FontFamily="Segoe UI" FontSize="13">
                                    <ComboBoxItem Content="Q1 (Jan–Mar)" Tag="1"/>
                                    <ComboBoxItem Content="Q2 (Apr–Jun)" Tag="2"/>
                                    <ComboBoxItem Content="Q3 (Jul–Sep)" Tag="3"/>
                                    <ComboBoxItem Content="Q4 (Oct–Dec)" Tag="4"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Mode 4: Custom Range Selection -->
                    <StackPanel x:Name="PnlCustomRange" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Custom Date Range" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DpStartDate" Grid.Column="0"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        Style="{StaticResource BrandDatePicker}"/>
                            <DatePicker x:Name="DpEndDate" Grid.Column="2"
                                        SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        Style="{StaticResource BrandDatePicker}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Barangay Selection -->
                    <TextBlock Text="Barangay" FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFilterBarangay"
                              Template="{StaticResource StyledComboTemplate}"
                              ItemContainerStyle="{StaticResource StyledComboItem}"
                              Height="40"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,18"
                              SelectionChanged="FilterCombo_Changed">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Biñan"/>
                        <ComboBoxItem Content="Bungahan"/>
                        <ComboBoxItem Content="Canlalay"/>
                        <ComboBoxItem Content="Casile"/>
                        <ComboBoxItem Content="De La Paz"/>
                        <ComboBoxItem Content="Ganado"/>
                        <ComboBoxItem Content="Langkiwa"/>
                        <ComboBoxItem Content="Loma"/>
                        <ComboBoxItem Content="Malaban"/>
                        <ComboBoxItem Content="Malamig"/>
                        <ComboBoxItem Content="Mampalasan"/>
                        <ComboBoxItem Content="Platero"/>
                        <ComboBoxItem Content="Poblacion"/>
                        <ComboBoxItem Content="San Antonio"/>
                        <ComboBoxItem Content="San Francisco"/>
                        <ComboBoxItem Content="San Jose"/>
                        <ComboBoxItem Content="San Vicente"/>
                        <ComboBoxItem Content="Santo Domingo"/>
                        <ComboBoxItem Content="Santo Niño"/>
                        <ComboBoxItem Content="Santo Tomas"/>
                        <ComboBoxItem Content="Soro-Soro"/>
                        <ComboBoxItem Content="Timbao"/>
                        <ComboBoxItem Content="Tubigan"/>
                        <ComboBoxItem Content="Zapote"/>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="42" Cursor="Hand"
                                Click="FilterReset_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F5EEF1" CornerRadius="10"
                                            BorderBrush="#DCC8CE" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EDD8DE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#702943"/>
                        </Button>
                        <Button Grid.Column="2" Height="42" Cursor="Hand"
                                Click="FilterApply_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#702943" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
