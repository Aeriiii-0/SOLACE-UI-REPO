<Page x:Class="SOLUM_UI.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="clr-namespace:SOLUM_UI.Views.Components"
      Title="Analytics"
      Background="#FFFFFF">

    <Page.Resources>
        <!-- Date Picker Style (matching PreCheckDialog) -->
        <Style x:Key="AnalyticsDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9A3AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Foreground="#111111" Background="Transparent"
                                               BorderThickness="0" Padding="10,0"
                                               VerticalAlignment="Center" FontSize="12"/>
                            <ToggleButton x:Name="PART_Button" Grid.Column="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="18" Height="18"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Focusable="False"
                                    IsChecked="{Binding IsOpen, ElementName=PART_Popup, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19Z"
                                              Fill="#7B1426" Stretch="Uniform" Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False" MaxWidth="280">
                                <Border Background="White" CornerRadius="8" BorderBrush="#D9A3AB"
                                        BorderThickness="1" Padding="8,6" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="White"
                                              BorderThickness="0" Foreground="#222222" FontSize="12"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style (matching app design) -->
        <Style x:Key="AnalyticsComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#D9A3AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AnalyticsComboBoxItemStyle}"/>
        </Style>

        <Style x:Key="StatNum" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="LineHeight" Value="36"/>
        </Style>

        <Style x:Key="StatSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="BarLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Stat row template used by all bar charts -->
        <DataTemplate x:Key="StatRowTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#333333"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Pct}" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#888888" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Count}" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <!-- gradient progress bar -->
                <Border Grid.Row="1" CornerRadius="3" Background="#EAE0E5" Height="6" VerticalAlignment="Bottom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FillGridLength}"/>
                            <ColumnDefinition Width="{Binding EmptyGridLength}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3" Height="6" VerticalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{Binding GradStart}" Offset="0"/>
                                    <GradientStop Color="{Binding GradEnd}"   Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="RecentItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDF0F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Missing Brushes for Filter Panel -->
        <SolidColorBrush x:Key="BodyTextBrush" Color="#2B1A1C"/>
        <SolidColorBrush x:Key="PrimaryMaroonBrush" Color="#7B1426"/>
        <SolidColorBrush x:Key="BorderMaroonBrush" Color="#EAD9DB"/>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderMaroonBrush}" BorderThickness="0,0,0,1" Padding="16,12,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range Picker -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker x:Name="DpDateFrom" Style="{StaticResource AnalyticsDatePicker}" Width="140"
                                SelectedDateChanged="DateRange_Changed" ToolTip="Start date" Margin="0,0,8,0"/>
                    <TextBlock Text="—" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpDateTo" Style="{StaticResource AnalyticsDatePicker}" Width="140"
                                SelectedDateChanged="DateRange_Changed" ToolTip="End date"/>
                </StackPanel>

                <!-- Filter Button -->
                <Button Grid.Column="1" x:Name="FilterBtn" Style="{StaticResource AnalyticsButtonStyle}" 
                        Click="FilterDrop_Click" Padding="12,6" Margin="12,0,0,0" Height="36"
                        ToolTip="Filter data by year, month, barangay">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z" Fill="{StaticResource BodyTextBrush}"
                              Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Filter" Foreground="{StaticResource BodyTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Export Button -->
                <Button Grid.Column="2" Style="{StaticResource AnalyticsButtonStyle}" 
                        Click="ExportXlsx_Click" Padding="12,6" Margin="8,0,0,0" Height="36"
                        ToolTip="Export to Excel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Fill="{StaticResource BodyTextBrush}"
                              Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Export" Foreground="{StaticResource BodyTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Last Refresh -->
                <Border Grid.Column="3" Background="{StaticResource TintMaroonBrush}" CornerRadius="4" 
                        Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource PrimaryMaroonBrush}" 
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtLastRefresh" Text="" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Avatar Placeholder -->

            </Grid>
        </Border>

        <!-- Filter Dropdown Popup (Card style, below button) -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterBtn}" Placement="Bottom" 
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Margin="0,4,0,0">
            <Border Background="White" CornerRadius="14" BorderBrush="#E0D0D5" BorderThickness="1" 
                    Padding="20,18,20,18" MinWidth="280">
                <Border.Effect>
                    <DropShadowEffect Color="#C0A0AA" BlurRadius="16" ShadowDepth="4" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Year -->
                    <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#1A1A1A" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbFilterYear" Style="{StaticResource AnalyticsComboBox}" Margin="0,0,0,16"/>

                    <!-- Month -->
                    <TextBlock Text="Month" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#1A1A1A" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbFilterMonth" Style="{StaticResource AnalyticsComboBox}" Margin="0,0,0,16"/>

                    <!-- Barangay -->
                    <TextBlock Text="Barangay" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#1A1A1A" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbFilterBarangay" Style="{StaticResource AnalyticsComboBox}" Margin="0,0,0,16"/>

                    <!-- Action Buttons -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Height="42" Click="FilterReset_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#F0F0F0" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="#555555"/>
                        </Button>
                        
                        <Button Grid.Column="2" Height="42" Click="FilterApply_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Apply Now" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="White"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="White">
            <Grid Margin="16,16,16,24" MinWidth="1100" MinHeight="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: KPI Cards (6 cards stacked with progressive color darkening) -->
                <StackPanel Grid.Column="0">
                    <components:KpiCard Value="{Binding PantawidBeneficiaryCount}" Label="Pantawid"
                                       CardStyle="{StaticResource KpiCardStyle1}"
                                       ValueStyle="{StaticResource KpiValueStyle1}"
                                       LabelStyle="{StaticResource KpiLabelStyle1}" Margin="0,0,0,10"/>
                    <components:KpiCard Value="{Binding LgbtCount}" Label="LGBT" Margin="0,0,0,10"
                                       CardStyle="{StaticResource KpiCardStyle2}"
                                       ValueStyle="{StaticResource KpiValueStyle2}"
                                       LabelStyle="{StaticResource KpiLabelStyle2}"/>
                    <components:KpiCard Value="{Binding TotalDependents}" Label="Total Dependents" Margin="0,0,0,10"
                                       CardStyle="{StaticResource KpiCardStyle3}"
                                       ValueStyle="{StaticResource KpiValueStyle3}"
                                       LabelStyle="{StaticResource KpiLabelStyle3}"/>
                    <components:KpiCard Value="{Binding MaleCount}" Label="Male" Margin="0,0,0,10"
                                       CardStyle="{StaticResource KpiCardStyle4}"
                                       ValueStyle="{StaticResource KpiValueStyle4}"
                                       LabelStyle="{StaticResource KpiLabelStyle4}"/>
                    <components:KpiCard Value="{Binding FemaleCount}" Label="Female" Margin="0,0,0,10"
                                       CardStyle="{StaticResource KpiCardStyle5}"
                                       ValueStyle="{StaticResource KpiValueStyle5}"
                                       LabelStyle="{StaticResource KpiLabelStyle5}"/>
                    <components:KpiCard Value="{Binding TotalSoloParents}" Label="Total Solo Parents"
                                       CardStyle="{StaticResource KpiCardStyle6}"
                                       ValueStyle="{StaticResource KpiValueStyle6}"
                                       LabelStyle="{StaticResource KpiLabelStyle6}"/>
                </StackPanel>

                <!-- Right Column: Charts Grid -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Area Chart (Top 10 Barangays) - Full Width -->
                    <Border Grid.Row="0" Style="{StaticResource CardContainerStyle}" Height="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Top 10 Barangays" Style="{StaticResource ChartTitleStyle}" Margin="0,0,0,10"/>
                            <components:AreaChart Grid.Row="1" x:Name="AreaChartBarangay" Data="{Binding BarangayData}"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: 3-Column Grid (Donut, Civil Status, Employment) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Donut: Age Group -->
                        <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}" Height="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Age Group" Style="{StaticResource ChartTitleStyle}" Margin="0,0,0,10"/>
                                <components:DonutChart Grid.Row="1" x:Name="DonutChartAge" Data="{Binding AgeGroupData}"/>
                            </Grid>
                        </Border>

                        <!-- List: Civil Status -->
                        <Border Grid.Column="2" Style="{StaticResource CardContainerStyle}" Height="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Civil Status" Style="{StaticResource ChartTitleStyle}" Margin="0,0,0,10"/>
                                <components:CivilStatusListCard Grid.Row="1" x:Name="CivilStatusListCard" Data="{Binding CivilStatusData}"/>
                            </Grid>
                        </Border>

                        <!-- Progress Rows: Employment Status -->
                        <Border Grid.Column="4" Style="{StaticResource CardContainerStyle}" Height="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Employment" Style="{StaticResource ChartTitleStyle}" Margin="0,0,0,10"/>
                                <components:ProgressRowList Grid.Row="1" x:Name="EmploymentProgressList" Data="{Binding EmploymentStatusData}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 3: 2-Column Grid (Column Chart for Dependents, Progress for Income) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column Chart: Dependents Age -->
                        <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}" Height="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Dependents Age" Style="{StaticResource ChartTitleStyle}" Margin="0,0,0,10"/>
                                <components:ColumnChart Grid.Row="1" x:Name="ColumnChartDependents" Data="{Binding DependentsAgeData}"/>
                            </Grid>
                        </Border>

                        <!-- Progress Rows: Income Brackets -->
                        <Border Grid.Column="2" Style="{StaticResource CardContainerStyle}" Height="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Income" Style="{StaticResource ChartTitleStyle}" Margin="0,0,0,10"/>
                                <components:ProgressRowList Grid.Row="1" x:Name="IncomeProgressList" Data="{Binding IncomeBracketData}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <components:LoadingOverlay x:Name="AnalyticsLoadingOverlay" Grid.RowSpan="2" Panel.ZIndex="9999"/>
    </Grid>
</Page>
