<Window x:Class="SOLUM_UI.ExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border Background="#66000000">
        <Border x:Name="Shell" Background="White" CornerRadius="18"
                ClipToBounds="True" Width="460"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="0" Opacity="0.24"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="36,32,36,0">
                    <Border Width="52" Height="52" CornerRadius="26" Background="#F0E8EC"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                              Fill="#702943" Stretch="Uniform" Width="22" Height="22"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Export Options" FontFamily="Segoe UI" FontSize="22"
                               FontWeight="Bold" Foreground="#111111" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFileName" Text="" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#999999" HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="36,24,36,0">

                    <Border Background="#FAFAFA" CornerRadius="12" BorderBrush="#E8E0E4"
                            BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="ChkPassword" VerticalAlignment="Center"
                                          Checked="ChkPassword_Changed" Unchecked="ChkPassword_Changed"
                                          Cursor="Hand">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                                        Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5"
                                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Path x:Name="Check" Data="M4,9L8,13L16,5"
                                                          Stroke="White" StrokeThickness="2.2"
                                                          Visibility="Collapsed"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Box" Property="Background" Value="#702943"/>
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#702943"/>
                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                    <TextBlock Text="Password protect the file" FontFamily="Segoe UI"
                                               FontSize="13" Foreground="#222222" FontWeight="SemiBold"/>
                                </CheckBox>
                            </StackPanel>

                            <Border Grid.Row="1" x:Name="PasswordSection" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Set password" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#888888" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="8" BorderBrush="#D0B8C0"
                                                BorderThickness="1.5" Background="White" Grid.ColumnSpan="2">
                                            <Grid>
                                                <PasswordBox x:Name="PwdBox" BorderThickness="0" Background="Transparent"
                                                             FontFamily="Segoe UI" FontSize="13" Padding="12,0,40,0" Height="38"
                                                             VerticalContentAlignment="Center"/>
                                                <Button x:Name="BtnTogglePwd" Width="28" Height="28"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Margin="0,0,6,0" Cursor="Hand" Click="BtnTogglePwd_Click"
                                                        Background="Transparent" BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Path x:Name="EyePath"
                                                          Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                                          Fill="#BBBBBB" Stretch="Uniform" Width="16" Height="16"/>
                                                </Button>
                                                <TextBox x:Name="PwdBoxVisible" BorderThickness="0" Background="Transparent"
                                                         FontFamily="Segoe UI" FontSize="13" Padding="12,0,40,0" Height="38"
                                                         VerticalContentAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Anyone opening this file will need this password."
                                               FontFamily="Segoe UI" FontSize="10" Foreground="#AAAAAA" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="#FAFAFA" CornerRadius="12" BorderBrush="#E8E0E4"
                            BorderThickness="1" Padding="18,14" Margin="0,0,0,0">
                        <CheckBox x:Name="ChkOpenAfter" IsChecked="True" Cursor="Hand">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                                Background="White" BorderBrush="#D0B8C0" BorderThickness="1.5"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path x:Name="Check" Data="M4,9L8,13L16,5"
                                                  Stroke="White" StrokeThickness="2.2"
                                                  Visibility="Visible"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="#702943"/>
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#702943"/>
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Box" Property="Background" Value="White"/>
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#D0B8C0"/>
                                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                            <TextBlock Text="Open file after export" FontFamily="Segoe UI"
                                       FontSize="13" Foreground="#222222" FontWeight="SemiBold"/>
                        </CheckBox>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Background="White" BorderBrush="#EEEEEE"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="36,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="46" Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="10"
                                            BorderBrush="#DDDDDD" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#555555"/>
                        </Button>
                        <Button Grid.Column="2" Height="46" Cursor="Hand" Click="BtnExport_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Export" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
