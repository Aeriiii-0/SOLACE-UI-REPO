<Window x:Class="SOLUM_UI.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="320"
        SizeToContent="Height"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="RootBorder"
            Background="White"
            BorderBrush="#702943"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="12,12,8,12"
            Margin="6,4,6,4"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="340" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.14"/>
        </Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="SlideTransform"
                            Storyboard.TargetProperty="X"
                            From="340" To="0"
                            Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconTile"
                    Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#F5E2E8"
                    SnapsToDevicePixels="True">
                <Viewbox Width="17" Height="17"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="IconPath"
                          Width="24" Height="24"
                          Stretch="Uniform"
                          Fill="#702943"
                          SnapsToDevicePixels="True"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1A1020"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtMessage"
                           FontFamily="Segoe UI"
                           FontSize="11.5"
                           Foreground="#6B5A62"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Width="24" Height="24"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    Focusable="False"
                    Click="CloseBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#F3E8EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                      Fill="#9B8A92" Stretch="Uniform" Width="9" Height="9"/>
            </Button>
        </Grid>
    </Border>
</Window>
