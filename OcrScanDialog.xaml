<Window x:Class="SOLUM_UI.OcrScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solace — OCR Document Ingestion &amp; Verification"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Width="1380" Height="860">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBg" Background="White" BorderBrush="#D0D0D0"
                                    BorderThickness="1.2" CornerRadius="6">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="Select..."
                                               Foreground="#BBBBBB" FontSize="12"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="10" Height="10"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ComboBg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DateBg" Background="White" BorderBrush="#D0D0D0"
                                BorderThickness="1.2" CornerRadius="6">
                            <Grid Margin="10,0,10,0">
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   HorizontalContentAlignment="Left"
                                                   VerticalContentAlignment="Center"
                                                   FontSize="12" Foreground="#111111"
                                                   BorderThickness="0" Background="Transparent"
                                                   FocusVisualStyle="{x:Null}"
                                                   SelectionBrush="#702943"
                                                   Focusable="True">
                                    <DatePickerTextBox.Style>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Focusable="False"
                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                      VerticalScrollBarVisibility="Hidden"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePickerTextBox.Style>
                                </DatePickerTextBox>
                                <Button x:Name="PART_Button"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="20" Height="20" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Path Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.9 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                                                  Fill="#702943" Stretch="Uniform" Width="14" Height="14"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" Placement="Bottom"
                                       AllowsTransparency="True" StaysOpen="False">
                                    <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0"
                                            BorderThickness="1" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.12"/>
                                        </Border.Effect>
                                        <Calendar x:Name="PART_Calendar" Background="White"
                                                  BorderThickness="0" Foreground="#222222"
                                                  FontSize="12"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DateBg" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="DateBg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,4,14,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="#702943"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardSectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#702943"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FormBoxSm" TargetType="TextBox" BasedOn="{StaticResource FormBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="FormDateSm" TargetType="DatePicker" BasedOn="{StaticResource FormDate}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FieldLabelSm" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow and Dialog Shell -->
    <Border Background="#44000000" Padding="0">
        <Border Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>
            <Border x:Name="DialogShell" Background="White" CornerRadius="16"
                    ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Header -->
                        <RowDefinition Height="56"/>
                        <!-- Main Body: Split Viewport (Left) vs 1:1 Record Form (Right) -->
                        <RowDefinition Height="*"/>
                        <!-- Footer Navigation -->
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>

                    <!-- TOP HEADER -->
                    <Border Grid.Row="0" Background="#702943" CornerRadius="16,16,0,0" Padding="20,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel>
                                    <TextBlock Text="OCR Document Ingestion &amp; Verification" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="City of Biñan CSWDO Application Form for Solo Parent (CSWDO-066-2)" FontSize="11" Foreground="#E0B8C4"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ServerStatusBadge"
                                        Width="14" Height="14" CornerRadius="7"
                                        Background="#10B981" BorderBrush="#55FFFFFF" BorderThickness="1.5"
                                        Margin="0,0,16,0" Cursor="Hand" VerticalAlignment="Center"
                                        MouseLeftButtonUp="ServerStatusBadge_MouseLeftButtonUp"
                                        ToolTipService.InitialShowDelay="50"
                                        ToolTipService.BetweenShowDelay="0"
                                        ToolTipService.ShowDuration="15000">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                    </Border.Effect>
                                </Border>

                                <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="30" Height="30">
                                    <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN WORKSPACE -->
                    <Grid Grid.Row="1" Margin="14,10">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Document Viewport (~44% width) -->
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="12"/>
                            <!-- Right: 1:1 Partitioned Record Verification (~56% width) -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: INTERACTIVE LIVE DOCUMENT VIEWPORT -->
                        <Border Grid.Column="0" Background="#F9F6F7" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Viewport Toolbar -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnScanHardware" Content="Scan Document" Click="ScanHardware_Click"
                                                Height="28" Padding="10,0" Background="#702943" Foreground="White" FontWeight="SemiBold"
                                                FontSize="11" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button x:Name="BtnScannerSettings" Content="Scanner Settings" Click="ScannerSettings_Click"
                                                Height="28" Padding="8,0" Background="#541B2D" Foreground="White" FontWeight="SemiBold"
                                                FontSize="11" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button x:Name="BtnSelectImage" Content="Upload File" Click="SelectImage_Click"
                                                Height="28" Padding="8,0" Background="#541B2D" Foreground="White" FontWeight="SemiBold"
                                                FontSize="11" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button x:Name="BtnAdjustTemplate" Content="Adjust Boxes" Click="AdjustTemplate_Click"
                                                Height="28" Padding="8,0" Background="#4A1D2B" Foreground="White" FontWeight="SemiBold"
                                                FontSize="11" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button x:Name="BtnViewDetections" Content="View AI Boxes" Click="ViewDetections_Click"
                                                Height="28" Padding="8,0" Background="#3D1723" Foreground="White" FontWeight="SemiBold"
                                                FontSize="11" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0" ToolTip="Open the visual detections overlay">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>

                                    <!-- Zoom Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="-" Click="ZoomOut_Click" Width="24" Height="24" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,3,0" FontWeight="Bold" FontSize="11"/>
                                        <Button Content="Fit" Click="ZoomFit_Click" Height="24" Padding="5,0" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,3,0" FontSize="10"/>
                                        <Button Content="+" Click="ZoomIn_Click" Width="24" Height="24" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Scrollable Pan & Zoom Document Canvas -->
                                <Border Grid.Row="1" Background="#E8E2E4" CornerRadius="8" ClipToBounds="True" BorderBrush="#D0C0C6" BorderThickness="1">
                                    <Grid>
                                        <ScrollViewer x:Name="DocScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                      PreviewMouseLeftButtonDown="DocScrollViewer_PreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="DocScrollViewer_PreviewMouseMove"
                                                      PreviewMouseLeftButtonUp="DocScrollViewer_PreviewMouseLeftButtonUp"
                                                      Cursor="Hand">
                                            <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image x:Name="ImgDocument" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False"
                                                        Width="{Binding ActualWidth, ElementName=ImgDocument}"
                                                        Height="{Binding ActualHeight, ElementName=ImgDocument}"/>
                                            </Grid>
                                        </ScrollViewer>

                                        <!-- Empty State Canvas Graphic -->
                                        <Grid x:Name="EmptyCanvasState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Visible">
                                            <Border Background="White" CornerRadius="12" Padding="22,18" BorderBrush="#D0C0C6" BorderThickness="1" MaxWidth="360">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="44" Height="44" CornerRadius="22" Background="#FBF6F8" BorderBrush="#E5D8DC" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="#702943" Data="M19,8H5C3.34,8 2,9.34 2,11V17H6V21H18V17H22V11C22,9.34 20.66,8 19,8M16,19H8V15H16V19M19,12C18.45,12 18,11.55 18,11C18,10.45 18.45,10 19,10C19.55,10 20,10.45 20,11C20,11.55 19.55,12 19,12M18,3H6V7H18V3Z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Text="Document Scanner Ready" FontSize="14" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="Place application form on scanner glass and click Scan Document, or select an existing file."
                                                               FontSize="11" Foreground="#777777" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                    <Border Background="#F9F5F6" CornerRadius="6" Padding="8,5" Margin="0,0,0,12" BorderBrush="#EADCE0" BorderThickness="1">
                                                        <TextBlock x:Name="TxtScannerStatusBadge" Text="Status: Scanner Ready (300 DPI)" FontSize="10" FontWeight="SemiBold" Foreground="#702943" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Scan Document" Click="ScanHardware_Click" Height="28" Padding="12,0"
                                                                Background="#702943" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Content="Upload File" Click="SelectImage_Click" Height="28" Padding="10,0"
                                                                Background="#F6F0F2" Foreground="#702943" BorderBrush="#D0B8C0" BorderThickness="1"
                                                                FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT: 1:1 RECORD DIALOG FORM WITH STEP 1 & STEP 2 PARTITIONING -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="10" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Step Wizard Indicator -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Scrollable Partitioned Content -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- STEP INDICATOR HEADER -->
                                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#EEEEEE"
                                        BorderThickness="0,0,0,1" Padding="20,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Step1Header_Click">
                                            <Border x:Name="Step1Dot" Width="26" Height="26" CornerRadius="13"
                                                    Background="#702943">
                                                <TextBlock Text="1" Foreground="White" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Personal Info" FontSize="12" FontWeight="Bold"
                                                           Foreground="#702943"/>
                                                <TextBlock Text="Identity, contact &amp; emergency" FontSize="10" Foreground="#888888"/>
                                            </StackPanel>
                                        </StackPanel>

