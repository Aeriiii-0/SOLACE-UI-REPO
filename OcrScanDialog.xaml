                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Emergency Contact Address" Style="{StaticResource FieldLabel}"/>
                                                                <Border x:Name="Badge_EmergencyAddress" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                    <TextBlock x:Name="TxtConf_EmergencyAddress" Text="—" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBox x:Name="TxtEmergencyAddress" Style="{StaticResource FormBox}"
                                                                     Tag="emergency_address" GotFocus="Field_GotFocus"/>
                                                        </StackPanel>
                                                    </Grid>

                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- ======================== STEP 2: CIRCUMSTANCES & FAMILY ======================== -->
                                    <ScrollViewer x:Name="ScrollStep2" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="#F4F6F9" Visibility="Collapsed">
                                        <StackPanel Margin="18,10,18,14">

                                            <!-- CARD: II. PROBLEM PRESENTED / CIRCUMSTANCE -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="II. PROBLEM PRESENTED / CIRCUMSTANCE OF BEING SOLO PARENT"
                                                                       Style="{StaticResource SectionLabel}"/>
                                                            <Border x:Name="BadgeCircumstanceDetected" Grid.Column="1" Background="#E6F9EE" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                                                                <TextBlock x:Name="TxtCircumstanceBadge" Text="● Encircled Detected" FontSize="10" FontWeight="Bold" Foreground="#27AE60"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Column 1: A1, A2, A3, A4 -->
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <CheckBox x:Name="ChkA1" Style="{StaticResource FormCheck}" Tag="circ_a1" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A1. " FontWeight="Bold"/><Run Text="Birth as result of rape"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkA2" Style="{StaticResource FormCheck}" Tag="circ_a2" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A2. " FontWeight="Bold"/><Run Text="Death of Spouse"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>
                                                            <StackPanel x:Name="PnlA2" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="8"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Cause of death" Style="{StaticResource FieldLabelSm}"/>
                                                                        <TextBox x:Name="TxtA2Cause" Style="{StaticResource FormBoxSm}" Tag="circ_a2_cause" GotFocus="Field_GotFocus"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Date" Style="{StaticResource FieldLabelSm}"/>
                                                                        <DatePicker x:Name="DpA2Date" Style="{StaticResource FormDateSm}" Tag="circ_a2_date"
                                                                                    GotFocus="Field_GotFocus" GotKeyboardFocus="Field_GotFocus"
                                                                                    PreviewMouseLeftButtonDown="Field_PreviewMouseDown"
                                                                                    CalendarOpened="DatePicker_CalendarOpened"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>

                                                            <CheckBox x:Name="ChkA3" Style="{StaticResource FormCheck}" Tag="circ_a3" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A3. " FontWeight="Bold"/><Run Text="Detention of Spouse"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkA4" Style="{StaticResource FormCheck}" Tag="circ_a4" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A4. " FontWeight="Bold"/><Run Text="Physical/Mental Incapacity"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>
                                                            <StackPanel x:Name="PnlA4" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Type of disability" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtA4Disability" Style="{StaticResource FormBoxSm}" Tag="circ_a4_disability" GotFocus="Field_GotFocus"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Column 2: A5, A6, A7, B -->
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <CheckBox x:Name="ChkA5" Style="{StaticResource FormCheck}" Tag="circ_a5" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A5. " FontWeight="Bold"/><Run Text="Separation from spouse"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>
                                                            <StackPanel x:Name="PnlA5" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Period of separation" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtA5Period" Style="{StaticResource FormBoxSm}" Tag="circ_a5_period" GotFocus="Field_GotFocus"/>
                                                            </StackPanel>

                                                            <CheckBox x:Name="ChkA6" Style="{StaticResource FormCheck}" Tag="circ_a6" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A6. " FontWeight="Bold"/><Run Text="Nullity / Annulment"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkA7" Style="{StaticResource FormCheck}" Tag="circ_a7" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="A7. " FontWeight="Bold"/><Run Text="Abandonment (6+ mos)"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkB" Style="{StaticResource FormCheck}" Tag="circ_b" GotFocus="Field_GotFocus"
                                                                      Checked="Circumstance_Changed" Unchecked="Circumstance_Changed">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="B. " FontWeight="Bold"/><Run Text="OFW Spouse / Family"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>
                                                            <StackPanel x:Name="PnlB" Visibility="Collapsed" Margin="18,0,0,4">
                                                                <TextBlock Text="Length of stay abroad" Style="{StaticResource FieldLabelSm}"/>
                                                                <TextBox x:Name="TxtBStayAbroad" Style="{StaticResource FormBoxSm}" Tag="circ_b_stay" GotFocus="Field_GotFocus"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Column 3: C, D, E, F -->
                                                        <StackPanel Grid.Column="2">
                                                            <CheckBox x:Name="ChkC" Style="{StaticResource FormCheck}" Tag="circ_c" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="C. " FontWeight="Bold"/><Run Text="Unmarried Mother/Father"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkD" Style="{StaticResource FormCheck}" Tag="circ_d" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="D. " FontWeight="Bold"/><Run Text="Legal Guardian / Foster"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkE" Style="{StaticResource FormCheck}" Tag="circ_e" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock TextWrapping="Wrap" FontSize="11">
                                                                        <Run Text="E. " FontWeight="Bold"/><Run Text="Relative 4th degree"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>

                                                            <CheckBox x:Name="ChkF" Style="{StaticResource FormCheck}" Tag="circ_f" GotFocus="Field_GotFocus">
                                                                <CheckBox.Content>
                                                                    <TextBlock FontSize="11">
                                                                        <Run Text="F. " FontWeight="Bold"/><Run Text="Pregnant Woman"/>
                                                                    </TextBlock>
                                                                </CheckBox.Content>
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: III. FAMILY COMPOSITION -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <TextBlock Text="III. FAMILY COMPOSITION (Include household dependents)"
                                                                   Style="{StaticResource SectionLabel}"/>
                                                    </Border>
                                                    <!-- Table header -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Name" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="1" Text="Sex" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2" Text="Age" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="3" Text="Birthdate" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="4" Text="Civil Stat" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="5" Text="Relation" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="6" Text="Educ / Job" FontSize="10" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="7" Text="Income" FontSize="10" FontWeight="Bold" Foreground="#555555"/>
                                                    </Grid>
                                                    <ItemsControl x:Name="FamilyRows">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="45"/>
                                                                        <ColumnDefinition Width="45"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="1.5*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="4,0"
                                                                             VerticalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_name" GotFocus="Field_GotFocus"
                                                                             PreviewTextInput="NameOnly_PreviewTextInput"
                                                                             Text="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="1" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="2,0"
                                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_sex" GotFocus="Field_GotFocus"
                                                                             MaxLength="6"
                                                                             PreviewTextInput="NameOnly_PreviewTextInput"
                                                                             Text="{Binding Sex, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="2" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="2,0"
                                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_age" GotFocus="Field_GotFocus"
                                                                             MaxLength="3"
                                                                             PreviewTextInput="NumberOnly_PreviewTextInput"
                                                                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="3" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="4,0"
                                                                             VerticalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_dob" GotFocus="Field_GotFocus"
                                                                             LostFocus="FamilyBirthdate_LostFocus"
                                                                             Text="{Binding Birthdate, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="4" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="4,0"
                                                                             VerticalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_civ" GotFocus="Field_GotFocus"
                                                                             Text="{Binding CivilStatus, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="5" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="4,0"
                                                                             VerticalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_rel" GotFocus="Field_GotFocus"
                                                                             Text="{Binding Relationship, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="6" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="4,0"
                                                                             VerticalContentAlignment="Center" Margin="0,0,3,0"
                                                                             Tag="fam_row1_edu" GotFocus="Field_GotFocus"
                                                                             Text="{Binding EducationEmployment, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <TextBox Grid.Column="7" Height="28" FontSize="11"
                                                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                                                             Background="White" Padding="4,0"
                                                                             VerticalContentAlignment="Center"
                                                                             Tag="fam_row1_inc" GotFocus="Field_GotFocus"
                                                                             Text="{Binding Income, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="+ Add Row" Click="AddFamilyRow_Click"
                                                            Margin="0,6,0,0" HorizontalAlignment="Left"
                                                            Height="28" Padding="12,0"
                                                            Background="White" Foreground="#702943"
                                                            FontSize="11" FontWeight="SemiBold"
                                                            BorderBrush="#702943" BorderThickness="1"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#FDF0F3"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: IV. NEEDS AND PROBLEMS -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="IV. NEEDS AND PROBLEMS" Style="{StaticResource SectionLabel}"/>
                                                            <Border x:Name="Badge_Needs" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                <TextBlock x:Name="TxtConf_Needs" Text="—" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBox x:Name="TxtNeeds" Style="{StaticResource FormBox}"
                                                             Tag="needs" GotFocus="Field_GotFocus"
                                                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             VerticalContentAlignment="Top" Padding="10,6"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: V. OTHER SOURCES OF INCOME -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="V. OTHER SOURCES OF INCOME" Style="{StaticResource SectionLabel}"/>
                                                            <Border x:Name="Badge_OtherIncome" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                                <TextBlock x:Name="TxtConf_OtherIncome" Text="—" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBox x:Name="TxtOtherIncome" Style="{StaticResource FormBox}"
                                                             Tag="other_income" GotFocus="Field_GotFocus"
                                                             Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             VerticalContentAlignment="Top" Padding="10,6"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- CARD: VI. APPLICATION STATUS -->
                                            <Border Style="{StaticResource CardSection}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource CardSectionHeader}">
                                                        <TextBlock Text="VI. APPLICATION STATUS" Style="{StaticResource SectionLabel}"/>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox x:Name="CmbStatus" Style="{StaticResource FormCombo}"
                                                                      Tag="status" GotFocus="Field_GotFocus"
                                                                      SelectionChanged="CmbStatus_SelectionChanged">
                                                                <ComboBoxItem Content="Valid" IsSelected="True"/>
                                                                <ComboBoxItem Content="Inactive"/>
                                                            </ComboBox>
                                                            <TextBlock x:Name="ErrStatus" Text="Required." Style="{StaticResource ErrorText}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- FOOTER ACTIONS -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0" Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ValidationMessage"
                                           Text=""
                                           FontSize="11" Foreground="#E53935"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtOverallConfBadge"
                                           Text="Overall AI Confidence: 0%"
                                           FontSize="11" Foreground="#702943" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Close_Click"/>
                                <Button x:Name="BtnBack" Content="&#x2190; Back" Style="{StaticResource CancelBtn}"
                                        Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
                                <Button x:Name="BtnNext" Content="Next &#x2192;" Style="{StaticResource SaveBtn}"
                                        Click="Next_Click"/>
                                <Button x:Name="BtnSave" Content="Save Record" Style="{StaticResource SaveBtn}"
                                        Click="Save_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OCR PROCESSING MODAL OVERLAY -->
                    <Grid x:Name="OverlayProcessing" Grid.RowSpan="3" Visibility="Collapsed" Background="#77000000">
                        <Border Background="White" CornerRadius="16" Width="420" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="50" Height="50" CornerRadius="25" Background="#F9F2F4" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#702943" Data="M19,8H5C3.34,8 2,9.34 2,11V17H6V21H18V17H22V11C22,9.34 20.66,8 19,8M16,19H8V15H16V19M19,12C18.45,12 18,11.55 18,11C18,10.45 18.45,10 19,10C19.55,10 20,10.45 20,11C20,11.55 19.55,12 19,12M18,3H6V7H18V3Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Ingesting Application Form..." FontSize="15" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtProcessingStep" Text="Analyzing document structure..." FontSize="11" Foreground="#702943" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <ProgressBar x:Name="OcrStageProgressBar" Height="6" Minimum="0" Maximum="100" Value="10" Foreground="#702943" Background="#F0E8EA" BorderThickness="0" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="⏱ Elapsed: " FontSize="10" FontWeight="SemiBold" Foreground="#888888"/>
                                    <TextBlock x:Name="TxtLiveElapsedTime" Text="0.0s" FontSize="10" FontWeight="Bold" Foreground="#702943"/>
                                </StackPanel>
                                <Border Background="#FAF7F8" CornerRadius="6" Padding="10,6" BorderBrush="#EADCE0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Active Task:" FontSize="10" FontWeight="Bold" Foreground="#702943" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtCurrentExtractingField" Grid.Column="1" Text="Deskewing and enhancing scan..." FontSize="10" Foreground="#555" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>
        </Border>
    </Border>
</Window>
