<Window x:Class="SOLUM_UI.OcrScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solace — OCR Document Ingestion &amp; Calibration"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1260" Height="820"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#33000000">
        <Border Background="White" CornerRadius="16" Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="60"/>
                    <!-- Main Body (Split into Document Viewport & HITL Review) -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Actions -->
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- TOP HEADER -->
                <Border Grid.Row="0" Background="#702943" CornerRadius="16,16,0,0" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="OCR Document Ingestion &amp; Verification" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="City of Biñan CSWDO Application Form for Solo Parent (CSWDO-066-2)" FontSize="11" Foreground="#E0B8C4"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ServerStatusBadge" Background="#388E3C" CornerRadius="12" Padding="10,4" Margin="0,0,16,0" Cursor="Hand" MouseLeftButtonUp="ServerStatusBadge_MouseLeftButtonUp" ToolTip="Click to check status or restart OCR Engine">
                                <TextBlock x:Name="TxtServerStatus" Text="● OCR Engine Online" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>

                            <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="32">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE -->
                <Grid Grid.Row="1" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Document Viewport (Fitted & Zoomable) -->
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="14"/>
                        <!-- Right: HITL Review & Family Members -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: DOCUMENT VIEWPORT -->
                    <Border Grid.Column="0" Background="#F9F6F7" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Controls Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSelectImage" Content="📁 Upload Scan" Click="SelectImage_Click"
                                            Height="30" Padding="12,0" Background="#702943" Foreground="White" FontWeight="SemiBold"
                                            FontSize="12" BorderThickness="0" Cursor="Hand"/>

                                    <Button x:Name="BtnAdjustTemplate" Content="📐 Adjust Field Boxes" Click="AdjustTemplate_Click"
                                            Height="30" Padding="10,0" Background="#541B2D" Foreground="White" FontWeight="SemiBold"
                                            FontSize="11" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="TxtImageStatus" Grid.Column="1" Text="Select document to auto-extract" FontSize="11"
                                           Foreground="#888888" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>

                                <!-- Zoom Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="-" Click="ZoomOut_Click" Width="26" Height="26" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,4,0" FontWeight="Bold"/>
                                    <Button Content="Fit" Click="ZoomFit_Click" Height="26" Padding="6,0" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" Margin="0,0,4,0" FontSize="11"/>
                                    <Button Content="+" Click="ZoomIn_Click" Width="26" Height="26" Background="White" BorderBrush="#D0C0C6" BorderThickness="1" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Document Preview Container (Draggable & Auto-Zoomable) -->
                            <Border Grid.Row="1" Background="#E8E2E4" CornerRadius="8" ClipToBounds="True" BorderBrush="#D0C0C6" BorderThickness="1">
                                <ScrollViewer x:Name="DocScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseLeftButtonDown="DocScrollViewer_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="DocScrollViewer_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="DocScrollViewer_PreviewMouseLeftButtonUp"
                                              Cursor="Hand">
                                    <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="ImgDocument" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Canvas x:Name="HighlightCanvas" IsHitTestVisible="False"
                                                Width="{Binding ActualWidth, ElementName=ImgDocument}"
                                                Height="{Binding ActualHeight, ElementName=ImgDocument}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT: HITL VERIFICATION & DEPENDENTS TABLE -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E5D8DC" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Overall Confidence Banner -->
                            <Border Grid.Row="0" Background="#FDF8F9" BorderBrush="#EADCE0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Human-in-the-Loop Verification" FontSize="13" FontWeight="Bold" Foreground="#702943"/>
                                        <TextBlock Text="Verify and edit the extracted information below before committing to records." FontSize="11" Foreground="#777777"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Confidence:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border x:Name="BadgeOverallConfidence" Background="#E6F9EE" CornerRadius="10" Padding="8,3">
                                            <TextBlock x:Name="TxtOverallConfidence" Text="— %" FontSize="11" FontWeight="Bold" Foreground="#27AE60"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scrollable Fields & Family Grid -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel>

                                    <!-- Section 1: Identifying Information -->
                                    <Border Background="#F9F2F4" CornerRadius="4" Padding="6,3" Margin="0,2,0,6">
                                        <TextBlock Text="I. IDENTIFYING INFORMATION" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Last Name" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_LastName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_LastName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtLastName" Height="26" FontSize="12"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="First Name" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_FirstName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_FirstName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtFirstName" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Middle Name" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_MiddleName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_MiddleName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtMiddleName" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ext." FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Extension" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Extension" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbExtension" Height="26" FontSize="12">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="Jr."/>
                                                <ComboBoxItem Content="Sr."/>
                                                <ComboBoxItem Content="II"/>
                                                <ComboBoxItem Content="III"/>
                                                <ComboBoxItem Content="IV"/>
                                                <ComboBoxItem Content="V"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Birthdate" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Birthdate" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Birthdate" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3.8*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="2.0*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="2.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CmbBirthMonth" Height="26" FontSize="11" Foreground="#333333" SelectedIndex="0" ToolTip="Select Month" SelectionChanged="BirthdateField_Changed">
                                                    <ComboBoxItem Content="Month"/>
                                                    <ComboBoxItem Content="01 - Jan"/>
                                                    <ComboBoxItem Content="02 - Feb"/>
                                                    <ComboBoxItem Content="03 - Mar"/>
                                                    <ComboBoxItem Content="04 - Apr"/>
                                                    <ComboBoxItem Content="05 - May"/>
                                                    <ComboBoxItem Content="06 - Jun"/>
                                                    <ComboBoxItem Content="07 - Jul"/>
                                                    <ComboBoxItem Content="08 - Aug"/>
                                                    <ComboBoxItem Content="09 - Sep"/>
                                                    <ComboBoxItem Content="10 - Oct"/>
                                                    <ComboBoxItem Content="11 - Nov"/>
                                                    <ComboBoxItem Content="12 - Dec"/>
                                                </ComboBox>
                                                <ComboBox x:Name="CmbBirthDay" Grid.Column="2" Height="26" FontSize="11" Foreground="#333333" SelectedIndex="0" ToolTip="Select Day" SelectionChanged="BirthdateField_Changed">
                                                    <ComboBoxItem Content="Day"/>
                                                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/>
                                                    <ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/>
                                                    <ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/>
                                                    <ComboBoxItem Content="16"/><ComboBoxItem Content="17"/><ComboBoxItem Content="18"/><ComboBoxItem Content="19"/><ComboBoxItem Content="20"/>
                                                    <ComboBoxItem Content="21"/><ComboBoxItem Content="22"/><ComboBoxItem Content="23"/><ComboBoxItem Content="24"/><ComboBoxItem Content="25"/>
                                                    <ComboBoxItem Content="26"/><ComboBoxItem Content="27"/><ComboBoxItem Content="28"/><ComboBoxItem Content="29"/><ComboBoxItem Content="30"/><ComboBoxItem Content="31"/>
                                                </ComboBox>
                                                <TextBox x:Name="TxtBirthYear" Grid.Column="4" Height="26" FontSize="12" Foreground="#333333" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" ToolTip="Type 4-digit Year (e.g. 2004)" TextChanged="BirthdateField_Changed"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtWarn_Birthdate" Text="⚠️ Unrecognized date. Please enter Month, Day, Year." FontSize="9" Foreground="#E74C3C" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Place of Birth" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Birthplace" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Birthplace" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtBirthplace" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sex" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Sex" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Sex" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbSex" Height="26" FontSize="12">
                                                <ComboBoxItem Content="Female"/>
                                                <ComboBoxItem Content="Male"/>
                                                <ComboBoxItem Content="Others"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Civil Status" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_CivilStatus" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_CivilStatus" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbCivilStatus" Height="26" FontSize="12" IsEditable="True">
                                                <ComboBoxItem Content="Single"/>
                                                <ComboBoxItem Content="Married"/>
                                                <ComboBoxItem Content="Widowed"/>
                                                <ComboBoxItem Content="Separated"/>
                                                <ComboBoxItem Content="Divorced"/>
                                                <ComboBoxItem Content="Annulled"/>
                                                <ComboBoxItem Content="Common-law / Live-in"/>
                                                <ComboBoxItem Content="Others"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Educational Attainment" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_EducationalAttainment" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_EducationalAttainment" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbEducationalAttainment" Height="26" FontSize="12" IsEditable="True">
                                                <ComboBoxItem Content="Elementary Level"/>
                                                <ComboBoxItem Content="Elementary Graduate"/>
                                                <ComboBoxItem Content="High School Level"/>
                                                <ComboBoxItem Content="High School Graduate"/>
                                                <ComboBoxItem Content="Vocational / TVET"/>
                                                <ComboBoxItem Content="College Level"/>
                                                <ComboBoxItem Content="College Graduate"/>
                                                <ComboBoxItem Content="Post-Graduate"/>
                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Others"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Religion" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Religion" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Religion" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbReligion" Height="26" FontSize="12" IsEditable="True">
                                                <ComboBoxItem Content="Roman Catholic"/>
                                                <ComboBoxItem Content="Islam"/>
                                                <ComboBoxItem Content="Iglesia ni Cristo"/>
                                                <ComboBoxItem Content="Seventh-day Adventist"/>
                                                <ComboBoxItem Content="Evangelical / Born Again"/>
                                                <ComboBoxItem Content="Jehovah's Witnesses"/>
                                                <ComboBoxItem Content="Baptist"/>
                                                <ComboBoxItem Content="Methodist"/>
                                                <ComboBoxItem Content="Others"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="PhilSys Card Number" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_PhilSysNumber" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_PhilSysNumber" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtPhilSysNumber" Height="26" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Section 2: Problem Presented / Circumstance (Encircled) -->
                                    <Border Background="#F9F2F4" CornerRadius="4" Padding="6,3" Margin="0,6,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="II. PROBLEM PRESENTED / CIRCUMSTANCES (ENCIRCLED OPTION)" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                            <Border x:Name="BadgeCircumstanceDetected" Grid.Column="1" Background="#E6F9EE" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                                <TextBlock x:Name="TxtCircumstanceBadge" Text="● Encircled Detected" FontSize="10" FontWeight="Bold" Foreground="#27AE60"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Circumstance of Being a Solo Parent" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                        <ComboBox x:Name="CmbCircumstance" Height="28" FontSize="12" Margin="0,2,0,0" SelectionChanged="CmbCircumstance_SelectionChanged"/>
                                        
                                        <!-- A2: Death of Spouse -->
                                        <StackPanel x:Name="PnlA2" Margin="0,6,0,0" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Cause of Death" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                                    <TextBox x:Name="TxtA2Cause" Height="26" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Date of Death (YYYY-MM-DD)" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                                    <TextBox x:Name="TxtA2Date" Height="26" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- A4: Physical & Mental Incapacity of Spouse -->
                                        <StackPanel x:Name="PnlA4" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Type of Disability" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                            <TextBox x:Name="TxtA4Disability" Height="26" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- A5: Legal or de facto Separation -->
                                        <StackPanel x:Name="PnlA5" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Period / Duration of Separation" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                            <TextBox x:Name="TxtA5Period" Height="26" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- A6: Declaration of nullity / annulment of marriage -->
                                        <StackPanel x:Name="PnlA6" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Marriage Status Selection" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <CheckBox x:Name="ChkA6Nullity" Content="Declaration of Nullity" FontSize="12" Margin="0,0,16,0"/>
                                                <CheckBox x:Name="ChkA6Annulment" Content="Annulment" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- B: Spouse / Family Member of OFW -->
                                        <StackPanel x:Name="PnlB" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Length of Stay Abroad / Country" FontSize="10" FontWeight="SemiBold" Foreground="#702943"/>
                                            <TextBox x:Name="TxtBStayAbroad" Height="26" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Section 3: Residence & Socioeconomic -->
                                    <Border Background="#F9F2F4" CornerRadius="4" Padding="6,3" Margin="0,6,0,6">
                                        <TextBlock Text="III. RESIDENCE &amp; SOCIOECONOMIC DATA" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Address (House No. / Street / Purok)" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Address" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Address" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtAddress" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Barangay" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Barangay" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Barangay" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtBarangay" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Monthly Income (₱)" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_MonthlyIncome" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_MonthlyIncome" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtMonthlyIncome" Height="26" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Occupation" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_Occupation" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_Occupation" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtOccupation" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Employment Status" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_EmploymentStatus" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_EmploymentStatus" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbEmploymentStatus" Height="26" FontSize="12" SelectionChanged="CmbEmploymentStatus_SelectionChanged">
                                                <ComboBoxItem Content="Employed"/>
                                                <ComboBoxItem Content="Self-Employed"/>
                                                <ComboBoxItem Content="Not Employed"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Contact Number" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_ContactNumber" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_ContactNumber" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtContactNumber" Height="26" FontSize="12" TextChanged="TxtContactNumber_TextChanged"/>
                                            <TextBlock x:Name="TxtWarn_ContactNumber" Text="⚠️ Must be 11 digits (09XXXXXXXXX)" FontSize="9" Foreground="#E74C3C" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Section 4: Emergency Contact -->
                                    <Border Background="#F9F2F4" CornerRadius="4" Padding="6,3" Margin="0,6,0,6">
                                        <TextBlock Text="IV. EMERGENCY CONTACT" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Contact Person" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_EmergencyName" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_EmergencyName" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtEmergencyName" Height="26" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Relationship" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_EmergencyRelationship" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_EmergencyRelationship" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <ComboBox x:Name="CmbEmergencyRelationship" Height="26" FontSize="12" IsEditable="True">
                                                <ComboBoxItem Content="Mother"/>
                                                <ComboBoxItem Content="Father"/>
                                                <ComboBoxItem Content="Sister"/>
                                                <ComboBoxItem Content="Brother"/>
                                                <ComboBoxItem Content="Son"/>
                                                <ComboBoxItem Content="Daughter"/>
                                                <ComboBoxItem Content="Child"/>
                                                <ComboBoxItem Content="Spouse"/>
                                                <ComboBoxItem Content="Aunt"/>
                                                <ComboBoxItem Content="Uncle"/>
                                                <ComboBoxItem Content="Cousin"/>
                                                <ComboBoxItem Content="Grandmother"/>
                                                <ComboBoxItem Content="Grandfather"/>
                                                <ComboBoxItem Content="In-law"/>
                                                <ComboBoxItem Content="Friend"/>
                                                <ComboBoxItem Content="Neighbor"/>
                                                <ComboBoxItem Content="Guardian"/>
                                                <ComboBoxItem Content="Others"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Emergency Phone" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                                <Border x:Name="Badge_EmergencyNumber" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtConf_EmergencyNumber" Text="—" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBox x:Name="TxtEmergencyNumber" Height="26" FontSize="12" TextChanged="TxtEmergencyNumber_TextChanged"/>
                                            <TextBlock x:Name="TxtWarn_EmergencyNumber" Text="⚠️ Must be 11 digits (09XXXXXXXXX)" FontSize="9" Foreground="#E74C3C" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,6">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Emergency Contact Address" FontSize="10" FontWeight="SemiBold" Foreground="#666"/>
                                            <Border x:Name="Badge_EmergencyAddress" Grid.Column="1" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
                                                <TextBlock x:Name="TxtConf_EmergencyAddress" Text="—" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <TextBox x:Name="TxtEmergencyAddress" Height="26" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Section 5: Family Composition (Dependents Table) -->
                                    <Grid Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#F9F2F4" CornerRadius="4" Padding="6,3">
                                            <TextBlock Text="V. FAMILY COMPOSITION (DEPENDENTS)" FontSize="11" FontWeight="Bold" Foreground="#702943"/>
                                        </Border>

                                        <Button Grid.Column="1" Content="+ Add Dependent" Click="AddDependent_Click"
                                                Background="Transparent" Foreground="#702943" FontWeight="Bold" FontSize="11"
                                                BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Dependents DataGrid -->
                                    <DataGrid x:Name="GridFamilyMembers" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" Background="White" RowHeight="28" BorderBrush="#E0D2D7"
                                              BorderThickness="1" MaxHeight="160" Margin="0,0,0,10"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0E8EA">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Member Name" Width="1.8*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding NameBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="name" Cursor="Hand">
                                                            <TextBox Text="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="name"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Sex" Width="55">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding SexBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="sex" Cursor="Hand">
                                                            <TextBox Text="{Binding Sex, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="sex"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Age" Width="45">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding AgeBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="age" Cursor="Hand">
                                                            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="age"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Birthdate" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DobBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="dob" Cursor="Hand">
                                                            <TextBox Text="{Binding Birthdate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="dob"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Civil Status" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding CivBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="civ" Cursor="Hand">
                                                            <TextBox Text="{Binding CivilStatus, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="civ"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Relationship" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding RelBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="rel" Cursor="Hand">
                                                            <TextBox Text="{Binding Relationship, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="rel"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Education/Job" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding EduBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="edu" Cursor="Hand">
                                                            <TextBox Text="{Binding EducationEmployment, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="edu"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Income" Width="75">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding IncBg}" Padding="4,2" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="inc" Cursor="Hand">
                                                            <TextBox Text="{Binding Income, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" GotFocus="FamilyMemberCell_GotFocus" PreviewMouseDown="FamilyMemberCell_PreviewMouseDown" Tag="inc"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FOOTER ACTIONS -->
                <Border Grid.Row="2" Background="#FDF8F9" BorderBrush="#EADCE0" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Click="Close_Click"
                                    Height="36" Width="100" Background="Transparent" Foreground="#702943"
                                    FontSize="12" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#D4BAC3" Cursor="Hand" Margin="0,0,10,0"/>

                            <Button x:Name="BtnConfirmPrepopulate" Content="✓ Pre-populate &amp; Open Registration Form" Click="ConfirmPrepopulate_Click"
                                    Height="36" Padding="18,0" Background="#702943" Foreground="White"
                                    FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- OCR PROCESSING MODAL OVERLAY -->
                <Grid x:Name="OverlayProcessing" Grid.RowSpan="3" Visibility="Collapsed" Background="#77000000">
                    <Border Background="White" CornerRadius="16" Width="440" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Icon with pulsing badge -->
                            <Border Width="60" Height="60" CornerRadius="30" Background="#F9F2F4" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="⚡" FontSize="26" Foreground="#702943" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <TextBlock Text="Ingesting Application Form..." FontSize="16" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtProcessingStep" Text="Analyzing document structure..." FontSize="12" Foreground="#702943" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            
                            <!-- Progress Bar -->
                            <ProgressBar x:Name="OcrStageProgressBar" Height="8" Minimum="0" Maximum="100" Value="10" Foreground="#702943" Background="#F0E8EA" BorderThickness="0" Margin="0,0,0,14"/>
                            
                            <!-- Active Sub-task / Field readout -->
                            <Border Background="#FAF7F8" CornerRadius="8" Padding="12,8" BorderBrush="#EADCE0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active Task:" FontSize="11" FontWeight="Bold" Foreground="#702943" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtCurrentExtractingField" Grid.Column="1" Text="Deskewing and enhancing scan..." FontSize="11" Foreground="#555" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
