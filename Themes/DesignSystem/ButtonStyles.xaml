<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Effects.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Shared button template.
        - Hover:   an overlay border fades in (0.12s) so the tint transitions smoothly
        - Pressed: the whole button scales to 97% and the overlay deepens
        - Focus:   keyboard-only rounded ring via FocusVisualStyle
        - Disabled: 45% opacity, arrow cursor
        Each variant supplies its own DsBtnHoverOverlay / DsBtnPressOverlay through Style.Resources.
    -->
    <ControlTemplate x:Key="DsButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource DsBtnCorner}"/>
            <Border x:Name="HoverOverlay"
                    Background="{DynamicResource DsBtnHoverOverlay}"
                    CornerRadius="{DynamicResource DsBtnCorner}"
                    Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="PressOverlay"
                    Background="{DynamicResource DsBtnPressOverlay}"
                    CornerRadius="{DynamicResource DsBtnCorner}"
                    Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.07"/>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.07"/>
                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Default corner radius; variants may override via Style.Resources -->
    <CornerRadius x:Key="DsBtnCorner">18</CornerRadius>

    <!-- Base: metrics only, no colors -->
    <Style x:Key="DsButtonBase" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontFamily" Value="{StaticResource DsFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource DsButtonTemplate}"/>
    </Style>

    <!-- Primary (filled brand) -->
    <Style x:Key="DsPrimaryButton" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="{StaticResource DsPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextOnPrimaryBrush}"/>
        <Setter Property="Effect" Value="{StaticResource DsShadowBrand}"/>
        <Style.Resources>
            <SolidColorBrush x:Key="DsBtnHoverOverlay" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="DsBtnPressOverlay" Color="#26000000"/>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary (outlined) -->
    <Style x:Key="DsSecondaryButton" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextBodyBrush}"/>
        <Style.Resources>
            <SolidColorBrush x:Key="DsBtnHoverOverlay" Color="#0D702943"/>
            <SolidColorBrush x:Key="DsBtnPressOverlay" Color="#1A702943"/>
        </Style.Resources>
    </Style>

    <!-- Ghost (no chrome until hover) -->
    <Style x:Key="DsGhostButton" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DsPrimaryBrush}"/>
        <Style.Resources>
            <SolidColorBrush x:Key="DsBtnHoverOverlay" Color="#12702943"/>
            <SolidColorBrush x:Key="DsBtnPressOverlay" Color="#22702943"/>
        </Style.Resources>
    </Style>

    <!-- Danger (destructive) -->
    <Style x:Key="DsDangerButton" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="{StaticResource DsDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsDangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DsTextOnPrimaryBrush}"/>
        <Style.Resources>
            <SolidColorBrush x:Key="DsBtnHoverOverlay" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="DsBtnPressOverlay" Color="#26000000"/>
        </Style.Resources>
    </Style>

    <!-- Icon button: square 32px, rounded, ghost behaviour. Content is usually a Path. -->
    <Style x:Key="DsIconButton" TargetType="Button" BasedOn="{StaticResource DsGhostButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}"/>
        <Style.Resources>
            <CornerRadius x:Key="DsBtnCorner">8</CornerRadius>
            <SolidColorBrush x:Key="DsBtnHoverOverlay" Color="#12702943"/>
            <SolidColorBrush x:Key="DsBtnPressOverlay" Color="#22702943"/>
        </Style.Resources>
    </Style>

</ResourceDictionary>
