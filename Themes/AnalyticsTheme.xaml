<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gradient Brushes for KPI Cards (Dark to Light by Importance) -->
    <LinearGradientBrush x:Key="KpiGradient1" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7B1426" Offset="0"/>
        <GradientStop Color="#F4E6E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiGradient2" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A14452" Offset="0"/>
        <GradientStop Color="#F4E6E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KpiGradient3" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9A3AB" Offset="0"/>
        <GradientStop Color="#F4E6E8" Offset="1"/>
    </LinearGradientBrush>

    <!-- KPI Text Styles for Gradient Cards -->
    <Style x:Key="KpiCardValueDark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="KpiCardLabelDark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style x:Key="KpiCardValueMid" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#5E0F1A"/>
    </Style>
    <Style x:Key="KpiCardLabelMid" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#7A5C60"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="KpiCardValueLight" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#5E0F1A"/>
    </Style>
    <Style x:Key="KpiCardLabelLight" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#7A5C60"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Color x:Key="PrimaryMaroon">#7B1426</Color>
    <Color x:Key="DarkMaroonText">#5E0F1A</Color>
    <Color x:Key="MidMaroon">#A14452</Color>
    <Color x:Key="LightMaroon">#D9A3AB</Color>
    <Color x:Key="TintMaroon">#F4E6E8</Color>
    <Color x:Key="BorderMaroon">#EAD9DB</Color>
    <Color x:Key="MutedText">#7A5C60</Color>
    <Color x:Key="BodyText">#2B1A1C</Color>
    <Color x:Key="BackgroundWhite">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryMaroonBrush" Color="{StaticResource PrimaryMaroon}"/>
    <SolidColorBrush x:Key="DarkMaroonTextBrush" Color="{StaticResource DarkMaroonText}"/>
    <SolidColorBrush x:Key="MidMaroonBrush" Color="{StaticResource MidMaroon}"/>
    <SolidColorBrush x:Key="LightMaroonBrush" Color="{StaticResource LightMaroon}"/>
    <SolidColorBrush x:Key="TintMaroonBrush" Color="{StaticResource TintMaroon}"/>
    <SolidColorBrush x:Key="BorderMaroonBrush" Color="{StaticResource BorderMaroon}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>
    <SolidColorBrush x:Key="BodyTextBrush" Color="{StaticResource BodyText}"/>
    <SolidColorBrush x:Key="BackgroundWhiteBrush" Color="{StaticResource BackgroundWhite}"/>

    <!-- KPI Card Style with Hover Effects -->
    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMaroonBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryMaroonBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- KPI Value Text Style -->
    <Style x:Key="KpiValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryMaroonBrush}"/>
    </Style>

    <!-- KPI Label Text Style -->
    <Style x:Key="KpiLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Title Text Style -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DarkMaroonTextBrush}"/>
    </Style>

    <!-- Chart Title Style -->
    <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
    </Style>

    <!-- Chart Label Style -->
    <Style x:Key="ChartLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <!-- Button Style (Filter, Export) -->
    <Style x:Key="AnalyticsButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BackgroundWhiteBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMaroonBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TintMaroonBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card Container Style with Hover Effects -->
    <Style x:Key="CardContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMaroonBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryMaroonBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Progress Bar Foreground (maroon) -->
    <Style x:Key="AnalyticsProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource PrimaryMaroonBrush}"/>
        <Setter Property="Background" Value="{StaticResource TintMaroonBrush}"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <!-- Progressive Gradient Brushes (Dark to Light, Top to Bottom Cards) -->
    <SolidColorBrush x:Key="KpiCardBg1" Color="#CB4E6E"/>     <!-- Card 1: Pantawid Beneficiary (Lightest) -->
    <SolidColorBrush x:Key="KpiCardBg2" Color="#BB4362"/>     <!-- Card 2: LGBT -->
    <SolidColorBrush x:Key="KpiCardBg3" Color="#AB3856"/>     <!-- Card 3: Total Dependents -->
    <SolidColorBrush x:Key="KpiCardBg4" Color="#9B2D4A"/>     <!-- Card 4: Male -->
    <SolidColorBrush x:Key="KpiCardBg5" Color="#8B2238"/>     <!-- Card 5: Female -->
    <SolidColorBrush x:Key="KpiCardBg6" Color="#7B1426"/>     <!-- Card 6: Total Solo Parents (Darkest) -->

    <!-- KPI Card Styles - Progressive Darkening -->
    
    <!-- Card 1: Pantawid Beneficiary (Lightest) -->
    <Style x:Key="KpiCardStyle1" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KpiCardBg1}"/>
        <Setter Property="BorderBrush" Value="#AB455C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#8D3845"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KpiValueStyle1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="KpiLabelStyle1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Card 2: LGBT -->
    <Style x:Key="KpiCardStyle2" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KpiCardBg2}"/>
        <Setter Property="BorderBrush" Value="#9B3B50"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#7D2F40"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KpiValueStyle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="KpiLabelStyle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Card 3: Total Dependents -->
    <Style x:Key="KpiCardStyle3" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KpiCardBg3}"/>
        <Setter Property="BorderBrush" Value="#8B3040"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#6D2530"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KpiValueStyle3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="KpiLabelStyle3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Card 4: Male -->
    <Style x:Key="KpiCardStyle4" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KpiCardBg4}"/>
        <Setter Property="BorderBrush" Value="#7B2530"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#5D1820"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KpiValueStyle4" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="KpiLabelStyle4" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Card 5: Female -->
    <Style x:Key="KpiCardStyle5" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KpiCardBg5}"/>
        <Setter Property="BorderBrush" Value="#6B1820"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#4D0F15"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KpiValueStyle5" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="KpiLabelStyle5" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Card 6: Total Solo Parents (Darkest) -->
    <Style x:Key="KpiCardStyle6" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KpiCardBg6}"/>
        <Setter Property="BorderBrush" Value="#5E0F1A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#3D0810"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KpiValueStyle6" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="KpiLabelStyle6" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <!-- ComboBox Item Style (for dropdown options) -->
    <Style x:Key="AnalyticsComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#2B1A1C"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#F4E6E8"/>
                            <Setter Property="Foreground" Value="#7B1426"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EAD9DB"/>
                            <Setter Property="Foreground" Value="#7B1426"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
