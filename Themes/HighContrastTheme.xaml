<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══ HIGH-CONTRAST ACCESSIBILITY THEME ═══ -->
    <Color x:Key="SolumPrimaryColor">#3D0C1D</Color>
    <SolidColorBrush x:Key="SolumPrimaryBrush" Color="#3D0C1D"/>
    <SolidColorBrush x:Key="SolumPrimaryHoverBrush" Color="#2A0512"/>
    <SolidColorBrush x:Key="SolumPrimaryPressedBrush" Color="#180007"/>
    <SolidColorBrush x:Key="SolumPrimaryBorderBrush" Color="#000000"/>

    <!-- High-Contrast Text Tokens -->
    <SolidColorBrush x:Key="SolumTextHeadingBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SolumTextBodyBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SolumTextMutedBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SolumTextSubtleBrush" Color="#222222"/>

    <!-- High-Contrast Borders -->
    <SolidColorBrush x:Key="SolumBorderSubtleBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SolumBorderDividerBrush" Color="#333333"/>
    <SolidColorBrush x:Key="DsBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DsBorderStrongBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DsDividerBrush" Color="#222222"/>

    <!-- Design System Text Overrides -->
    <SolidColorBrush x:Key="DsTextHeadingBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DsTextBodyBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DsTextMutedBrush" Color="#111111"/>
    <SolidColorBrush x:Key="DsFocusRingBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DsFocusGlowBrush" Color="#CC000000"/>

    <!-- High-Contrast Table Row Overrides -->
    <SolidColorBrush x:Key="SolumTableRowHoverBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="SolumTableRowHoverBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SolumTableRowSelectedBorderBrush" Color="#000000"/>

    <!-- Thick High-Contrast Input Borders -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#000000"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#000000"/>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#000000"/>
    </Style>
</ResourceDictionary>
