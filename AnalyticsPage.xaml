<Page x:Class="SOLUM_UI.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Analytics"
      Background="#FFFFFF">

    <Page.Resources>
        <Style x:Key="AnalyticsCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0B8C0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="CmbBg" Background="White" BorderBrush="#D0B8C0"
                                    BorderThickness="1.5" CornerRadius="8">
                                <Grid Margin="12,0,36,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Opacity="0"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Data="M7,10L12,15L17,10H7Z"
                                  Fill="#702943" Stretch="Uniform" Width="12" Height="12"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" CornerRadius="10" BorderBrush="#D0B8C0"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#C0A0AA" BlurRadius="12" ShadowDepth="3" Opacity="0.14"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CmbBg" Property="BorderBrush" Value="#702943"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="CmbBg" Property="BorderBrush" Value="#702943"/>
                                <Setter TargetName="CmbBg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBg" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#FDF0F3"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBg" Property="Background" Value="#F0E4E8"/>
                                        <Setter Property="Foreground" Value="#702943"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E0D0D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="StatNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="StatLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SecLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#702943"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BarLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RecentItem" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#EEE4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDF5F7"/>
                    <Setter Property="BorderBrush" Value="#C0A0AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0D0D5"
                BorderThickness="0,0,0,1" Padding="24,14,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FDF5F7" CornerRadius="8" BorderBrush="#E0D0D5"
                            BorderThickness="1" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#702943" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLastRefresh" Text=""
                                       FontSize="10" Foreground="#702943"
                                       FontFamily="Segoe UI" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ActiveFilterBadge" Background="#F0E8EC" CornerRadius="8"
                            BorderBrush="#D0B8C0" BorderThickness="1"
                            Padding="12,5" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtActiveFilter" Text=""
                                   FontSize="10" Foreground="#702943"
                                   FontFamily="Segoe UI" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF" CornerRadius="22"
                            BorderBrush="#E0D0D5" BorderThickness="1.5" Margin="0,0,0,0">
                        <Button x:Name="FilterDropBtn" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Height="40" Padding="16,0" Click="FilterDrop_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,2H21V4L14,11V20L10,18V11L3,4V2Z"
                                      Fill="#702943" Stretch="Uniform" Width="13" Height="13"
                                      VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Filter" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#702943" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterDropBtn}"
                           Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="White" CornerRadius="16"
                                BorderBrush="#E8D4DA" BorderThickness="1.5" Padding="20,18,20,18"
                                MinWidth="260">
                            <Border.Effect>
                                <DropShadowEffect Color="#702943" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="FILTER DATA" FontFamily="Segoe UI" FontSize="10"
                                           FontWeight="Bold" Foreground="#702943" Margin="0,0,0,16"/>

                                <TextBlock Text="Year" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbFilterYear"
                                          Style="{StaticResource AnalyticsCombo}"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="Month" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbFilterMonth"
                                          Style="{StaticResource AnalyticsCombo}"
                                          Margin="0,0,0,16"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="40" Cursor="Hand" Click="FilterReset_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="#F0F0F0" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="Reset" FontFamily="Segoe UI" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#555555"/>
                                    </Button>
                                    <Button Grid.Column="2" Height="40" Cursor="Hand" Click="FilterApply_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="#702943" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="Apply" FontFamily="Segoe UI" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Background="White">
            <StackPanel Margin="22,18,22,22">

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtTotalRecords" Style="{StaticResource StatNum}" Text="0"/>
                            <TextBlock Grid.Row="1" Text="Total Records" Style="{StaticResource StatLbl}"/>
                            <Border Grid.Row="2" Background="#F0E8EC" CornerRadius="5"
                                    Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtPeriodLabel" Text="All time"
                                           FontSize="9" Foreground="#702943" FontFamily="Segoe UI"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtActiveRecords" Style="{StaticResource StatNum}" Text="0" Foreground="#27AE60"/>
                            <TextBlock Grid.Row="1" Text="Valid Records" Style="{StaticResource StatLbl}"/>
                            <Border Grid.Row="2" Background="#E8F5E9" CornerRadius="5"
                                    Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtActiveRate" Text="0%" FontSize="9" Foreground="#27AE60" FontFamily="Segoe UI"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtInactiveRecords" Style="{StaticResource StatNum}" Text="0" Foreground="#999999"/>
                            <TextBlock Grid.Row="1" Text="Inactive" Style="{StaticResource StatLbl}"/>
                            <Border Grid.Row="2" Background="#F2F2F2" CornerRadius="5"
                                    Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtInactiveRate" Text="0%" FontSize="9" Foreground="#999999" FontFamily="Segoe UI"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtTotalChildren" Style="{StaticResource StatNum}" Text="0" Foreground="#C0762A"/>
                            <TextBlock Grid.Row="1" Text="Total Dependants" Style="{StaticResource StatLbl}"/>
                            <Border Grid.Row="2" Background="#FFF4E3" CornerRadius="5"
                                    Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtAvgChildren" Text="0 avg." FontSize="9" Foreground="#C0762A" FontFamily="Segoe UI"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="TxtFemaleCount" Style="{StaticResource StatNum}" Text="0"/>
                            <TextBlock Grid.Row="1" Text="Female Registrants" Style="{StaticResource StatLbl}"/>
                            <Border Grid.Row="2" Background="#F0E8EC" CornerRadius="5"
                                    Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtMaleCount" Text="0 male" FontSize="9" Foreground="#702943" FontFamily="Segoe UI"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="4" CornerRadius="2" Background="#702943" Margin="0,1,10,1"/>
                            <TextBlock Text="AI SUMMARY" Style="{StaticResource SecLabel}"/>
                        </StackPanel>
                        <Border Background="#FDF5F7" CornerRadius="8" BorderBrush="#E0D0D5"
                                BorderThickness="1" Padding="18,14" MinHeight="70">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="placeholder ng summary hehe" FontSize="13"
                                           FontStyle="Italic" Foreground="#C0A0AA"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock Text="AI-generated insights will appear here once integrated."
                                           FontSize="10" Foreground="#D0B8C0" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="4" CornerRadius="2" Background="#702943" Margin="0,1,10,1"/>
                                <TextBlock Text="RECORDS BY BARANGAY" Style="{StaticResource SecLabel}"/>
                            </StackPanel>
                            <Canvas x:Name="BarangayCanvas" Height="160" Margin="0,0,0,24"/>
                            <ItemsControl x:Name="BarangayLabels">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BarLbl}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   FontSize="9" Margin="2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="4" CornerRadius="2" Background="#702943" Margin="0,1,10,1"/>
                                <TextBlock Text="CIVIL STATUS" Style="{StaticResource SecLabel}"/>
                            </StackPanel>
                            <ItemsControl x:Name="CivilStatusChart">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       FontSize="11" Foreground="#444444"
                                                       FontFamily="Segoe UI" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Height="14" CornerRadius="3"
                                                    Background="#F0E8EC" VerticalAlignment="Center">
                                                <Border Height="14" CornerRadius="3"
                                                        Background="{Binding BarColor}"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#702943" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="4" CornerRadius="2" Background="#702943" Margin="0,1,10,1"/>
                                <TextBlock Text="SEX DISTRIBUTION" Style="{StaticResource SecLabel}"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Border Width="84" Height="84" CornerRadius="42"
                                            Background="#FDF0F3" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtFemaleCircle" Text="0"
                                                       FontSize="24" FontWeight="Bold"
                                                       Foreground="#702943" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="F" FontSize="10" Foreground="#A06080"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtFemaleRate" Text="0%"
                                               FontSize="14" FontWeight="Bold" Foreground="#702943"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Female" FontSize="10" Foreground="#999999"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Border Width="84" Height="84" CornerRadius="42"
                                            Background="#EEF2FF" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtMaleCircle" Text="0"
                                                       FontSize="24" FontWeight="Bold"
                                                       Foreground="#3B5BDB" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="M" FontSize="10" Foreground="#7088E0"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="TxtMaleRate" Text="0%"
                                               FontSize="14" FontWeight="Bold" Foreground="#3B5BDB"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Male" FontSize="10" Foreground="#999999"
                                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="4" CornerRadius="2" Background="#702943" Margin="0,1,10,1"/>
                            <TextBlock Text="RECENTLY UPDATED RECORDS" Style="{StaticResource SecLabel}"/>
                            <TextBlock Text="  — click a record to view details"
                                       FontSize="10" Foreground="#BBBBBB"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RecentItem}" Margin="0,0,10,8"
                                            MouseLeftButtonDown="RecentRecord_Click"
                                            Tag="{Binding SpId}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#111111"
                                                           FontFamily="Segoe UI"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Barangay}" FontSize="10"
                                                           Foreground="#888888" FontFamily="Segoe UI"
                                                           Margin="0,2,0,4"/>
                                                <TextBlock Text="{Binding DateLabel}" FontSize="9"
                                                           Foreground="#BBBBBB" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="5"
                                                    Background="{Binding StatusBg}"
                                                    Padding="7,3" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Status}" FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding StatusFg}"
                                                           FontFamily="Segoe UI"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
